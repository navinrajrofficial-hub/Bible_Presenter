{
  "version": 1,
  "slides": [
    {
      "id": 1774107563826.375,
      "type": "html",
      "name": "Esther Sunday",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"/>\n<title>உயிர்த்தெழுதல் நாள் - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel+Decorative:wght@700;900&family=Noto+Serif+Tamil:wght@400;700;900&family=IM+Fell+English:ital@1&family=Playfair+Display:wght@700;900&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#050301}\n.stage{position:relative;width:100vw;height:100vh;overflow:hidden}\n.sky{position:absolute;inset:0;z-index:0;background:linear-gradient(185deg,#020100 0%,#0a0502 8%,#1a0c04 16%,#2e1406 24%,#4a1e08 32%,#6b2a0a 40%,#8c3a10 48%,#a85020 55%,#c46828 62%,#d98030 68%,#e89040 73%,#c46828 78%,#8c3a10 84%,#4a1e08 90%,#1a0c04 96%,#050301 100%)}\ncanvas{position:absolute;inset:0;pointer-events:none}\n#cRays{z-index:1}#cDoves{z-index:2}#cGlow{z-index:3}#cSparkle{z-index:5}#cPetals{z-index:6}\n.ground-mist{position:absolute;left:0;right:0;bottom:0;height:20vh;z-index:4;background:linear-gradient(to top,rgba(255,200,100,.08) 0%,rgba(255,160,60,.04) 50%,transparent 100%)}\n.content{position:absolute;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0}\n.verse-banner{width:min(99vw,1500px);text-align:center;padding:.8vh 1.2vw;margin-bottom:.5vh;border-top:1px solid rgba(255,200,80,.25);border-bottom:1px solid rgba(255,200,80,.25);background:linear-gradient(90deg,rgba(180,100,20,0) 0%,rgba(220,140,40,.18) 20%,rgba(255,180,60,.22) 50%,rgba(220,140,40,.18) 80%,rgba(180,100,20,0) 100%);opacity:0;animation:fadeDown .9s ease forwards .3s}\n.verse-ta{font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1.05vw,18px);color:rgba(255,230,160,.92);line-height:1.5}\n.verse-ref{font-family:'IM Fell English',serif;font-style:italic;font-size:clamp(11px,.9vw,14px);color:rgba(255,200,120,.7);margin-top:.15vh}\n.card{width:min(99vw,1500px);max-height:96vh;overflow-y:auto;scrollbar-width:none;position:relative;display:flex;flex-direction:column;align-items:center;gap:0;padding:clamp(10px,1.2vh,18px) clamp(16px,1.6vw,26px);border-radius:12px;border:1px solid rgba(255,190,80,.28);background:rgba(10,5,1,.8);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);box-shadow:0 0 60px rgba(220,140,40,.22),0 0 120px rgba(180,100,20,.1),inset 0 1px 0 rgba(255,220,120,.18),inset 0 -1px 0 rgba(220,160,60,.12);opacity:0;animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .6s}\n.card::-webkit-scrollbar{display:none}\n.card::before{content:'';position:absolute;inset:0;pointer-events:none;border-radius:12px;background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(255,180,60,.07) 0%,transparent 60%),radial-gradient(ellipse 60% 40% at 50% 100%,rgba(220,140,40,.06) 0%,transparent 60%)}\n.card::after{content:'';position:absolute;top:2px;left:2px;right:2px;bottom:2px;border-radius:9px;border:1px solid rgba(255,200,100,.10);pointer-events:none}\n.church-top{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.75vw,12px);color:rgba(255,210,140,.6);letter-spacing:2px;margin-bottom:.5vh;opacity:0;animation:fadeUp .8s ease forwards 1s}\n.div-row{display:flex;align-items:center;gap:1vw;width:100%;margin-bottom:.45vh;opacity:0;animation:fadeUp .7s ease forwards 1.1s}\n.div-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(255,180,60,.50),transparent)}\n.div-gem{color:rgba(255,210,120,.8);font-size:clamp(10px,.9vw,14px)}\n.event-tag{font-family:'Noto Serif Tamil',serif;font-size:clamp(9px,.85vw,12px);color:rgba(255,210,140,.85);letter-spacing:3px;margin-bottom:.3vh;opacity:0;animation:fadeUp .8s ease forwards 1.2s}\n.palm-title{font-family:'Noto Serif Tamil',serif;font-weight:900;font-size:clamp(32px,4.2vw,74px);line-height:1.08;letter-spacing:1px;margin-bottom:.25vh;text-align:center;opacity:0;background:linear-gradient(150deg,#fff8e0 0%,#ffe090 18%,#ffd060 32%,#ffb830 48%,#e8880a 64%,#c86010 80%,#e8880a 100%);background-size:250% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 4px 18px rgba(255,160,40,.55));animation:palmReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.3s,goldFlow 6s ease-in-out infinite 2.5s}\n.service-text{font-family:'Noto Serif Tamil',serif;font-size:clamp(20px,2vw,34px);font-weight:700;letter-spacing:4px;margin:.15vh 0;opacity:0;background:linear-gradient(90deg,#c86010 0%,#ffb830 25%,#fff0c0 50%,#ffb830 75%,#c86010 100%);background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:fadeUp .8s ease forwards 1.6s,goldShift 3s linear infinite 2.5s}\n.service-subtext{font-family:'Noto Serif Tamil',serif;font-size:clamp(11px,.95vw,15px);color:rgba(255,200,120,.55);letter-spacing:3px;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 1.75s}\n.cross-wrap{position:relative;margin:.7vh 0;opacity:0;animation:crossReveal 1.2s cubic-bezier(.34,1.56,.64,1) forwards 1.8s}\n.cross-wrap svg{display:block;width:auto;height:clamp(80px,13vh,150px);filter:drop-shadow(0 0 14px rgba(255,200,80,.9)) drop-shadow(0 0 30px rgba(220,150,40,.6));animation:crossGlow 3s ease-in-out infinite}\n.info-row{display:flex;align-items:center;gap:2.5vw;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 2s}\n.info-box{text-align:center}\n.info-label{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(255,190,100,.60);letter-spacing:2px;margin-bottom:.2vh}\n.info-value{font-family:'Playfair Display',serif;font-size:clamp(18px,1.5vw,28px);font-weight:700;color:rgba(255,230,160,.95);text-shadow:0 0 18px rgba(255,180,60,.5)}\n.info-sep{font-size:clamp(15px,1.4vw,24px);color:rgba(255,180,80,.35)}\n.bishop-block{width:100%;position:relative;overflow:hidden;text-align:center;margin-bottom:.8vh;border-radius:16px;padding:clamp(8px,1vh,12px) clamp(10px,2vw,24px);background:linear-gradient(160deg,rgba(60,30,5,.75) 0%,rgba(20,8,1,.92) 100%);border:1px solid rgba(255,180,60,.15);box-shadow:0 12px 30px rgba(0,0,0,.6),inset 0 1px 1px rgba(255,255,255,.06);opacity:0;animation:fadeUp .9s ease forwards 2.2s}\n.bishop-block::before{content:'';position:absolute;top:0;left:20%;right:20%;height:1.5px;background:linear-gradient(90deg,transparent,rgba(255,200,80,.80),transparent);box-shadow:0 0 12px rgba(255,180,60,.8)}\n.bishop-block::after{content:'';position:absolute;top:0;left:-100%;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,220,120,.06),transparent);transform:skewX(-20deg);animation:blockSweep 5.5s infinite;pointer-events:none;z-index:1}\n.bishop-role{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(255,190,100,.60);letter-spacing:3px;margin-bottom:.2vh}\n.bishop-name-wrapper{position:relative;display:inline-block;z-index:2;padding:0 10px}\n.bishop-name-wrapper::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:140%;height:160%;background:radial-gradient(ellipse,rgba(255,180,60,.15) 0%,transparent 60%);animation:auraPulse 3s ease-in-out infinite;pointer-events:none}\n.bishop-name-en{position:relative;font-family:'Alex Brush',cursive;font-weight:400;font-size:clamp(36px,3.2vw,56px);line-height:1.15;letter-spacing:1px;background:linear-gradient(90deg,#c86010 0%,#ffe090 25%,#ffb830 50%,#ffe090 75%,#c86010 100%);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 3px 5px rgba(0,0,0,.95)) drop-shadow(0 0 15px rgba(255,180,60,.5));clip-path:polygon(0 0,0 0,0 100%,0 100%);animation:signatureLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s,goldShift 4s linear infinite}\n.pen-flare{position:absolute;top:45%;left:0;width:4px;height:4px;border-radius:50%;background:#fff8e0;opacity:0;z-index:10;pointer-events:none;box-shadow:0 0 10px 4px #ffe090,0 0 25px 12px #ffb830,0 0 40px 20px rgba(220,140,40,.6);animation:flareLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s}\n.bishop-name-ta{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1vw,18px);font-weight:700;color:rgba(255,220,150,.85)}\n.church-badge{position:relative;display:inline-flex;align-items:center;justify-content:center;opacity:0;animation:churchReveal 1s cubic-bezier(.34,1.56,.64,1) forwards 2.5s}\n.church-bg-inner{position:absolute;inset:3px;background:rgba(10,5,1,.92);border-radius:50px;z-index:1}\n.church-name{position:relative;z-index:2;white-space:nowrap;font-family:'Noto Serif Tamil',serif;font-weight:900;font-size:clamp(12px,.95vw,16px);letter-spacing:1px;padding:clamp(5px,.55vh,7px) clamp(16px,1.5vw,28px);background:linear-gradient(90deg,#c86010,#ffb830,#fff0c0,#ffb830,#c86010,#ffb830,#fff0c0);background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:goldShift 3s linear infinite;filter:drop-shadow(0 0 8px rgba(255,180,60,.7))}\n.ornament{position:absolute;font-size:clamp(14px,1.2vw,21px);opacity:.35;animation:ornSway 4s ease-in-out infinite}\n.orn-tl{top:10px;left:12px}.orn-tr{top:10px;right:12px;animation-delay:.5s}.orn-bl{bottom:10px;left:12px;animation-delay:1s}.orn-br{bottom:10px;right:12px;animation-delay:1.5s}\n.deco-row{position:absolute;left:0;right:0;bottom:0;z-index:11;display:flex;justify-content:center;gap:.5vw;padding-bottom:2px;pointer-events:none}\n.deco-item{font-size:clamp(12px,1.8vw,20px);opacity:.4;animation:decoSway 3.6s ease-in-out infinite;transform-origin:bottom center}\n.deco-item:nth-child(2n){animation-delay:.6s}.deco-item:nth-child(3n){animation-delay:1.2s}.deco-item:nth-child(4n){animation-delay:1.8s}\n.hallelujah{font-family:'Cinzel Decorative',cursive;font-size:clamp(9px,.8vw,13px);color:rgba(255,210,120,.6);letter-spacing:6px;margin-bottom:.3vh;opacity:0;animation:fadeUp .8s ease forwards .9s}\n@keyframes cardReveal{from{opacity:0;transform:translateY(30px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}\n@keyframes fadeDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes palmReveal{from{opacity:0;transform:scale(.7);filter:blur(14px)}to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 18px rgba(255,160,40,.55))}}\n@keyframes goldFlow{0%,100%{background-position:0% center}50%{background-position:100% center}}\n@keyframes goldShift{0%{background-position:0% center}100%{background-position:300% center}}\n@keyframes crossReveal{from{opacity:0;transform:scale(.3) rotate(-15deg)}to{opacity:1;transform:scale(1) rotate(0)}}\n@keyframes crossGlow{0%,100%{filter:drop-shadow(0 0 14px rgba(255,200,80,.9)) drop-shadow(0 0 30px rgba(220,150,40,.6))}50%{filter:drop-shadow(0 0 26px rgba(255,230,120,1)) drop-shadow(0 0 55px rgba(255,180,60,.9))}}\n@keyframes blockSweep{0%,30%{left:-100%}70%,100%{left:200%}}\n@keyframes auraPulse{0%,100%{opacity:.5;transform:translate(-50%,-50%) scale(.9)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}}\n@keyframes signatureLoop{0%,5%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:1}30%,85%{clip-path:polygon(0 0,100% 0,100% 100%,0 100%);opacity:1}95%{opacity:0}100%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:0}}\n@keyframes flareLoop{0%,5%{left:0%;opacity:0;transform:scale(.5) translateY(0)}8%{opacity:1;transform:scale(1.2) translateY(-4px)}28%{opacity:1;transform:scale(1.2) translateY(-1px)}30%,100%{left:100%;opacity:0;transform:scale(.5) translateY(0)}}\n@keyframes churchReveal{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}\n@keyframes ornSway{0%,100%{transform:rotate(-5deg) scale(1)}50%{transform:rotate(5deg) scale(1.1)}}\n@keyframes decoSway{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}\n@media (max-width:900px){.card,.verse-banner{width:99.5vw}.palm-title{font-size:clamp(28px,10vw,56px)}.service-text{font-size:clamp(18px,6vw,28px)}.bishop-name-en{font-size:clamp(30px,9vw,44px)}.info-value{font-size:clamp(15px,4.4vw,24px)}}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n  <div class=\"sky\"></div>\n  <canvas id=\"cRays\"></canvas>\n  <canvas id=\"cDoves\"></canvas>\n  <canvas id=\"cGlow\"></canvas>\n  <div class=\"ground-mist\"></div>\n  <canvas id=\"cSparkle\"></canvas>\n  <canvas id=\"cPetals\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"verse-banner\">\n      <div class=\"verse-ta\">அவர் இங்கே இல்லை, சொன்னபடியே உயிரோடு எழுந்திருந்தார்</div>\n      <div class=\"verse-ref\">— மத்தேயு 28:6</div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"ornament orn-tl\">🌸</span>\n      <span class=\"ornament orn-tr\">🌸</span>\n      <span class=\"ornament orn-bl\">🕊️</span>\n      <span class=\"ornament orn-br\">🕊️</span>\n\n      <div class=\"hallelujah\">✦ HALLELUJAH ✦</div>\n      <div class=\"church-top\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n\n      <div class=\"div-row\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-gem\">✦</span>\n        <span class=\"div-gem\" style=\"font-size:clamp(11px,1.4vw,16px);color:rgba(255,180,80,0.5)\">☀</span>\n        <span class=\"div-gem\">✦</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"event-tag\">☀ Easter Sunday · உயிர்த்தெழுதல் ☀</div>\n      <div class=\"palm-title\">உயிர்த்தெழுதல் நாள்</div>\n      <div class=\"service-text\">ஆராதனை</div>\n      <div class=\"service-subtext\">உயிர்ப்பின் நினைவு · ஜெபம் · மகிழ்ச்சி</div>\n\n      <div class=\"cross-wrap\">\n        <svg viewBox=\"0 0 160 220\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <radialGradient id=\"sunburst\" cx=\"50%\" cy=\"45%\" r=\"50%\">\n              <stop offset=\"0%\" stop-color=\"rgba(255,250,200,0.9)\"/>\n              <stop offset=\"40%\" stop-color=\"rgba(255,210,80,0.5)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(255,150,20,0)\"/>\n            </radialGradient>\n            <linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff8e0\"/>\n              <stop offset=\"15%\" stop-color=\"#ffe090\"/>\n              <stop offset=\"35%\" stop-color=\"#c87820\"/>\n              <stop offset=\"50%\" stop-color=\"#ffe8b0\"/>\n              <stop offset=\"65%\" stop-color=\"#d09030\"/>\n              <stop offset=\"85%\" stop-color=\"#f0c060\"/>\n              <stop offset=\"100%\" stop-color=\"#a05818\"/>\n            </linearGradient>\n            <linearGradient id=\"cg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff0c0\"/>\n              <stop offset=\"50%\" stop-color=\"#c87820\"/>\n              <stop offset=\"100%\" stop-color=\"#ffe090\"/>\n            </linearGradient>\n            <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n              <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n            <radialGradient id=\"shine\" cx=\"35%\" cy=\"30%\" r=\"60%\">\n              <stop offset=\"0%\" stop-color=\"rgba(255,250,220,0.7)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(255,250,220,0)\"/>\n            </radialGradient>\n          </defs>\n          <!-- Sunburst halo -->\n          <circle cx=\"80\" cy=\"110\" r=\"75\" fill=\"url(#sunburst)\" opacity=\"0.65\"/>\n          <!-- Light rays -->\n          <g opacity=\"0.22\">\n            <line x1=\"80\" y1=\"5\" x2=\"80\" y2=\"25\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"80\" y1=\"175\" x2=\"80\" y2=\"215\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"5\" y1=\"90\" x2=\"25\" y2=\"90\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"135\" y1=\"90\" x2=\"155\" y2=\"90\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"22\" y1=\"30\" x2=\"38\" y2=\"46\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <line x1=\"122\" y1=\"150\" x2=\"138\" y2=\"166\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <line x1=\"138\" y1=\"30\" x2=\"122\" y2=\"46\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <line x1=\"22\" y1=\"166\" x2=\"38\" y2=\"150\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </g>\n          <!-- Vertical beam: long top-to-bottom -->\n          <rect x=\"66\" y=\"10\" width=\"28\" height=\"205\" rx=\"5\" fill=\"url(#cg1)\" filter=\"url(#glow)\"/>\n          <!-- Horizontal beam: shorter, placed at upper third -->\n          <rect x=\"16\" y=\"62\" width=\"128\" height=\"28\" rx=\"5\" fill=\"url(#cg2)\" filter=\"url(#glow)\"/>\n          <!-- Shine overlays -->\n          <rect x=\"66\" y=\"10\" width=\"28\" height=\"205\" rx=\"5\" fill=\"url(#shine)\" opacity=\".65\"/>\n          <rect x=\"16\" y=\"62\" width=\"128\" height=\"28\" rx=\"5\" fill=\"url(#shine)\" opacity=\".45\"/>\n          <!-- Centre highlight stripes -->\n          <rect x=\"74\" y=\"10\" width=\"7\" height=\"205\" rx=\"3\" fill=\"rgba(255,250,200,0.30)\"/>\n          <rect x=\"16\" y=\"69\" width=\"128\" height=\"7\" rx=\"3\" fill=\"rgba(255,250,200,0.26)\"/>\n          <!-- Centre jewel at intersection -->\n          <circle cx=\"80\" cy=\"76\" r=\"13\" fill=\"url(#cg1)\" stroke=\"rgba(255,220,120,.6)\" stroke-width=\"1.5\" filter=\"url(#glow)\"/>\n          <circle cx=\"80\" cy=\"76\" r=\"6\" fill=\"rgba(255,250,220,0.9)\"/>\n          <circle cx=\"80\" cy=\"76\" r=\"2.5\" fill=\"rgba(255,230,140,1)\"/>\n        </svg>\n      </div>\n\n      <div class=\"info-row\">\n        <div class=\"info-box\">\n          <div class=\"info-label\">தேதி</div>\n          <div class=\"info-value\">05 · 04 · 2026</div>\n        </div>\n        <div class=\"info-sep\">✦</div>\n        <div class=\"info-box\">\n          <div class=\"info-label\">நேரம்</div>\n          <div class=\"info-value\">காலை 7:00</div>\n        </div>\n      </div>\n\n      <div class=\"bishop-block\">\n        <div class=\"bishop-role\">பிஷப்</div>\n        <div class=\"bishop-name-wrapper\">\n          <div class=\"pen-flare\"></div>\n          <div class=\"bishop-name-en\">Bp. V. Paul Yuvaraj</div>\n        </div>\n        <div class=\"bishop-name-ta\">பி. வி. பால் யுவராஜ்</div>\n      </div>\n\n      <div class=\"church-badge\">\n        <div class=\"church-bg-inner\"></div>\n        <div class=\"church-name\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">☀</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">☀</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span>\n  </div>\n</div>\n\n<script>\n(function(){\n  const cv=document.getElementById('cRays');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const R=Array.from({length:28},(_,i)=>({a:(i/28)*Math.PI*1.8-Math.PI*.9+(Math.random()-.5)*.25,al:.03+Math.random()*.07,sp:(.0008+Math.random()*.002)*(Math.random()>.5?1:-1),ln:.35+Math.random()*.65}));\n  function draw(){t++;cx.clearRect(0,0,W,H);\n    const skyY=H*.38;\n    const gBg=cx.createRadialGradient(W*.5,skyY,0,W*.5,skyY,W*.6);\n    gBg.addColorStop(0,'rgba(255,220,100,.06)');gBg.addColorStop(.5,'rgba(255,160,40,.03)');gBg.addColorStop(1,'transparent');\n    cx.fillStyle=gBg;cx.fillRect(0,0,W,H);\n    R.forEach(r=>{r.a+=r.sp;\n      const ox=W*.5,oy=skyY;\n      const ax=Math.cos(r.a)*W*r.ln+ox,ay=Math.sin(r.a)*W*r.ln+oy;\n      const bx=Math.cos(r.a+.022)*W*r.ln+ox,by=Math.sin(r.a+.022)*W*r.ln+oy;\n      const g=cx.createLinearGradient(ox,oy,ax,ay);\n      g.addColorStop(0,`rgba(255,210,80,${r.al*2.2})`);\n      g.addColorStop(.35,`rgba(255,170,40,${r.al})`);\n      g.addColorStop(1,'rgba(200,100,10,0)');\n      cx.save();cx.beginPath();cx.moveTo(ox,oy);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();cx.fillStyle=g;cx.fill();cx.restore()\n    });\n    const pulse=.8+.2*Math.sin(t*.028);\n    const gSun=cx.createRadialGradient(W*.5,skyY,0,W*.5,skyY,W*.12*pulse);\n    gSun.addColorStop(0,'rgba(255,250,200,.25)');gSun.addColorStop(.3,'rgba(255,230,120,.15)');gSun.addColorStop(.6,'rgba(255,200,60,.07)');gSun.addColorStop(1,'transparent');\n    cx.fillStyle=gSun;cx.fillRect(0,0,W,H);\n    requestAnimationFrame(draw)\n  }\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cDoves');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function drawDove(cx,x,y,size,alpha,flap){\n    cx.save();cx.globalAlpha=alpha;cx.fillStyle='rgba(255,240,200,0.85)';cx.shadowColor='rgba(255,200,80,0.7)';cx.shadowBlur=size*3;\n    const wingAngle=Math.sin(flap)*.45;\n    cx.beginPath();cx.ellipse(x,y,size*1.2,size*.5,0,0,Math.PI*2);cx.fill();\n    cx.save();cx.translate(x,y);cx.rotate(-wingAngle);cx.beginPath();cx.ellipse(-size*.5,-size*.2,size*1.1,size*.38,-.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.save();cx.translate(x,y);cx.rotate(wingAngle);cx.beginPath();cx.ellipse(size*.5,-size*.2,size*1.1,size*.38,.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.beginPath();cx.arc(x+size*1.1,y-size*.1,size*.35,0,Math.PI*2);cx.fill();cx.restore();\n  }\n  const doves=Array.from({length:7},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight*.55+innerHeight*.05,size:4+Math.random()*7,vx:(.4+Math.random()*.7)*(Math.random()>.5?1:-1),vy:(Math.random()-.5)*.15,flapSpeed:.05+Math.random()*.04,flapOffset:Math.random()*Math.PI*2,alpha:.1+Math.random()*.2}));\n  function draw(){t++;cx.clearRect(0,0,W,H);doves.forEach(d=>{d.x+=d.vx;d.y+=d.vy;if(d.x>W+40)d.x=-40;if(d.x<-40)d.x=W+40;if(d.y<0)d.y=H*.5;if(d.y>H*.65)d.y=H*.1;drawDove(cx,d.x,d.y,d.size,d.alpha,t*d.flapSpeed+d.flapOffset)});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cGlow');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function draw(){t++;cx.clearRect(0,0,W,H);\n    const pulse=.85+.15*Math.sin(t*.025);\n    const g=cx.createRadialGradient(W*.5,H*.58,0,W*.5,H*.58,W*.38*pulse);\n    g.addColorStop(0,'rgba(255,190,60,.1)');g.addColorStop(.35,'rgba(220,140,30,.05)');g.addColorStop(.65,'rgba(180,100,20,.02)');g.addColorStop(1,'transparent');\n    cx.fillStyle=g;cx.fillRect(0,0,W,H);requestAnimationFrame(draw)\n  }\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cSparkle');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const S=Array.from({length:60},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:.4+Math.random()*1.6,ph:Math.random()*Math.PI*2,sp:.018+Math.random()*.035,vy:-(Math.random()*.2+.05),vx:(Math.random()-.5)*.08,col:Math.random()>.5?'255,220,120':'255,240,180'}));\n  function draw(){t++;cx.clearRect(0,0,W,H);S.forEach(s=>{s.y+=s.vy;s.x+=s.vx;if(s.y<-10){s.y=H+10;s.x=Math.random()*W}const a=.1+.6*(.5+.5*Math.sin(t*s.sp+s.ph));cx.save();cx.globalAlpha=a;cx.fillStyle=`rgba(${s.col},1)`;cx.shadowColor=`rgba(${s.col},.7)`;cx.shadowBlur=s.r*6;cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();cx.restore()});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cPetals');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  class Petal{\n    constructor(rand){\n      this.x=Math.random()*innerWidth;this.y=rand?(Math.random()*innerHeight):(-20);\n      this.w=6+Math.random()*10;this.h=4+Math.random()*7;\n      this.vx=(Math.random()-.5)*.8;this.vy=Math.random()*.5+.15;\n      this.rot=Math.random()*Math.PI*2;this.rotV=(Math.random()-.5)*.04;\n      this.alpha=Math.random()*.35+.1;\n      const c=Math.random();\n      this.r=c>.6?255:c>.3?255:255;\n      this.g=c>.6?180:c>.3?220:240;\n      this.b=c>.6?100:c>.3?140:200;\n    }\n    update(){this.y+=this.vy;this.x+=this.vx+Math.sin(t*.01+this.x*.01)*.3;this.rot+=this.rotV;this.alpha-=.0005;if(this.alpha<=0||this.y>innerHeight+30)Object.assign(this,new Petal(false))}\n    draw(cx){cx.save();cx.globalAlpha=Math.max(0,this.alpha);cx.translate(this.x,this.y);cx.rotate(this.rot);cx.fillStyle=`rgba(${this.r},${this.g},${this.b},.8)`;cx.beginPath();cx.ellipse(0,0,this.w/2,this.h/2,0,0,Math.PI*2);cx.fill();cx.restore()}\n  }\n  const petals=Array.from({length:18},()=>new Petal(true));\n  function draw(){t++;cx.clearRect(0,0,W,H);if(t%70===0&&petals.length<26)petals.push(new Petal(false));petals.forEach(p=>{p.update();p.draw(cx)});requestAnimationFrame(draw)}\n  draw();\n})();\n</script>\n</body>\n</html>",
      "bookmarked": true,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"/>\n<title>உயிர்த்தெழுதல் நாள் - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel+Decorative:wght@700;900&family=Noto+Serif+Tamil:wght@400;700;900&family=IM+Fell+English:ital@1&family=Playfair+Display:wght@700;900&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#050301}\n.stage{position:relative;width:100vw;height:100vh;overflow:hidden}\n.sky{position:absolute;inset:0;z-index:0;background:linear-gradient(185deg,#020100 0%,#0a0502 8%,#1a0c04 16%,#2e1406 24%,#4a1e08 32%,#6b2a0a 40%,#8c3a10 48%,#a85020 55%,#c46828 62%,#d98030 68%,#e89040 73%,#c46828 78%,#8c3a10 84%,#4a1e08 90%,#1a0c04 96%,#050301 100%)}\ncanvas{position:absolute;inset:0;pointer-events:none}\n#cRays{z-index:1}#cDoves{z-index:2}#cGlow{z-index:3}#cSparkle{z-index:5}#cPetals{z-index:6}\n.ground-mist{position:absolute;left:0;right:0;bottom:0;height:20vh;z-index:4;background:linear-gradient(to top,rgba(255,200,100,.08) 0%,rgba(255,160,60,.04) 50%,transparent 100%)}\n.content{position:absolute;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0}\n.verse-banner{width:min(99vw,1500px);text-align:center;padding:.8vh 1.2vw;margin-bottom:.5vh;border-top:1px solid rgba(255,200,80,.25);border-bottom:1px solid rgba(255,200,80,.25);background:linear-gradient(90deg,rgba(180,100,20,0) 0%,rgba(220,140,40,.18) 20%,rgba(255,180,60,.22) 50%,rgba(220,140,40,.18) 80%,rgba(180,100,20,0) 100%);opacity:0;animation:fadeDown .9s ease forwards .3s}\n.verse-ta{font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1.05vw,18px);color:rgba(255,230,160,.92);line-height:1.5}\n.verse-ref{font-family:'IM Fell English',serif;font-style:italic;font-size:clamp(11px,.9vw,14px);color:rgba(255,200,120,.7);margin-top:.15vh}\n.card{width:min(99vw,1500px);max-height:96vh;overflow-y:auto;scrollbar-width:none;position:relative;display:flex;flex-direction:column;align-items:center;gap:0;padding:clamp(10px,1.2vh,18px) clamp(16px,1.6vw,26px);border-radius:12px;border:1px solid rgba(255,190,80,.28);background:rgba(10,5,1,.8);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);box-shadow:0 0 60px rgba(220,140,40,.22),0 0 120px rgba(180,100,20,.1),inset 0 1px 0 rgba(255,220,120,.18),inset 0 -1px 0 rgba(220,160,60,.12);opacity:0;animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .6s}\n.card::-webkit-scrollbar{display:none}\n.card::before{content:'';position:absolute;inset:0;pointer-events:none;border-radius:12px;background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(255,180,60,.07) 0%,transparent 60%),radial-gradient(ellipse 60% 40% at 50% 100%,rgba(220,140,40,.06) 0%,transparent 60%)}\n.card::after{content:'';position:absolute;top:2px;left:2px;right:2px;bottom:2px;border-radius:9px;border:1px solid rgba(255,200,100,.10);pointer-events:none}\n.church-top{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.75vw,12px);color:rgba(255,210,140,.6);letter-spacing:2px;margin-bottom:.5vh;opacity:0;animation:fadeUp .8s ease forwards 1s}\n.div-row{display:flex;align-items:center;gap:1vw;width:100%;margin-bottom:.45vh;opacity:0;animation:fadeUp .7s ease forwards 1.1s}\n.div-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(255,180,60,.50),transparent)}\n.div-gem{color:rgba(255,210,120,.8);font-size:clamp(10px,.9vw,14px)}\n.event-tag{font-family:'Noto Serif Tamil',serif;font-size:clamp(9px,.85vw,12px);color:rgba(255,210,140,.85);letter-spacing:3px;margin-bottom:.3vh;opacity:0;animation:fadeUp .8s ease forwards 1.2s}\n.palm-title{font-family:'Noto Serif Tamil',serif;font-weight:900;font-size:clamp(32px,4.2vw,74px);line-height:1.08;letter-spacing:1px;margin-bottom:.25vh;text-align:center;opacity:0;background:linear-gradient(150deg,#fff8e0 0%,#ffe090 18%,#ffd060 32%,#ffb830 48%,#e8880a 64%,#c86010 80%,#e8880a 100%);background-size:250% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 4px 18px rgba(255,160,40,.55));animation:palmReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.3s,goldFlow 6s ease-in-out infinite 2.5s}\n.service-text{font-family:'Noto Serif Tamil',serif;font-size:clamp(20px,2vw,34px);font-weight:700;letter-spacing:4px;margin:.15vh 0;opacity:0;background:linear-gradient(90deg,#c86010 0%,#ffb830 25%,#fff0c0 50%,#ffb830 75%,#c86010 100%);background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:fadeUp .8s ease forwards 1.6s,goldShift 3s linear infinite 2.5s}\n.service-subtext{font-family:'Noto Serif Tamil',serif;font-size:clamp(11px,.95vw,15px);color:rgba(255,200,120,.55);letter-spacing:3px;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 1.75s}\n.cross-wrap{position:relative;margin:.7vh 0;opacity:0;animation:crossReveal 1.2s cubic-bezier(.34,1.56,.64,1) forwards 1.8s}\n.cross-wrap svg{display:block;width:auto;height:clamp(80px,13vh,150px);filter:drop-shadow(0 0 14px rgba(255,200,80,.9)) drop-shadow(0 0 30px rgba(220,150,40,.6));animation:crossGlow 3s ease-in-out infinite}\n.info-row{display:flex;align-items:center;gap:2.5vw;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 2s}\n.info-box{text-align:center}\n.info-label{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(255,190,100,.60);letter-spacing:2px;margin-bottom:.2vh}\n.info-value{font-family:'Playfair Display',serif;font-size:clamp(18px,1.5vw,28px);font-weight:700;color:rgba(255,230,160,.95);text-shadow:0 0 18px rgba(255,180,60,.5)}\n.info-sep{font-size:clamp(15px,1.4vw,24px);color:rgba(255,180,80,.35)}\n.bishop-block{width:100%;position:relative;overflow:hidden;text-align:center;margin-bottom:.8vh;border-radius:16px;padding:clamp(8px,1vh,12px) clamp(10px,2vw,24px);background:linear-gradient(160deg,rgba(60,30,5,.75) 0%,rgba(20,8,1,.92) 100%);border:1px solid rgba(255,180,60,.15);box-shadow:0 12px 30px rgba(0,0,0,.6),inset 0 1px 1px rgba(255,255,255,.06);opacity:0;animation:fadeUp .9s ease forwards 2.2s}\n.bishop-block::before{content:'';position:absolute;top:0;left:20%;right:20%;height:1.5px;background:linear-gradient(90deg,transparent,rgba(255,200,80,.80),transparent);box-shadow:0 0 12px rgba(255,180,60,.8)}\n.bishop-block::after{content:'';position:absolute;top:0;left:-100%;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,220,120,.06),transparent);transform:skewX(-20deg);animation:blockSweep 5.5s infinite;pointer-events:none;z-index:1}\n.bishop-role{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(255,190,100,.60);letter-spacing:3px;margin-bottom:.2vh}\n.bishop-name-wrapper{position:relative;display:inline-block;z-index:2;padding:0 10px}\n.bishop-name-wrapper::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:140%;height:160%;background:radial-gradient(ellipse,rgba(255,180,60,.15) 0%,transparent 60%);animation:auraPulse 3s ease-in-out infinite;pointer-events:none}\n.bishop-name-en{position:relative;font-family:'Alex Brush',cursive;font-weight:400;font-size:clamp(36px,3.2vw,56px);line-height:1.15;letter-spacing:1px;background:linear-gradient(90deg,#c86010 0%,#ffe090 25%,#ffb830 50%,#ffe090 75%,#c86010 100%);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 3px 5px rgba(0,0,0,.95)) drop-shadow(0 0 15px rgba(255,180,60,.5));clip-path:polygon(0 0,0 0,0 100%,0 100%);animation:signatureLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s,goldShift 4s linear infinite}\n.pen-flare{position:absolute;top:45%;left:0;width:4px;height:4px;border-radius:50%;background:#fff8e0;opacity:0;z-index:10;pointer-events:none;box-shadow:0 0 10px 4px #ffe090,0 0 25px 12px #ffb830,0 0 40px 20px rgba(220,140,40,.6);animation:flareLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s}\n.bishop-name-ta{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1vw,18px);font-weight:700;color:rgba(255,220,150,.85)}\n.church-badge{position:relative;display:inline-flex;align-items:center;justify-content:center;opacity:0;animation:churchReveal 1s cubic-bezier(.34,1.56,.64,1) forwards 2.5s}\n.church-bg-inner{position:absolute;inset:3px;background:rgba(10,5,1,.92);border-radius:50px;z-index:1}\n.church-name{position:relative;z-index:2;white-space:nowrap;font-family:'Noto Serif Tamil',serif;font-weight:900;font-size:clamp(12px,.95vw,16px);letter-spacing:1px;padding:clamp(5px,.55vh,7px) clamp(16px,1.5vw,28px);background:linear-gradient(90deg,#c86010,#ffb830,#fff0c0,#ffb830,#c86010,#ffb830,#fff0c0);background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:goldShift 3s linear infinite;filter:drop-shadow(0 0 8px rgba(255,180,60,.7))}\n.ornament{position:absolute;font-size:clamp(14px,1.2vw,21px);opacity:.35;animation:ornSway 4s ease-in-out infinite}\n.orn-tl{top:10px;left:12px}.orn-tr{top:10px;right:12px;animation-delay:.5s}.orn-bl{bottom:10px;left:12px;animation-delay:1s}.orn-br{bottom:10px;right:12px;animation-delay:1.5s}\n.deco-row{position:absolute;left:0;right:0;bottom:0;z-index:11;display:flex;justify-content:center;gap:.5vw;padding-bottom:2px;pointer-events:none}\n.deco-item{font-size:clamp(12px,1.8vw,20px);opacity:.4;animation:decoSway 3.6s ease-in-out infinite;transform-origin:bottom center}\n.deco-item:nth-child(2n){animation-delay:.6s}.deco-item:nth-child(3n){animation-delay:1.2s}.deco-item:nth-child(4n){animation-delay:1.8s}\n.hallelujah{font-family:'Cinzel Decorative',cursive;font-size:clamp(9px,.8vw,13px);color:rgba(255,210,120,.6);letter-spacing:6px;margin-bottom:.3vh;opacity:0;animation:fadeUp .8s ease forwards .9s}\n@keyframes cardReveal{from{opacity:0;transform:translateY(30px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}\n@keyframes fadeDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes palmReveal{from{opacity:0;transform:scale(.7);filter:blur(14px)}to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 18px rgba(255,160,40,.55))}}\n@keyframes goldFlow{0%,100%{background-position:0% center}50%{background-position:100% center}}\n@keyframes goldShift{0%{background-position:0% center}100%{background-position:300% center}}\n@keyframes crossReveal{from{opacity:0;transform:scale(.3) rotate(-15deg)}to{opacity:1;transform:scale(1) rotate(0)}}\n@keyframes crossGlow{0%,100%{filter:drop-shadow(0 0 14px rgba(255,200,80,.9)) drop-shadow(0 0 30px rgba(220,150,40,.6))}50%{filter:drop-shadow(0 0 26px rgba(255,230,120,1)) drop-shadow(0 0 55px rgba(255,180,60,.9))}}\n@keyframes blockSweep{0%,30%{left:-100%}70%,100%{left:200%}}\n@keyframes auraPulse{0%,100%{opacity:.5;transform:translate(-50%,-50%) scale(.9)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}}\n@keyframes signatureLoop{0%,5%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:1}30%,85%{clip-path:polygon(0 0,100% 0,100% 100%,0 100%);opacity:1}95%{opacity:0}100%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:0}}\n@keyframes flareLoop{0%,5%{left:0%;opacity:0;transform:scale(.5) translateY(0)}8%{opacity:1;transform:scale(1.2) translateY(-4px)}28%{opacity:1;transform:scale(1.2) translateY(-1px)}30%,100%{left:100%;opacity:0;transform:scale(.5) translateY(0)}}\n@keyframes churchReveal{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}\n@keyframes ornSway{0%,100%{transform:rotate(-5deg) scale(1)}50%{transform:rotate(5deg) scale(1.1)}}\n@keyframes decoSway{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}\n@media (max-width:900px){.card,.verse-banner{width:99.5vw}.palm-title{font-size:clamp(28px,10vw,56px)}.service-text{font-size:clamp(18px,6vw,28px)}.bishop-name-en{font-size:clamp(30px,9vw,44px)}.info-value{font-size:clamp(15px,4.4vw,24px)}}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n  <div class=\"sky\"></div>\n  <canvas id=\"cRays\"></canvas>\n  <canvas id=\"cDoves\"></canvas>\n  <canvas id=\"cGlow\"></canvas>\n  <div class=\"ground-mist\"></div>\n  <canvas id=\"cSparkle\"></canvas>\n  <canvas id=\"cPetals\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"verse-banner\">\n      <div class=\"verse-ta\">அவர் இங்கே இல்லை, சொன்னபடியே உயிரோடு எழுந்திருந்தார்</div>\n      <div class=\"verse-ref\">— மத்தேயு 28:6</div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"ornament orn-tl\">🌸</span>\n      <span class=\"ornament orn-tr\">🌸</span>\n      <span class=\"ornament orn-bl\">🕊️</span>\n      <span class=\"ornament orn-br\">🕊️</span>\n\n      <div class=\"hallelujah\">✦ HALLELUJAH ✦</div>\n      <div class=\"church-top\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n\n      <div class=\"div-row\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-gem\">✦</span>\n        <span class=\"div-gem\" style=\"font-size:clamp(11px,1.4vw,16px);color:rgba(255,180,80,0.5)\">☀</span>\n        <span class=\"div-gem\">✦</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"event-tag\">☀ Easter Sunday · உயிர்த்தெழுதல் ☀</div>\n      <div class=\"palm-title\">உயிர்த்தெழுதல் நாள்</div>\n      <div class=\"service-text\">ஆராதனை</div>\n      <div class=\"service-subtext\">உயிர்ப்பின் நினைவு · ஜெபம் · மகிழ்ச்சி</div>\n\n      <div class=\"cross-wrap\">\n        <svg viewBox=\"0 0 160 220\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <radialGradient id=\"sunburst\" cx=\"50%\" cy=\"45%\" r=\"50%\">\n              <stop offset=\"0%\" stop-color=\"rgba(255,250,200,0.9)\"/>\n              <stop offset=\"40%\" stop-color=\"rgba(255,210,80,0.5)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(255,150,20,0)\"/>\n            </radialGradient>\n            <linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff8e0\"/>\n              <stop offset=\"15%\" stop-color=\"#ffe090\"/>\n              <stop offset=\"35%\" stop-color=\"#c87820\"/>\n              <stop offset=\"50%\" stop-color=\"#ffe8b0\"/>\n              <stop offset=\"65%\" stop-color=\"#d09030\"/>\n              <stop offset=\"85%\" stop-color=\"#f0c060\"/>\n              <stop offset=\"100%\" stop-color=\"#a05818\"/>\n            </linearGradient>\n            <linearGradient id=\"cg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff0c0\"/>\n              <stop offset=\"50%\" stop-color=\"#c87820\"/>\n              <stop offset=\"100%\" stop-color=\"#ffe090\"/>\n            </linearGradient>\n            <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n              <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n            <radialGradient id=\"shine\" cx=\"35%\" cy=\"30%\" r=\"60%\">\n              <stop offset=\"0%\" stop-color=\"rgba(255,250,220,0.7)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(255,250,220,0)\"/>\n            </radialGradient>\n          </defs>\n          <!-- Sunburst halo -->\n          <circle cx=\"80\" cy=\"110\" r=\"75\" fill=\"url(#sunburst)\" opacity=\"0.65\"/>\n          <!-- Light rays -->\n          <g opacity=\"0.22\">\n            <line x1=\"80\" y1=\"5\" x2=\"80\" y2=\"25\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"80\" y1=\"175\" x2=\"80\" y2=\"215\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"5\" y1=\"90\" x2=\"25\" y2=\"90\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"135\" y1=\"90\" x2=\"155\" y2=\"90\" stroke=\"#ffe090\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"22\" y1=\"30\" x2=\"38\" y2=\"46\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <line x1=\"122\" y1=\"150\" x2=\"138\" y2=\"166\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <line x1=\"138\" y1=\"30\" x2=\"122\" y2=\"46\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <line x1=\"22\" y1=\"166\" x2=\"38\" y2=\"150\" stroke=\"#ffe090\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </g>\n          <!-- Vertical beam: long top-to-bottom -->\n          <rect x=\"66\" y=\"10\" width=\"28\" height=\"205\" rx=\"5\" fill=\"url(#cg1)\" filter=\"url(#glow)\"/>\n          <!-- Horizontal beam: shorter, placed at upper third -->\n          <rect x=\"16\" y=\"62\" width=\"128\" height=\"28\" rx=\"5\" fill=\"url(#cg2)\" filter=\"url(#glow)\"/>\n          <!-- Shine overlays -->\n          <rect x=\"66\" y=\"10\" width=\"28\" height=\"205\" rx=\"5\" fill=\"url(#shine)\" opacity=\".65\"/>\n          <rect x=\"16\" y=\"62\" width=\"128\" height=\"28\" rx=\"5\" fill=\"url(#shine)\" opacity=\".45\"/>\n          <!-- Centre highlight stripes -->\n          <rect x=\"74\" y=\"10\" width=\"7\" height=\"205\" rx=\"3\" fill=\"rgba(255,250,200,0.30)\"/>\n          <rect x=\"16\" y=\"69\" width=\"128\" height=\"7\" rx=\"3\" fill=\"rgba(255,250,200,0.26)\"/>\n          <!-- Centre jewel at intersection -->\n          <circle cx=\"80\" cy=\"76\" r=\"13\" fill=\"url(#cg1)\" stroke=\"rgba(255,220,120,.6)\" stroke-width=\"1.5\" filter=\"url(#glow)\"/>\n          <circle cx=\"80\" cy=\"76\" r=\"6\" fill=\"rgba(255,250,220,0.9)\"/>\n          <circle cx=\"80\" cy=\"76\" r=\"2.5\" fill=\"rgba(255,230,140,1)\"/>\n        </svg>\n      </div>\n\n      <div class=\"info-row\">\n        <div class=\"info-box\">\n          <div class=\"info-label\">தேதி</div>\n          <div class=\"info-value\">05 · 04 · 2026</div>\n        </div>\n        <div class=\"info-sep\">✦</div>\n        <div class=\"info-box\">\n          <div class=\"info-label\">நேரம்</div>\n          <div class=\"info-value\">காலை 7:00</div>\n        </div>\n      </div>\n\n      <div class=\"bishop-block\">\n        <div class=\"bishop-role\">பிஷப்</div>\n        <div class=\"bishop-name-wrapper\">\n          <div class=\"pen-flare\"></div>\n          <div class=\"bishop-name-en\">Bp. V. Paul Yuvaraj</div>\n        </div>\n        <div class=\"bishop-name-ta\">பி. வி. பால் யுவராஜ்</div>\n      </div>\n\n      <div class=\"church-badge\">\n        <div class=\"church-bg-inner\"></div>\n        <div class=\"church-name\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">☀</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">☀</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌸</span>\n  </div>\n</div>\n\n<script>\n(function(){\n  const cv=document.getElementById('cRays');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const R=Array.from({length:28},(_,i)=>({a:(i/28)*Math.PI*1.8-Math.PI*.9+(Math.random()-.5)*.25,al:.03+Math.random()*.07,sp:(.0008+Math.random()*.002)*(Math.random()>.5?1:-1),ln:.35+Math.random()*.65}));\n  function draw(){t++;cx.clearRect(0,0,W,H);\n    const skyY=H*.38;\n    const gBg=cx.createRadialGradient(W*.5,skyY,0,W*.5,skyY,W*.6);\n    gBg.addColorStop(0,'rgba(255,220,100,.06)');gBg.addColorStop(.5,'rgba(255,160,40,.03)');gBg.addColorStop(1,'transparent');\n    cx.fillStyle=gBg;cx.fillRect(0,0,W,H);\n    R.forEach(r=>{r.a+=r.sp;\n      const ox=W*.5,oy=skyY;\n      const ax=Math.cos(r.a)*W*r.ln+ox,ay=Math.sin(r.a)*W*r.ln+oy;\n      const bx=Math.cos(r.a+.022)*W*r.ln+ox,by=Math.sin(r.a+.022)*W*r.ln+oy;\n      const g=cx.createLinearGradient(ox,oy,ax,ay);\n      g.addColorStop(0,`rgba(255,210,80,${r.al*2.2})`);\n      g.addColorStop(.35,`rgba(255,170,40,${r.al})`);\n      g.addColorStop(1,'rgba(200,100,10,0)');\n      cx.save();cx.beginPath();cx.moveTo(ox,oy);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();cx.fillStyle=g;cx.fill();cx.restore()\n    });\n    const pulse=.8+.2*Math.sin(t*.028);\n    const gSun=cx.createRadialGradient(W*.5,skyY,0,W*.5,skyY,W*.12*pulse);\n    gSun.addColorStop(0,'rgba(255,250,200,.25)');gSun.addColorStop(.3,'rgba(255,230,120,.15)');gSun.addColorStop(.6,'rgba(255,200,60,.07)');gSun.addColorStop(1,'transparent');\n    cx.fillStyle=gSun;cx.fillRect(0,0,W,H);\n    requestAnimationFrame(draw)\n  }\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cDoves');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function drawDove(cx,x,y,size,alpha,flap){\n    cx.save();cx.globalAlpha=alpha;cx.fillStyle='rgba(255,240,200,0.85)';cx.shadowColor='rgba(255,200,80,0.7)';cx.shadowBlur=size*3;\n    const wingAngle=Math.sin(flap)*.45;\n    cx.beginPath();cx.ellipse(x,y,size*1.2,size*.5,0,0,Math.PI*2);cx.fill();\n    cx.save();cx.translate(x,y);cx.rotate(-wingAngle);cx.beginPath();cx.ellipse(-size*.5,-size*.2,size*1.1,size*.38,-.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.save();cx.translate(x,y);cx.rotate(wingAngle);cx.beginPath();cx.ellipse(size*.5,-size*.2,size*1.1,size*.38,.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.beginPath();cx.arc(x+size*1.1,y-size*.1,size*.35,0,Math.PI*2);cx.fill();cx.restore();\n  }\n  const doves=Array.from({length:7},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight*.55+innerHeight*.05,size:4+Math.random()*7,vx:(.4+Math.random()*.7)*(Math.random()>.5?1:-1),vy:(Math.random()-.5)*.15,flapSpeed:.05+Math.random()*.04,flapOffset:Math.random()*Math.PI*2,alpha:.1+Math.random()*.2}));\n  function draw(){t++;cx.clearRect(0,0,W,H);doves.forEach(d=>{d.x+=d.vx;d.y+=d.vy;if(d.x>W+40)d.x=-40;if(d.x<-40)d.x=W+40;if(d.y<0)d.y=H*.5;if(d.y>H*.65)d.y=H*.1;drawDove(cx,d.x,d.y,d.size,d.alpha,t*d.flapSpeed+d.flapOffset)});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cGlow');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function draw(){t++;cx.clearRect(0,0,W,H);\n    const pulse=.85+.15*Math.sin(t*.025);\n    const g=cx.createRadialGradient(W*.5,H*.58,0,W*.5,H*.58,W*.38*pulse);\n    g.addColorStop(0,'rgba(255,190,60,.1)');g.addColorStop(.35,'rgba(220,140,30,.05)');g.addColorStop(.65,'rgba(180,100,20,.02)');g.addColorStop(1,'transparent');\n    cx.fillStyle=g;cx.fillRect(0,0,W,H);requestAnimationFrame(draw)\n  }\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cSparkle');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const S=Array.from({length:60},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:.4+Math.random()*1.6,ph:Math.random()*Math.PI*2,sp:.018+Math.random()*.035,vy:-(Math.random()*.2+.05),vx:(Math.random()-.5)*.08,col:Math.random()>.5?'255,220,120':'255,240,180'}));\n  function draw(){t++;cx.clearRect(0,0,W,H);S.forEach(s=>{s.y+=s.vy;s.x+=s.vx;if(s.y<-10){s.y=H+10;s.x=Math.random()*W}const a=.1+.6*(.5+.5*Math.sin(t*s.sp+s.ph));cx.save();cx.globalAlpha=a;cx.fillStyle=`rgba(${s.col},1)`;cx.shadowColor=`rgba(${s.col},.7)`;cx.shadowBlur=s.r*6;cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();cx.restore()});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cPetals');if(!cv)return;\n  const cx=cv.getContext('2d');let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  class Petal{\n    constructor(rand){\n      this.x=Math.random()*innerWidth;this.y=rand?(Math.random()*innerHeight):(-20);\n      this.w=6+Math.random()*10;this.h=4+Math.random()*7;\n      this.vx=(Math.random()-.5)*.8;this.vy=Math.random()*.5+.15;\n      this.rot=Math.random()*Math.PI*2;this.rotV=(Math.random()-.5)*.04;\n      this.alpha=Math.random()*.35+.1;\n      const c=Math.random();\n      this.r=c>.6?255:c>.3?255:255;\n      this.g=c>.6?180:c>.3?220:240;\n      this.b=c>.6?100:c>.3?140:200;\n    }\n    update(){this.y+=this.vy;this.x+=this.vx+Math.sin(t*.01+this.x*.01)*.3;this.rot+=this.rotV;this.alpha-=.0005;if(this.alpha<=0||this.y>innerHeight+30)Object.assign(this,new Petal(false))}\n    draw(cx){cx.save();cx.globalAlpha=Math.max(0,this.alpha);cx.translate(this.x,this.y);cx.rotate(this.rot);cx.fillStyle=`rgba(${this.r},${this.g},${this.b},.8)`;cx.beginPath();cx.ellipse(0,0,this.w/2,this.h/2,0,0,Math.PI*2);cx.fill();cx.restore()}\n  }\n  const petals=Array.from({length:18},()=>new Petal(true));\n  function draw(){t++;cx.clearRect(0,0,W,H);if(t%70===0&&petals.length<26)petals.push(new Petal(false));petals.forEach(p=>{p.update();p.draw(cx)});requestAnimationFrame(draw)}\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1772937978152.9502,
      "type": "html",
      "name": "Title",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Church Overlay</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@700;900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    *{margin:0;padding:0;box-sizing:border-box}\n    html,body{width:100%;height:100%;overflow:hidden;background:#000}\n    .stage{width:100vw;height:100vh;position:relative;overflow:hidden}\n\n    .video-bg{\n      position:absolute;inset:0;z-index:0;\n      width:100%;height:100%;object-fit:cover\n    }\n\n    .overlay{\n      position:absolute;inset:0;z-index:1;\n      background:radial-gradient(\n        ellipse 80% 38% at 50% 28%,\n        rgba(0,0,0,0.52) 0%,\n        rgba(0,0,0,0.18) 60%,\n        rgba(0,0,0,0.00) 100%\n      )\n    }\n\n    .content{\n      position:absolute;inset:0;z-index:10;\n      display:flex;flex-direction:column;\n      align-items:center;justify-content:center;\n      margin-top:-26vh;\n    }\n\n    .line-clip{\n      overflow:hidden;width:100%;\n      display:flex;align-items:center;justify-content:center;\n      position:relative\n    }\n\n    .church-text{\n      font-family:'Noto Serif Tamil',serif;\n      white-space:nowrap;display:inline-block\n    }\n\n    .line1{\n      font-size:clamp(28px,5vw,80px);\n      font-weight:900;letter-spacing:2px;\n      background:linear-gradient(105deg,\n        #7a5200 0%,#c8860a 12%,#f5d060 25%,#fff8c0 38%,\n        #ffd700 50%,#fff8c0 62%,#f5c842 75%,#c8860a 88%,#7a5200 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromLeft 0.9s cubic-bezier(.16,1,.3,1) forwards,\n        goldShimmer 3.5s linear 0.9s infinite,\n        revealHide 7s ease-in-out 0.9s infinite\n    }\n\n    .line2{\n      font-size:clamp(18px,3.4vw,56px);\n      font-weight:700;letter-spacing:16px;\n      background:linear-gradient(105deg,\n        #6b4f00 0%,#b8780a 12%,#e8c840 25%,#fffacc 38%,\n        #fce87a 50%,#fffacc 62%,#e8c840 75%,#b8780a 88%,#6b4f00 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromRight 0.9s cubic-bezier(.16,1,.3,1) 0.2s forwards,\n        goldShimmer 3.5s linear 1.1s infinite,\n        revealHide 7s ease-in-out 1.1s infinite\n    }\n\n    .divider{\n      width:0;height:1.5px;\n      margin:clamp(4px,0.9vh,13px) 0;\n      background:linear-gradient(90deg,transparent,#ffd700 50%,transparent);\n      opacity:0;\n      animation:\n        dividerExpand 0.6s cubic-bezier(.16,1,.3,1) 0.5s forwards,\n        dividerHide 7s ease-in-out 0.9s infinite\n    }\n\n    .flare{\n      position:absolute;top:0;left:-65%;\n      width:38%;height:100%;\n      background:linear-gradient(108deg,\n        transparent 0%,rgba(255,250,190,0) 35%,\n        rgba(255,252,200,.52) 50%,rgba(255,250,190,0) 65%,transparent 100%\n      );\n      pointer-events:none;mix-blend-mode:screen;\n      animation:flareSweep 3.5s ease-in-out 0.9s infinite\n    }\n\n    @keyframes slideFromLeft{\n      from{opacity:0;transform:translateX(-140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes slideFromRight{\n      from{opacity:0;transform:translateX(140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes goldShimmer{\n      0%{background-position:220% center}\n      100%{background-position:-60% center}\n    }\n    @keyframes revealHide{\n      0%{opacity:1;transform:translateX(0)}\n      58%{opacity:1;transform:translateX(0)}\n      70%{opacity:0;transform:translateX(110px)}\n      71%{opacity:0;transform:translateX(-110px)}\n      84%{opacity:1;transform:translateX(0)}\n      100%{opacity:1;transform:translateX(0)}\n    }\n    @keyframes dividerExpand{\n      from{width:0;opacity:0}\n      to{width:clamp(100px,20vw,300px);opacity:1}\n    }\n    @keyframes dividerHide{\n      0%,57%{opacity:1}\n      69%{opacity:0}\n      83%{opacity:1}\n      100%{opacity:1}\n    }\n    @keyframes flareSweep{\n      0%{left:-65%;opacity:0}\n      8%{opacity:1}\n      58%{left:120%;opacity:0}\n      100%{left:120%;opacity:0}\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\">\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"goatbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <div class=\"line-clip\">\n        <span class=\"church-text line1\">நல்ல சமாரியன் இயேசு</span>\n        <div class=\"flare\"></div>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div class=\"line-clip\">\n        <span class=\"church-text line2\">ஜெப வீடு</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
      "bookmarked": false,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Church Overlay</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@700;900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    *{margin:0;padding:0;box-sizing:border-box}\n    html,body{width:100%;height:100%;overflow:hidden;background:#000}\n    .stage{width:100vw;height:100vh;position:relative;overflow:hidden}\n\n    .video-bg{\n      position:absolute;inset:0;z-index:0;\n      width:100%;height:100%;object-fit:cover\n    }\n\n    .overlay{\n      position:absolute;inset:0;z-index:1;\n      background:radial-gradient(\n        ellipse 80% 38% at 50% 28%,\n        rgba(0,0,0,0.52) 0%,\n        rgba(0,0,0,0.18) 60%,\n        rgba(0,0,0,0.00) 100%\n      )\n    }\n\n    .content{\n      position:absolute;inset:0;z-index:10;\n      display:flex;flex-direction:column;\n      align-items:center;justify-content:center;\n      margin-top:-26vh;\n    }\n\n    .line-clip{\n      overflow:hidden;width:100%;\n      display:flex;align-items:center;justify-content:center;\n      position:relative\n    }\n\n    .church-text{\n      font-family:'Noto Serif Tamil',serif;\n      white-space:nowrap;display:inline-block\n    }\n\n    .line1{\n      font-size:clamp(28px,5vw,80px);\n      font-weight:900;letter-spacing:2px;\n      background:linear-gradient(105deg,\n        #7a5200 0%,#c8860a 12%,#f5d060 25%,#fff8c0 38%,\n        #ffd700 50%,#fff8c0 62%,#f5c842 75%,#c8860a 88%,#7a5200 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromLeft 0.9s cubic-bezier(.16,1,.3,1) forwards,\n        goldShimmer 3.5s linear 0.9s infinite,\n        revealHide 7s ease-in-out 0.9s infinite\n    }\n\n    .line2{\n      font-size:clamp(18px,3.4vw,56px);\n      font-weight:700;letter-spacing:16px;\n      background:linear-gradient(105deg,\n        #6b4f00 0%,#b8780a 12%,#e8c840 25%,#fffacc 38%,\n        #fce87a 50%,#fffacc 62%,#e8c840 75%,#b8780a 88%,#6b4f00 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromRight 0.9s cubic-bezier(.16,1,.3,1) 0.2s forwards,\n        goldShimmer 3.5s linear 1.1s infinite,\n        revealHide 7s ease-in-out 1.1s infinite\n    }\n\n    .divider{\n      width:0;height:1.5px;\n      margin:clamp(4px,0.9vh,13px) 0;\n      background:linear-gradient(90deg,transparent,#ffd700 50%,transparent);\n      opacity:0;\n      animation:\n        dividerExpand 0.6s cubic-bezier(.16,1,.3,1) 0.5s forwards,\n        dividerHide 7s ease-in-out 0.9s infinite\n    }\n\n    .flare{\n      position:absolute;top:0;left:-65%;\n      width:38%;height:100%;\n      background:linear-gradient(108deg,\n        transparent 0%,rgba(255,250,190,0) 35%,\n        rgba(255,252,200,.52) 50%,rgba(255,250,190,0) 65%,transparent 100%\n      );\n      pointer-events:none;mix-blend-mode:screen;\n      animation:flareSweep 3.5s ease-in-out 0.9s infinite\n    }\n\n    @keyframes slideFromLeft{\n      from{opacity:0;transform:translateX(-140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes slideFromRight{\n      from{opacity:0;transform:translateX(140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes goldShimmer{\n      0%{background-position:220% center}\n      100%{background-position:-60% center}\n    }\n    @keyframes revealHide{\n      0%{opacity:1;transform:translateX(0)}\n      58%{opacity:1;transform:translateX(0)}\n      70%{opacity:0;transform:translateX(110px)}\n      71%{opacity:0;transform:translateX(-110px)}\n      84%{opacity:1;transform:translateX(0)}\n      100%{opacity:1;transform:translateX(0)}\n    }\n    @keyframes dividerExpand{\n      from{width:0;opacity:0}\n      to{width:clamp(100px,20vw,300px);opacity:1}\n    }\n    @keyframes dividerHide{\n      0%,57%{opacity:1}\n      69%{opacity:0}\n      83%{opacity:1}\n      100%{opacity:1}\n    }\n    @keyframes flareSweep{\n      0%{left:-65%;opacity:0}\n      8%{opacity:1}\n      58%{left:120%;opacity:0}\n      100%{left:120%;opacity:0}\n    }\n  </style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n  <div class=\"stage\">\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"goatbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <div class=\"line-clip\">\n        <span class=\"church-text line1\">நல்ல சமாரியன் இயேசு</span>\n        <div class=\"flare\"></div>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div class=\"line-clip\">\n        <span class=\"church-text line2\">ஜெப வீடு</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
