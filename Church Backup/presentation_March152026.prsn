    {
      "id": 1773493162639.0945,
      "type": "simple",
      "name": "HTML Slide",
      "title": "அடைக்கலமே உமதடிமை நானே",
      "body": "",
      "bg": "#3c096c",
      "color": "#ffd700",
      "layout": "center",
      "font": "Noto Serif Tamil",
      "_thumbHtml": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{width:100%;height:100%;overflow:hidden;}\nbody{background:#3c096c;display:flex;align-items:center;justify-content:center;padding:4vw 6vw;}\n.wrap{display:flex;flex-direction:column;align-items:center;width:100%;height:100%;justify-content:center;gap:0.45em;overflow:hidden;}\n.s-title{\n  font-weight:900;\n  color:#ffd700;\n  text-align:center;\n  line-height:1.2;\n  font-family:'Noto Serif Tamil', Georgia, serif;\n  word-break:break-word;\n  letter-spacing:0.04em;\n  text-shadow:0 2px 18px rgba(0,0,0,0.45),0 0 40px rgba(0,0,0,0.25);\n}\n.s-body{\n  font-weight:800;\n  color:#ffd700;\n  text-align:center;\n  line-height:1.55;\n  font-family:'Noto Serif Tamil', Georgia, serif;\n  opacity:0.96;\n  word-break:break-word;\n  letter-spacing:0.025em;\n}\n.bullet{margin-bottom:0.22em;}\n.bline{margin-bottom:0.12em;}\n.divider{\n  width:50%;\n  height:2px;\n  background:#ffd700;\n  opacity:0.35;\n  margin:0.2em auto;\n  border-radius:2px;\n}\n</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head><body>\n<div class=\"wrap\" id=\"swrap\">\n  <div class=\"s-title\" id=\"stitle\">அடைக்கலமே உமதடிமை நானே</div>\n  \n  \n</div>\n<script>\nfunction autoFit() {\n  var wrap  = document.getElementById('swrap');\n  var title = document.getElementById('stitle');\n  var body  = document.getElementById('sbody');\n  if (!wrap) return;\n  var availW = wrap.clientWidth, availH = wrap.clientHeight;\n  if (availH < 10 || availW < 10) return;\n  // Reset first so measurements start clean on each call\n  if (title) title.style.fontSize = '';\n  if (body)  body.style.fontSize  = '';\n  var lo = 6, hi = availH * 0.92;\n  for (var i = 0; i < 32; i++) {\n    var mid = (lo + hi) / 2;\n    if (title) title.style.fontSize = mid + 'px';\n    if (body)  body.style.fontSize  = (title ? mid * 0.58 : mid) + 'px';\n    // Measure each child's rendered height directly.\n    // wrap.scrollHeight is UNRELIABLE in a flex container with justify-content:center\n    // + overflow:hidden because upward overflow is silently clipped and not reported.\n    var needed = (title ? title.offsetHeight : 0)\n               + (body  ? body.offsetHeight  : 0)\n               + 28; // budget for divider + flex gaps\n    var wideT = title && title.scrollWidth > availW * 0.98;\n    var wideB = body  && body.scrollWidth  > availW * 0.98;\n    if (needed > availH * 0.92 || wideT || wideB) { hi = mid; } else { lo = mid; }\n  }\n  if (title) title.style.fontSize = lo + 'px';\n  if (body)  body.style.fontSize  = (title ? lo * 0.58 : lo) + 'px';\n}\ndocument.addEventListener('DOMContentLoaded', autoFit);\ndocument.fonts ? document.fonts.ready.then(autoFit) : window.addEventListener('load', autoFit);\nwindow.addEventListener('resize', autoFit);\n</script>\n</body></html>"
