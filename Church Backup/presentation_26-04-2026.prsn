{
  "version": 1,
  "slides": [
    {
      "id": 1774107563826.375,
      "type": "html",
      "name": "TITLE 2 ",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cinzel+Decorative:wght@700;900&family=Cormorant+Garamond:ital,wght@1,400;0,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n    background:#020008;\n  }\n\n  canvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n  #cAurora{z-index:1}\n  #cParticles{z-index:3}\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n    gap:0;\n  }\n\n  /* ── CROSS ── */\n  .cross-wrap{\n    margin-bottom:2.5vh;\n    opacity:0;\n    animation:crossIn 1.2s cubic-bezier(.34,1.56,.64,1) forwards .3s;\n  }\n  @keyframes crossIn{\n    0%{opacity:0;transform:scale(.3) rotate(-20deg);filter:blur(20px)}\n    100%{opacity:1;transform:scale(1) rotate(0deg);filter:blur(0)}\n  }\n  .cross-icon{\n    font-size:clamp(44px,6vh,80px);\n    display:block;text-align:center;\n    background:linear-gradient(135deg,#fff 0%,#ffe066 30%,#ff6ec7 60%,#66cfff 100%);\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    background-size:300% 300%;\n    animation:crossColorShift 3s ease-in-out infinite 1.5s;\n    filter:drop-shadow(0 0 12px rgba(255,180,255,.6)) drop-shadow(0 0 30px rgba(100,200,255,.4));\n  }\n  @keyframes crossColorShift{\n    0%,100%{background-position:0% 50%;filter:drop-shadow(0 0 12px rgba(255,180,255,.6)) drop-shadow(0 0 30px rgba(100,200,255,.4))}\n    50%{background-position:100% 50%;filter:drop-shadow(0 0 20px rgba(255,220,100,.9)) drop-shadow(0 0 50px rgba(255,120,200,.6))}\n  }\n\n  /* ── WELCOME ── */\n  .welcome{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(12px,1.5vw,20px);\n    letter-spacing:12px;\n    text-transform:uppercase;\n    margin-bottom:1.6vh;\n    opacity:0;\n    animation:fadeUp .9s ease forwards 1s;\n    background:linear-gradient(90deg,#a78bfa,#f472b6,#fb923c,#facc15);\n    background-size:300% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:welcomeAnim 3s ease-in-out infinite 1s,fadeUp .9s ease forwards 1s;\n  }\n  @keyframes welcomeAnim{\n    0%,100%{background-position:0% center;opacity:1}\n    50%{background-position:100% center}\n  }\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(16px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n\n  /* ── ORN LINE ── */\n  .orn{\n    width:55vw;height:1px;margin-bottom:2vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .8s ease forwards 1.4s;\n    background:linear-gradient(90deg,transparent,#a78bfa,#f472b6,#38bdf8,transparent);\n    position:relative;\n  }\n  .orn::before,.orn::after{\n    content:'◆';position:absolute;top:-7px;\n    font-size:12px;color:#f472b6;\n    text-shadow:0 0 10px #f472b6,0 0 20px #a78bfa;\n  }\n  .orn::before{left:-4px} .orn::after{right:-4px}\n  @keyframes lineExpand{to{opacity:1;transform:scaleX(1)}}\n\n  /* ── TITLE LINE 1 ── */\n  .t1-wrap{\n    overflow:visible;\n    margin-bottom:.5vh;\n    opacity:0;\n    animation:fadeUp 1s ease forwards 1.7s;\n  }\n  .t1{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(28px,5.2vw,80px);\n    font-weight:900;\n    line-height:1.2;\n    white-space:nowrap;\n    letter-spacing:3px;\n    /* Trendy chrome-rainbow gradient */\n    background:linear-gradient(\n      90deg,\n      #ff6b6b 0%,\n      #ffd93d 15%,\n      #6bcb77 28%,\n      #4d96ff 42%,\n      #c77dff 56%,\n      #ff6b9d 70%,\n      #ffd93d 85%,\n      #ff6b6b 100%\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:rainbowFlow 4s linear infinite;\n    filter:drop-shadow(0 0 15px rgba(200,120,255,.5)) drop-shadow(0 4px 20px rgba(0,0,0,.8));\n  }\n  @keyframes rainbowFlow{\n    0%{background-position:0% center}\n    100%{background-position:200% center}\n  }\n\n  /* ── TITLE LINE 2 ── */\n  .t2-wrap{\n    overflow:visible;\n    opacity:0;\n    animation:fadeUp 1s ease forwards 2s;\n  }\n  .t2{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(22px,4vw,62px);\n    font-weight:700;\n    line-height:1.3;\n    letter-spacing:10px;\n    white-space:nowrap;\n    /* Trendy aurora/neon gradient */\n    background:linear-gradient(\n      90deg,\n      #00f5ff 0%,\n      #7b2fff 20%,\n      #ff2ff4 40%,\n      #ff9500 60%,\n      #00f5ff 80%,\n      #7b2fff 100%\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:auroraFlow 3s linear infinite;\n    filter:drop-shadow(0 0 20px rgba(0,245,255,.4)) drop-shadow(0 4px 20px rgba(0,0,0,.9));\n  }\n  @keyframes auroraFlow{\n    0%{background-position:0% center}\n    100%{background-position:200% center}\n  }\n\n  /* ── ORN 2 ── */\n  .orn2{\n    width:38vw;height:1px;margin-top:2vh;margin-bottom:1.6vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .8s ease forwards 2.6s;\n    background:linear-gradient(90deg,transparent,#38bdf8,#a78bfa,#f472b6,transparent);\n  }\n\n  /* ── VERSE ── */\n  .verse{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:600;\n    font-size:clamp(11px,1.3vw,19px);\n    letter-spacing:2px;text-align:center;\n    padding:0 10vw;\n    opacity:0;\n    animation:fadeUp .9s ease forwards 2.9s;\n    background:linear-gradient(90deg,#e0c3fc,#a5f3fc,#fde68a,#e0c3fc);\n    background-size:300% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:verseShimmer 5s ease-in-out infinite 2.9s, fadeUp .9s ease forwards 2.9s;\n  }\n  @keyframes verseShimmer{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── CORNER BRACKETS ── */\n  .corner{\n    position:absolute;z-index:11;\n    width:clamp(40px,5vw,70px);height:clamp(40px,5vw,70px);\n    opacity:0;animation:cornerIn .8s ease forwards 2.3s;\n    background:transparent;\n  }\n  @keyframes cornerIn{to{opacity:1}}\n  .corner::before,.corner::after{\n    content:'';position:absolute;background:transparent;\n  }\n  /* TL */\n  .corner.tl{top:5vh;left:4vw;}\n  .corner.tl::before{top:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,#f472b6,#a78bfa);}\n  .corner.tl::after{top:0;left:0;width:2px;height:100%;background:linear-gradient(180deg,#f472b6,#a78bfa);}\n  /* TR */\n  .corner.tr{top:5vh;right:4vw;}\n  .corner.tr::before{top:0;right:0;left:auto;width:100%;height:2px;background:linear-gradient(90deg,#38bdf8,#6bcb77);}\n  .corner.tr::after{top:0;right:0;left:auto;width:2px;height:100%;background:linear-gradient(180deg,#38bdf8,#6bcb77);}\n  /* BL */\n  .corner.bl{bottom:5vh;left:4vw;}\n  .corner.bl::before{bottom:0;left:0;top:auto;width:100%;height:2px;background:linear-gradient(90deg,#ffd93d,#ff6b9d);}\n  .corner.bl::after{bottom:0;left:0;top:auto;width:2px;height:100%;background:linear-gradient(0deg,#ffd93d,#ff6b9d);}\n  /* BR */\n  .corner.br{bottom:5vh;right:4vw;}\n  .corner.br::before{bottom:0;right:0;left:auto;top:auto;width:100%;height:2px;background:linear-gradient(90deg,#6bcb77,#4d96ff);}\n  .corner.br::after{bottom:0;right:0;left:auto;top:auto;width:2px;height:100%;background:linear-gradient(0deg,#6bcb77,#4d96ff);}\n\n  /* ── FLOATING GLOW ORBS behind content ── */\n  .orb{\n    position:absolute;border-radius:50%;\n    filter:blur(80px);z-index:2;\n    animation:orbFloat ease-in-out infinite;\n  }\n  @keyframes orbFloat{\n    0%,100%{transform:translateY(0) scale(1)}\n    50%{transform:translateY(-30px) scale(1.1)}\n  }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <canvas id=\"cAurora\"></canvas>\n\n  <!-- Glow orbs -->\n  <div class=\"orb\" style=\"width:40vw;height:40vw;left:-10vw;top:10vh;background:rgba(167,139,250,.15);animation-duration:8s;animation-delay:0s\"></div>\n  <div class=\"orb\" style=\"width:35vw;height:35vw;right:-8vw;top:20vh;background:rgba(244,114,182,.12);animation-duration:10s;animation-delay:-3s\"></div>\n  <div class=\"orb\" style=\"width:30vw;height:30vw;left:30vw;bottom:5vh;background:rgba(56,189,248,.1);animation-duration:7s;animation-delay:-5s\"></div>\n  <div class=\"orb\" style=\"width:25vw;height:25vw;left:60vw;top:5vh;background:rgba(251,191,36,.08);animation-duration:9s;animation-delay:-2s\"></div>\n\n  <canvas id=\"cParticles\"></canvas>\n\n  <!-- Corners -->\n  <div class=\"corner tl\"></div>\n  <div class=\"corner tr\"></div>\n  <div class=\"corner bl\"></div>\n  <div class=\"corner br\"></div>\n\n  <!-- CONTENT -->\n  <div class=\"content\">\n    <div class=\"cross-wrap\"><span class=\"cross-icon\">✝</span></div>\n    <div class=\"welcome\">Welcome to</div>\n    <div class=\"orn\"></div>\n    <div class=\"t1-wrap\"><span class=\"t1\">நல்ல சமாரியன் இயேசு</span></div>\n    <div class=\"t2-wrap\"><span class=\"t2\">ஜெப வீடு</span></div>\n    <div class=\"orn2\"></div>\n    <div class=\"verse\">❝ என்னுடைய வீடு ஜெபவீடு என்னப்படும் ❞ — மத்தேயு 21:13</div>\n  </div>\n</div>\n\n<script>\n/* ══════════════════════════════════\n   AURORA BACKGROUND\n══════════════════════════════════ */\n(function(){\n  const cv=document.getElementById('cAurora');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}\n  resize();window.addEventListener('resize',resize);\n\n  // aurora bands\n  const bands=[\n    {y:.2,  amp:.08, freq:.6,  speed:.007, color:[167,139,250], alpha:.25},\n    {y:.35, amp:.10, freq:.5,  speed:.005, color:[244,114,182], alpha:.20},\n    {y:.5,  amp:.07, freq:.8,  speed:.009, color:[56,189,248],  alpha:.18},\n    {y:.65, amp:.09, freq:.55, speed:.006, color:[251,191,36],  alpha:.15},\n    {y:.15, amp:.06, freq:.9,  speed:.011, color:[107,203,119], alpha:.12},\n  ];\n\n  function draw(){\n    t+=1;\n    cx.clearRect(0,0,W,H);\n\n    // deep space base\n    const bg=cx.createLinearGradient(0,0,0,H);\n    bg.addColorStop(0,'#020008');\n    bg.addColorStop(.4,'#060014');\n    bg.addColorStop(.7,'#080018');\n    bg.addColorStop(1,'#040010');\n    cx.fillStyle=bg;cx.fillRect(0,0,W,H);\n\n    // aurora bands\n    bands.forEach(b=>{\n      const baseY=b.y*H;\n      const thickness=H*.22;\n      cx.save();\n      cx.beginPath();\n      cx.moveTo(0,H);\n      for(let x=0;x<=W;x+=8){\n        const wave=Math.sin(x*b.freq*.01+t*b.speed)*b.amp*H\n                  +Math.sin(x*b.freq*.007+t*b.speed*.7)*(b.amp*.5)*H;\n        cx.lineTo(x,baseY+wave);\n      }\n      cx.lineTo(W,H);cx.closePath();\n\n      const g=cx.createLinearGradient(0,baseY-thickness*.3,0,baseY+thickness*.7);\n      g.addColorStop(0,`rgba(${b.color},0)`);\n      g.addColorStop(.3,`rgba(${b.color},${b.alpha})`);\n      g.addColorStop(.6,`rgba(${b.color},${b.alpha*.5})`);\n      g.addColorStop(1,`rgba(${b.color},0)`);\n      cx.fillStyle=g;cx.fill();\n      cx.restore();\n    });\n\n    // moving light streaks\n    for(let i=0;i<5;i++){\n      const sx=((t*(.8+i*.3)+i*300)%(W+200))-100;\n      const g=cx.createLinearGradient(sx-80,0,sx+80,0);\n      g.addColorStop(0,'rgba(255,255,255,0)');\n      g.addColorStop(.5,`rgba(255,255,255,${.04+i*.01})`);\n      g.addColorStop(1,'rgba(255,255,255,0)');\n      cx.fillStyle=g;cx.fillRect(sx-80,0,160,H);\n    }\n\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n\n/* ══════════════════════════════════\n   PARTICLE SYSTEM — colourful\n══════════════════════════════════ */\n(function(){\n  const cv=document.getElementById('cParticles');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}\n  resize();window.addEventListener('resize',resize);\n\n  const COLORS=[\n    [167,139,250],[244,114,182],[56,189,248],\n    [251,191,36],[107,203,119],[255,107,107],\n    [0,245,255],[255,46,244]\n  ];\n\n  class Star{\n    constructor(){this.init()}\n    init(){\n      this.x=Math.random();\n      this.y=Math.random();\n      this.r=Math.random()*2.5+.5;\n      this.vx=(Math.random()-.5)*.0005;\n      this.vy=-(Math.random()*.0008+.0002);\n      this.a=Math.random()*.8+.2;\n      this.da=(Math.random()*.006+.002)*(Math.random()>.5?1:-1);\n      this.c=COLORS[Math.floor(Math.random()*COLORS.length)];\n      this.pulse=Math.random()*Math.PI*2;\n      this.type=Math.random()>.7?'diamond':'circle';\n    }\n    update(){\n      this.x+=this.vx;this.y+=this.vy;\n      this.a+=this.da;this.pulse+=.04;\n      if(this.a>.95||this.a<.1)this.da*=-1;\n      if(this.y<-.02)this.y=1.02;\n      if(this.x<0)this.x=1;if(this.x>1)this.x=0;\n    }\n    draw(cx){\n      const px=this.x*W,py=this.y*H;\n      const glow=Math.sin(this.pulse)*.5+.5;\n      const [r,g,b]=this.c;\n\n      cx.shadowColor=`rgba(${r},${g},${b},${glow*.8})`;\n      cx.shadowBlur=this.r*6;\n      cx.globalAlpha=this.a;\n\n      if(this.type==='diamond'){\n        const s=this.r*1.5;\n        cx.beginPath();\n        cx.moveTo(px,py-s);cx.lineTo(px+s,py);\n        cx.lineTo(px,py+s);cx.lineTo(px-s,py);\n        cx.closePath();\n        cx.fillStyle=`rgba(${r},${g},${b},1)`;\n        cx.fill();\n        // sparkle arms\n        cx.strokeStyle=`rgba(${r},${g},${b},${glow*.6})`;\n        cx.lineWidth=.5;\n        cx.beginPath();cx.moveTo(px-s*2.5,py);cx.lineTo(px+s*2.5,py);cx.stroke();\n        cx.beginPath();cx.moveTo(px,py-s*2.5);cx.lineTo(px,py+s*2.5);cx.stroke();\n      } else {\n        cx.beginPath();cx.arc(px,py,this.r,0,Math.PI*2);\n        cx.fillStyle=`rgba(${r},${g},${b},1)`;cx.fill();\n      }\n      cx.globalAlpha=1;cx.shadowBlur=0;\n    }\n  }\n\n  // shooting stars\n  class Streak{\n    constructor(){this.init()}\n    init(){\n      this.x=Math.random()*1.5-.25;\n      this.y=Math.random()*.5;\n      this.len=Math.random()*.15+.06;\n      this.speed=Math.random()*.012+.008;\n      this.a=0;this.maxA=Math.random()*.7+.3;\n      this.c=COLORS[Math.floor(Math.random()*COLORS.length)];\n      this.alive=true;this.phase=0;\n    }\n    update(){\n      this.phase+=.03;\n      if(this.phase<1) this.a=Math.min(this.maxA,this.phase*this.maxA*3);\n      else this.a=Math.max(0,this.a-.015);\n      this.x+=this.speed*.7;this.y+=this.speed*.4;\n      if(this.a<=0&&this.phase>1)this.alive=false;\n    }\n    draw(cx){\n      if(this.a<=0)return;\n      const [r,g,b]=this.c;\n      const x1=this.x*W,y1=this.y*H;\n      const x2=x1-this.len*W*.7,y2=y1-this.len*H*.4;\n      const grad=cx.createLinearGradient(x2,y2,x1,y1);\n      grad.addColorStop(0,`rgba(${r},${g},${b},0)`);\n      grad.addColorStop(1,`rgba(${r},${g},${b},${this.a})`);\n      cx.save();\n      cx.strokeStyle=grad;cx.lineWidth=1.5;\n      cx.shadowColor=`rgba(${r},${g},${b},.6)`;cx.shadowBlur=6;\n      cx.beginPath();cx.moveTo(x2,y2);cx.lineTo(x1,y1);cx.stroke();\n      cx.restore();\n    }\n  }\n\n  const stars=Array.from({length:200},()=>new Star());\n  const streaks=[];\n  let streakTimer=0;\n\n  function draw(){\n    t++;streakTimer++;\n    cx.clearRect(0,0,W,H);\n\n    // spawn streak every ~90 frames\n    if(streakTimer>90+Math.random()*60){\n      streaks.push(new Streak());streakTimer=0;\n    }\n\n    stars.forEach(s=>{s.update();s.draw(cx)});\n\n    // streaks\n    for(let i=streaks.length-1;i>=0;i--){\n      streaks[i].update();streaks[i].draw(cx);\n      if(!streaks[i].alive)streaks.splice(i,1);\n    }\n\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
      "bookmarked": true,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cinzel+Decorative:wght@700;900&family=Cormorant+Garamond:ital,wght@1,400;0,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n    background:#020008;\n  }\n\n  canvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n  #cAurora{z-index:1}\n  #cParticles{z-index:3}\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n    gap:0;\n  }\n\n  /* ── CROSS ── */\n  .cross-wrap{\n    margin-bottom:2.5vh;\n    opacity:0;\n    animation:crossIn 1.2s cubic-bezier(.34,1.56,.64,1) forwards .3s;\n  }\n  @keyframes crossIn{\n    0%{opacity:0;transform:scale(.3) rotate(-20deg);filter:blur(20px)}\n    100%{opacity:1;transform:scale(1) rotate(0deg);filter:blur(0)}\n  }\n  .cross-icon{\n    font-size:clamp(44px,6vh,80px);\n    display:block;text-align:center;\n    background:linear-gradient(135deg,#fff 0%,#ffe066 30%,#ff6ec7 60%,#66cfff 100%);\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    background-size:300% 300%;\n    animation:crossColorShift 3s ease-in-out infinite 1.5s;\n    filter:drop-shadow(0 0 12px rgba(255,180,255,.6)) drop-shadow(0 0 30px rgba(100,200,255,.4));\n  }\n  @keyframes crossColorShift{\n    0%,100%{background-position:0% 50%;filter:drop-shadow(0 0 12px rgba(255,180,255,.6)) drop-shadow(0 0 30px rgba(100,200,255,.4))}\n    50%{background-position:100% 50%;filter:drop-shadow(0 0 20px rgba(255,220,100,.9)) drop-shadow(0 0 50px rgba(255,120,200,.6))}\n  }\n\n  /* ── WELCOME ── */\n  .welcome{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(12px,1.5vw,20px);\n    letter-spacing:12px;\n    text-transform:uppercase;\n    margin-bottom:1.6vh;\n    opacity:0;\n    animation:fadeUp .9s ease forwards 1s;\n    background:linear-gradient(90deg,#a78bfa,#f472b6,#fb923c,#facc15);\n    background-size:300% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:welcomeAnim 3s ease-in-out infinite 1s,fadeUp .9s ease forwards 1s;\n  }\n  @keyframes welcomeAnim{\n    0%,100%{background-position:0% center;opacity:1}\n    50%{background-position:100% center}\n  }\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(16px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n\n  /* ── ORN LINE ── */\n  .orn{\n    width:55vw;height:1px;margin-bottom:2vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .8s ease forwards 1.4s;\n    background:linear-gradient(90deg,transparent,#a78bfa,#f472b6,#38bdf8,transparent);\n    position:relative;\n  }\n  .orn::before,.orn::after{\n    content:'◆';position:absolute;top:-7px;\n    font-size:12px;color:#f472b6;\n    text-shadow:0 0 10px #f472b6,0 0 20px #a78bfa;\n  }\n  .orn::before{left:-4px} .orn::after{right:-4px}\n  @keyframes lineExpand{to{opacity:1;transform:scaleX(1)}}\n\n  /* ── TITLE LINE 1 ── */\n  .t1-wrap{\n    overflow:visible;\n    margin-bottom:.5vh;\n    opacity:0;\n    animation:fadeUp 1s ease forwards 1.7s;\n  }\n  .t1{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(28px,5.2vw,80px);\n    font-weight:900;\n    line-height:1.2;\n    white-space:nowrap;\n    letter-spacing:3px;\n    /* Trendy chrome-rainbow gradient */\n    background:linear-gradient(\n      90deg,\n      #ff6b6b 0%,\n      #ffd93d 15%,\n      #6bcb77 28%,\n      #4d96ff 42%,\n      #c77dff 56%,\n      #ff6b9d 70%,\n      #ffd93d 85%,\n      #ff6b6b 100%\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:rainbowFlow 4s linear infinite;\n    filter:drop-shadow(0 0 15px rgba(200,120,255,.5)) drop-shadow(0 4px 20px rgba(0,0,0,.8));\n  }\n  @keyframes rainbowFlow{\n    0%{background-position:0% center}\n    100%{background-position:200% center}\n  }\n\n  /* ── TITLE LINE 2 ── */\n  .t2-wrap{\n    overflow:visible;\n    opacity:0;\n    animation:fadeUp 1s ease forwards 2s;\n  }\n  .t2{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(22px,4vw,62px);\n    font-weight:700;\n    line-height:1.3;\n    letter-spacing:10px;\n    white-space:nowrap;\n    /* Trendy aurora/neon gradient */\n    background:linear-gradient(\n      90deg,\n      #00f5ff 0%,\n      #7b2fff 20%,\n      #ff2ff4 40%,\n      #ff9500 60%,\n      #00f5ff 80%,\n      #7b2fff 100%\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:auroraFlow 3s linear infinite;\n    filter:drop-shadow(0 0 20px rgba(0,245,255,.4)) drop-shadow(0 4px 20px rgba(0,0,0,.9));\n  }\n  @keyframes auroraFlow{\n    0%{background-position:0% center}\n    100%{background-position:200% center}\n  }\n\n  /* ── ORN 2 ── */\n  .orn2{\n    width:38vw;height:1px;margin-top:2vh;margin-bottom:1.6vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .8s ease forwards 2.6s;\n    background:linear-gradient(90deg,transparent,#38bdf8,#a78bfa,#f472b6,transparent);\n  }\n\n  /* ── VERSE ── */\n  .verse{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:600;\n    font-size:clamp(11px,1.3vw,19px);\n    letter-spacing:2px;text-align:center;\n    padding:0 10vw;\n    opacity:0;\n    animation:fadeUp .9s ease forwards 2.9s;\n    background:linear-gradient(90deg,#e0c3fc,#a5f3fc,#fde68a,#e0c3fc);\n    background-size:300% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:verseShimmer 5s ease-in-out infinite 2.9s, fadeUp .9s ease forwards 2.9s;\n  }\n  @keyframes verseShimmer{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── CORNER BRACKETS ── */\n  .corner{\n    position:absolute;z-index:11;\n    width:clamp(40px,5vw,70px);height:clamp(40px,5vw,70px);\n    opacity:0;animation:cornerIn .8s ease forwards 2.3s;\n    background:transparent;\n  }\n  @keyframes cornerIn{to{opacity:1}}\n  .corner::before,.corner::after{\n    content:'';position:absolute;background:transparent;\n  }\n  /* TL */\n  .corner.tl{top:5vh;left:4vw;}\n  .corner.tl::before{top:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,#f472b6,#a78bfa);}\n  .corner.tl::after{top:0;left:0;width:2px;height:100%;background:linear-gradient(180deg,#f472b6,#a78bfa);}\n  /* TR */\n  .corner.tr{top:5vh;right:4vw;}\n  .corner.tr::before{top:0;right:0;left:auto;width:100%;height:2px;background:linear-gradient(90deg,#38bdf8,#6bcb77);}\n  .corner.tr::after{top:0;right:0;left:auto;width:2px;height:100%;background:linear-gradient(180deg,#38bdf8,#6bcb77);}\n  /* BL */\n  .corner.bl{bottom:5vh;left:4vw;}\n  .corner.bl::before{bottom:0;left:0;top:auto;width:100%;height:2px;background:linear-gradient(90deg,#ffd93d,#ff6b9d);}\n  .corner.bl::after{bottom:0;left:0;top:auto;width:2px;height:100%;background:linear-gradient(0deg,#ffd93d,#ff6b9d);}\n  /* BR */\n  .corner.br{bottom:5vh;right:4vw;}\n  .corner.br::before{bottom:0;right:0;left:auto;top:auto;width:100%;height:2px;background:linear-gradient(90deg,#6bcb77,#4d96ff);}\n  .corner.br::after{bottom:0;right:0;left:auto;top:auto;width:2px;height:100%;background:linear-gradient(0deg,#6bcb77,#4d96ff);}\n\n  /* ── FLOATING GLOW ORBS behind content ── */\n  .orb{\n    position:absolute;border-radius:50%;\n    filter:blur(80px);z-index:2;\n    animation:orbFloat ease-in-out infinite;\n  }\n  @keyframes orbFloat{\n    0%,100%{transform:translateY(0) scale(1)}\n    50%{transform:translateY(-30px) scale(1.1)}\n  }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <canvas id=\"cAurora\"></canvas>\n\n  <!-- Glow orbs -->\n  <div class=\"orb\" style=\"width:40vw;height:40vw;left:-10vw;top:10vh;background:rgba(167,139,250,.15);animation-duration:8s;animation-delay:0s\"></div>\n  <div class=\"orb\" style=\"width:35vw;height:35vw;right:-8vw;top:20vh;background:rgba(244,114,182,.12);animation-duration:10s;animation-delay:-3s\"></div>\n  <div class=\"orb\" style=\"width:30vw;height:30vw;left:30vw;bottom:5vh;background:rgba(56,189,248,.1);animation-duration:7s;animation-delay:-5s\"></div>\n  <div class=\"orb\" style=\"width:25vw;height:25vw;left:60vw;top:5vh;background:rgba(251,191,36,.08);animation-duration:9s;animation-delay:-2s\"></div>\n\n  <canvas id=\"cParticles\"></canvas>\n\n  <!-- Corners -->\n  <div class=\"corner tl\"></div>\n  <div class=\"corner tr\"></div>\n  <div class=\"corner bl\"></div>\n  <div class=\"corner br\"></div>\n\n  <!-- CONTENT -->\n  <div class=\"content\">\n    <div class=\"cross-wrap\"><span class=\"cross-icon\">✝</span></div>\n    <div class=\"welcome\">Welcome to</div>\n    <div class=\"orn\"></div>\n    <div class=\"t1-wrap\"><span class=\"t1\">நல்ல சமாரியன் இயேசு</span></div>\n    <div class=\"t2-wrap\"><span class=\"t2\">ஜெப வீடு</span></div>\n    <div class=\"orn2\"></div>\n    <div class=\"verse\">❝ என்னுடைய வீடு ஜெபவீடு என்னப்படும் ❞ — மத்தேயு 21:13</div>\n  </div>\n</div>\n\n<script>\n/* ══════════════════════════════════\n   AURORA BACKGROUND\n══════════════════════════════════ */\n(function(){\n  const cv=document.getElementById('cAurora');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}\n  resize();window.addEventListener('resize',resize);\n\n  // aurora bands\n  const bands=[\n    {y:.2,  amp:.08, freq:.6,  speed:.007, color:[167,139,250], alpha:.25},\n    {y:.35, amp:.10, freq:.5,  speed:.005, color:[244,114,182], alpha:.20},\n    {y:.5,  amp:.07, freq:.8,  speed:.009, color:[56,189,248],  alpha:.18},\n    {y:.65, amp:.09, freq:.55, speed:.006, color:[251,191,36],  alpha:.15},\n    {y:.15, amp:.06, freq:.9,  speed:.011, color:[107,203,119], alpha:.12},\n  ];\n\n  function draw(){\n    t+=1;\n    cx.clearRect(0,0,W,H);\n\n    // deep space base\n    const bg=cx.createLinearGradient(0,0,0,H);\n    bg.addColorStop(0,'#020008');\n    bg.addColorStop(.4,'#060014');\n    bg.addColorStop(.7,'#080018');\n    bg.addColorStop(1,'#040010');\n    cx.fillStyle=bg;cx.fillRect(0,0,W,H);\n\n    // aurora bands\n    bands.forEach(b=>{\n      const baseY=b.y*H;\n      const thickness=H*.22;\n      cx.save();\n      cx.beginPath();\n      cx.moveTo(0,H);\n      for(let x=0;x<=W;x+=8){\n        const wave=Math.sin(x*b.freq*.01+t*b.speed)*b.amp*H\n                  +Math.sin(x*b.freq*.007+t*b.speed*.7)*(b.amp*.5)*H;\n        cx.lineTo(x,baseY+wave);\n      }\n      cx.lineTo(W,H);cx.closePath();\n\n      const g=cx.createLinearGradient(0,baseY-thickness*.3,0,baseY+thickness*.7);\n      g.addColorStop(0,`rgba(${b.color},0)`);\n      g.addColorStop(.3,`rgba(${b.color},${b.alpha})`);\n      g.addColorStop(.6,`rgba(${b.color},${b.alpha*.5})`);\n      g.addColorStop(1,`rgba(${b.color},0)`);\n      cx.fillStyle=g;cx.fill();\n      cx.restore();\n    });\n\n    // moving light streaks\n    for(let i=0;i<5;i++){\n      const sx=((t*(.8+i*.3)+i*300)%(W+200))-100;\n      const g=cx.createLinearGradient(sx-80,0,sx+80,0);\n      g.addColorStop(0,'rgba(255,255,255,0)');\n      g.addColorStop(.5,`rgba(255,255,255,${.04+i*.01})`);\n      g.addColorStop(1,'rgba(255,255,255,0)');\n      cx.fillStyle=g;cx.fillRect(sx-80,0,160,H);\n    }\n\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n\n/* ══════════════════════════════════\n   PARTICLE SYSTEM — colourful\n══════════════════════════════════ */\n(function(){\n  const cv=document.getElementById('cParticles');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}\n  resize();window.addEventListener('resize',resize);\n\n  const COLORS=[\n    [167,139,250],[244,114,182],[56,189,248],\n    [251,191,36],[107,203,119],[255,107,107],\n    [0,245,255],[255,46,244]\n  ];\n\n  class Star{\n    constructor(){this.init()}\n    init(){\n      this.x=Math.random();\n      this.y=Math.random();\n      this.r=Math.random()*2.5+.5;\n      this.vx=(Math.random()-.5)*.0005;\n      this.vy=-(Math.random()*.0008+.0002);\n      this.a=Math.random()*.8+.2;\n      this.da=(Math.random()*.006+.002)*(Math.random()>.5?1:-1);\n      this.c=COLORS[Math.floor(Math.random()*COLORS.length)];\n      this.pulse=Math.random()*Math.PI*2;\n      this.type=Math.random()>.7?'diamond':'circle';\n    }\n    update(){\n      this.x+=this.vx;this.y+=this.vy;\n      this.a+=this.da;this.pulse+=.04;\n      if(this.a>.95||this.a<.1)this.da*=-1;\n      if(this.y<-.02)this.y=1.02;\n      if(this.x<0)this.x=1;if(this.x>1)this.x=0;\n    }\n    draw(cx){\n      const px=this.x*W,py=this.y*H;\n      const glow=Math.sin(this.pulse)*.5+.5;\n      const [r,g,b]=this.c;\n\n      cx.shadowColor=`rgba(${r},${g},${b},${glow*.8})`;\n      cx.shadowBlur=this.r*6;\n      cx.globalAlpha=this.a;\n\n      if(this.type==='diamond'){\n        const s=this.r*1.5;\n        cx.beginPath();\n        cx.moveTo(px,py-s);cx.lineTo(px+s,py);\n        cx.lineTo(px,py+s);cx.lineTo(px-s,py);\n        cx.closePath();\n        cx.fillStyle=`rgba(${r},${g},${b},1)`;\n        cx.fill();\n        // sparkle arms\n        cx.strokeStyle=`rgba(${r},${g},${b},${glow*.6})`;\n        cx.lineWidth=.5;\n        cx.beginPath();cx.moveTo(px-s*2.5,py);cx.lineTo(px+s*2.5,py);cx.stroke();\n        cx.beginPath();cx.moveTo(px,py-s*2.5);cx.lineTo(px,py+s*2.5);cx.stroke();\n      } else {\n        cx.beginPath();cx.arc(px,py,this.r,0,Math.PI*2);\n        cx.fillStyle=`rgba(${r},${g},${b},1)`;cx.fill();\n      }\n      cx.globalAlpha=1;cx.shadowBlur=0;\n    }\n  }\n\n  // shooting stars\n  class Streak{\n    constructor(){this.init()}\n    init(){\n      this.x=Math.random()*1.5-.25;\n      this.y=Math.random()*.5;\n      this.len=Math.random()*.15+.06;\n      this.speed=Math.random()*.012+.008;\n      this.a=0;this.maxA=Math.random()*.7+.3;\n      this.c=COLORS[Math.floor(Math.random()*COLORS.length)];\n      this.alive=true;this.phase=0;\n    }\n    update(){\n      this.phase+=.03;\n      if(this.phase<1) this.a=Math.min(this.maxA,this.phase*this.maxA*3);\n      else this.a=Math.max(0,this.a-.015);\n      this.x+=this.speed*.7;this.y+=this.speed*.4;\n      if(this.a<=0&&this.phase>1)this.alive=false;\n    }\n    draw(cx){\n      if(this.a<=0)return;\n      const [r,g,b]=this.c;\n      const x1=this.x*W,y1=this.y*H;\n      const x2=x1-this.len*W*.7,y2=y1-this.len*H*.4;\n      const grad=cx.createLinearGradient(x2,y2,x1,y1);\n      grad.addColorStop(0,`rgba(${r},${g},${b},0)`);\n      grad.addColorStop(1,`rgba(${r},${g},${b},${this.a})`);\n      cx.save();\n      cx.strokeStyle=grad;cx.lineWidth=1.5;\n      cx.shadowColor=`rgba(${r},${g},${b},.6)`;cx.shadowBlur=6;\n      cx.beginPath();cx.moveTo(x2,y2);cx.lineTo(x1,y1);cx.stroke();\n      cx.restore();\n    }\n  }\n\n  const stars=Array.from({length:200},()=>new Star());\n  const streaks=[];\n  let streakTimer=0;\n\n  function draw(){\n    t++;streakTimer++;\n    cx.clearRect(0,0,W,H);\n\n    // spawn streak every ~90 frames\n    if(streakTimer>90+Math.random()*60){\n      streaks.push(new Streak());streakTimer=0;\n    }\n\n    stars.forEach(s=>{s.update();s.draw(cx)});\n\n    // streaks\n    for(let i=streaks.length-1;i>=0;i--){\n      streaks[i].update();streaks[i].draw(cx);\n      if(!streaks[i].alive)streaks.splice(i,1);\n    }\n\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1775933223980.9812,
      "type": "html",
      "name": "Bishop Title",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Thor Style Lightning Title - Sequential</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #020611; }\n    \n    .stage { \n      width: 100vw; height: 100vh; position: relative; overflow: hidden;\n      perspective: 1000px;\n    }\n\n    /* Background video is now much more visible */\n    .video-bg {\n      position: absolute; inset: 0; z-index: 0;\n      width: 100%; height: 100%; object-fit: cover;\n      opacity: 0.8; /* Increased visibility */\n    }\n\n    /* Subtle vignette just to keep the text readable, not hiding the video */\n    .overlay {\n      position: absolute; inset: 0; z-index: 1;\n      background: radial-gradient(circle at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);\n    }\n\n    /* --- Localized Lightning Strikes --- */\n    .lightning {\n      position: absolute; z-index: 2;\n      border-radius: 50%;\n      mix-blend-mode: overlay;\n      pointer-events: none;\n      opacity: 0;\n    }\n    \n    .strike-top-left {\n      top: -20%; left: -10%; width: 60vw; height: 60vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 60%);\n      animation: localizedFlash 4s infinite 1.5s;\n    }\n    \n    .strike-right {\n      top: 20%; right: -20%; width: 70vw; height: 70vw;\n      background: radial-gradient(circle, #b3e5fc 0%, transparent 60%);\n      animation: localizedFlash 5.5s infinite 3s;\n    }\n    \n    .strike-bottom {\n      bottom: -30%; left: 20%; width: 80vw; height: 50vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 70%);\n      animation: localizedFlash 6s infinite 0.5s;\n    }\n\n    /* Container for the text */\n    .content {\n      position: absolute; inset: 0; z-index: 10;\n      display: flex; flex-direction: column;\n      align-items: center; justify-content: center;\n    }\n\n    /* Base styling for all words */\n    .word {\n      display: inline-block;\n      color: #ffffff;\n      white-space: nowrap;\n      opacity: 0; /* Hidden initially */\n      /* Reduced, sharper glow for readability */\n      text-shadow: \n        0 0 4px #fff,\n        0 0 10px #00e5ff,\n        0 0 20px #008cff;\n    }\n\n    .title-small {\n      font-size: clamp(16px, 3vw, 40px);\n      letter-spacing: 20px;\n      font-family: 'Cinzel', serif;\n      font-weight: 700;\n      margin-bottom: 10px;\n      margin-right: -20px; /* Offset for letter spacing */\n    }\n\n    .title-large {\n      font-size: clamp(30px, 8vw, 120px);\n      font-weight: 900;\n      font-family: 'Montserrat', sans-serif;\n      letter-spacing: 5px;\n      display: flex;\n      gap: 2vw; /* Space between PAUL and YUVARAJ */\n    }\n\n    /* \n      Word-by-Word Sequential Animations \n      Using animation delays to bring them in one after the other \n    */\n    .w-bishop {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 0.5s,\n        subtleFlicker 3s infinite alternate 1.7s;\n    }\n\n    .w-paul {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 1.7s,\n        subtleFlicker 3s infinite alternate 2.9s;\n    }\n\n    .w-yuvaraj {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 2.6s,\n        subtleFlicker 3s infinite alternate 3.8s;\n    }\n\n    /* \n      The Animation: Starts as a distant glowing star, zooms in, \n      bounces slightly (impact), and clears up perfectly.\n    */\n    @keyframes starZoomSlam {\n      0% {\n        opacity: 0;\n        transform: translateZ(-2000px) scale(0.01);\n        filter: blur(10px);\n        text-shadow: 0 0 100px #fff, 0 0 300px #00e5ff;\n        color: transparent;\n      }\n      40% {\n        opacity: 1;\n        transform: translateZ(-500px) scale(0.5);\n        filter: blur(4px);\n        color: #fff;\n      }\n      80% {\n        transform: translateZ(50px) scale(1.1); /* Slams past normal size */\n        filter: blur(0px);\n      }\n      90% {\n        transform: translateZ(-10px) scale(0.97); /* Bounces back */\n      }\n      100% {\n        opacity: 1;\n        transform: translateZ(0) scale(1); /* Settles perfectly clear */\n        filter: blur(0px);\n      }\n    }\n\n    /* Random sharp flashes for the background lightning */\n    @keyframes localizedFlash {\n      0%, 9%, 11%, 49%, 51%, 100% { opacity: 0; }\n      10% { opacity: 0.8; } /* Bright flash */\n      12% { opacity: 0.2; } /* Fade out */\n      15% { opacity: 0.6; } /* Secondary crackle */\n      50% { opacity: 0.4; } /* Random mid-animation flash */\n    }\n\n    /* A very subtle crisp electric flicker for the text after it lands */\n    @keyframes subtleFlicker {\n      0%, 100% {\n        text-shadow: 0 0 4px #fff, 0 0 10px #00e5ff, 0 0 20px #008cff;\n      }\n      50% {\n        text-shadow: 0 0 2px #fff, 0 0 5px #00e5ff, 0 0 10px #008cff;\n      }\n      55% {\n        text-shadow: 0 0 8px #fff, 0 0 15px #00e5ff, 0 0 30px #008cff;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\">\n    <!-- Background video (Now much clearer) -->\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"earthbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <!-- Thunder strikes happening in different areas -->\n    <div class=\"lightning strike-top-left\"></div>\n    <div class=\"lightning strike-right\"></div>\n    <div class=\"lightning strike-bottom\"></div>\n    \n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <!-- First word -->\n      <div class=\"title-small\">\n        <span class=\"word w-bishop\">பிஷப்</span>\n      </div>\n\n      <!-- Second and Third words -->\n      <div class=\"title-large\">\n        <span class=\"word w-paul\">வி. பால்</span>\n        <span class=\"word w-yuvaraj\">யுவராஜ்</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
      "bookmarked": false,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Thor Style Lightning Title - Sequential</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #020611; }\n    \n    .stage { \n      width: 100vw; height: 100vh; position: relative; overflow: hidden;\n      perspective: 1000px;\n    }\n\n    /* Background video is now much more visible */\n    .video-bg {\n      position: absolute; inset: 0; z-index: 0;\n      width: 100%; height: 100%; object-fit: cover;\n      opacity: 0.8; /* Increased visibility */\n    }\n\n    /* Subtle vignette just to keep the text readable, not hiding the video */\n    .overlay {\n      position: absolute; inset: 0; z-index: 1;\n      background: radial-gradient(circle at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);\n    }\n\n    /* --- Localized Lightning Strikes --- */\n    .lightning {\n      position: absolute; z-index: 2;\n      border-radius: 50%;\n      mix-blend-mode: overlay;\n      pointer-events: none;\n      opacity: 0;\n    }\n    \n    .strike-top-left {\n      top: -20%; left: -10%; width: 60vw; height: 60vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 60%);\n      animation: localizedFlash 4s infinite 1.5s;\n    }\n    \n    .strike-right {\n      top: 20%; right: -20%; width: 70vw; height: 70vw;\n      background: radial-gradient(circle, #b3e5fc 0%, transparent 60%);\n      animation: localizedFlash 5.5s infinite 3s;\n    }\n    \n    .strike-bottom {\n      bottom: -30%; left: 20%; width: 80vw; height: 50vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 70%);\n      animation: localizedFlash 6s infinite 0.5s;\n    }\n\n    /* Container for the text */\n    .content {\n      position: absolute; inset: 0; z-index: 10;\n      display: flex; flex-direction: column;\n      align-items: center; justify-content: center;\n    }\n\n    /* Base styling for all words */\n    .word {\n      display: inline-block;\n      color: #ffffff;\n      white-space: nowrap;\n      opacity: 0; /* Hidden initially */\n      /* Reduced, sharper glow for readability */\n      text-shadow: \n        0 0 4px #fff,\n        0 0 10px #00e5ff,\n        0 0 20px #008cff;\n    }\n\n    .title-small {\n      font-size: clamp(16px, 3vw, 40px);\n      letter-spacing: 20px;\n      font-family: 'Cinzel', serif;\n      font-weight: 700;\n      margin-bottom: 10px;\n      margin-right: -20px; /* Offset for letter spacing */\n    }\n\n    .title-large {\n      font-size: clamp(30px, 8vw, 120px);\n      font-weight: 900;\n      font-family: 'Montserrat', sans-serif;\n      letter-spacing: 5px;\n      display: flex;\n      gap: 2vw; /* Space between PAUL and YUVARAJ */\n    }\n\n    /* \n      Word-by-Word Sequential Animations \n      Using animation delays to bring them in one after the other \n    */\n    .w-bishop {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 0.5s,\n        subtleFlicker 3s infinite alternate 1.7s;\n    }\n\n    .w-paul {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 1.7s,\n        subtleFlicker 3s infinite alternate 2.9s;\n    }\n\n    .w-yuvaraj {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 2.6s,\n        subtleFlicker 3s infinite alternate 3.8s;\n    }\n\n    /* \n      The Animation: Starts as a distant glowing star, zooms in, \n      bounces slightly (impact), and clears up perfectly.\n    */\n    @keyframes starZoomSlam {\n      0% {\n        opacity: 0;\n        transform: translateZ(-2000px) scale(0.01);\n        filter: blur(10px);\n        text-shadow: 0 0 100px #fff, 0 0 300px #00e5ff;\n        color: transparent;\n      }\n      40% {\n        opacity: 1;\n        transform: translateZ(-500px) scale(0.5);\n        filter: blur(4px);\n        color: #fff;\n      }\n      80% {\n        transform: translateZ(50px) scale(1.1); /* Slams past normal size */\n        filter: blur(0px);\n      }\n      90% {\n        transform: translateZ(-10px) scale(0.97); /* Bounces back */\n      }\n      100% {\n        opacity: 1;\n        transform: translateZ(0) scale(1); /* Settles perfectly clear */\n        filter: blur(0px);\n      }\n    }\n\n    /* Random sharp flashes for the background lightning */\n    @keyframes localizedFlash {\n      0%, 9%, 11%, 49%, 51%, 100% { opacity: 0; }\n      10% { opacity: 0.8; } /* Bright flash */\n      12% { opacity: 0.2; } /* Fade out */\n      15% { opacity: 0.6; } /* Secondary crackle */\n      50% { opacity: 0.4; } /* Random mid-animation flash */\n    }\n\n    /* A very subtle crisp electric flicker for the text after it lands */\n    @keyframes subtleFlicker {\n      0%, 100% {\n        text-shadow: 0 0 4px #fff, 0 0 10px #00e5ff, 0 0 20px #008cff;\n      }\n      50% {\n        text-shadow: 0 0 2px #fff, 0 0 5px #00e5ff, 0 0 10px #008cff;\n      }\n      55% {\n        text-shadow: 0 0 8px #fff, 0 0 15px #00e5ff, 0 0 30px #008cff;\n      }\n    }\n  </style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n  <div class=\"stage\">\n    <!-- Background video (Now much clearer) -->\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"earthbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <!-- Thunder strikes happening in different areas -->\n    <div class=\"lightning strike-top-left\"></div>\n    <div class=\"lightning strike-right\"></div>\n    <div class=\"lightning strike-bottom\"></div>\n    \n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <!-- First word -->\n      <div class=\"title-small\">\n        <span class=\"word w-bishop\">பிஷப்</span>\n      </div>\n\n      <!-- Second and Third words -->\n      <div class=\"title-large\">\n        <span class=\"word w-paul\">வி. பால்</span>\n        <span class=\"word w-yuvaraj\">யுவராஜ்</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
