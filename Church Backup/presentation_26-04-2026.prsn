      "id": 1772937978152.9502,
      "type": "html",
      "name": "Title",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Church Overlay</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@700;900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    *{margin:0;padding:0;box-sizing:border-box}\n    html,body{width:100%;height:100%;overflow:hidden;background:#000}\n    .stage{width:100vw;height:100vh;position:relative;overflow:hidden}\n\n    .video-bg{\n      position:absolute;inset:0;z-index:0;\n      width:100%;height:100%;object-fit:cover\n    }\n\n    .overlay{\n      position:absolute;inset:0;z-index:1;\n      background:radial-gradient(\n        ellipse 80% 38% at 50% 28%,\n        rgba(0,0,0,0.52) 0%,\n        rgba(0,0,0,0.18) 60%,\n        rgba(0,0,0,0.00) 100%\n      )\n    }\n\n    .content{\n      position:absolute;inset:0;z-index:10;\n      display:flex;flex-direction:column;\n      align-items:center;justify-content:center;\n      margin-top:-26vh;\n    }\n\n    .line-clip{\n      overflow:hidden;width:100%;\n      display:flex;align-items:center;justify-content:center;\n      position:relative\n    }\n\n    .church-text{\n      font-family:'Noto Serif Tamil',serif;\n      white-space:nowrap;display:inline-block\n    }\n\n    .line1{\n      font-size:clamp(28px,5vw,80px);\n      font-weight:900;letter-spacing:2px;\n      background:linear-gradient(105deg,\n        #7a5200 0%,#c8860a 12%,#f5d060 25%,#fff8c0 38%,\n        #ffd700 50%,#fff8c0 62%,#f5c842 75%,#c8860a 88%,#7a5200 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromLeft 0.9s cubic-bezier(.16,1,.3,1) forwards,\n        goldShimmer 3.5s linear 0.9s infinite,\n        revealHide 7s ease-in-out 0.9s infinite\n    }\n\n    .line2{\n      font-size:clamp(18px,3.4vw,56px);\n      font-weight:700;letter-spacing:16px;\n      background:linear-gradient(105deg,\n        #6b4f00 0%,#b8780a 12%,#e8c840 25%,#fffacc 38%,\n        #fce87a 50%,#fffacc 62%,#e8c840 75%,#b8780a 88%,#6b4f00 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromRight 0.9s cubic-bezier(.16,1,.3,1) 0.2s forwards,\n        goldShimmer 3.5s linear 1.1s infinite,\n        revealHide 7s ease-in-out 1.1s infinite\n    }\n\n    .divider{\n      width:0;height:1.5px;\n      margin:clamp(4px,0.9vh,13px) 0;\n      background:linear-gradient(90deg,transparent,#ffd700 50%,transparent);\n      opacity:0;\n      animation:\n        dividerExpand 0.6s cubic-bezier(.16,1,.3,1) 0.5s forwards,\n        dividerHide 7s ease-in-out 0.9s infinite\n    }\n\n    .flare{\n      position:absolute;top:0;left:-65%;\n      width:38%;height:100%;\n      background:linear-gradient(108deg,\n        transparent 0%,rgba(255,250,190,0) 35%,\n        rgba(255,252,200,.52) 50%,rgba(255,250,190,0) 65%,transparent 100%\n      );\n      pointer-events:none;mix-blend-mode:screen;\n      animation:flareSweep 3.5s ease-in-out 0.9s infinite\n    }\n\n    @keyframes slideFromLeft{\n      from{opacity:0;transform:translateX(-140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes slideFromRight{\n      from{opacity:0;transform:translateX(140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes goldShimmer{\n      0%{background-position:220% center}\n      100%{background-position:-60% center}\n    }\n    @keyframes revealHide{\n      0%{opacity:1;transform:translateX(0)}\n      58%{opacity:1;transform:translateX(0)}\n      70%{opacity:0;transform:translateX(110px)}\n      71%{opacity:0;transform:translateX(-110px)}\n      84%{opacity:1;transform:translateX(0)}\n      100%{opacity:1;transform:translateX(0)}\n    }\n    @keyframes dividerExpand{\n      from{width:0;opacity:0}\n      to{width:clamp(100px,20vw,300px);opacity:1}\n    }\n    @keyframes dividerHide{\n      0%,57%{opacity:1}\n      69%{opacity:0}\n      83%{opacity:1}\n      100%{opacity:1}\n    }\n    @keyframes flareSweep{\n      0%{left:-65%;opacity:0}\n      8%{opacity:1}\n      58%{left:120%;opacity:0}\n      100%{left:120%;opacity:0}\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\">\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"goatbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <div class=\"line-clip\">\n        <span class=\"church-text line1\">நல்ல சமாரியன் இயேசு</span>\n        <div class=\"flare\"></div>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div class=\"line-clip\">\n        <span class=\"church-text line2\">ஜெப வீடு</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
      "bookmarked": false,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Church Overlay</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@700;900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    *{margin:0;padding:0;box-sizing:border-box}\n    html,body{width:100%;height:100%;overflow:hidden;background:#000}\n    .stage{width:100vw;height:100vh;position:relative;overflow:hidden}\n\n    .video-bg{\n      position:absolute;inset:0;z-index:0;\n      width:100%;height:100%;object-fit:cover\n    }\n\n    .overlay{\n      position:absolute;inset:0;z-index:1;\n      background:radial-gradient(\n        ellipse 80% 38% at 50% 28%,\n        rgba(0,0,0,0.52) 0%,\n        rgba(0,0,0,0.18) 60%,\n        rgba(0,0,0,0.00) 100%\n      )\n    }\n\n    .content{\n      position:absolute;inset:0;z-index:10;\n      display:flex;flex-direction:column;\n      align-items:center;justify-content:center;\n      margin-top:-26vh;\n    }\n\n    .line-clip{\n      overflow:hidden;width:100%;\n      display:flex;align-items:center;justify-content:center;\n      position:relative\n    }\n\n    .church-text{\n      font-family:'Noto Serif Tamil',serif;\n      white-space:nowrap;display:inline-block\n    }\n\n    .line1{\n      font-size:clamp(28px,5vw,80px);\n      font-weight:900;letter-spacing:2px;\n      background:linear-gradient(105deg,\n        #7a5200 0%,#c8860a 12%,#f5d060 25%,#fff8c0 38%,\n        #ffd700 50%,#fff8c0 62%,#f5c842 75%,#c8860a 88%,#7a5200 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromLeft 0.9s cubic-bezier(.16,1,.3,1) forwards,\n        goldShimmer 3.5s linear 0.9s infinite,\n        revealHide 7s ease-in-out 0.9s infinite\n    }\n\n    .line2{\n      font-size:clamp(18px,3.4vw,56px);\n      font-weight:700;letter-spacing:16px;\n      background:linear-gradient(105deg,\n        #6b4f00 0%,#b8780a 12%,#e8c840 25%,#fffacc 38%,\n        #fce87a 50%,#fffacc 62%,#e8c840 75%,#b8780a 88%,#6b4f00 100%\n      );\n      background-size:260% auto;\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n      animation:\n        slideFromRight 0.9s cubic-bezier(.16,1,.3,1) 0.2s forwards,\n        goldShimmer 3.5s linear 1.1s infinite,\n        revealHide 7s ease-in-out 1.1s infinite\n    }\n\n    .divider{\n      width:0;height:1.5px;\n      margin:clamp(4px,0.9vh,13px) 0;\n      background:linear-gradient(90deg,transparent,#ffd700 50%,transparent);\n      opacity:0;\n      animation:\n        dividerExpand 0.6s cubic-bezier(.16,1,.3,1) 0.5s forwards,\n        dividerHide 7s ease-in-out 0.9s infinite\n    }\n\n    .flare{\n      position:absolute;top:0;left:-65%;\n      width:38%;height:100%;\n      background:linear-gradient(108deg,\n        transparent 0%,rgba(255,250,190,0) 35%,\n        rgba(255,252,200,.52) 50%,rgba(255,250,190,0) 65%,transparent 100%\n      );\n      pointer-events:none;mix-blend-mode:screen;\n      animation:flareSweep 3.5s ease-in-out 0.9s infinite\n    }\n\n    @keyframes slideFromLeft{\n      from{opacity:0;transform:translateX(-140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes slideFromRight{\n      from{opacity:0;transform:translateX(140px)}\n      to{opacity:1;transform:translateX(0)}\n    }\n    @keyframes goldShimmer{\n      0%{background-position:220% center}\n      100%{background-position:-60% center}\n    }\n    @keyframes revealHide{\n      0%{opacity:1;transform:translateX(0)}\n      58%{opacity:1;transform:translateX(0)}\n      70%{opacity:0;transform:translateX(110px)}\n      71%{opacity:0;transform:translateX(-110px)}\n      84%{opacity:1;transform:translateX(0)}\n      100%{opacity:1;transform:translateX(0)}\n    }\n    @keyframes dividerExpand{\n      from{width:0;opacity:0}\n      to{width:clamp(100px,20vw,300px);opacity:1}\n    }\n    @keyframes dividerHide{\n      0%,57%{opacity:1}\n      69%{opacity:0}\n      83%{opacity:1}\n      100%{opacity:1}\n    }\n    @keyframes flareSweep{\n      0%{left:-65%;opacity:0}\n      8%{opacity:1}\n      58%{left:120%;opacity:0}\n      100%{left:120%;opacity:0}\n    }\n  </style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n  <div class=\"stage\">\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"goatbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <div class=\"line-clip\">\n        <span class=\"church-text line1\">நல்ல சமாரியன் இயேசு</span>\n        <div class=\"flare\"></div>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div class=\"line-clip\">\n        <span class=\"church-text line2\">ஜெப வீடு</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
    },
    {
      "id": 1774107161738.447,
      "type": "html",
      "name": "Testimony",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>சாட்சி நேரம் – Testimony Time</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+Tamil:ital,wght@0,400;0,600;0,700;1,400&display=swap');\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    background: #0d0c18;\n    font-family: 'Noto Serif Tamil', serif;\n    overflow: hidden;\n  }\n\n  /* ─── SLIDE CANVAS ─── */\n  .slide {\n    position: fixed;\n    inset: 0;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* ─── HEAVEN SKY BACKGROUND ─── */\n  .sky {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 100% 80% at 50% 0%,\n      #e8dfc8 0%, #c4a96d 20%, #8a6f3e 40%,\n      #4a3520 60%, #1e1510 80%, #0d0c18 100%);\n  }\n\n  .clouds-layer {\n    position: absolute; inset: 0;\n    background-image:\n      radial-gradient(ellipse 300px 60px at 20% 15%, rgba(255,248,235,0.18) 0%, transparent 100%),\n      radial-gradient(ellipse 200px 40px at 70% 10%, rgba(255,248,235,0.12) 0%, transparent 100%),\n      radial-gradient(ellipse 400px 80px at 50% 20%, rgba(255,245,225,0.08) 0%, transparent 100%),\n      radial-gradient(ellipse 150px 35px at 85% 18%, rgba(255,248,235,0.10) 0%, transparent 100%);\n    animation: cloudDrift 20s ease-in-out infinite alternate;\n  }\n  @keyframes cloudDrift {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(18px); }\n  }\n\n  .light-beam {\n    position: absolute;\n    top: 0; left: 50%; transform: translateX(-50%);\n    width: min(92vw, 900px);\n    height: 100%;\n    background: conic-gradient(\n      from 270deg at 50% 0%,\n      transparent 0deg,\n      rgba(255,245,200,0.04) 8deg,\n      rgba(255,245,200,0.09) 12deg,\n      rgba(255,245,200,0.04) 16deg,\n      transparent 24deg,\n      rgba(255,245,200,0.06) 30deg,\n      rgba(255,245,200,0.10) 34deg,\n      rgba(255,245,200,0.06) 38deg,\n      transparent 46deg,\n      rgba(255,245,200,0.04) 52deg,\n      rgba(255,245,200,0.08) 56deg,\n      rgba(255,245,200,0.04) 60deg,\n      transparent 68deg\n    );\n    animation: beamPulse 5s ease-in-out infinite;\n  }\n  @keyframes beamPulse {\n    0%, 100% { opacity: 0.7; }\n    50% { opacity: 1; }\n  }\n\n  .vignette-bottom {\n    position: absolute;\n    bottom: 0; left: 0; right: 0; height: 55%;\n    background: linear-gradient(0deg, rgba(13,12,24,0.97) 0%, rgba(13,12,24,0.6) 55%, transparent 100%);\n  }\n  .vignette-sides {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 80% 100% at 50% 50%, transparent 55%, rgba(13,12,24,0.7) 100%);\n  }\n\n  .motes { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }\n  .mote {\n    position: absolute;\n    border-radius: 50%;\n    background: rgba(255, 245, 200, 0.85);\n    animation: moteFloat linear infinite;\n  }\n  @keyframes moteFloat {\n    0%   { opacity: 0; transform: translateY(0) scale(0.5); }\n    15%  { opacity: 1; }\n    85%  { opacity: 0.6; }\n    100% { opacity: 0; transform: translateY(-90vh) scale(1.5); }\n  }\n\n  .content {\n    position: relative; z-index: 10;\n    display: flex; flex-direction: column;\n    align-items: center; gap: 0;\n    width: 100%;\n    padding: 0 12px; /* reduced from 40px */\n    margin-top: 14vh;\n  }\n\n  .church-label {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(9px, 1.1vw, 13px);\n    letter-spacing: 4px;\n    color: rgba(212, 178, 100, 0.75);\n    text-transform: uppercase;\n    margin-bottom: 14px;\n    animation: fadeIn 1.5s ease forwards;\n    text-align: center;\n  }\n\n  .divider {\n    width: 180px; height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.5), transparent);\n    margin-bottom: 28px;\n    animation: fadeIn 1.8s ease forwards;\n  }\n\n  .title-ta {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(42px, 8vw, 96px);\n    font-weight: 700;\n    color: #ffffff;\n    text-align: center;\n    line-height: 1.15;\n    letter-spacing: 3px;\n    text-shadow:\n      0 0 30px rgba(212,178,100,0.55),\n      0 0 70px rgba(212,178,100,0.2),\n      0 6px 40px rgba(0,0,0,0.9);\n    animation: titleReveal 1.2s ease forwards;\n    margin-bottom: 12px;\n    display:flex;align-items:center;justify-content:center;gap:24px;\n    flex-wrap: wrap;\n  }\n\n  @keyframes titleReveal {\n    from { opacity:0; transform: translateY(24px); }\n    to   { opacity:1; transform: translateY(0); }\n  }\n\n  .title-en {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(14px, 2.4vw, 26px);\n    color: rgba(212, 178, 100, 0.9);\n    letter-spacing: 6px;\n    text-transform: uppercase;\n    text-shadow: 0 0 20px rgba(212,178,100,0.4);\n    animation: fadeIn 1.6s ease forwards;\n    margin-bottom: 28px;\n    text-align: center;\n  }\n\n  .divider-bottom {\n    display: flex; align-items: center; gap: 14px;\n    margin-bottom: 22px;\n    animation: fadeIn 2s ease forwards;\n  }\n  .dl { width: 80px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,178,100,0.45)); }\n  .dr { width: 80px; height: 1px; background: linear-gradient(90deg, rgba(212,178,100,0.45), transparent); }\n  .dot {\n    width: 5px; height: 5px; border-radius: 50%;\n    background: rgba(212,178,100,0.85);\n    box-shadow: 0 0 8px rgba(212,178,100,0.6);\n  }\n\n  .scripture {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(11px, 1.4vw, 15px);\n    font-style: italic;\n    color: rgba(212,178,100,0.55);\n    letter-spacing: 1px;\n    text-align: center;\n    animation: fadeIn 2.2s ease forwards;\n    max-width: 95vw;\n  }\n\n  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }\n</style>\n</head>\n<body>\n<div class=\"slide\">\n\n  <div class=\"sky\"></div>\n  <div class=\"clouds-layer\"></div>\n  <div class=\"light-beam\"></div>\n\n  <svg style=\"position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:900px;height:auto;z-index:2;opacity:0.22;pointer-events:none\"\n       viewBox=\"0 0 900 420\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <linearGradient id=\"wg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n      <linearGradient id=\"wg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n    </defs>\n\n    <g transform=\"translate(450,30) scale(-1,1)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.55\"/>\n    </g>\n\n    <g transform=\"translate(450,30)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.55\"/>\n    </g>\n\n    <ellipse cx=\"450\" cy=\"30\" rx=\"55\" ry=\"22\" fill=\"#fff8d0\" opacity=\"0.18\"/>\n    <ellipse cx=\"450\" cy=\"30\" rx=\"40\" ry=\"15\" fill=\"#fff8d0\" opacity=\"0.22\"/>\n    <circle cx=\"450\" cy=\"30\" r=\"10\" fill=\"#fffae0\" opacity=\"0.35\"/>\n  </svg>\n\n  <svg style=\"position:absolute;top:22%;left:50%;transform:translate(-50%,-50%);width:80px;z-index:5;opacity:0;animation:doveAppear 2s 0.5s ease forwards;pointer-events:none\"\n       viewBox=\"0 0 80 55\" xmlns=\"http://www.w3.org/2000/svg\">\n    <style>@keyframes doveAppear{from{opacity:0;transform:translate(-50%,-58%)}to{opacity:0.85;transform:translate(-50%,-50%)}}</style>\n    <ellipse cx=\"38\" cy=\"30\" rx=\"18\" ry=\"10\" fill=\"#fffcf0\"/>\n    <circle cx=\"54\" cy=\"23\" r=\"7\" fill=\"#fffcf0\"/>\n    <path d=\"M60,22 L67,21 L60,24Z\" fill=\"#e8c870\"/>\n    <path d=\"M30,28 Q15,14 8,20 Q18,22 26,30Z\" fill=\"#fff8e0\" opacity=\"0.95\"/>\n    <path d=\"M32,26 Q20,8 10,12 Q22,18 28,28Z\" fill=\"#fff8e0\" opacity=\"0.75\"/>\n    <path d=\"M20,32 Q10,38 6,36 Q14,33 20,30Z\" fill=\"#fffcf0\"/>\n    <circle cx=\"57\" cy=\"22\" r=\"2\" fill=\"#2a1a08\"/>\n    <circle cx=\"57.7\" cy=\"21.3\" r=\"0.7\" fill=\"#fff\"/>\n  </svg>\n\n  <div class=\"vignette-bottom\"></div>\n  <div class=\"vignette-sides\"></div>\n\n  <div class=\"motes\" id=\"motes\"></div>\n\n  <div class=\"content\">\n    <div class=\"church-label\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n    <div class=\"divider\"></div>\n\n    <div class=\"title-ta\">\n      <span>சாட்சி</span>\n      <svg width=\"52\" height=\"70\" viewBox=\"0 0 60 80\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0;opacity:0.92;filter:drop-shadow(0 0 10px rgba(212,168,67,0.5))\">\n        <defs>\n          <linearGradient id=\"mg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#fff5d0\"/>\n            <stop offset=\"100%\" stop-color=\"#d4a843\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"18\" y=\"4\" width=\"24\" height=\"38\" rx=\"12\" fill=\"url(#mg2)\" stroke=\"rgba(212,168,67,0.5)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"18\" x2=\"42\" y2=\"18\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"25\" x2=\"42\" y2=\"25\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"32\" x2=\"42\" y2=\"32\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <path d=\"M12,38 Q10,52 30,52 Q50,52 48,38\" fill=\"none\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <line x1=\"30\" y1=\"52\" x2=\"30\" y2=\"68\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <rect x=\"14\" y=\"67\" width=\"32\" height=\"5\" rx=\"2.5\" fill=\"url(#mg2)\"/>\n      </svg>\n      <span>நேரம்</span>\n    </div>\n\n    <div class=\"title-en\">Testimony Time</div>\n\n    <div class=\"divider-bottom\">\n      <div class=\"dl\"></div>\n      <div class=\"dot\"></div>\n      <div class=\"dr\"></div>\n    </div>\n\n    <div class=\"scripture\">\n      \"உங்கள் வாயால் சொல்லுங்கள், கர்த்தர் என்னை இரட்சித்தார்\" — ஏசாயா 38:20\n    </div>\n  </div>\n</div>\n\n<script>\n  const container = document.getElementById('motes');\n  for (let i = 0; i < 50; i++) {\n    const m = document.createElement('div');\n    m.classList.add('mote');\n    const size = 1 + Math.random() * 3;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.bottom = (Math.random() * 30) + '%';\n    m.style.animationDuration = (8 + Math.random() * 14) + 's';\n    m.style.animationDelay = (Math.random() * 10) + 's';\n    m.style.opacity = 0;\n    container.appendChild(m);\n  }\n</script>\n</body>\n</html>",
      "bookmarked": false,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>சாட்சி நேரம் – Testimony Time</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+Tamil:ital,wght@0,400;0,600;0,700;1,400&display=swap');\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    background: #0d0c18;\n    font-family: 'Noto Serif Tamil', serif;\n    overflow: hidden;\n  }\n\n  /* ─── SLIDE CANVAS ─── */\n  .slide {\n    position: fixed;\n    inset: 0;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* ─── HEAVEN SKY BACKGROUND ─── */\n  .sky {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 100% 80% at 50% 0%,\n      #e8dfc8 0%, #c4a96d 20%, #8a6f3e 40%,\n      #4a3520 60%, #1e1510 80%, #0d0c18 100%);\n  }\n\n  .clouds-layer {\n    position: absolute; inset: 0;\n    background-image:\n      radial-gradient(ellipse 300px 60px at 20% 15%, rgba(255,248,235,0.18) 0%, transparent 100%),\n      radial-gradient(ellipse 200px 40px at 70% 10%, rgba(255,248,235,0.12) 0%, transparent 100%),\n      radial-gradient(ellipse 400px 80px at 50% 20%, rgba(255,245,225,0.08) 0%, transparent 100%),\n      radial-gradient(ellipse 150px 35px at 85% 18%, rgba(255,248,235,0.10) 0%, transparent 100%);\n    animation: cloudDrift 20s ease-in-out infinite alternate;\n  }\n  @keyframes cloudDrift {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(18px); }\n  }\n\n  .light-beam {\n    position: absolute;\n    top: 0; left: 50%; transform: translateX(-50%);\n    width: min(92vw, 900px);\n    height: 100%;\n    background: conic-gradient(\n      from 270deg at 50% 0%,\n      transparent 0deg,\n      rgba(255,245,200,0.04) 8deg,\n      rgba(255,245,200,0.09) 12deg,\n      rgba(255,245,200,0.04) 16deg,\n      transparent 24deg,\n      rgba(255,245,200,0.06) 30deg,\n      rgba(255,245,200,0.10) 34deg,\n      rgba(255,245,200,0.06) 38deg,\n      transparent 46deg,\n      rgba(255,245,200,0.04) 52deg,\n      rgba(255,245,200,0.08) 56deg,\n      rgba(255,245,200,0.04) 60deg,\n      transparent 68deg\n    );\n    animation: beamPulse 5s ease-in-out infinite;\n  }\n  @keyframes beamPulse {\n    0%, 100% { opacity: 0.7; }\n    50% { opacity: 1; }\n  }\n\n  .vignette-bottom {\n    position: absolute;\n    bottom: 0; left: 0; right: 0; height: 55%;\n    background: linear-gradient(0deg, rgba(13,12,24,0.97) 0%, rgba(13,12,24,0.6) 55%, transparent 100%);\n  }\n  .vignette-sides {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 80% 100% at 50% 50%, transparent 55%, rgba(13,12,24,0.7) 100%);\n  }\n\n  .motes { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }\n  .mote {\n    position: absolute;\n    border-radius: 50%;\n    background: rgba(255, 245, 200, 0.85);\n    animation: moteFloat linear infinite;\n  }\n  @keyframes moteFloat {\n    0%   { opacity: 0; transform: translateY(0) scale(0.5); }\n    15%  { opacity: 1; }\n    85%  { opacity: 0.6; }\n    100% { opacity: 0; transform: translateY(-90vh) scale(1.5); }\n  }\n\n  .content {\n    position: relative; z-index: 10;\n    display: flex; flex-direction: column;\n    align-items: center; gap: 0;\n    width: 100%;\n    padding: 0 12px; /* reduced from 40px */\n    margin-top: 14vh;\n  }\n\n  .church-label {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(9px, 1.1vw, 13px);\n    letter-spacing: 4px;\n    color: rgba(212, 178, 100, 0.75);\n    text-transform: uppercase;\n    margin-bottom: 14px;\n    animation: fadeIn 1.5s ease forwards;\n    text-align: center;\n  }\n\n  .divider {\n    width: 180px; height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.5), transparent);\n    margin-bottom: 28px;\n    animation: fadeIn 1.8s ease forwards;\n  }\n\n  .title-ta {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(42px, 8vw, 96px);\n    font-weight: 700;\n    color: #ffffff;\n    text-align: center;\n    line-height: 1.15;\n    letter-spacing: 3px;\n    text-shadow:\n      0 0 30px rgba(212,178,100,0.55),\n      0 0 70px rgba(212,178,100,0.2),\n      0 6px 40px rgba(0,0,0,0.9);\n    animation: titleReveal 1.2s ease forwards;\n    margin-bottom: 12px;\n    display:flex;align-items:center;justify-content:center;gap:24px;\n    flex-wrap: wrap;\n  }\n\n  @keyframes titleReveal {\n    from { opacity:0; transform: translateY(24px); }\n    to   { opacity:1; transform: translateY(0); }\n  }\n\n  .title-en {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(14px, 2.4vw, 26px);\n    color: rgba(212, 178, 100, 0.9);\n    letter-spacing: 6px;\n    text-transform: uppercase;\n    text-shadow: 0 0 20px rgba(212,178,100,0.4);\n    animation: fadeIn 1.6s ease forwards;\n    margin-bottom: 28px;\n    text-align: center;\n  }\n\n  .divider-bottom {\n    display: flex; align-items: center; gap: 14px;\n    margin-bottom: 22px;\n    animation: fadeIn 2s ease forwards;\n  }\n  .dl { width: 80px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,178,100,0.45)); }\n  .dr { width: 80px; height: 1px; background: linear-gradient(90deg, rgba(212,178,100,0.45), transparent); }\n  .dot {\n    width: 5px; height: 5px; border-radius: 50%;\n    background: rgba(212,178,100,0.85);\n    box-shadow: 0 0 8px rgba(212,178,100,0.6);\n  }\n\n  .scripture {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(11px, 1.4vw, 15px);\n    font-style: italic;\n    color: rgba(212,178,100,0.55);\n    letter-spacing: 1px;\n    text-align: center;\n    animation: fadeIn 2.2s ease forwards;\n    max-width: 95vw;\n  }\n\n  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"slide\">\n\n  <div class=\"sky\"></div>\n  <div class=\"clouds-layer\"></div>\n  <div class=\"light-beam\"></div>\n\n  <svg style=\"position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:900px;height:auto;z-index:2;opacity:0.22;pointer-events:none\"\n       viewBox=\"0 0 900 420\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <linearGradient id=\"wg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n      <linearGradient id=\"wg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n    </defs>\n\n    <g transform=\"translate(450,30) scale(-1,1)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.55\"/>\n    </g>\n\n    <g transform=\"translate(450,30)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.55\"/>\n    </g>\n\n    <ellipse cx=\"450\" cy=\"30\" rx=\"55\" ry=\"22\" fill=\"#fff8d0\" opacity=\"0.18\"/>\n    <ellipse cx=\"450\" cy=\"30\" rx=\"40\" ry=\"15\" fill=\"#fff8d0\" opacity=\"0.22\"/>\n    <circle cx=\"450\" cy=\"30\" r=\"10\" fill=\"#fffae0\" opacity=\"0.35\"/>\n  </svg>\n\n  <svg style=\"position:absolute;top:22%;left:50%;transform:translate(-50%,-50%);width:80px;z-index:5;opacity:0;animation:doveAppear 2s 0.5s ease forwards;pointer-events:none\"\n       viewBox=\"0 0 80 55\" xmlns=\"http://www.w3.org/2000/svg\">\n    <style>@keyframes doveAppear{from{opacity:0;transform:translate(-50%,-58%)}to{opacity:0.85;transform:translate(-50%,-50%)}}</style>\n    <ellipse cx=\"38\" cy=\"30\" rx=\"18\" ry=\"10\" fill=\"#fffcf0\"/>\n    <circle cx=\"54\" cy=\"23\" r=\"7\" fill=\"#fffcf0\"/>\n    <path d=\"M60,22 L67,21 L60,24Z\" fill=\"#e8c870\"/>\n    <path d=\"M30,28 Q15,14 8,20 Q18,22 26,30Z\" fill=\"#fff8e0\" opacity=\"0.95\"/>\n    <path d=\"M32,26 Q20,8 10,12 Q22,18 28,28Z\" fill=\"#fff8e0\" opacity=\"0.75\"/>\n    <path d=\"M20,32 Q10,38 6,36 Q14,33 20,30Z\" fill=\"#fffcf0\"/>\n    <circle cx=\"57\" cy=\"22\" r=\"2\" fill=\"#2a1a08\"/>\n    <circle cx=\"57.7\" cy=\"21.3\" r=\"0.7\" fill=\"#fff\"/>\n  </svg>\n\n  <div class=\"vignette-bottom\"></div>\n  <div class=\"vignette-sides\"></div>\n\n  <div class=\"motes\" id=\"motes\"></div>\n\n  <div class=\"content\">\n    <div class=\"church-label\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n    <div class=\"divider\"></div>\n\n    <div class=\"title-ta\">\n      <span>சாட்சி</span>\n      <svg width=\"52\" height=\"70\" viewBox=\"0 0 60 80\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0;opacity:0.92;filter:drop-shadow(0 0 10px rgba(212,168,67,0.5))\">\n        <defs>\n          <linearGradient id=\"mg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#fff5d0\"/>\n            <stop offset=\"100%\" stop-color=\"#d4a843\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"18\" y=\"4\" width=\"24\" height=\"38\" rx=\"12\" fill=\"url(#mg2)\" stroke=\"rgba(212,168,67,0.5)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"18\" x2=\"42\" y2=\"18\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"25\" x2=\"42\" y2=\"25\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"32\" x2=\"42\" y2=\"32\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <path d=\"M12,38 Q10,52 30,52 Q50,52 48,38\" fill=\"none\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <line x1=\"30\" y1=\"52\" x2=\"30\" y2=\"68\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <rect x=\"14\" y=\"67\" width=\"32\" height=\"5\" rx=\"2.5\" fill=\"url(#mg2)\"/>\n      </svg>\n      <span>நேரம்</span>\n    </div>\n\n    <div class=\"title-en\">Testimony Time</div>\n\n    <div class=\"divider-bottom\">\n      <div class=\"dl\"></div>\n      <div class=\"dot\"></div>\n      <div class=\"dr\"></div>\n    </div>\n\n    <div class=\"scripture\">\n      \"உங்கள் வாயால் சொல்லுங்கள், கர்த்தர் என்னை இரட்சித்தார்\" — ஏசாயா 38:20\n    </div>\n  </div>\n</div>\n\n<script>\n  const container = document.getElementById('motes');\n  for (let i = 0; i < 50; i++) {\n    const m = document.createElement('div');\n    m.classList.add('mote');\n    const size = 1 + Math.random() * 3;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.bottom = (Math.random() * 30) + '%';\n    m.style.animationDuration = (8 + Math.random() * 14) + 's';\n    m.style.animationDelay = (Math.random() * 10) + 's';\n    m.style.opacity = 0;\n    container.appendChild(m);\n  }\n</script>\n</body>\n</html>"
    },
    {
      "id": 1774106242517.191,
      "type": "html",
      "name": "Information",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>அறிவிப்பு - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── SKY GRADIENT — deep royal blue to golden dawn (announcement feel) ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      170deg,\n      #05102a 0%,\n      #0e2257 12%,\n      #1a4a8a 26%,\n      #2e6db4 40%,\n      #5299d3 54%,\n      #8ac4e8 68%,\n      #c9e8f7 82%,\n      #f0f8ff 92%,\n      #ffffff 100%\n    );\n    z-index:0;\n  }\n\n  /* ── MEGAPHONE / BELL GLOW ── */\n  .bell-glow{\n    position:absolute;\n    top:-10vh;\n    left:50%;\n    transform:translateX(-50%);\n    width:55vw;height:55vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(180,220,255,0.55) 0%,\n      rgba(100,170,255,0.3) 30%,\n      rgba(50,120,220,0.1) 60%,\n      transparent 100%\n    );\n    z-index:1;\n    animation:bellPulse 3.5s ease-in-out infinite;\n  }\n  @keyframes bellPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.8}\n    50%{transform:translateX(-50%) scale(1.08);opacity:1}\n  }\n\n  /* ── CANVASES ── */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.stars{position:absolute;inset:0;z-index:3;pointer-events:none}\n  canvas.bells{position:absolute;inset:0;z-index:5;pointer-events:none}\n\n  /* ── MIST ── */\n  .mist{\n    position:absolute;\n    bottom:0;left:0;right:0;\n    height:28vh;\n    background:linear-gradient(to top,\n      rgba(240,248,255,0.65) 0%,\n      rgba(200,230,255,0.25) 50%,\n      transparent 100%\n    );\n    z-index:4;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,255,255,0.14);\n    backdrop-filter:blur(20px);\n    -webkit-backdrop-filter:blur(20px);\n    border:1px solid rgba(255,255,255,0.4);\n    border-radius:26px;\n    padding:clamp(22px,3.8vh,48px) clamp(30px,5.5vw,85px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(20,60,140,0.3),\n      0 2px 20px rgba(100,180,255,0.2),\n      inset 0 1px 0 rgba(255,255,255,0.55);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:hidden;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,255,0.2) 0%,\n      rgba(150,210,255,0.08) 50%,\n      rgba(255,255,255,0.05) 100%\n    );\n    border-radius:26px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(30px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── ICON ROW ── */\n  .icon-row{\n    display:flex;align-items:center;gap:1.3vw;\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .icon-emoji{\n    font-size:clamp(22px,3.2vw,46px);\n    animation:iconBounce 2.8s ease-in-out infinite;\n    filter:drop-shadow(0 2px 8px rgba(30,80,200,.4));\n  }\n  .icon-emoji:nth-child(1){animation-delay:0s}\n  .icon-emoji:nth-child(2){animation-delay:.35s}\n  .icon-emoji:nth-child(3){animation-delay:.7s}\n  @keyframes iconBounce{\n    0%,100%{transform:translateY(0) rotate(-4deg)}\n    50%{transform:translateY(-9px) rotate(4deg)}\n  }\n\n  /* ── TOP SCRIPT ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.25vw,16px);\n    letter-spacing:8px;\n    text-transform:uppercase;\n    color:rgba(20,60,140,0.7);\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(40,100,220,.45),transparent);\n  }\n  .div-icon{font-size:clamp(10px,1.3vw,17px);color:rgba(40,100,200,.65)}\n\n  /* ── MAIN WORD ── */\n  .main-word{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(52px,9vw,140px);\n    font-weight:900;\n    line-height:1.15;\n    letter-spacing:6px;\n    padding-top:0.1em;\n    background:linear-gradient(\n      155deg,\n      #0a2a6e 0%,\n      #1a4fbb 18%,\n      #2e8de8 34%,\n      #56c2f5 50%,\n      #1a6fcc 66%,\n      #0d3590 82%,\n      #1a4fbb 100%\n    );\n    background-size:260% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 22px rgba(30,90,220,.35));\n    opacity:0;\n    animation:wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              wordFlow 5s ease-in-out infinite 2.5s;\n    margin-bottom:.4vh;\n  }\n  @keyframes wordReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(15px) drop-shadow(0 4px 22px rgba(30,90,220,.35))}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 22px rgba(30,90,220,.35))}\n  }\n  @keyframes wordFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(13px,2vw,28px);\n    font-weight:700;\n    color:rgba(15,45,120,0.85);\n    letter-spacing:4px;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(100,180,255,.4);\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(180,220,255,0.2);\n    border:1px solid rgba(60,130,220,.3);\n    border-radius:14px;\n    padding:clamp(10px,1.4vh,17px) clamp(16px,2.8vw,38px);\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:70vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(11px,1.4vw,19px);\n    color:rgba(10,35,100,0.9);\n    line-height:1.85;\n    letter-spacing:1px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.05vw,14px);\n    color:rgba(30,80,180,.65);\n    letter-spacing:3px;\n    margin-top:.5vh;\n  }\n\n  /* ── CHURCH BADGE ── */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-12deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n  .church-bg{\n    position:absolute;\n    inset:3px;\n    border-radius:46px;\n    background:rgba(5,12,40,0.9);\n    z-index:1;\n  }\n  .church{\n    position:relative;\n    z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.4vw,19px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.4vw,34px);\n    white-space:nowrap;\n    background:linear-gradient(\n      90deg,\n      #7ee8ff 0%,\n      #ffdd57 18%,\n      #72f5a8 36%,\n      #a259ff 54%,\n      #7ee8ff 72%,\n      #ffdd57 90%,\n      #72f5a8 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:rainbowShift 3s linear infinite;\n    filter:drop-shadow(0 0 6px rgba(100,220,255,.7))\n           drop-shadow(0 0 14px rgba(162,89,255,.5));\n  }\n  @keyframes rainbowShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* sparkles */\n  .church-sparks{position:absolute;inset:0;border-radius:50px;z-index:3;pointer-events:none;overflow:visible}\n  .spark{position:absolute;border-radius:50%;top:50%;left:50%;transform-origin:0 0;width:clamp(4px,.55vw,8px);height:clamp(4px,.55vw,8px)}\n  .spark:nth-child(1){background:#7ee8ff;animation:orbitSpark 2.4s linear infinite 0s}\n  .spark:nth-child(2){background:#ffdd57;animation:orbitSpark 2.4s linear infinite .4s}\n  .spark:nth-child(3){background:#72f5a8;animation:orbitSpark 2.4s linear infinite .8s}\n  .spark:nth-child(4){background:#a259ff;animation:orbitSpark 2.4s linear infinite 1.2s}\n  .spark:nth-child(5){background:#ff6ec7;animation:orbitSpark 2.4s linear infinite 1.6s}\n  .spark:nth-child(6){background:#ffbe00;animation:orbitSpark 2.4s linear infinite 2.0s}\n  @keyframes orbitSpark{\n    0%  {transform:rotate(0deg)   translateX(clamp(22px,3.4vw,46px)) scale(1)}\n    50% {transform:rotate(180deg) translateX(clamp(22px,3.4vw,46px)) scale(1.5)}\n    100%{transform:rotate(360deg) translateX(clamp(22px,3.4vw,46px)) scale(1)}\n  }\n\n  /* ── BOTTOM DECORATION ── */\n  .deco-row{\n    position:absolute;\n    bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;\n    gap:.45vw;overflow:hidden;\n    z-index:11;pointer-events:none;\n  }\n  .deco-item{\n    font-size:clamp(15px,2.3vw,34px);\n    opacity:.5;\n    animation:decoSway 3.2s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .deco-item:nth-child(2n){animation-delay:.5s}\n  .deco-item:nth-child(3n){animation-delay:1s}\n  .deco-item:nth-child(4n){animation-delay:1.5s}\n  @keyframes decoSway{\n    0%,100%{transform:rotate(-6deg)}\n    50%{transform:rotate(6deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(18px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n  <div class=\"bell-glow\"></div>\n\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"stars\" id=\"cStars\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"bells\" id=\"cBells\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <!-- Icon row: megaphone / bell / cross -->\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">📣</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">🔔</span>\n      </div>\n\n      <div class=\"script-top\">கவனியுங்கள் • Please Note</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">📢</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <!-- BIG WORD -->\n      <div class=\"main-word\">அறிவிப்பு</div>\n      <div class=\"subtitle\">Announcement · Information</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\">\n          ❝ உங்கள் கோரிக்கைகளை தேவனுக்கு தெரிவியுங்கள் ❞\n        </div>\n        <div class=\"verse-ref\">— பிலிப்பியர் 4:6</div>\n      </div>\n\n      <!-- CHURCH BADGE -->\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- bottom deco -->\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span>\n  </div>\n\n</div>\n\n<script>\n/* ── LIGHT RAYS (blue tone) ── */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const RAYS=Array.from({length:20},(_,i)=>({\n    angle:(i/20)*Math.PI-Math.PI/2+(Math.random()-.5)*.3,\n    width:2+Math.random()*5,\n    alpha:.035+Math.random()*.07,\n    speed:(.002+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length:.55+Math.random()*.55\n  }));\n  const OX=W*.5,OY=H*-.05;\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.04)*W*r.length+OX;\n      const by=Math.sin(r.angle+.04)*W*r.length+OY;\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(150,210,255,${r.alpha*2})`);\n      g.addColorStop(.4,`rgba(100,180,255,${r.alpha})`);\n      g.addColorStop(1,'rgba(100,180,255,0)');\n      cx.beginPath();cx.moveTo(OX,OY);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── TWINKLING STARS ── */\n(function(){\n  const cv=document.getElementById('cStars');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const STARS=Array.from({length:55},()=>({\n    x:Math.random(),y:Math.random()*.55,\n    r:Math.random()*2.2+.5,\n    phase:Math.random()*Math.PI*2,\n    speed:Math.random()*.025+.012\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    STARS.forEach(s=>{\n      const alpha=.3+.7*(.5+.5*Math.sin(t*s.speed+s.phase));\n      cx.save();\n      cx.globalAlpha=alpha;\n      cx.fillStyle='rgba(200,230,255,1)';\n      cx.shadowColor='rgba(150,210,255,.9)';\n      cx.shadowBlur=s.r*4;\n      cx.beginPath();cx.arc(s.x*W,s.y*H,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING BELL RINGS ── */\n(function(){\n  const cv=document.getElementById('cBells');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  class Ring{\n    constructor(){this.reset(true);}\n    reset(rand){\n      this.x=(0.25+Math.random()*.5)*W;\n      this.y=rand?(Math.random()*H):(H+30);\n      this.vy=-(Math.random()*.6+.25);\n      this.r=Math.random()*18+8;\n      this.maxR=this.r*5;\n      this.alpha=Math.random()*.4+.2;\n      this.growing=true;\n    }\n    update(){\n      this.y+=this.vy;\n      this.r+=.4;\n      this.alpha-=.004;\n      if(this.alpha<=0||this.y<-50)this.reset(false);\n    }\n    draw(cx){\n      cx.save();\n      cx.globalAlpha=Math.max(0,this.alpha);\n      cx.strokeStyle='rgba(100,180,255,0.7)';\n      cx.lineWidth=1.5;\n      cx.shadowColor='rgba(100,200,255,0.5)';\n      cx.shadowBlur=6;\n      cx.beginPath();cx.arc(this.x,this.y,this.r,0,Math.PI*2);cx.stroke();\n      cx.restore();\n    }\n  }\n\n  const rings=Array.from({length:12},()=>new Ring());\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%40===0&&rings.length<18)rings.push(new Ring());\n    rings.forEach(r=>{r.update();r.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
