      "name": "சங்கீதம் 20:9",
      "html": "<!DOCTYPE html><html lang=\"ta\"><head><meta charset=\"UTF-8\">\n<style>\n@font-face{font-family:'Noto Serif Tamil';src:local('Noto Serif Tamil'),local('Nirmala UI'),local('Vijaya'),local('Latha'),local('Tamil Sangam MN');font-weight:400 900;}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{width:100%;height:100%;overflow:hidden;}\nbody{background:linear-gradient(180deg,#020510 0%,#0a1628 40%,#162a50 70%,#1b3a5c 100%);display:flex;align-items:center;justify-content:center;font-family:'Noto Serif Tamil',serif;padding:1.2vw;position:relative;}\n.sky{position:absolute;inset:0;z-index:0;}\n.verse-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;gap:0.6vh;overflow:hidden;position:relative;z-index:5;}\n.verse-text{font-weight:900;color:#ffffff;text-align:center;line-height:1.22;word-break:break-word;width:100%;white-space:pre-wrap;text-shadow:0 2px 10px rgba(0,0,0,0.8);}\n.verse-ref{color:#ffffff;opacity:0.9;font-style:italic;letter-spacing:2px;text-align:right;align-self:flex-end;padding-right:1vw;font-weight:900;text-shadow:0 2px 6px rgba(0,0,0,0.6);}\n</style></head><body>\n<div class=\"sky\"></div>\n<div class=\"verse-wrap\" id=\"vwrap\">\n  <div class=\"verse-text\" id=\"vtext\">கர்த்தாவே, இரட்சியும்; நாங்கள் கூப்பிடுகிற நாளிலே ராஜா எங்களுக்குச் செவிகொடுப்பாராக.</div>\n  <div class=\"verse-ref\" id=\"vref\">— சங்கீதம் 20:9</div>\n</div>\n<script>\nvar MAX_FONT = 130;\nfunction autoFit() {\n  var wrap = document.getElementById('vwrap');\n  var vt   = document.getElementById('vtext');\n  var vr   = document.getElementById('vref');\n  if (!wrap || !vt) return;\n  var availW = wrap.clientWidth;\n  var availH = wrap.clientHeight;\n  if (availH < 10 || availW < 10) { setTimeout(autoFit, 100); return; }\n  vt.style.width = '100%';\n  var lo = 8, hi = Math.min(availH, MAX_FONT);\n  for (var i = 0; i < 30; i++) {\n    var mid = (lo + hi) / 2;\n    vt.style.fontSize = mid + 'px';\n    if (vr) vr.style.fontSize = (mid * 0.32) + 'px';\n    var needed = vt.scrollHeight + (vr ? vr.offsetHeight + mid * 0.2 : 0);\n    if (needed > availH || vt.scrollWidth > vt.clientWidth + 1) {\n      hi = mid;\n    } else {\n      lo = mid;\n    }\n  }\n  vt.style.fontSize = lo + 'px';\n  if (vr) vr.style.fontSize = (lo * 0.32) + 'px';\n}\ndocument.fonts ? document.fonts.ready.then(autoFit) : window.addEventListener('load', autoFit);\nwindow.addEventListener('resize', autoFit);\n</script>\n</body></html>",
      "_thumbHtml": "<!DOCTYPE html><html lang=\"ta\"><head><meta charset=\"UTF-8\">\n<style>\n@font-face{font-family:'Noto Serif Tamil';src:local('Noto Serif Tamil'),local('Nirmala UI'),local('Vijaya'),local('Latha'),local('Tamil Sangam MN');font-weight:400 900;}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{width:100%;height:100%;overflow:hidden;}\nbody{background:linear-gradient(180deg,#020510 0%,#0a1628 40%,#162a50 70%,#1b3a5c 100%);display:flex;align-items:center;justify-content:center;font-family:'Noto Serif Tamil',serif;padding:1.2vw;position:relative;}\n.sky{position:absolute;inset:0;z-index:0;}\n.verse-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;gap:0.6vh;overflow:hidden;position:relative;z-index:5;}\n.verse-text{font-weight:900;color:#ffffff;text-align:center;line-height:1.22;word-break:break-word;width:100%;white-space:pre-wrap;text-shadow:0 2px 10px rgba(0,0,0,0.8);}\n.verse-ref{color:#ffffff;opacity:0.9;font-style:italic;letter-spacing:2px;text-align:right;align-self:flex-end;padding-right:1vw;font-weight:900;text-shadow:0 2px 6px rgba(0,0,0,0.6);}\n</style><style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head><body>\n<div class=\"sky\"></div>\n<div class=\"verse-wrap\" id=\"vwrap\">\n  <div class=\"verse-text\" id=\"vtext\">கர்த்தாவே, இரட்சியும்; நாங்கள் கூப்பிடுகிற நாளிலே ராஜா எங்களுக்குச் செவிகொடுப்பாராக.</div>\n  <div class=\"verse-ref\" id=\"vref\">— சங்கீதம் 20:9</div>\n</div>\n<script>\nvar MAX_FONT = 130;\nfunction autoFit() {\n  var wrap = document.getElementById('vwrap');\n  var vt   = document.getElementById('vtext');\n  var vr   = document.getElementById('vref');\n  if (!wrap || !vt) return;\n  var availW = wrap.clientWidth;\n  var availH = wrap.clientHeight;\n  if (availH < 10 || availW < 10) { setTimeout(autoFit, 100); return; }\n  vt.style.width = '100%';\n  var lo = 8, hi = Math.min(availH, MAX_FONT);\n  for (var i = 0; i < 30; i++) {\n    var mid = (lo + hi) / 2;\n    vt.style.fontSize = mid + 'px';\n    if (vr) vr.style.fontSize = (mid * 0.32) + 'px';\n    var needed = vt.scrollHeight + (vr ? vr.offsetHeight + mid * 0.2 : 0);\n    if (needed > availH || vt.scrollWidth > vt.clientWidth + 1) {\n      hi = mid;\n    } else {\n      lo = mid;\n    }\n  }\n  vt.style.fontSize = lo + 'px';\n  if (vr) vr.style.fontSize = (lo * 0.32) + 'px';\n}\ndocument.fonts ? document.fonts.ready.then(autoFit) : window.addEventListener('load', autoFit);\nwindow.addEventListener('resize', autoFit);\n</script>\n</body></html>"
    },
    {
      "id": 1774114726219.4692,
      "type": "html",
      "name": "Thanks",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நன்றி - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── SKY GRADIENT BACKGROUND ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      175deg,\n      #1a0533 0%,\n      #3d1060 12%,\n      #7b2d8b 25%,\n      #c2527a 40%,\n      #e8845a 55%,\n      #f5b973 68%,\n      #fde8b0 80%,\n      #fff8e7 92%,\n      #ffffff 100%\n    );\n    z-index:0;\n  }\n\n  /* ── SUN GLOW ── */\n  .sun-glow{\n    position:absolute;\n    bottom:-15vh;\n    left:50%;\n    transform:translateX(-50%);\n    width:60vw;height:60vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(255,240,180,0.9) 0%,\n      rgba(255,210,100,0.6) 25%,\n      rgba(255,170,60,0.3) 50%,\n      rgba(255,130,30,0.1) 70%,\n      transparent 100%\n    );\n    z-index:1;\n    animation:sunPulse 4s ease-in-out infinite;\n  }\n  @keyframes sunPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.9}\n    50%{transform:translateX(-50%) scale(1.06);opacity:1}\n  }\n\n  /* ── LIGHT RAYS ── */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.petals{position:absolute;inset:0;z-index:4;pointer-events:none}\n  canvas.doves{position:absolute;inset:0;z-index:5;pointer-events:none}\n\n  /* ── HORIZON MIST ── */\n  .mist{\n    position:absolute;\n    bottom:0;left:0;right:0;\n    height:30vh;\n    background:linear-gradient(to top,\n      rgba(255,248,230,0.7) 0%,\n      rgba(255,240,200,0.3) 50%,\n      transparent 100%\n    );\n    z-index:3;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,255,255,0.13);\n    backdrop-filter:blur(18px);\n    -webkit-backdrop-filter:blur(18px);\n    border:1px solid rgba(255,255,255,0.35);\n    border-radius:24px;\n    padding:clamp(24px,4vh,50px) clamp(32px,6vw,90px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(120,40,80,0.25),\n      0 2px 20px rgba(255,160,80,0.2),\n      inset 0 1px 0 rgba(255,255,255,0.5);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:hidden;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,255,0.18) 0%,\n      rgba(255,200,120,0.08) 50%,\n      rgba(255,255,255,0.05) 100%\n    );\n    border-radius:24px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(30px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── DOVE ICON (CSS) ── */\n  .dove-row{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .dove-emoji{\n    font-size:clamp(24px,3.5vw,50px);\n    animation:doveWing 2.5s ease-in-out infinite;\n    filter:drop-shadow(0 2px 8px rgba(180,100,40,.4));\n  }\n  .dove-emoji:nth-child(2){animation-delay:.4s}\n  .dove-emoji:nth-child(3){animation-delay:.8s}\n  @keyframes doveWing{\n    0%,100%{transform:translateY(0) rotate(-3deg)}\n    50%{transform:translateY(-8px) rotate(3deg)}\n  }\n\n  /* ── TOP SCRIPT ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.3vw,17px);\n    letter-spacing:8px;\n    text-transform:uppercase;\n    color:rgba(120,50,20,0.75);\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(180,100,40,.5),transparent);\n  }\n  .div-flower{font-size:clamp(10px,1.4vw,18px);color:rgba(200,80,60,.7)}\n\n  /* ── MAIN THANKS ── */\n  .thanks{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(68px,12vw,180px);\n    font-weight:900;\n    line-height:1;\n    letter-spacing:8px;\n    background:linear-gradient(\n      160deg,\n      #4a1530 0%,\n      #8b2252 18%,\n      #c0392b 34%,\n      #e84393 50%,\n      #8b2252 66%,\n      #4a1530 80%,\n      #8b2252 100%\n    );\n    background-size:250% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 20px rgba(180,40,80,.3));\n    opacity:0;\n    animation:thankReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              thankFlow 5s ease-in-out infinite 2.5s;\n    margin-bottom:.5vh;\n  }\n  @keyframes thankReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(15px) drop-shadow(0 4px 20px rgba(180,40,80,.3))}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 20px rgba(180,40,80,.3))}\n  }\n  @keyframes thankFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(14px,2.2vw,30px);\n    font-weight:700;\n    color:rgba(90,20,40,0.85);\n    letter-spacing:3px;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(255,180,120,.4);\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(255,230,180,0.25);\n    border:1px solid rgba(200,120,60,.3);\n    border-radius:14px;\n    padding:clamp(10px,1.5vh,18px) clamp(16px,3vw,40px);\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:70vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(12px,1.5vw,20px);\n    color:rgba(80,30,20,0.9);\n    line-height:1.8;\n    letter-spacing:1px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.1vw,15px);\n    color:rgba(140,60,30,.7);\n    letter-spacing:3px;\n    margin-top:.5vh;\n  }\n\n  /* ══════════════════════════════════════════\n     ANIME CHURCH NAME — full rework\n  ══════════════════════════════════════════ */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-12deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n\n  /* white backing so text stays clean */\n  .church-bg{\n    position:absolute;\n    inset:3px;\n    border-radius:46px;\n    background:rgba(10,6,30,0.88);\n    z-index:1;\n  }\n\n  /* the actual text */\n  .church{\n    position:relative;\n    z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.45vw,20px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.5vw,36px);\n    white-space:nowrap;\n\n    /* animated rainbow gradient text */\n    background:linear-gradient(\n      90deg,\n      #ff6ec7 0%,\n      #ffbe00 18%,\n      #ff4d4d 36%,\n      #a259ff 54%,\n      #ff6ec7 72%,\n      #ffbe00 90%,\n      #ff4d4d 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:rainbowShift 3s linear infinite;\n\n    /* neon glow */\n    filter:drop-shadow(0 0 6px rgba(255,110,200,.7))\n           drop-shadow(0 0 14px rgba(162,89,255,.5));\n  }\n  @keyframes rainbowShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* sparkle dots orbiting the badge */\n  .church-sparks{\n    position:absolute;\n    inset:0;\n    border-radius:50px;\n    z-index:3;\n    pointer-events:none;\n    overflow:visible;\n  }\n  .spark{\n    position:absolute;\n    width:clamp(4px,0.6vw,8px);\n    height:clamp(4px,0.6vw,8px);\n    border-radius:50%;\n    top:50%;left:50%;\n    transform-origin:0 0;\n  }\n  .spark:nth-child(1){background:#ff6ec7;animation:orbitSpark 2.4s linear infinite 0s}\n  .spark:nth-child(2){background:#ffbe00;animation:orbitSpark 2.4s linear infinite .4s}\n  .spark:nth-child(3){background:#ff9900;animation:orbitSpark 2.4s linear infinite .8s}\n  .spark:nth-child(4){background:#a259ff;animation:orbitSpark 2.4s linear infinite 1.2s}\n  .spark:nth-child(5){background:#ff4d4d;animation:orbitSpark 2.4s linear infinite 1.6s}\n  .spark:nth-child(6){background:#39ff14;animation:orbitSpark 2.4s linear infinite 2.0s}\n  @keyframes orbitSpark{\n    0%  {transform:rotate(0deg)   translateX(clamp(22px,3.5vw,48px)) scale(1)}\n    50% {transform:rotate(180deg) translateX(clamp(22px,3.5vw,48px)) scale(1.5)}\n    100%{transform:rotate(360deg) translateX(clamp(22px,3.5vw,48px)) scale(1)}\n  }\n\n  /* ── PETAL BOTTOM DECORATION ── */\n  .petal-row{\n    position:absolute;\n    bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;\n    gap:.5vw;overflow:hidden;\n    z-index:11;\n    pointer-events:none;\n  }\n  .petal-static{\n    font-size:clamp(16px,2.5vw,36px);\n    opacity:.55;\n    animation:petalSway 3s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .petal-static:nth-child(2n){animation-delay:.5s}\n  .petal-static:nth-child(3n){animation-delay:1s}\n  .petal-static:nth-child(4n){animation-delay:1.5s}\n  @keyframes petalSway{\n    0%,100%{transform:rotate(-6deg)}\n    50%{transform:rotate(6deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(18px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <!-- SKY -->\n  <div class=\"sky\"></div>\n  <div class=\"sun-glow\"></div>\n\n  <!-- CANVASES -->\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"petals\" id=\"cPetals\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"doves\" id=\"cDoves\"></canvas>\n\n  <!-- CONTENT -->\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <div class=\"dove-row\">\n        <span class=\"dove-emoji\">🕊️</span>\n        <span class=\"dove-emoji\">✝</span>\n        <span class=\"dove-emoji\">🕊️</span>\n      </div>\n\n      <div class=\"script-top\">வாருங்கள் • மீண்டும் சந்திப்போம்</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-flower\">🌸</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"thanks\">நன்றி</div>\n      <div class=\"subtitle\">ஆராதனையில் கலந்துகொண்டதற்கு</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\">\n          ❝ கர்த்தர் உங்களை ஆசீர்வதித்து உங்களைக் காப்பாராக ❞\n        </div>\n        <div class=\"verse-ref\">— எண்ணாகமம் 6:24</div>\n      </div>\n\n      <!-- ANIME CHURCH NAME BADGE -->\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- PETAL GROUND ROW -->\n  <div class=\"petal-row\">\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌼</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌼</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌼</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span>\n  </div>\n\n</div>\n\n<script>\n/* ══════════════════\n   LIGHT RAYS\n══════════════════ */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  const RAYS=Array.from({length:18},(_,i)=>({\n    angle: (i/18)*Math.PI - Math.PI/2 + (Math.random()-.5)*.3,\n    width: 2+Math.random()*6,\n    alpha: .04+Math.random()*.08,\n    speed: (.002+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length: .5+Math.random()*.6\n  }));\n\n  const OX=W*.5, OY=H*1.1;\n\n  function draw(){\n    t+=1;\n    cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.04)*W*r.length+OX;\n      const by=Math.sin(r.angle+.04)*W*r.length+OY;\n\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(255,220,130,${r.alpha*2})`);\n      g.addColorStop(.4,`rgba(255,200,100,${r.alpha})`);\n      g.addColorStop(1,'rgba(255,220,130,0)');\n      cx.beginPath();\n      cx.moveTo(OX,OY);\n      cx.lineTo(ax,ay);\n      cx.lineTo(bx,by);\n      cx.closePath();\n      cx.fillStyle=g;\n      cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ══════════════════\n   FALLING PETALS\n══════════════════ */\n(function(){\n  const cv=document.getElementById('cPetals');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  const COLORS=[\n    [255,182,193],[255,160,180],[255,200,210],\n    [255,220,180],[255,240,200],[240,150,160],\n    [255,210,230],[200,160,200]\n  ];\n\n  class Petal{\n    constructor(fromTop){this.reset(fromTop);}\n    reset(fromTop){\n      this.x=Math.random()*W;\n      this.y=fromTop ? -20 : Math.random()*H;\n      this.size=Math.random()*14+6;\n      this.speedY=Math.random()*.8+.3;\n      this.speedX=(Math.random()-.5)*.5;\n      this.rot=Math.random()*Math.PI*2;\n      this.rotSpeed=(Math.random()-.5)*.03;\n      this.sway=Math.random()*2+1;\n      this.swaySpeed=Math.random()*.02+.01;\n      this.swayOffset=Math.random()*Math.PI*2;\n      this.c=COLORS[Math.floor(Math.random()*COLORS.length)];\n      this.alpha=Math.random()*.7+.3;\n      this.shape=Math.floor(Math.random()*3);\n    }\n    update(){\n      this.y+=this.speedY;\n      this.x+=this.speedX+Math.sin(t*this.swaySpeed+this.swayOffset)*this.sway*.1;\n      this.rot+=this.rotSpeed;\n      if(this.y>H+20)this.reset(true);\n      if(this.x<-20)this.x=W+20;\n      if(this.x>W+20)this.x=-20;\n    }\n    draw(cx){\n      cx.save();\n      cx.translate(this.x,this.y);\n      cx.rotate(this.rot);\n      cx.globalAlpha=this.alpha;\n      const [r,g,b]=this.c;\n      cx.fillStyle=`rgba(${r},${g},${b},1)`;\n      cx.shadowColor=`rgba(${r},${g},${b},.5)`;\n      cx.shadowBlur=4;\n      if(this.shape===0){\n        cx.beginPath();cx.ellipse(0,0,this.size*.4,this.size,0,0,Math.PI*2);cx.fill();\n      }else if(this.shape===1){\n        cx.beginPath();\n        cx.moveTo(0,-this.size);\n        cx.bezierCurveTo(this.size*.6,-this.size*.3,this.size*.6,this.size*.3,0,this.size*.5);\n        cx.bezierCurveTo(-this.size*.6,this.size*.3,-this.size*.6,-this.size*.3,0,-this.size);\n        cx.fill();\n      }else{\n        cx.beginPath();cx.arc(0,0,this.size*.5,0,Math.PI*2);cx.fill();\n      }\n      cx.fillStyle=`rgba(255,255,255,.25)`;\n      cx.beginPath();cx.ellipse(-this.size*.1,-this.size*.2,this.size*.15,this.size*.3,-.4,0,Math.PI*2);cx.fill();\n      cx.restore();\n    }\n  }\n\n  const petals=Array.from({length:60},()=>new Petal(false));\n  function draw(){t++;cx.clearRect(0,0,W,H);petals.forEach(p=>{p.update();p.draw(cx);});requestAnimationFrame(draw);}\n  draw();\n})();\n\n/* ══════════════════\n   FLYING DOVES\n══════════════════ */\n(function(){\n  const cv=document.getElementById('cDoves');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  let ctx;\n  function drawDove(cx, x, y, size, wingPhase, alpha){\n    cx.save();\n    cx.globalAlpha=alpha;\n    cx.translate(x,y);\n    const wf=Math.sin(wingPhase);\n    cx.fillStyle='rgba(255,255,255,0.9)';\n    cx.shadowColor='rgba(200,180,255,0.6)';\n    cx.shadowBlur=size*1.5;\n    cx.beginPath();cx.ellipse(0,0,size*1.2,size*.55,0,0,Math.PI*2);cx.fill();\n    cx.beginPath();cx.arc(size*.9,-size*.1,size*.38,0,Math.PI*2);cx.fill();\n    cx.fillStyle='rgba(255,200,100,0.9)';\n    cx.beginPath();cx.moveTo(size*1.3,-size*.08);cx.lineTo(size*1.65,size*.02);cx.lineTo(size*1.3,size*.1);cx.closePath();cx.fill();\n    cx.fillStyle='rgba(60,30,30,0.8)';\n    cx.beginPath();cx.arc(size*1.02,-size*.16,size*.1,0,Math.PI*2);cx.fill();\n    cx.fillStyle='rgba(240,240,255,0.8)';\n    cx.beginPath();cx.moveTo(-size*.9,0);cx.lineTo(-size*1.6,-size*.3);cx.lineTo(-size*1.5,size*.05);cx.lineTo(-size*1.6,size*.35);cx.closePath();cx.fill();\n    cx.fillStyle='rgba(255,255,255,0.85)';\n    cx.beginPath();\n    const wy=-size*.3+wf*size*1.0;\n    cx.moveTo(-size*.2,-size*.1);cx.bezierCurveTo(0,wy-size*.5,size*.8,wy-size*.3,size*.5,-size*.05);cx.bezierCurveTo(size*.3,-size*.05,-size*.1,-size*.1,-size*.2,-size*.1);cx.fill();\n    cx.fillStyle='rgba(230,230,255,0.7)';\n    cx.beginPath();\n    const wy2=size*.3-wf*size*.8;\n    cx.moveTo(-size*.2,size*.1);cx.bezierCurveTo(0,wy2+size*.5,size*.8,wy2+size*.3,size*.5,size*.05);cx.bezierCurveTo(size*.3,size*.05,-size*.1,size*.1,-size*.2,size*.1);cx.fill();\n    cx.restore();\n  }\n\n  const DOVES=[\n    {x:.15,y:.22,size:18,speed:.0008,wingSpeed:.06,offset:0,  dir:1 ,alpha:.85},\n    {x:.70,y:.18,size:13,speed:.0006,wingSpeed:.08,offset:1.2,dir:1 ,alpha:.70},\n    {x:.35,y:.30,size:10,speed:.0007,wingSpeed:.07,offset:2.5,dir:-1,alpha:.60},\n    {x:.85,y:.25,size:15,speed:.0009,wingSpeed:.065,offset:.8,dir:1, alpha:.75},\n    {x:.05,y:.38,size:9, speed:.0005,wingSpeed:.09,offset:3.1,dir:1, alpha:.50},\n  ];\n\n  function draw(){\n    t++;\n    cx.clearRect(0,0,W,H);\n    DOVES.forEach(d=>{\n      d.x+=d.speed*d.dir;\n      if(d.x>1.15)d.x=-0.1;\n      if(d.x<-0.1)d.x=1.1;\n      const wingPhase=t*d.wingSpeed+d.offset;\n      drawDove(cx,d.x*W,d.y*H,d.size,wingPhase,d.alpha);\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நன்றி - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── SKY GRADIENT BACKGROUND ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      175deg,\n      #1a0533 0%,\n      #3d1060 12%,\n      #7b2d8b 25%,\n      #c2527a 40%,\n      #e8845a 55%,\n      #f5b973 68%,\n      #fde8b0 80%,\n      #fff8e7 92%,\n      #ffffff 100%\n    );\n    z-index:0;\n  }\n\n  /* ── SUN GLOW ── */\n  .sun-glow{\n    position:absolute;\n    bottom:-15vh;\n    left:50%;\n    transform:translateX(-50%);\n    width:60vw;height:60vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(255,240,180,0.9) 0%,\n      rgba(255,210,100,0.6) 25%,\n      rgba(255,170,60,0.3) 50%,\n      rgba(255,130,30,0.1) 70%,\n      transparent 100%\n    );\n    z-index:1;\n    animation:sunPulse 4s ease-in-out infinite;\n  }\n  @keyframes sunPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.9}\n    50%{transform:translateX(-50%) scale(1.06);opacity:1}\n  }\n\n  /* ── LIGHT RAYS ── */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.petals{position:absolute;inset:0;z-index:4;pointer-events:none}\n  canvas.doves{position:absolute;inset:0;z-index:5;pointer-events:none}\n\n  /* ── HORIZON MIST ── */\n  .mist{\n    position:absolute;\n    bottom:0;left:0;right:0;\n    height:30vh;\n    background:linear-gradient(to top,\n      rgba(255,248,230,0.7) 0%,\n      rgba(255,240,200,0.3) 50%,\n      transparent 100%\n    );\n    z-index:3;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,255,255,0.13);\n    backdrop-filter:blur(18px);\n    -webkit-backdrop-filter:blur(18px);\n    border:1px solid rgba(255,255,255,0.35);\n    border-radius:24px;\n    padding:clamp(24px,4vh,50px) clamp(32px,6vw,90px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(120,40,80,0.25),\n      0 2px 20px rgba(255,160,80,0.2),\n      inset 0 1px 0 rgba(255,255,255,0.5);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:hidden;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,255,0.18) 0%,\n      rgba(255,200,120,0.08) 50%,\n      rgba(255,255,255,0.05) 100%\n    );\n    border-radius:24px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(30px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── DOVE ICON (CSS) ── */\n  .dove-row{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .dove-emoji{\n    font-size:clamp(24px,3.5vw,50px);\n    animation:doveWing 2.5s ease-in-out infinite;\n    filter:drop-shadow(0 2px 8px rgba(180,100,40,.4));\n  }\n  .dove-emoji:nth-child(2){animation-delay:.4s}\n  .dove-emoji:nth-child(3){animation-delay:.8s}\n  @keyframes doveWing{\n    0%,100%{transform:translateY(0) rotate(-3deg)}\n    50%{transform:translateY(-8px) rotate(3deg)}\n  }\n\n  /* ── TOP SCRIPT ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.3vw,17px);\n    letter-spacing:8px;\n    text-transform:uppercase;\n    color:rgba(120,50,20,0.75);\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(180,100,40,.5),transparent);\n  }\n  .div-flower{font-size:clamp(10px,1.4vw,18px);color:rgba(200,80,60,.7)}\n\n  /* ── MAIN THANKS ── */\n  .thanks{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(68px,12vw,180px);\n    font-weight:900;\n    line-height:1;\n    letter-spacing:8px;\n    background:linear-gradient(\n      160deg,\n      #4a1530 0%,\n      #8b2252 18%,\n      #c0392b 34%,\n      #e84393 50%,\n      #8b2252 66%,\n      #4a1530 80%,\n      #8b2252 100%\n    );\n    background-size:250% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 20px rgba(180,40,80,.3));\n    opacity:0;\n    animation:thankReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              thankFlow 5s ease-in-out infinite 2.5s;\n    margin-bottom:.5vh;\n  }\n  @keyframes thankReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(15px) drop-shadow(0 4px 20px rgba(180,40,80,.3))}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 20px rgba(180,40,80,.3))}\n  }\n  @keyframes thankFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(14px,2.2vw,30px);\n    font-weight:700;\n    color:rgba(90,20,40,0.85);\n    letter-spacing:3px;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(255,180,120,.4);\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(255,230,180,0.25);\n    border:1px solid rgba(200,120,60,.3);\n    border-radius:14px;\n    padding:clamp(10px,1.5vh,18px) clamp(16px,3vw,40px);\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:70vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(12px,1.5vw,20px);\n    color:rgba(80,30,20,0.9);\n    line-height:1.8;\n    letter-spacing:1px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.1vw,15px);\n    color:rgba(140,60,30,.7);\n    letter-spacing:3px;\n    margin-top:.5vh;\n  }\n\n  /* ══════════════════════════════════════════\n     ANIME CHURCH NAME — full rework\n  ══════════════════════════════════════════ */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-12deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n\n  /* white backing so text stays clean */\n  .church-bg{\n    position:absolute;\n    inset:3px;\n    border-radius:46px;\n    background:rgba(10,6,30,0.88);\n    z-index:1;\n  }\n\n  /* the actual text */\n  .church{\n    position:relative;\n    z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.45vw,20px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.5vw,36px);\n    white-space:nowrap;\n\n    /* animated rainbow gradient text */\n    background:linear-gradient(\n      90deg,\n      #ff6ec7 0%,\n      #ffbe00 18%,\n      #ff4d4d 36%,\n      #a259ff 54%,\n      #ff6ec7 72%,\n      #ffbe00 90%,\n      #ff4d4d 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:rainbowShift 3s linear infinite;\n\n    /* neon glow */\n    filter:drop-shadow(0 0 6px rgba(255,110,200,.7))\n           drop-shadow(0 0 14px rgba(162,89,255,.5));\n  }\n  @keyframes rainbowShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* sparkle dots orbiting the badge */\n  .church-sparks{\n    position:absolute;\n    inset:0;\n    border-radius:50px;\n    z-index:3;\n    pointer-events:none;\n    overflow:visible;\n  }\n  .spark{\n    position:absolute;\n    width:clamp(4px,0.6vw,8px);\n    height:clamp(4px,0.6vw,8px);\n    border-radius:50%;\n    top:50%;left:50%;\n    transform-origin:0 0;\n  }\n  .spark:nth-child(1){background:#ff6ec7;animation:orbitSpark 2.4s linear infinite 0s}\n  .spark:nth-child(2){background:#ffbe00;animation:orbitSpark 2.4s linear infinite .4s}\n  .spark:nth-child(3){background:#ff9900;animation:orbitSpark 2.4s linear infinite .8s}\n  .spark:nth-child(4){background:#a259ff;animation:orbitSpark 2.4s linear infinite 1.2s}\n  .spark:nth-child(5){background:#ff4d4d;animation:orbitSpark 2.4s linear infinite 1.6s}\n  .spark:nth-child(6){background:#39ff14;animation:orbitSpark 2.4s linear infinite 2.0s}\n  @keyframes orbitSpark{\n    0%  {transform:rotate(0deg)   translateX(clamp(22px,3.5vw,48px)) scale(1)}\n    50% {transform:rotate(180deg) translateX(clamp(22px,3.5vw,48px)) scale(1.5)}\n    100%{transform:rotate(360deg) translateX(clamp(22px,3.5vw,48px)) scale(1)}\n  }\n\n  /* ── PETAL BOTTOM DECORATION ── */\n  .petal-row{\n    position:absolute;\n    bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;\n    gap:.5vw;overflow:hidden;\n    z-index:11;\n    pointer-events:none;\n  }\n  .petal-static{\n    font-size:clamp(16px,2.5vw,36px);\n    opacity:.55;\n    animation:petalSway 3s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .petal-static:nth-child(2n){animation-delay:.5s}\n  .petal-static:nth-child(3n){animation-delay:1s}\n  .petal-static:nth-child(4n){animation-delay:1.5s}\n  @keyframes petalSway{\n    0%,100%{transform:rotate(-6deg)}\n    50%{transform:rotate(6deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(18px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <!-- SKY -->\n  <div class=\"sky\"></div>\n  <div class=\"sun-glow\"></div>\n\n  <!-- CANVASES -->\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"petals\" id=\"cPetals\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"doves\" id=\"cDoves\"></canvas>\n\n  <!-- CONTENT -->\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <div class=\"dove-row\">\n        <span class=\"dove-emoji\">🕊️</span>\n        <span class=\"dove-emoji\">✝</span>\n        <span class=\"dove-emoji\">🕊️</span>\n      </div>\n\n      <div class=\"script-top\">வாருங்கள் • மீண்டும் சந்திப்போம்</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-flower\">🌸</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"thanks\">நன்றி</div>\n      <div class=\"subtitle\">ஆராதனையில் கலந்துகொண்டதற்கு</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\"><br>          ❝ கர்த்தர் உங்களை ஆசீர்வதித்து உங்களைக் காப்பாராக ❞<br></div>\n        <div class=\"verse-ref\">— எண்ணாகமம் 6:24</div>\n      </div>\n\n      <!-- ANIME CHURCH NAME BADGE -->\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- PETAL GROUND ROW -->\n  <div class=\"petal-row\">\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌼</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌼</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌼</span>\n    <span class=\"petal-static\">🌸</span><span class=\"petal-static\">🌺</span>\n    <span class=\"petal-static\">🌸</span>\n  </div>\n\n</div>\n\n<script>\n/* ══════════════════\n   LIGHT RAYS\n══════════════════ */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  const RAYS=Array.from({length:18},(_,i)=>({\n    angle: (i/18)*Math.PI - Math.PI/2 + (Math.random()-.5)*.3,\n    width: 2+Math.random()*6,\n    alpha: .04+Math.random()*.08,\n    speed: (.002+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length: .5+Math.random()*.6\n  }));\n\n  const OX=W*.5, OY=H*1.1;\n\n  function draw(){\n    t+=1;\n    cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.04)*W*r.length+OX;\n      const by=Math.sin(r.angle+.04)*W*r.length+OY;\n\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(255,220,130,${r.alpha*2})`);\n      g.addColorStop(.4,`rgba(255,200,100,${r.alpha})`);\n      g.addColorStop(1,'rgba(255,220,130,0)');\n      cx.beginPath();\n      cx.moveTo(OX,OY);\n      cx.lineTo(ax,ay);\n      cx.lineTo(bx,by);\n      cx.closePath();\n      cx.fillStyle=g;\n      cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ══════════════════\n   FALLING PETALS\n══════════════════ */\n(function(){\n  const cv=document.getElementById('cPetals');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  const COLORS=[\n    [255,182,193],[255,160,180],[255,200,210],\n    [255,220,180],[255,240,200],[240,150,160],\n    [255,210,230],[200,160,200]\n  ];\n\n  class Petal{\n    constructor(fromTop){this.reset(fromTop);}\n    reset(fromTop){\n      this.x=Math.random()*W;\n      this.y=fromTop ? -20 : Math.random()*H;\n      this.size=Math.random()*14+6;\n      this.speedY=Math.random()*.8+.3;\n      this.speedX=(Math.random()-.5)*.5;\n      this.rot=Math.random()*Math.PI*2;\n      this.rotSpeed=(Math.random()-.5)*.03;\n      this.sway=Math.random()*2+1;\n      this.swaySpeed=Math.random()*.02+.01;\n      this.swayOffset=Math.random()*Math.PI*2;\n      this.c=COLORS[Math.floor(Math.random()*COLORS.length)];\n      this.alpha=Math.random()*.7+.3;\n      this.shape=Math.floor(Math.random()*3);\n    }\n    update(){\n      this.y+=this.speedY;\n      this.x+=this.speedX+Math.sin(t*this.swaySpeed+this.swayOffset)*this.sway*.1;\n      this.rot+=this.rotSpeed;\n      if(this.y>H+20)this.reset(true);\n      if(this.x<-20)this.x=W+20;\n      if(this.x>W+20)this.x=-20;\n    }\n    draw(cx){\n      cx.save();\n      cx.translate(this.x,this.y);\n      cx.rotate(this.rot);\n      cx.globalAlpha=this.alpha;\n      const [r,g,b]=this.c;\n      cx.fillStyle=`rgba(${r},${g},${b},1)`;\n      cx.shadowColor=`rgba(${r},${g},${b},.5)`;\n      cx.shadowBlur=4;\n      if(this.shape===0){\n        cx.beginPath();cx.ellipse(0,0,this.size*.4,this.size,0,0,Math.PI*2);cx.fill();\n      }else if(this.shape===1){\n        cx.beginPath();\n        cx.moveTo(0,-this.size);\n        cx.bezierCurveTo(this.size*.6,-this.size*.3,this.size*.6,this.size*.3,0,this.size*.5);\n        cx.bezierCurveTo(-this.size*.6,this.size*.3,-this.size*.6,-this.size*.3,0,-this.size);\n        cx.fill();\n      }else{\n        cx.beginPath();cx.arc(0,0,this.size*.5,0,Math.PI*2);cx.fill();\n      }\n      cx.fillStyle=`rgba(255,255,255,.25)`;\n      cx.beginPath();cx.ellipse(-this.size*.1,-this.size*.2,this.size*.15,this.size*.3,-.4,0,Math.PI*2);cx.fill();\n      cx.restore();\n    }\n  }\n\n  const petals=Array.from({length:60},()=>new Petal(false));\n  function draw(){t++;cx.clearRect(0,0,W,H);petals.forEach(p=>{p.update();p.draw(cx);});requestAnimationFrame(draw);}\n  draw();\n})();\n\n/* ══════════════════\n   FLYING DOVES\n══════════════════ */\n(function(){\n  const cv=document.getElementById('cDoves');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  let ctx;\n  function drawDove(cx, x, y, size, wingPhase, alpha){\n    cx.save();\n    cx.globalAlpha=alpha;\n    cx.translate(x,y);\n    const wf=Math.sin(wingPhase);\n    cx.fillStyle='rgba(255,255,255,0.9)';\n    cx.shadowColor='rgba(200,180,255,0.6)';\n    cx.shadowBlur=size*1.5;\n    cx.beginPath();cx.ellipse(0,0,size*1.2,size*.55,0,0,Math.PI*2);cx.fill();\n    cx.beginPath();cx.arc(size*.9,-size*.1,size*.38,0,Math.PI*2);cx.fill();\n    cx.fillStyle='rgba(255,200,100,0.9)';\n    cx.beginPath();cx.moveTo(size*1.3,-size*.08);cx.lineTo(size*1.65,size*.02);cx.lineTo(size*1.3,size*.1);cx.closePath();cx.fill();\n    cx.fillStyle='rgba(60,30,30,0.8)';\n    cx.beginPath();cx.arc(size*1.02,-size*.16,size*.1,0,Math.PI*2);cx.fill();\n    cx.fillStyle='rgba(240,240,255,0.8)';\n    cx.beginPath();cx.moveTo(-size*.9,0);cx.lineTo(-size*1.6,-size*.3);cx.lineTo(-size*1.5,size*.05);cx.lineTo(-size*1.6,size*.35);cx.closePath();cx.fill();\n    cx.fillStyle='rgba(255,255,255,0.85)';\n    cx.beginPath();\n    const wy=-size*.3+wf*size*1.0;\n    cx.moveTo(-size*.2,-size*.1);cx.bezierCurveTo(0,wy-size*.5,size*.8,wy-size*.3,size*.5,-size*.05);cx.bezierCurveTo(size*.3,-size*.05,-size*.1,-size*.1,-size*.2,-size*.1);cx.fill();\n    cx.fillStyle='rgba(230,230,255,0.7)';\n    cx.beginPath();\n    const wy2=size*.3-wf*size*.8;\n    cx.moveTo(-size*.2,size*.1);cx.bezierCurveTo(0,wy2+size*.5,size*.8,wy2+size*.3,size*.5,size*.05);cx.bezierCurveTo(size*.3,size*.05,-size*.1,size*.1,-size*.2,size*.1);cx.fill();\n    cx.restore();\n  }\n\n  const DOVES=[\n    {x:.15,y:.22,size:18,speed:.0008,wingSpeed:.06,offset:0,  dir:1 ,alpha:.85},\n    {x:.70,y:.18,size:13,speed:.0006,wingSpeed:.08,offset:1.2,dir:1 ,alpha:.70},\n    {x:.35,y:.30,size:10,speed:.0007,wingSpeed:.07,offset:2.5,dir:-1,alpha:.60},\n    {x:.85,y:.25,size:15,speed:.0009,wingSpeed:.065,offset:.8,dir:1, alpha:.75},\n    {x:.05,y:.38,size:9, speed:.0005,wingSpeed:.09,offset:3.1,dir:1, alpha:.50},\n  ];\n\n  function draw(){\n    t++;\n    cx.clearRect(0,0,W,H);\n    DOVES.forEach(d=>{\n      d.x+=d.speed*d.dir;\n      if(d.x>1.15)d.x=-0.1;\n      if(d.x<-0.1)d.x=1.1;\n      const wingPhase=t*d.wingSpeed+d.offset;\n      drawDove(cx,d.x*W,d.y*H,d.size,wingPhase,d.alpha);\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>"
    }
  ]
}