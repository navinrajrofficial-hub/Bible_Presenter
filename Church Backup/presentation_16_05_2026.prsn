{
  "version": 1,
  "slides": [
    {
      "id": 1774107563826.375,
      "type": "html",
      "name": "TITLE 2 ",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;600;700;900&family=Playfair+Display:ital,wght@1,400;0,700;0,900&family=IM+Fell+English:ital@1&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n:root{\n  --gold:#d4a843;\n  --gold-light:#f0cc70;\n  --cream:#fdf6e3;\n  --amber:#c47a1e;\n  --deep:#1a0a00;\n  --warm-dark:#120800;\n}\n\n.stage{\n  width:100vw;height:100vh;\n  position:relative;overflow:hidden;\n  background:var(--warm-dark);\n}\n\n/* ── LAYERED CANVASES ── */\ncanvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n#cFlame{z-index:1}\n#cDust{z-index:3}\n\n/* ── VIGNETTE ── */\n.vignette{\n  position:absolute;inset:0;z-index:4;\n  background:radial-gradient(ellipse 85% 85% at 50% 50%,\n    transparent 30%,\n    rgba(10,4,0,.4) 60%,\n    rgba(5,2,0,.85) 100%\n  );\n  pointer-events:none;\n}\n\n/* ── ORNAMENTAL FRAME ── */\n.frame{\n  position:absolute;inset:3vmin;z-index:6;\n  border:1px solid rgba(212,168,67,.25);\n  pointer-events:none;\n}\n.frame::before{\n  content:'';position:absolute;inset:6px;\n  border:1px solid rgba(212,168,67,.12);\n}\n/* corner ornaments */\n.frame-corner{\n  position:absolute;width:50px;height:50px;\n  z-index:7;pointer-events:none;\n  opacity:0;animation:fadeIn 1s ease forwards;\n}\n.frame-corner svg{fill:none;stroke:var(--gold);stroke-width:1.2;opacity:.7}\n.fc-tl{top:3vmin;left:3vmin;animation-delay:.8s}\n.fc-tr{top:3vmin;right:3vmin;transform:scaleX(-1);animation-delay:1s}\n.fc-bl{bottom:3vmin;left:3vmin;transform:scaleY(-1);animation-delay:1.2s}\n.fc-br{bottom:3vmin;right:3vmin;transform:scale(-1,-1);animation-delay:1.4s}\n\n/* ── CONTENT CENTER ── */\n.content{\n  position:absolute;inset:0;z-index:10;\n  display:flex;flex-direction:column;\n  align-items:center;justify-content:center;\n}\n\n/* ── HALO RING ── */\n.halo{\n  position:relative;margin-bottom:3vh;\n  opacity:0;animation:haloIn 1.5s cubic-bezier(.2,1,.4,1) forwards .2s;\n}\n@keyframes haloIn{\n  0%{opacity:0;transform:scale(.5);filter:blur(30px)}\n  60%{opacity:1;filter:blur(2px)}\n  100%{opacity:1;transform:scale(1);filter:blur(0)}\n}\n.halo-ring{\n  width:clamp(80px,10vw,140px);\n  height:clamp(80px,10vw,140px);\n  border-radius:50%;\n  border:1px solid rgba(212,168,67,.3);\n  display:flex;align-items:center;justify-content:center;\n  position:relative;\n  animation:rotateSlow 20s linear infinite;\n}\n@keyframes rotateSlow{to{transform:rotate(360deg)}}\n.halo-ring::before{\n  content:'';position:absolute;inset:-6px;border-radius:50%;\n  border:1px solid transparent;\n  border-top-color:var(--gold);\n  border-right-color:rgba(212,168,67,.4);\n  animation:rotateFast 4s linear infinite;\n}\n@keyframes rotateFast{to{transform:rotate(-360deg)}}\n.halo-ring::after{\n  content:'';position:absolute;inset:-14px;border-radius:50%;\n  border:1px solid rgba(212,168,67,.15);\n  border-bottom-color:rgba(212,168,67,.6);\n  animation:rotateFast 7s linear infinite reverse;\n}\n.cross-symbol{\n  font-size:clamp(28px,4vw,56px);\n  line-height:1;\n  animation:rotateSlow 20s linear infinite reverse;\n  background:linear-gradient(170deg,#fff8e7 0%,var(--gold-light) 40%,var(--gold) 70%,var(--amber) 100%);\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 0 8px rgba(212,168,67,.8)) drop-shadow(0 0 20px rgba(212,168,67,.4));\n}\n\n/* ── TOP TAG ── */\n.tag{\n  font-family:'IM Fell English',serif;\n  font-style:italic;\n  font-size:clamp(10px,1.2vw,15px);\n  letter-spacing:8px;\n  text-transform:uppercase;\n  color:rgba(212,168,67,.6);\n  margin-bottom:2.5vh;\n  opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n}\n\n/* ── DIVIDER ── */\n.divider{\n  display:flex;align-items:center;gap:1.5vw;\n  margin-bottom:2.5vh;\n  opacity:0;animation:fadeIn .8s ease forwards 1.5s;\n}\n.div-line{\n  height:1px;width:clamp(40px,8vw,120px);\n  background:linear-gradient(90deg,transparent,var(--gold));\n}\n.div-line.r{background:linear-gradient(90deg,var(--gold),transparent)}\n.div-gem{\n  font-size:clamp(8px,1vw,13px);\n  color:var(--gold);\n  text-shadow:0 0 10px rgba(212,168,67,.8);\n}\n\n/* ── MAIN TITLE ── */\n.title-block{\n  text-align:center;\n  margin-bottom:2vh;\n}\n.t1{\n  display:block;\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(30px,5.5vw,90px);\n  font-weight:900;\n  line-height:1.15;\n  letter-spacing:4px;\n  color:transparent;\n  background:linear-gradient(\n    160deg,\n    #fff8e7 0%,\n    var(--gold-light) 25%,\n    var(--gold) 50%,\n    var(--amber) 75%,\n    #8b5c0f 100%\n  );\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 2px 30px rgba(212,168,67,.3));\n  opacity:0;animation:slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 1.8s;\n}\n.t2{\n  display:block;\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(18px,3.2vw,52px);\n  font-weight:600;\n  letter-spacing:14px;\n  color:transparent;\n  background:linear-gradient(\n    90deg,\n    rgba(212,168,67,.5) 0%,\n    var(--gold-light) 50%,\n    rgba(212,168,67,.5) 100%\n  );\n  background-size:200% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  animation:shimmerText 4s ease-in-out infinite 3s, slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 2.1s;\n  opacity:0;\n}\n@keyframes shimmerText{\n  0%,100%{background-position:0% center}\n  50%{background-position:200% center}\n}\n@keyframes slideDown{\n  from{opacity:0;transform:translateY(-20px);filter:blur(8px)}\n  to{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n@keyframes slideUp{\n  from{opacity:0;transform:translateY(20px);filter:blur(8px)}\n  to{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n\n/* ── DIVIDER 2 ── */\n.divider2{\n  margin-bottom:2.5vh;\n  opacity:0;animation:fadeIn .8s ease forwards 2.6s;\n  display:flex;align-items:center;gap:1vw;\n}\n.div2-line{height:1px;width:clamp(30px,6vw,90px);background:linear-gradient(90deg,transparent,rgba(212,168,67,.4))}\n.div2-line.r{background:linear-gradient(90deg,rgba(212,168,67,.4),transparent)}\n.div2-dot{width:4px;height:4px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px var(--gold)}\n\n/* ── VERSE ── */\n.verse{\n  font-family:'Playfair Display',serif;\n  font-style:italic;\n  font-size:clamp(10px,1.2vw,16px);\n  color:rgba(240,204,112,.55);\n  letter-spacing:1.5px;\n  text-align:center;\n  padding:0 12vw;\n  line-height:1.8;\n  opacity:0;animation:fadeUp .8s ease forwards 2.9s;\n}\n.verse cite{\n  display:block;\n  font-style:normal;\n  font-family:'IM Fell English',serif;\n  font-size:.9em;\n  color:rgba(212,168,67,.35);\n  letter-spacing:4px;\n  margin-top:.5em;\n  text-transform:uppercase;\n}\n\n/* ── BOTTOM TAGLINE ── */\n.tagline{\n  position:absolute;bottom:5vh;left:0;right:0;\n  text-align:center;z-index:11;\n  font-family:'IM Fell English',serif;\n  font-style:italic;\n  font-size:clamp(9px,1vw,13px);\n  letter-spacing:6px;\n  color:rgba(212,168,67,.25);\n  text-transform:uppercase;\n  opacity:0;animation:fadeIn 1.5s ease forwards 3.5s;\n}\n\n/* ── ANIMATIONS ── */\n@keyframes fadeUp{\n  from{opacity:0;transform:translateY(12px)}\n  to{opacity:1;transform:translateY(0)}\n}\n@keyframes fadeIn{\n  to{opacity:1}\n}\n\n/* ── CANDLE GLOW BEHIND CROSS ── */\n.candle-glow{\n  position:absolute;\n  width:clamp(200px,30vw,400px);\n  height:clamp(200px,30vw,400px);\n  border-radius:50%;\n  background:radial-gradient(circle,rgba(212,168,67,.12) 0%,rgba(180,100,20,.06) 40%,transparent 70%);\n  top:50%;left:50%;transform:translate(-50%,-50%);\n  z-index:5;\n  animation:candleGlow 3s ease-in-out infinite;\n}\n@keyframes candleGlow{\n  0%,100%{opacity:.8;transform:translate(-50%,-50%) scale(1)}\n  50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}\n}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <canvas id=\"cFlame\"></canvas>\n  <div class=\"vignette\"></div>\n  <div class=\"candle-glow\"></div>\n  <canvas id=\"cDust\"></canvas>\n\n  <!-- Frame -->\n  <div class=\"frame\"></div>\n  <div class=\"frame-corner fc-tl\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n  <div class=\"frame-corner fc-tr\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n  <div class=\"frame-corner fc-bl\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n  <div class=\"frame-corner fc-br\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n\n  <!-- CONTENT -->\n  <div class=\"content\">\n    <div class=\"halo\">\n      <div class=\"halo-ring\">\n        <span class=\"cross-symbol\">✝</span>\n      </div>\n    </div>\n\n    <div class=\"tag\">Welcome to</div>\n\n    <div class=\"divider\">\n      <div class=\"div-line\"></div>\n      <span class=\"div-gem\">✦</span>\n      <span class=\"div-gem\" style=\"font-size:.6em;opacity:.5\">✦</span>\n      <span class=\"div-gem\">✦</span>\n      <div class=\"div-line r\"></div>\n    </div>\n\n    <div class=\"title-block\">\n      <span class=\"t1\">நல்ல சமாரியன் இயேசு</span>\n      <span class=\"t2\">ஜெப வீடு</span>\n    </div>\n\n    <div class=\"divider2\">\n      <div class=\"div2-line\"></div>\n      <div class=\"div2-dot\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n      <div class=\"div2-dot\"></div>\n      <div class=\"div2-line r\"></div>\n    </div>\n\n    <div class=\"verse\">\n      என்னுடைய வீடு ஜெபவீடு என்னப்படும்\n      <cite>— மத்தேயு 21:13</cite>\n    </div>\n  </div>\n\n  <div class=\"tagline\">Good Samarian Jesus Prayer House</div>\n</div>\n\n<script>\n/* ══════════════════════════════\n   FLAME / EMBER BACKGROUND\n══════════════════════════════ */\n(function(){\n  const cv = document.getElementById('cFlame');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n\n  function resize(){\n    W = cv.width  = window.innerWidth;\n    H = cv.height = window.innerHeight;\n  }\n  resize();\n  window.addEventListener('resize', resize);\n\n  // Noise helper (simple smooth noise)\n  function noise(x, y, t){\n    return Math.sin(x * .012 + t * .008) * Math.cos(y * .009 - t * .006) * .5\n         + Math.sin(x * .007 - t * .005) * Math.sin(y * .013 + t * .007) * .3\n         + Math.sin((x+y) * .006 + t * .004) * .2;\n  }\n\n  function draw(){\n    t++;\n    cx.clearRect(0,0,W,H);\n\n    // Deep warm base\n    const bg = cx.createRadialGradient(W*.5, H*.7, 0, W*.5, H*.5, H*.9);\n    bg.addColorStop(0,  'rgba(30,10,0,1)');\n    bg.addColorStop(.3, 'rgba(20,6,0,1)');\n    bg.addColorStop(.7, 'rgba(10,3,0,1)');\n    bg.addColorStop(1,  'rgba(5,1,0,1)');\n    cx.fillStyle = bg;\n    cx.fillRect(0,0,W,H);\n\n    // Slow fire columns rising from bottom\n    const cols = 12;\n    for(let i=0;i<cols;i++){\n      const cx_ = (i/(cols-1)) * W;\n      const height = H * (.3 + noise(i*80, 0, t) * .25 + .15);\n      const baseX  = cx_ + noise(i*60, t, 0) * 40;\n      const alpha  = (.04 + Math.abs(noise(i*40, t*1.2, i)) * .06) * (1 - Math.abs((i/(cols-1))-.5)*1.2);\n      if(alpha <= 0) continue;\n\n      const grd = cx.createLinearGradient(baseX, H, baseX + noise(i,t,0)*20, H - height);\n      grd.addColorStop(0,   `rgba(180,80,0,${alpha})`);\n      grd.addColorStop(.35, `rgba(220,120,0,${alpha*.8})`);\n      grd.addColorStop(.65, `rgba(200,140,30,${alpha*.4})`);\n      grd.addColorStop(1,   `rgba(255,200,50,0)`);\n\n      cx.save();\n      cx.beginPath();\n      const w = W / cols * (.6 + Math.abs(noise(i*30,t,0)) * .8);\n      cx.ellipse(baseX, H, w*.5, height*.6, 0, 0, Math.PI*2);\n      cx.fillStyle = grd;\n      cx.fill();\n      cx.restore();\n    }\n\n    // Central altar glow\n    const cg = cx.createRadialGradient(W*.5, H*.72, 0, W*.5, H*.65, H*.45);\n    cg.addColorStop(0,   'rgba(212,168,67,.07)');\n    cg.addColorStop(.3,  'rgba(180,100,20,.04)');\n    cg.addColorStop(.6,  'rgba(150,60,0,.02)');\n    cg.addColorStop(1,   'rgba(0,0,0,0)');\n    cx.fillStyle = cg;\n    cx.fillRect(0,0,W,H);\n\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n\n/* ══════════════════════════════\n   GOLDEN DUST PARTICLES\n══════════════════════════════ */\n(function(){\n  const cv = document.getElementById('cDust');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  function resize(){W = cv.width = window.innerWidth; H = cv.height = window.innerHeight;}\n  resize();\n  window.addEventListener('resize', resize);\n\n  class Mote {\n    constructor(){ this.reset(true) }\n    reset(init){\n      this.x  = Math.random();\n      this.y  = init ? Math.random() : 1.02;\n      this.r  = Math.random() * 1.8 + .4;\n      this.vy = -(Math.random() * .0006 + .0001);\n      this.vx = (Math.random() - .5) * .0003;\n      this.a  = 0;\n      this.maxA = Math.random() * .6 + .15;\n      this.phase = Math.random() * Math.PI * 2;\n      this.speed = Math.random() * .02 + .01;\n      // gold palette\n      const palettes = [\n        [212,168,67],[240,204,112],[255,235,150],\n        [196,122,30],[255,200,80],[180,140,60]\n      ];\n      this.color = palettes[Math.floor(Math.random()*palettes.length)];\n    }\n    update(){\n      this.phase += this.speed;\n      this.y  += this.vy;\n      this.x  += this.vx + Math.sin(this.phase * .4) * .0001;\n      // fade in/out\n      if(this.y > .7) this.a = Math.min(this.maxA, this.a + .005);\n      if(this.y < .2) this.a = Math.max(0, this.a - .003);\n      if(this.y < -.03) this.reset(false);\n    }\n    draw(cx){\n      if(this.a <= 0) return;\n      const px = this.x * W, py = this.y * H;\n      const [r,g,b] = this.color;\n      const glow = (Math.sin(this.phase) * .5 + .5);\n      cx.save();\n      cx.globalAlpha = this.a * (.6 + glow * .4);\n      cx.shadowColor = `rgba(${r},${g},${b},0.9)`;\n      cx.shadowBlur  = this.r * 5;\n\n      // alternating shape\n      if(this.r > 1.5){\n        // tiny cross-sparkle\n        cx.strokeStyle = `rgba(${r},${g},${b},1)`;\n        cx.lineWidth = .8;\n        cx.beginPath();\n        cx.moveTo(px - this.r*2, py); cx.lineTo(px + this.r*2, py);\n        cx.moveTo(px, py - this.r*2); cx.lineTo(px, py + this.r*2);\n        cx.stroke();\n      } else {\n        cx.beginPath();\n        cx.arc(px, py, this.r, 0, Math.PI*2);\n        cx.fillStyle = `rgba(${r},${g},${b},1)`;\n        cx.fill();\n      }\n      cx.restore();\n    }\n  }\n\n  // Slow drifting beam\n  class LightBeam {\n    constructor(){ this.reset() }\n    reset(){\n      this.x = Math.random();\n      this.w = Math.random() * .06 + .02;\n      this.a = 0;\n      this.maxA = Math.random() * .04 + .01;\n      this.phase = Math.random() * Math.PI * 2;\n      this.speed = Math.random() * .003 + .001;\n      this.vx = (Math.random() - .5) * .0002;\n    }\n    update(){\n      this.phase += this.speed;\n      this.x += this.vx;\n      this.a = this.maxA * (Math.sin(this.phase) * .5 + .5);\n      if(this.x < -.1 || this.x > 1.1) this.vx *= -1;\n    }\n    draw(cx){\n      if(this.a <= 0) return;\n      const px = this.x * W;\n      const g = cx.createLinearGradient(px - this.w*W*.5, 0, px + this.w*W*.5, 0);\n      g.addColorStop(0,   'rgba(212,168,67,0)');\n      g.addColorStop(.5,  `rgba(212,168,67,${this.a})`);\n      g.addColorStop(1,   'rgba(212,168,67,0)');\n      cx.fillStyle = g;\n      cx.fillRect(px - this.w*W*.5, 0, this.w*W, H);\n    }\n  }\n\n  const motes = Array.from({length:160}, () => new Mote());\n  const beams = Array.from({length:5},  () => new LightBeam());\n\n  function draw(){\n    t++;\n    cx.clearRect(0,0,W,H);\n    beams.forEach(b => { b.update(); b.draw(cx); });\n    motes.forEach(m => { m.update(); m.draw(cx); });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
      "bookmarked": true,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;600;700;900&family=Playfair+Display:ital,wght@1,400;0,700;0,900&family=IM+Fell+English:ital@1&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n:root{\n  --gold:#d4a843;\n  --gold-light:#f0cc70;\n  --cream:#fdf6e3;\n  --amber:#c47a1e;\n  --deep:#1a0a00;\n  --warm-dark:#120800;\n}\n\n.stage{\n  width:100vw;height:100vh;\n  position:relative;overflow:hidden;\n  background:var(--warm-dark);\n}\n\n/* ── LAYERED CANVASES ── */\ncanvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n#cFlame{z-index:1}\n#cDust{z-index:3}\n\n/* ── VIGNETTE ── */\n.vignette{\n  position:absolute;inset:0;z-index:4;\n  background:radial-gradient(ellipse 85% 85% at 50% 50%,\n    transparent 30%,\n    rgba(10,4,0,.4) 60%,\n    rgba(5,2,0,.85) 100%\n  );\n  pointer-events:none;\n}\n\n/* ── ORNAMENTAL FRAME ── */\n.frame{\n  position:absolute;inset:3vmin;z-index:6;\n  border:1px solid rgba(212,168,67,.25);\n  pointer-events:none;\n}\n.frame::before{\n  content:'';position:absolute;inset:6px;\n  border:1px solid rgba(212,168,67,.12);\n}\n/* corner ornaments */\n.frame-corner{\n  position:absolute;width:50px;height:50px;\n  z-index:7;pointer-events:none;\n  opacity:0;animation:fadeIn 1s ease forwards;\n}\n.frame-corner svg{fill:none;stroke:var(--gold);stroke-width:1.2;opacity:.7}\n.fc-tl{top:3vmin;left:3vmin;animation-delay:.8s}\n.fc-tr{top:3vmin;right:3vmin;transform:scaleX(-1);animation-delay:1s}\n.fc-bl{bottom:3vmin;left:3vmin;transform:scaleY(-1);animation-delay:1.2s}\n.fc-br{bottom:3vmin;right:3vmin;transform:scale(-1,-1);animation-delay:1.4s}\n\n/* ── CONTENT CENTER ── */\n.content{\n  position:absolute;inset:0;z-index:10;\n  display:flex;flex-direction:column;\n  align-items:center;justify-content:center;\n}\n\n/* ── HALO RING ── */\n.halo{\n  position:relative;margin-bottom:3vh;\n  opacity:0;animation:haloIn 1.5s cubic-bezier(.2,1,.4,1) forwards .2s;\n}\n@keyframes haloIn{\n  0%{opacity:0;transform:scale(.5);filter:blur(30px)}\n  60%{opacity:1;filter:blur(2px)}\n  100%{opacity:1;transform:scale(1);filter:blur(0)}\n}\n.halo-ring{\n  width:clamp(80px,10vw,140px);\n  height:clamp(80px,10vw,140px);\n  border-radius:50%;\n  border:1px solid rgba(212,168,67,.3);\n  display:flex;align-items:center;justify-content:center;\n  position:relative;\n  animation:rotateSlow 20s linear infinite;\n}\n@keyframes rotateSlow{to{transform:rotate(360deg)}}\n.halo-ring::before{\n  content:'';position:absolute;inset:-6px;border-radius:50%;\n  border:1px solid transparent;\n  border-top-color:var(--gold);\n  border-right-color:rgba(212,168,67,.4);\n  animation:rotateFast 4s linear infinite;\n}\n@keyframes rotateFast{to{transform:rotate(-360deg)}}\n.halo-ring::after{\n  content:'';position:absolute;inset:-14px;border-radius:50%;\n  border:1px solid rgba(212,168,67,.15);\n  border-bottom-color:rgba(212,168,67,.6);\n  animation:rotateFast 7s linear infinite reverse;\n}\n.cross-symbol{\n  font-size:clamp(28px,4vw,56px);\n  line-height:1;\n  animation:rotateSlow 20s linear infinite reverse;\n  background:linear-gradient(170deg,#fff8e7 0%,var(--gold-light) 40%,var(--gold) 70%,var(--amber) 100%);\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 0 8px rgba(212,168,67,.8)) drop-shadow(0 0 20px rgba(212,168,67,.4));\n}\n\n/* ── TOP TAG ── */\n.tag{\n  font-family:'IM Fell English',serif;\n  font-style:italic;\n  font-size:clamp(10px,1.2vw,15px);\n  letter-spacing:8px;\n  text-transform:uppercase;\n  color:rgba(212,168,67,.6);\n  margin-bottom:2.5vh;\n  opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n}\n\n/* ── DIVIDER ── */\n.divider{\n  display:flex;align-items:center;gap:1.5vw;\n  margin-bottom:2.5vh;\n  opacity:0;animation:fadeIn .8s ease forwards 1.5s;\n}\n.div-line{\n  height:1px;width:clamp(40px,8vw,120px);\n  background:linear-gradient(90deg,transparent,var(--gold));\n}\n.div-line.r{background:linear-gradient(90deg,var(--gold),transparent)}\n.div-gem{\n  font-size:clamp(8px,1vw,13px);\n  color:var(--gold);\n  text-shadow:0 0 10px rgba(212,168,67,.8);\n}\n\n/* ── MAIN TITLE ── */\n.title-block{\n  text-align:center;\n  margin-bottom:2vh;\n}\n.t1{\n  display:block;\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(30px,5.5vw,90px);\n  font-weight:900;\n  line-height:1.15;\n  letter-spacing:4px;\n  color:transparent;\n  background:linear-gradient(\n    160deg,\n    #fff8e7 0%,\n    var(--gold-light) 25%,\n    var(--gold) 50%,\n    var(--amber) 75%,\n    #8b5c0f 100%\n  );\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 2px 30px rgba(212,168,67,.3));\n  opacity:0;animation:slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 1.8s;\n}\n.t2{\n  display:block;\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(18px,3.2vw,52px);\n  font-weight:600;\n  letter-spacing:14px;\n  color:transparent;\n  background:linear-gradient(\n    90deg,\n    rgba(212,168,67,.5) 0%,\n    var(--gold-light) 50%,\n    rgba(212,168,67,.5) 100%\n  );\n  background-size:200% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  animation:shimmerText 4s ease-in-out infinite 3s, slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 2.1s;\n  opacity:0;\n}\n@keyframes shimmerText{\n  0%,100%{background-position:0% center}\n  50%{background-position:200% center}\n}\n@keyframes slideDown{\n  from{opacity:0;transform:translateY(-20px);filter:blur(8px)}\n  to{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n@keyframes slideUp{\n  from{opacity:0;transform:translateY(20px);filter:blur(8px)}\n  to{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n\n/* ── DIVIDER 2 ── */\n.divider2{\n  margin-bottom:2.5vh;\n  opacity:0;animation:fadeIn .8s ease forwards 2.6s;\n  display:flex;align-items:center;gap:1vw;\n}\n.div2-line{height:1px;width:clamp(30px,6vw,90px);background:linear-gradient(90deg,transparent,rgba(212,168,67,.4))}\n.div2-line.r{background:linear-gradient(90deg,rgba(212,168,67,.4),transparent)}\n.div2-dot{width:4px;height:4px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px var(--gold)}\n\n/* ── VERSE ── */\n.verse{\n  font-family:'Playfair Display',serif;\n  font-style:italic;\n  font-size:clamp(10px,1.2vw,16px);\n  color:rgba(240,204,112,.55);\n  letter-spacing:1.5px;\n  text-align:center;\n  padding:0 12vw;\n  line-height:1.8;\n  opacity:0;animation:fadeUp .8s ease forwards 2.9s;\n}\n.verse cite{\n  display:block;\n  font-style:normal;\n  font-family:'IM Fell English',serif;\n  font-size:.9em;\n  color:rgba(212,168,67,.35);\n  letter-spacing:4px;\n  margin-top:.5em;\n  text-transform:uppercase;\n}\n\n/* ── BOTTOM TAGLINE ── */\n.tagline{\n  position:absolute;bottom:5vh;left:0;right:0;\n  text-align:center;z-index:11;\n  font-family:'IM Fell English',serif;\n  font-style:italic;\n  font-size:clamp(9px,1vw,13px);\n  letter-spacing:6px;\n  color:rgba(212,168,67,.25);\n  text-transform:uppercase;\n  opacity:0;animation:fadeIn 1.5s ease forwards 3.5s;\n}\n\n/* ── ANIMATIONS ── */\n@keyframes fadeUp{\n  from{opacity:0;transform:translateY(12px)}\n  to{opacity:1;transform:translateY(0)}\n}\n@keyframes fadeIn{\n  to{opacity:1}\n}\n\n/* ── CANDLE GLOW BEHIND CROSS ── */\n.candle-glow{\n  position:absolute;\n  width:clamp(200px,30vw,400px);\n  height:clamp(200px,30vw,400px);\n  border-radius:50%;\n  background:radial-gradient(circle,rgba(212,168,67,.12) 0%,rgba(180,100,20,.06) 40%,transparent 70%);\n  top:50%;left:50%;transform:translate(-50%,-50%);\n  z-index:5;\n  animation:candleGlow 3s ease-in-out infinite;\n}\n@keyframes candleGlow{\n  0%,100%{opacity:.8;transform:translate(-50%,-50%) scale(1)}\n  50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <canvas id=\"cFlame\"></canvas>\n  <div class=\"vignette\"></div>\n  <div class=\"candle-glow\"></div>\n  <canvas id=\"cDust\"></canvas>\n\n  <!-- Frame -->\n  <div class=\"frame\"></div>\n  <div class=\"frame-corner fc-tl\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n  <div class=\"frame-corner fc-tr\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n  <div class=\"frame-corner fc-bl\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n  <div class=\"frame-corner fc-br\">\n    <svg viewBox=\"0 0 50 50\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M2 48 L2 2 L48 2\" stroke-linecap=\"round\"/>\n      <path d=\"M2 20 L2 2 L20 2\" stroke-width=\"2.5\" opacity=\".8\"/>\n      <circle cx=\"2\" cy=\"2\" r=\"2.5\" fill=\"#d4a843\" stroke=\"none\"/>\n      <path d=\"M10 2 L10 8 M2 10 L8 10\" opacity=\".5\"/>\n    </svg>\n  </div>\n\n  <!-- CONTENT -->\n  <div class=\"content\">\n    <div class=\"halo\">\n      <div class=\"halo-ring\">\n        <span class=\"cross-symbol\">✝</span>\n      </div>\n    </div>\n\n    <div class=\"tag\">Welcome to</div>\n\n    <div class=\"divider\">\n      <div class=\"div-line\"></div>\n      <span class=\"div-gem\">✦</span>\n      <span class=\"div-gem\" style=\"font-size:.6em;opacity:.5\">✦</span>\n      <span class=\"div-gem\">✦</span>\n      <div class=\"div-line r\"></div>\n    </div>\n\n    <div class=\"title-block\">\n      <span class=\"t1\">நல்ல சமாரியன் இயேசு</span>\n      <span class=\"t2\">ஜெப வீடு</span>\n    </div>\n\n    <div class=\"divider2\">\n      <div class=\"div2-line\"></div>\n      <div class=\"div2-dot\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n      <div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n      <div class=\"div2-dot\"></div>\n      <div class=\"div2-line r\"></div>\n    </div>\n\n    <div class=\"verse\">\n      என்னுடைய வீடு ஜெபவீடு என்னப்படும்\n      <cite>— மத்தேயு 21:13</cite>\n    </div>\n  </div>\n\n  <div class=\"tagline\">Good Samarian Jesus Prayer House</div>\n</div>\n\n<script>\n/* ══════════════════════════════\n   FLAME / EMBER BACKGROUND\n══════════════════════════════ */\n(function(){\n  const cv = document.getElementById('cFlame');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n\n  function resize(){\n    W = cv.width  = window.innerWidth;\n    H = cv.height = window.innerHeight;\n  }\n  resize();\n  window.addEventListener('resize', resize);\n\n  // Noise helper (simple smooth noise)\n  function noise(x, y, t){\n    return Math.sin(x * .012 + t * .008) * Math.cos(y * .009 - t * .006) * .5\n         + Math.sin(x * .007 - t * .005) * Math.sin(y * .013 + t * .007) * .3\n         + Math.sin((x+y) * .006 + t * .004) * .2;\n  }\n\n  function draw(){\n    t++;\n    cx.clearRect(0,0,W,H);\n\n    // Deep warm base\n    const bg = cx.createRadialGradient(W*.5, H*.7, 0, W*.5, H*.5, H*.9);\n    bg.addColorStop(0,  'rgba(30,10,0,1)');\n    bg.addColorStop(.3, 'rgba(20,6,0,1)');\n    bg.addColorStop(.7, 'rgba(10,3,0,1)');\n    bg.addColorStop(1,  'rgba(5,1,0,1)');\n    cx.fillStyle = bg;\n    cx.fillRect(0,0,W,H);\n\n    // Slow fire columns rising from bottom\n    const cols = 12;\n    for(let i=0;i<cols;i++){\n      const cx_ = (i/(cols-1)) * W;\n      const height = H * (.3 + noise(i*80, 0, t) * .25 + .15);\n      const baseX  = cx_ + noise(i*60, t, 0) * 40;\n      const alpha  = (.04 + Math.abs(noise(i*40, t*1.2, i)) * .06) * (1 - Math.abs((i/(cols-1))-.5)*1.2);\n      if(alpha <= 0) continue;\n\n      const grd = cx.createLinearGradient(baseX, H, baseX + noise(i,t,0)*20, H - height);\n      grd.addColorStop(0,   `rgba(180,80,0,${alpha})`);\n      grd.addColorStop(.35, `rgba(220,120,0,${alpha*.8})`);\n      grd.addColorStop(.65, `rgba(200,140,30,${alpha*.4})`);\n      grd.addColorStop(1,   `rgba(255,200,50,0)`);\n\n      cx.save();\n      cx.beginPath();\n      const w = W / cols * (.6 + Math.abs(noise(i*30,t,0)) * .8);\n      cx.ellipse(baseX, H, w*.5, height*.6, 0, 0, Math.PI*2);\n      cx.fillStyle = grd;\n      cx.fill();\n      cx.restore();\n    }\n\n    // Central altar glow\n    const cg = cx.createRadialGradient(W*.5, H*.72, 0, W*.5, H*.65, H*.45);\n    cg.addColorStop(0,   'rgba(212,168,67,.07)');\n    cg.addColorStop(.3,  'rgba(180,100,20,.04)');\n    cg.addColorStop(.6,  'rgba(150,60,0,.02)');\n    cg.addColorStop(1,   'rgba(0,0,0,0)');\n    cx.fillStyle = cg;\n    cx.fillRect(0,0,W,H);\n\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n\n/* ══════════════════════════════\n   GOLDEN DUST PARTICLES\n══════════════════════════════ */\n(function(){\n  const cv = document.getElementById('cDust');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  function resize(){W = cv.width = window.innerWidth; H = cv.height = window.innerHeight;}\n  resize();\n  window.addEventListener('resize', resize);\n\n  class Mote {\n    constructor(){ this.reset(true) }\n    reset(init){\n      this.x  = Math.random();\n      this.y  = init ? Math.random() : 1.02;\n      this.r  = Math.random() * 1.8 + .4;\n      this.vy = -(Math.random() * .0006 + .0001);\n      this.vx = (Math.random() - .5) * .0003;\n      this.a  = 0;\n      this.maxA = Math.random() * .6 + .15;\n      this.phase = Math.random() * Math.PI * 2;\n      this.speed = Math.random() * .02 + .01;\n      // gold palette\n      const palettes = [\n        [212,168,67],[240,204,112],[255,235,150],\n        [196,122,30],[255,200,80],[180,140,60]\n      ];\n      this.color = palettes[Math.floor(Math.random()*palettes.length)];\n    }\n    update(){\n      this.phase += this.speed;\n      this.y  += this.vy;\n      this.x  += this.vx + Math.sin(this.phase * .4) * .0001;\n      // fade in/out\n      if(this.y > .7) this.a = Math.min(this.maxA, this.a + .005);\n      if(this.y < .2) this.a = Math.max(0, this.a - .003);\n      if(this.y < -.03) this.reset(false);\n    }\n    draw(cx){\n      if(this.a <= 0) return;\n      const px = this.x * W, py = this.y * H;\n      const [r,g,b] = this.color;\n      const glow = (Math.sin(this.phase) * .5 + .5);\n      cx.save();\n      cx.globalAlpha = this.a * (.6 + glow * .4);\n      cx.shadowColor = `rgba(${r},${g},${b},0.9)`;\n      cx.shadowBlur  = this.r * 5;\n\n      // alternating shape\n      if(this.r > 1.5){\n        // tiny cross-sparkle\n        cx.strokeStyle = `rgba(${r},${g},${b},1)`;\n        cx.lineWidth = .8;\n        cx.beginPath();\n        cx.moveTo(px - this.r*2, py); cx.lineTo(px + this.r*2, py);\n        cx.moveTo(px, py - this.r*2); cx.lineTo(px, py + this.r*2);\n        cx.stroke();\n      } else {\n        cx.beginPath();\n        cx.arc(px, py, this.r, 0, Math.PI*2);\n        cx.fillStyle = `rgba(${r},${g},${b},1)`;\n        cx.fill();\n      }\n      cx.restore();\n    }\n  }\n\n  // Slow drifting beam\n  class LightBeam {\n    constructor(){ this.reset() }\n    reset(){\n      this.x = Math.random();\n      this.w = Math.random() * .06 + .02;\n      this.a = 0;\n      this.maxA = Math.random() * .04 + .01;\n      this.phase = Math.random() * Math.PI * 2;\n      this.speed = Math.random() * .003 + .001;\n      this.vx = (Math.random() - .5) * .0002;\n    }\n    update(){\n      this.phase += this.speed;\n      this.x += this.vx;\n      this.a = this.maxA * (Math.sin(this.phase) * .5 + .5);\n      if(this.x < -.1 || this.x > 1.1) this.vx *= -1;\n    }\n    draw(cx){\n      if(this.a <= 0) return;\n      const px = this.x * W;\n      const g = cx.createLinearGradient(px - this.w*W*.5, 0, px + this.w*W*.5, 0);\n      g.addColorStop(0,   'rgba(212,168,67,0)');\n      g.addColorStop(.5,  `rgba(212,168,67,${this.a})`);\n      g.addColorStop(1,   'rgba(212,168,67,0)');\n      cx.fillStyle = g;\n      cx.fillRect(px - this.w*W*.5, 0, this.w*W, H);\n    }\n  }\n\n  const motes = Array.from({length:160}, () => new Mote());\n  const beams = Array.from({length:5},  () => new LightBeam());\n\n  function draw(){\n    t++;\n    cx.clearRect(0,0,W,H);\n    beams.forEach(b => { b.update(); b.draw(cx); });\n    motes.forEach(m => { m.update(); m.draw(cx); });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1775933223980.9812,
      "type": "html",
      "name": "Bishop Title",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Thor Style Lightning Title - Sequential</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #020611; }\n    \n    .stage { \n      width: 100vw; height: 100vh; position: relative; overflow: hidden;\n      perspective: 1000px;\n    }\n\n    /* Background video is now much more visible */\n    .video-bg {\n      position: absolute; inset: 0; z-index: 0;\n      width: 100%; height: 100%; object-fit: cover;\n      opacity: 0.8; /* Increased visibility */\n    }\n\n    /* Subtle vignette just to keep the text readable, not hiding the video */\n    .overlay {\n      position: absolute; inset: 0; z-index: 1;\n      background: radial-gradient(circle at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);\n    }\n\n    /* --- Localized Lightning Strikes --- */\n    .lightning {\n      position: absolute; z-index: 2;\n      border-radius: 50%;\n      mix-blend-mode: overlay;\n      pointer-events: none;\n      opacity: 0;\n    }\n    \n    .strike-top-left {\n      top: -20%; left: -10%; width: 60vw; height: 60vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 60%);\n      animation: localizedFlash 4s infinite 1.5s;\n    }\n    \n    .strike-right {\n      top: 20%; right: -20%; width: 70vw; height: 70vw;\n      background: radial-gradient(circle, #b3e5fc 0%, transparent 60%);\n      animation: localizedFlash 5.5s infinite 3s;\n    }\n    \n    .strike-bottom {\n      bottom: -30%; left: 20%; width: 80vw; height: 50vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 70%);\n      animation: localizedFlash 6s infinite 0.5s;\n    }\n\n    /* Container for the text */\n    .content {\n      position: absolute; inset: 0; z-index: 10;\n      display: flex; flex-direction: column;\n      align-items: center; justify-content: center;\n    }\n\n    /* Base styling for all words */\n    .word {\n      display: inline-block;\n      color: #ffffff;\n      white-space: nowrap;\n      opacity: 0; /* Hidden initially */\n      /* Reduced, sharper glow for readability */\n      text-shadow: \n        0 0 4px #fff,\n        0 0 10px #00e5ff,\n        0 0 20px #008cff;\n    }\n\n    .title-small {\n      font-size: clamp(16px, 3vw, 40px);\n      letter-spacing: 20px;\n      font-family: 'Cinzel', serif;\n      font-weight: 700;\n      margin-bottom: 10px;\n      margin-right: -20px; /* Offset for letter spacing */\n    }\n\n    .title-large {\n      font-size: clamp(30px, 8vw, 120px);\n      font-weight: 900;\n      font-family: 'Montserrat', sans-serif;\n      letter-spacing: 5px;\n      display: flex;\n      gap: 2vw; /* Space between PAUL and YUVARAJ */\n    }\n\n    /* \n      Word-by-Word Sequential Animations \n      Using animation delays to bring them in one after the other \n    */\n    .w-bishop {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 0.5s,\n        subtleFlicker 3s infinite alternate 1.7s;\n    }\n\n    .w-paul {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 1.7s,\n        subtleFlicker 3s infinite alternate 2.9s;\n    }\n\n    .w-yuvaraj {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 2.6s,\n        subtleFlicker 3s infinite alternate 3.8s;\n    }\n\n    /* \n      The Animation: Starts as a distant glowing star, zooms in, \n      bounces slightly (impact), and clears up perfectly.\n    */\n    @keyframes starZoomSlam {\n      0% {\n        opacity: 0;\n        transform: translateZ(-2000px) scale(0.01);\n        filter: blur(10px);\n        text-shadow: 0 0 100px #fff, 0 0 300px #00e5ff;\n        color: transparent;\n      }\n      40% {\n        opacity: 1;\n        transform: translateZ(-500px) scale(0.5);\n        filter: blur(4px);\n        color: #fff;\n      }\n      80% {\n        transform: translateZ(50px) scale(1.1); /* Slams past normal size */\n        filter: blur(0px);\n      }\n      90% {\n        transform: translateZ(-10px) scale(0.97); /* Bounces back */\n      }\n      100% {\n        opacity: 1;\n        transform: translateZ(0) scale(1); /* Settles perfectly clear */\n        filter: blur(0px);\n      }\n    }\n\n    /* Random sharp flashes for the background lightning */\n    @keyframes localizedFlash {\n      0%, 9%, 11%, 49%, 51%, 100% { opacity: 0; }\n      10% { opacity: 0.8; } /* Bright flash */\n      12% { opacity: 0.2; } /* Fade out */\n      15% { opacity: 0.6; } /* Secondary crackle */\n      50% { opacity: 0.4; } /* Random mid-animation flash */\n    }\n\n    /* A very subtle crisp electric flicker for the text after it lands */\n    @keyframes subtleFlicker {\n      0%, 100% {\n        text-shadow: 0 0 4px #fff, 0 0 10px #00e5ff, 0 0 20px #008cff;\n      }\n      50% {\n        text-shadow: 0 0 2px #fff, 0 0 5px #00e5ff, 0 0 10px #008cff;\n      }\n      55% {\n        text-shadow: 0 0 8px #fff, 0 0 15px #00e5ff, 0 0 30px #008cff;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\">\n    <!-- Background video (Now much clearer) -->\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"earthbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <!-- Thunder strikes happening in different areas -->\n    <div class=\"lightning strike-top-left\"></div>\n    <div class=\"lightning strike-right\"></div>\n    <div class=\"lightning strike-bottom\"></div>\n    \n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <!-- First word -->\n      <div class=\"title-small\">\n        <span class=\"word w-bishop\">பிஷப்</span>\n      </div>\n\n      <!-- Second and Third words -->\n      <div class=\"title-large\">\n        <span class=\"word w-paul\">வி. பால்</span>\n        <span class=\"word w-yuvaraj\">யுவராஜ்</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
      "bookmarked": false,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Thor Style Lightning Title - Sequential</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #020611; }\n    \n    .stage { \n      width: 100vw; height: 100vh; position: relative; overflow: hidden;\n      perspective: 1000px;\n    }\n\n    /* Background video is now much more visible */\n    .video-bg {\n      position: absolute; inset: 0; z-index: 0;\n      width: 100%; height: 100%; object-fit: cover;\n      opacity: 0.8; /* Increased visibility */\n    }\n\n    /* Subtle vignette just to keep the text readable, not hiding the video */\n    .overlay {\n      position: absolute; inset: 0; z-index: 1;\n      background: radial-gradient(circle at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);\n    }\n\n    /* --- Localized Lightning Strikes --- */\n    .lightning {\n      position: absolute; z-index: 2;\n      border-radius: 50%;\n      mix-blend-mode: overlay;\n      pointer-events: none;\n      opacity: 0;\n    }\n    \n    .strike-top-left {\n      top: -20%; left: -10%; width: 60vw; height: 60vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 60%);\n      animation: localizedFlash 4s infinite 1.5s;\n    }\n    \n    .strike-right {\n      top: 20%; right: -20%; width: 70vw; height: 70vw;\n      background: radial-gradient(circle, #b3e5fc 0%, transparent 60%);\n      animation: localizedFlash 5.5s infinite 3s;\n    }\n    \n    .strike-bottom {\n      bottom: -30%; left: 20%; width: 80vw; height: 50vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 70%);\n      animation: localizedFlash 6s infinite 0.5s;\n    }\n\n    /* Container for the text */\n    .content {\n      position: absolute; inset: 0; z-index: 10;\n      display: flex; flex-direction: column;\n      align-items: center; justify-content: center;\n    }\n\n    /* Base styling for all words */\n    .word {\n      display: inline-block;\n      color: #ffffff;\n      white-space: nowrap;\n      opacity: 0; /* Hidden initially */\n      /* Reduced, sharper glow for readability */\n      text-shadow: \n        0 0 4px #fff,\n        0 0 10px #00e5ff,\n        0 0 20px #008cff;\n    }\n\n    .title-small {\n      font-size: clamp(16px, 3vw, 40px);\n      letter-spacing: 20px;\n      font-family: 'Cinzel', serif;\n      font-weight: 700;\n      margin-bottom: 10px;\n      margin-right: -20px; /* Offset for letter spacing */\n    }\n\n    .title-large {\n      font-size: clamp(30px, 8vw, 120px);\n      font-weight: 900;\n      font-family: 'Montserrat', sans-serif;\n      letter-spacing: 5px;\n      display: flex;\n      gap: 2vw; /* Space between PAUL and YUVARAJ */\n    }\n\n    /* \n      Word-by-Word Sequential Animations \n      Using animation delays to bring them in one after the other \n    */\n    .w-bishop {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 0.5s,\n        subtleFlicker 3s infinite alternate 1.7s;\n    }\n\n    .w-paul {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 1.7s,\n        subtleFlicker 3s infinite alternate 2.9s;\n    }\n\n    .w-yuvaraj {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 2.6s,\n        subtleFlicker 3s infinite alternate 3.8s;\n    }\n\n    /* \n      The Animation: Starts as a distant glowing star, zooms in, \n      bounces slightly (impact), and clears up perfectly.\n    */\n    @keyframes starZoomSlam {\n      0% {\n        opacity: 0;\n        transform: translateZ(-2000px) scale(0.01);\n        filter: blur(10px);\n        text-shadow: 0 0 100px #fff, 0 0 300px #00e5ff;\n        color: transparent;\n      }\n      40% {\n        opacity: 1;\n        transform: translateZ(-500px) scale(0.5);\n        filter: blur(4px);\n        color: #fff;\n      }\n      80% {\n        transform: translateZ(50px) scale(1.1); /* Slams past normal size */\n        filter: blur(0px);\n      }\n      90% {\n        transform: translateZ(-10px) scale(0.97); /* Bounces back */\n      }\n      100% {\n        opacity: 1;\n        transform: translateZ(0) scale(1); /* Settles perfectly clear */\n        filter: blur(0px);\n      }\n    }\n\n    /* Random sharp flashes for the background lightning */\n    @keyframes localizedFlash {\n      0%, 9%, 11%, 49%, 51%, 100% { opacity: 0; }\n      10% { opacity: 0.8; } /* Bright flash */\n      12% { opacity: 0.2; } /* Fade out */\n      15% { opacity: 0.6; } /* Secondary crackle */\n      50% { opacity: 0.4; } /* Random mid-animation flash */\n    }\n\n    /* A very subtle crisp electric flicker for the text after it lands */\n    @keyframes subtleFlicker {\n      0%, 100% {\n        text-shadow: 0 0 4px #fff, 0 0 10px #00e5ff, 0 0 20px #008cff;\n      }\n      50% {\n        text-shadow: 0 0 2px #fff, 0 0 5px #00e5ff, 0 0 10px #008cff;\n      }\n      55% {\n        text-shadow: 0 0 8px #fff, 0 0 15px #00e5ff, 0 0 30px #008cff;\n      }\n    }\n  </style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n  <div class=\"stage\">\n    <!-- Background video (Now much clearer) -->\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"earthbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <!-- Thunder strikes happening in different areas -->\n    <div class=\"lightning strike-top-left\"></div>\n    <div class=\"lightning strike-right\"></div>\n    <div class=\"lightning strike-bottom\"></div>\n    \n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <!-- First word -->\n      <div class=\"title-small\">\n        <span class=\"word w-bishop\">பிஷப்</span>\n      </div>\n\n      <!-- Second and Third words -->\n      <div class=\"title-large\">\n        <span class=\"word w-paul\">வி. பால்</span>\n        <span class=\"word w-yuvaraj\">யுவராஜ்</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
