  "version": 1,
  "slides": [
    {
      "id": 1774107563826.375,
      "type": "html",
      "name": "TITLE 2 ",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;600;700;900&family=Playfair+Display:ital,wght@1,400;0,700;0,900&family=IM+Fell+English:ital@1&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;}\n:root{\n--gold:#d4a843;\n--gold-light:#f0cc70;\n--cream:#fdf6e3;\n--amber:#c47a1e;\n--deep:#1a0a00;\n--warm-dark:#120800;\n}\n.stage{\nwidth:100vw;\nheight:100vh;\nposition:relative;\noverflow:hidden;\nbackground:linear-gradient(135deg,#1a0b2e 0%,#2d1b4e 8%,#16213e 16%,#0f3460 24%,#1a2b4e 32%,#1a1a2e 40%,#2a1845 48%,#16213e 56%,#0f3460 64%,#1b2f3a 72%,#1a0b2e 80%,#2d1b4e 88%,#16213e 96%,#1a1a2e 100%);\nbackground-size:400% 400%;\nanimation:bgShift 15s ease infinite;\n}\n@keyframes bgShift{\n0%{background-position:0% 50%;}\n50%{background-position:100% 50%;}\n100%{background-position:0% 50%;}\n}\n/* ── LAYERED CANVASES ── */\ncanvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n#cFlame{z-index:1;opacity:0.15;}\n#cDust{z-index:3;opacity:0.3;}\n/* ── VIGNETTE ── */\n.vignette{\nposition:absolute;\ninset:0;\nz-index:4;\nbackground:radial-gradient(ellipse 85% 85% at 50% 50%,transparent 30%,rgba(10,4,20,.3) 60%,rgba(5,2,15,.7) 100%);\npointer-events:none;\n}\n/* ── ORNAMENTAL FRAME - REMOVED ── */\n/* ── CONTENT CENTER ── */\n.content{\nposition:absolute;\ninset:0;\nz-index:10;\ndisplay:flex;\nflex-direction:column;\nalign-items:center;\njustify-content:center;\npadding:3vh 4vw;\noverflow:hidden;\n}\n/* ── HALO RING ── */\n.halo{\nposition:relative;\nmargin-bottom:1.8vh;\nopacity:0;\nanimation:haloIn 1.5s cubic-bezier(.2,1,.4,1) forwards .2s;\n}\n@keyframes haloIn{\n0%{opacity:0;transform:scale(.5);filter:blur(30px)}\n60%{opacity:1;filter:blur(2px)}\n100%{opacity:1;transform:scale(1);filter:blur(0)}\n}\n.halo-ring{\nwidth:clamp(140px,16vw,230px);\nheight:clamp(140px,16vw,230px);\nborder-radius:50%;\nborder:1px solid rgba(126,232,255,.25);\ndisplay:flex;\nalign-items:center;\njustify-content:center;\nposition:relative;\nanimation:rotateSlow 20s linear infinite;\n}\n@keyframes rotateSlow{to{transform:rotate(360deg)}}\n.halo-ring::before{\ncontent:'';\nposition:absolute;\ninset:-6px;\nborder-radius:50%;\nborder:1px solid transparent;\nborder-top-color:#7ee8ff;\nborder-right-color:rgba(126,232,255,.4);\nanimation:rotateFast 4s linear infinite;\n}\n@keyframes rotateFast{to{transform:rotate(-360deg)}}\n.halo-ring::after{\ncontent:'';\nposition:absolute;\ninset:-14px;\nborder-radius:50%;\nborder:1px solid rgba(126,232,255,.15);\nborder-bottom-color:rgba(162,89,255,.4);\nanimation:rotateFast 7s linear infinite reverse;\n}\n.cross-symbol{\nfont-size:clamp(110px,14vw,200px);\nline-height:1;\nanimation:rotateSlow 20s linear infinite reverse;\nbackground:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\nbackground-size:300% auto;\n-webkit-background-clip:text;\n-webkit-text-fill-color:transparent;\nbackground-clip:text;\nanimation:rainbowShift 3s linear infinite, rotateSlow 20s linear infinite reverse;\n}\n@keyframes rainbowShift{\n0%{background-position:0% center;}\n100%{background-position:300% center;}\n}\n/* ── TOP TAG ── */\n.tag{\nfont-family:'IM Fell English',serif;\nfont-style:italic;\nfont-size:clamp(14px,1.7vw,22px);\nletter-spacing:8px;\ntext-transform:uppercase;\ncolor:rgba(126,232,255,.6);\nmargin-bottom:1.2vh;\nopacity:0;\nanimation:fadeUp .8s ease forwards 1.2s;\n}\n/* ── DIVIDER ── */\n.divider{\ndisplay:flex;\nalign-items:center;\ngap:1.5vw;\nmargin-bottom:1.2vh;\nopacity:0;\nanimation:fadeIn .8s ease forwards 1.5s;\n}\n.div-line{\nheight:1px;\nwidth:clamp(45px,9vw,130px);\nbackground:linear-gradient(90deg,transparent,#7ee8ff);\n}\n.div-line.r{\nbackground:linear-gradient(90deg,#7ee8ff,transparent);\n}\n.div-gem{\nfont-size:clamp(10px,1.3vw,16px);\ncolor:#7ee8ff;\ntext-shadow:0 0 10px rgba(126,232,255,.8);\n}\n/* ── MAIN TITLE ── */\n.title-block{\ntext-align:center;\nmargin-bottom:1vh;\nmax-width:90vw;\n}\n.t1{\ndisplay:block;\nfont-family:'Noto Serif Tamil',serif;\nfont-size:clamp(42px,6.5vw,100px);\nfont-weight:900;\nline-height:1.1;\nletter-spacing:3px;\nbackground:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\nbackground-size:300% auto;\n-webkit-background-clip:text;\n-webkit-text-fill-color:transparent;\nbackground-clip:text;\nanimation:rainbowShift 3s linear infinite, slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 1.8s;\nopacity:0;\n}\n.t2{\ndisplay:block;\nfont-family:'Noto Serif Tamil',serif;\nfont-size:clamp(28px,4.2vw,62px);\nfont-weight:600;\nletter-spacing:10px;\nbackground:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\nbackground-size:300% auto;\n-webkit-background-clip:text;\n-webkit-text-fill-color:transparent;\nbackground-clip:text;\nanimation:rainbowShift 3s linear infinite, slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 2.1s;\nopacity:0;\n}\n@keyframes slideDown{\nfrom{opacity:0;transform:translateY(-20px);filter:blur(8px)}\nto{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n@keyframes slideUp{\nfrom{opacity:0;transform:translateY(20px);filter:blur(8px)}\nto{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n/* ── DIVIDER 2 ── */\n.divider2{\nmargin-bottom:1.2vh;\nopacity:0;\nanimation:fadeIn .8s ease forwards 2.6s;\ndisplay:flex;\nalign-items:center;\ngap:1vw;\n}\n.div2-line{\nheight:1px;\nwidth:clamp(35px,7vw,100px);\nbackground:linear-gradient(90deg,transparent,rgba(126,232,255,.3));\n}\n.div2-line.r{\nbackground:linear-gradient(90deg,rgba(126,232,255,.3),transparent);\n}\n.div2-dot{\nwidth:4px;\nheight:4px;\nborder-radius:50%;\nbackground:#7ee8ff;\nbox-shadow:0 0 8px #7ee8ff;\n}\n/* ── VERSE ── */\n.verse{\nfont-family:'Playfair Display',serif;\nfont-style:italic;\nfont-size:clamp(20px,2.5vw,36px);\ncolor:rgba(126,232,255,.65);\nletter-spacing:1.5px;\ntext-align:center;\npadding:0 8vw;\nline-height:1.6;\nopacity:0;\nanimation:fadeUp .8s ease forwards 2.9s;\nmax-width:85vw;\n}\n.verse cite{\ndisplay:block;\nfont-style:normal;\nfont-family:'IM Fell English',serif;\nfont-size:.95em;\ncolor:rgba(126,232,255,.5);\nletter-spacing:3px;\nmargin-top:.6em;\ntext-transform:uppercase;\n}\n/* ── ANIMATIONS ── */\n@keyframes fadeUp{\nfrom{opacity:0;transform:translateY(12px)}\nto{opacity:1;transform:translateY(0)}\n}\n@keyframes fadeIn{to{opacity:1}}\n/* ── CANDLE GLOW BEHIND CROSS ── */\n.candle-glow{\nposition:absolute;\nwidth:clamp(220px,32vw,450px);\nheight:clamp(220px,32vw,450px);\nborder-radius:50%;\nbackground:radial-gradient(circle,rgba(126,232,255,.08) 0%,rgba(162,89,255,.04) 40%,transparent 70%);\ntop:50%;\nleft:50%;\ntransform:translate(-50%,-50%);\nz-index:5;\nanimation:candleGlow 3s ease-in-out infinite;\n}\n@keyframes candleGlow{\n0%,100%{opacity:.8;transform:translate(-50%,-50%) scale(1)}\n50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}\n}\n/* Responsive */\n@media (max-width: 768px) {\n.tag{font-size:clamp(12px,1.5vw,18px);letter-spacing:6px;}\n.t1{font-size:clamp(34px,5.8vw,85px);letter-spacing:2px;}\n.t2{font-size:clamp(24px,3.8vw,54px);letter-spacing:8px;}\n.cross-symbol{font-size:clamp(90px,12vw,170px);}\n.halo-ring{width:clamp(110px,14vw,180px);height:clamp(110px,14vw,180px);}\n.verse{font-size:clamp(18px,2.2vw,32px);padding:0 5vw;}\n.verse cite{font-size:.9em;}\n.content{padding:2vh 3vw;}\n}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n<canvas id=\"cFlame\"></canvas>\n<div class=\"vignette\"></div>\n<div class=\"candle-glow\"></div>\n<canvas id=\"cDust\"></canvas>\n<!-- CONTENT -->\n<div class=\"content\">\n<div class=\"halo\">\n<div class=\"halo-ring\">\n<span class=\"cross-symbol\">✝</span>\n</div>\n</div>\n<div class=\"tag\">Welcome to</div>\n<div class=\"divider\">\n<div class=\"div-line\"></div>\n<span class=\"div-gem\">✦</span>\n<span class=\"div-gem\" style=\"font-size:.6em;opacity:.5\">✦</span>\n<span class=\"div-gem\">✦</span>\n<div class=\"div-line r\"></div>\n</div>\n<div class=\"title-block\">\n<span class=\"t1\">நல்ல சமாரியன் இயேசு</span>\n<span class=\"t2\">ஜெப வீடு</span>\n</div>\n<div class=\"divider2\">\n<div class=\"div2-line\"></div>\n<div class=\"div2-dot\"></div>\n<div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n<div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n<div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n<div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n<div class=\"div2-dot\"></div>\n<div class=\"div2-line r\"></div>\n</div>\n<div class=\"verse\">\nஎன்னுடைய வீடு ஜெபவீடு என்னப்படும்\n<cite>— மத்தேயு 21:13</cite>\n</div>\n</div>\n</div>\n<script>\n/* ══════════════════════════════\nFLAME / EMBER BACKGROUND\n══════════════════════════════ */\n(function(){\nconst cv = document.getElementById('cFlame');\nconst cx = cv.getContext('2d');\nlet W, H, t = 0;\nfunction resize(){\nW = cv.width  = window.innerWidth;\nH = cv.height = window.innerHeight;\n}\nresize();\nwindow.addEventListener('resize', resize);\n// Noise helper (simple smooth noise)\nfunction noise(x, y, t){\nreturn Math.sin(x * .012 + t * .008) * Math.cos(y * .009 - t * .006) * .5\n+ Math.sin(x * .007 - t * .005) * Math.sin(y * .013 + t * .007) * .3\n+ Math.sin((x+y) * .006 + t * .004) * .2;\n}\nfunction draw(){\nt++;\ncx.clearRect(0,0,W,H);\n// Deep cool base\nconst bg = cx.createRadialGradient(W*.5, H*.7, 0, W*.5, H*.5, H*.9);\nbg.addColorStop(0,  'rgba(20,10,30,1)');\nbg.addColorStop(.3, 'rgba(15,10,25,1)');\nbg.addColorStop(.7, 'rgba(10,8,20,1)');\nbg.addColorStop(1,  'rgba(5,5,15,1)');\ncx.fillStyle = bg;\ncx.fillRect(0,0,W,H);\n// Slow ethereal columns\nconst cols = 12;\nfor(let i=0;i<cols;i++){\nconst cx_ = (i/(cols-1)) * W;\nconst height = H * (.3 + noise(i*80, 0, t) * .25 + .15);\nconst baseX  = cx_ + noise(i*60, t, 0) * 40;\nconst alpha  = (.04 + Math.abs(noise(i*40, t*1.2, i)) * .06) * (1 - Math.abs((i/(cols-1))-.5)*1.2);\nif(alpha <= 0) continue;\nconst grd = cx.createLinearGradient(baseX, H, baseX + noise(i,t,0)*20, H - height);\ngrd.addColorStop(0,   `rgba(80,150,200,${alpha})`);\ngrd.addColorStop(.35, `rgba(100,180,220,${alpha*.8})`);\ngrd.addColorStop(.65, `rgba(120,200,240,${alpha*.4})`);\ngrd.addColorStop(1,   `rgba(150,220,255,0)`);\ncx.save();\ncx.beginPath();\nconst w = W / cols * (.6 + Math.abs(noise(i*30,t,0)) * .8);\ncx.ellipse(baseX, H, w*.5, height*.6, 0, 0, Math.PI*2);\ncx.fillStyle = grd;\ncx.fill();\ncx.restore();\n}\n// Central glow\nconst cg = cx.createRadialGradient(W*.5, H*.72, 0, W*.5, H*.65, H*.45);\ncg.addColorStop(0,   'rgba(126,232,255,.05)');\ncg.addColorStop(.3,  'rgba(100,180,255,.03)');\ncg.addColorStop(.6,  'rgba(80,150,220,.02)');\ncg.addColorStop(1,   'rgba(0,0,0,0)');\ncx.fillStyle = cg;\ncx.fillRect(0,0,W,H);\nrequestAnimationFrame(draw);\n}\ndraw();\n})();\n/* ══════════════════════════════\nGOLDEN DUST PARTICLES\n══════════════════════════════ */\n(function(){\nconst cv = document.getElementById('cDust');\nconst cx = cv.getContext('2d');\nlet W, H, t = 0;\nfunction resize(){\nW = cv.width = window.innerWidth; H = cv.height = window.innerHeight;\n}\nresize();\nwindow.addEventListener('resize', resize);\nclass Mote {\nconstructor(){ this.reset(true) }\nreset(init){\nthis.x  = Math.random();\nthis.y  = init ? Math.random() : 1.02;\nthis.r  = Math.random() * 1.8 + .4;\nthis.vy = -(Math.random() * .0006 + .0001);\nthis.vx = (Math.random() - .5) * .0003;\nthis.a  = 0;\nthis.maxA = Math.random() * .6 + .15;\nthis.phase = Math.random() * Math.PI * 2;\nthis.speed = Math.random() * .02 + .01;\n// colorful palette\nconst palettes = [\n[126,232,255],[255,221,87],[114,245,168],[162,89,255],[180,200,255],[200,255,180]\n];\nthis.color = palettes[Math.floor(Math.random()*palettes.length)];\n}\nupdate(){\nthis.phase += this.speed;\nthis.y  += this.vy;\nthis.x  += this.vx + Math.sin(this.phase * .4) * .0001;\n// fade in/out\nif(this.y > .7) this.a = Math.min(this.maxA, this.a + .005);\nif(this.y < .2) this.a = Math.max(0, this.a - .003);\nif(this.y < -.03) this.reset(false);\n}\ndraw(cx){\nif(this.a <= 0) return;\nconst px = this.x * W, py = this.y * H;\nconst [r,g,b] = this.color;\nconst glow = (Math.sin(this.phase) * .5 + .5);\ncx.save();\ncx.globalAlpha = this.a * (.6 + glow * .4);\ncx.shadowColor = `rgba(${r},${g},${b},0.9)`;\ncx.shadowBlur  = this.r * 5;\n// alternating shape\nif(this.r > 1.5){\n// tiny cross-sparkle\ncx.strokeStyle = `rgba(${r},${g},${b},1)`;\ncx.lineWidth = .8;\ncx.beginPath();\ncx.moveTo(px - this.r*2, py); cx.lineTo(px + this.r*2, py);\ncx.moveTo(px, py - this.r*2); cx.lineTo(px, py + this.r*2);\ncx.stroke();\n} else {\ncx.beginPath();\ncx.arc(px, py, this.r, 0, Math.PI*2);\ncx.fillStyle = `rgba(${r},${g},${b},1)`;\ncx.fill();\n}\ncx.restore();\n}\n}\n// Slow drifting beam\nclass LightBeam {\nconstructor(){ this.reset() }\nreset(){\nthis.x = Math.random();\nthis.w = Math.random() * .06 + .02;\nthis.a = 0;\nthis.maxA = Math.random() * .04 + .01;\nthis.phase = Math.random() * Math.PI * 2;\nthis.speed = Math.random() * .003 + .001;\nthis.vx = (Math.random() - .5) * .0002;\n}\nupdate(){\nthis.phase += this.speed;\nthis.x += this.vx;\nthis.a = this.maxA * (Math.sin(this.phase) * .5 + .5);\nif(this.x < -.1 || this.x > 1.1) this.vx *= -1;\n}\ndraw(cx){\nif(this.a <= 0) return;\nconst px = this.x * W;\nconst g = cx.createLinearGradient(px - this.w*W*.5, 0, px + this.w*W*.5, 0);\ng.addColorStop(0,   'rgba(126,232,255,0)');\ng.addColorStop(.5,  `rgba(126,232,255,${this.a})`);\ng.addColorStop(1,   'rgba(126,232,255,0)');\ncx.fillStyle = g;\ncx.fillRect(px - this.w*W*.5, 0, this.w*W, H);\n}\n}\nconst motes = Array.from({length:160}, () => new Mote());\nconst beams = Array.from({length:5},  () => new LightBeam());\nfunction draw(){\nt++;\ncx.clearRect(0,0,W,H);\nbeams.forEach(b => { b.update(); b.draw(cx); });\nmotes.forEach(m => { m.update(); m.draw(cx); });\nrequestAnimationFrame(draw);\n}\ndraw();\n})();\n</script>\n</body>\n</html>\n",
      "bookmarked": true,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;600;700;900&family=Playfair+Display:ital,wght@1,400;0,700;0,900&family=IM+Fell+English:ital@1&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;}\n:root{\n--gold:#d4a843;\n--gold-light:#f0cc70;\n--cream:#fdf6e3;\n--amber:#c47a1e;\n--deep:#1a0a00;\n--warm-dark:#120800;\n}\n.stage{\nwidth:100vw;\nheight:100vh;\nposition:relative;\noverflow:hidden;\nbackground:linear-gradient(135deg,#1a0b2e 0%,#2d1b4e 8%,#16213e 16%,#0f3460 24%,#1a2b4e 32%,#1a1a2e 40%,#2a1845 48%,#16213e 56%,#0f3460 64%,#1b2f3a 72%,#1a0b2e 80%,#2d1b4e 88%,#16213e 96%,#1a1a2e 100%);\nbackground-size:400% 400%;\nanimation:bgShift 15s ease infinite;\n}\n@keyframes bgShift{\n0%{background-position:0% 50%;}\n50%{background-position:100% 50%;}\n100%{background-position:0% 50%;}\n}\n/* ── LAYERED CANVASES ── */\ncanvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}\n#cFlame{z-index:1;opacity:0.15;}\n#cDust{z-index:3;opacity:0.3;}\n/* ── VIGNETTE ── */\n.vignette{\nposition:absolute;\ninset:0;\nz-index:4;\nbackground:radial-gradient(ellipse 85% 85% at 50% 50%,transparent 30%,rgba(10,4,20,.3) 60%,rgba(5,2,15,.7) 100%);\npointer-events:none;\n}\n/* ── ORNAMENTAL FRAME - REMOVED ── */\n/* ── CONTENT CENTER ── */\n.content{\nposition:absolute;\ninset:0;\nz-index:10;\ndisplay:flex;\nflex-direction:column;\nalign-items:center;\njustify-content:center;\npadding:3vh 4vw;\noverflow:hidden;\n}\n/* ── HALO RING ── */\n.halo{\nposition:relative;\nmargin-bottom:1.8vh;\nopacity:0;\nanimation:haloIn 1.5s cubic-bezier(.2,1,.4,1) forwards .2s;\n}\n@keyframes haloIn{\n0%{opacity:0;transform:scale(.5);filter:blur(30px)}\n60%{opacity:1;filter:blur(2px)}\n100%{opacity:1;transform:scale(1);filter:blur(0)}\n}\n.halo-ring{\nwidth:clamp(140px,16vw,230px);\nheight:clamp(140px,16vw,230px);\nborder-radius:50%;\nborder:1px solid rgba(126,232,255,.25);\ndisplay:flex;\nalign-items:center;\njustify-content:center;\nposition:relative;\nanimation:rotateSlow 20s linear infinite;\n}\n@keyframes rotateSlow{to{transform:rotate(360deg)}}\n.halo-ring::before{\ncontent:'';\nposition:absolute;\ninset:-6px;\nborder-radius:50%;\nborder:1px solid transparent;\nborder-top-color:#7ee8ff;\nborder-right-color:rgba(126,232,255,.4);\nanimation:rotateFast 4s linear infinite;\n}\n@keyframes rotateFast{to{transform:rotate(-360deg)}}\n.halo-ring::after{\ncontent:'';\nposition:absolute;\ninset:-14px;\nborder-radius:50%;\nborder:1px solid rgba(126,232,255,.15);\nborder-bottom-color:rgba(162,89,255,.4);\nanimation:rotateFast 7s linear infinite reverse;\n}\n.cross-symbol{\nfont-size:clamp(110px,14vw,200px);\nline-height:1;\nanimation:rotateSlow 20s linear infinite reverse;\nbackground:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\nbackground-size:300% auto;\n-webkit-background-clip:text;\n-webkit-text-fill-color:transparent;\nbackground-clip:text;\nanimation:rainbowShift 3s linear infinite, rotateSlow 20s linear infinite reverse;\n}\n@keyframes rainbowShift{\n0%{background-position:0% center;}\n100%{background-position:300% center;}\n}\n/* ── TOP TAG ── */\n.tag{\nfont-family:'IM Fell English',serif;\nfont-style:italic;\nfont-size:clamp(14px,1.7vw,22px);\nletter-spacing:8px;\ntext-transform:uppercase;\ncolor:rgba(126,232,255,.6);\nmargin-bottom:1.2vh;\nopacity:0;\nanimation:fadeUp .8s ease forwards 1.2s;\n}\n/* ── DIVIDER ── */\n.divider{\ndisplay:flex;\nalign-items:center;\ngap:1.5vw;\nmargin-bottom:1.2vh;\nopacity:0;\nanimation:fadeIn .8s ease forwards 1.5s;\n}\n.div-line{\nheight:1px;\nwidth:clamp(45px,9vw,130px);\nbackground:linear-gradient(90deg,transparent,#7ee8ff);\n}\n.div-line.r{\nbackground:linear-gradient(90deg,#7ee8ff,transparent);\n}\n.div-gem{\nfont-size:clamp(10px,1.3vw,16px);\ncolor:#7ee8ff;\ntext-shadow:0 0 10px rgba(126,232,255,.8);\n}\n/* ── MAIN TITLE ── */\n.title-block{\ntext-align:center;\nmargin-bottom:1vh;\nmax-width:90vw;\n}\n.t1{\ndisplay:block;\nfont-family:'Noto Serif Tamil',serif;\nfont-size:clamp(42px,6.5vw,100px);\nfont-weight:900;\nline-height:1.1;\nletter-spacing:3px;\nbackground:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\nbackground-size:300% auto;\n-webkit-background-clip:text;\n-webkit-text-fill-color:transparent;\nbackground-clip:text;\nanimation:rainbowShift 3s linear infinite, slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 1.8s;\nopacity:0;\n}\n.t2{\ndisplay:block;\nfont-family:'Noto Serif Tamil',serif;\nfont-size:clamp(28px,4.2vw,62px);\nfont-weight:600;\nletter-spacing:10px;\nbackground:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\nbackground-size:300% auto;\n-webkit-background-clip:text;\n-webkit-text-fill-color:transparent;\nbackground-clip:text;\nanimation:rainbowShift 3s linear infinite, slideDown 1s cubic-bezier(.2,1.4,.4,1) forwards 2.1s;\nopacity:0;\n}\n@keyframes slideDown{\nfrom{opacity:0;transform:translateY(-20px);filter:blur(8px)}\nto{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n@keyframes slideUp{\nfrom{opacity:0;transform:translateY(20px);filter:blur(8px)}\nto{opacity:1;transform:translateY(0);filter:blur(0)}\n}\n/* ── DIVIDER 2 ── */\n.divider2{\nmargin-bottom:1.2vh;\nopacity:0;\nanimation:fadeIn .8s ease forwards 2.6s;\ndisplay:flex;\nalign-items:center;\ngap:1vw;\n}\n.div2-line{\nheight:1px;\nwidth:clamp(35px,7vw,100px);\nbackground:linear-gradient(90deg,transparent,rgba(126,232,255,.3));\n}\n.div2-line.r{\nbackground:linear-gradient(90deg,rgba(126,232,255,.3),transparent);\n}\n.div2-dot{\nwidth:4px;\nheight:4px;\nborder-radius:50%;\nbackground:#7ee8ff;\nbox-shadow:0 0 8px #7ee8ff;\n}\n/* ── VERSE ── */\n.verse{\nfont-family:'Playfair Display',serif;\nfont-style:italic;\nfont-size:clamp(20px,2.5vw,36px);\ncolor:rgba(126,232,255,.65);\nletter-spacing:1.5px;\ntext-align:center;\npadding:0 8vw;\nline-height:1.6;\nopacity:0;\nanimation:fadeUp .8s ease forwards 2.9s;\nmax-width:85vw;\n}\n.verse cite{\ndisplay:block;\nfont-style:normal;\nfont-family:'IM Fell English',serif;\nfont-size:.95em;\ncolor:rgba(126,232,255,.5);\nletter-spacing:3px;\nmargin-top:.6em;\ntext-transform:uppercase;\n}\n/* ── ANIMATIONS ── */\n@keyframes fadeUp{\nfrom{opacity:0;transform:translateY(12px)}\nto{opacity:1;transform:translateY(0)}\n}\n@keyframes fadeIn{to{opacity:1}}\n/* ── CANDLE GLOW BEHIND CROSS ── */\n.candle-glow{\nposition:absolute;\nwidth:clamp(220px,32vw,450px);\nheight:clamp(220px,32vw,450px);\nborder-radius:50%;\nbackground:radial-gradient(circle,rgba(126,232,255,.08) 0%,rgba(162,89,255,.04) 40%,transparent 70%);\ntop:50%;\nleft:50%;\ntransform:translate(-50%,-50%);\nz-index:5;\nanimation:candleGlow 3s ease-in-out infinite;\n}\n@keyframes candleGlow{\n0%,100%{opacity:.8;transform:translate(-50%,-50%) scale(1)}\n50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}\n}\n/* Responsive */\n@media (max-width: 768px) {\n.tag{font-size:clamp(12px,1.5vw,18px);letter-spacing:6px;}\n.t1{font-size:clamp(34px,5.8vw,85px);letter-spacing:2px;}\n.t2{font-size:clamp(24px,3.8vw,54px);letter-spacing:8px;}\n.cross-symbol{font-size:clamp(90px,12vw,170px);}\n.halo-ring{width:clamp(110px,14vw,180px);height:clamp(110px,14vw,180px);}\n.verse{font-size:clamp(18px,2.2vw,32px);padding:0 5vw;}\n.verse cite{font-size:.9em;}\n.content{padding:2vh 3vw;}\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n<canvas id=\"cFlame\"></canvas>\n<div class=\"vignette\"></div>\n<div class=\"candle-glow\"></div>\n<canvas id=\"cDust\"></canvas>\n<!-- CONTENT -->\n<div class=\"content\">\n<div class=\"halo\">\n<div class=\"halo-ring\">\n<span class=\"cross-symbol\">✝</span>\n</div>\n</div>\n<div class=\"tag\">Welcome to</div>\n<div class=\"divider\">\n<div class=\"div-line\"></div>\n<span class=\"div-gem\">✦</span>\n<span class=\"div-gem\" style=\"font-size:.6em;opacity:.5\">✦</span>\n<span class=\"div-gem\">✦</span>\n<div class=\"div-line r\"></div>\n</div>\n<div class=\"title-block\">\n<span class=\"t1\">நல்ல சமாரியன் இயேசு</span>\n<span class=\"t2\">ஜெப வீடு</span>\n</div>\n<div class=\"divider2\">\n<div class=\"div2-line\"></div>\n<div class=\"div2-dot\"></div>\n<div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n<div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n<div class=\"div2-dot\" style=\"opacity:.2;width:2px;height:2px\"></div>\n<div class=\"div2-dot\" style=\"opacity:.4;width:3px;height:3px\"></div>\n<div class=\"div2-dot\"></div>\n<div class=\"div2-line r\"></div>\n</div>\n<div class=\"verse\">\nஎன்னுடைய வீடு ஜெபவீடு என்னப்படும்\n<cite>— மத்தேயு 21:13</cite>\n</div>\n</div>\n</div>\n<script>\n/* ══════════════════════════════\nFLAME / EMBER BACKGROUND\n══════════════════════════════ */\n(function(){\nconst cv = document.getElementById('cFlame');\nconst cx = cv.getContext('2d');\nlet W, H, t = 0;\nfunction resize(){\nW = cv.width  = window.innerWidth;\nH = cv.height = window.innerHeight;\n}\nresize();\nwindow.addEventListener('resize', resize);\n// Noise helper (simple smooth noise)\nfunction noise(x, y, t){\nreturn Math.sin(x * .012 + t * .008) * Math.cos(y * .009 - t * .006) * .5\n+ Math.sin(x * .007 - t * .005) * Math.sin(y * .013 + t * .007) * .3\n+ Math.sin((x+y) * .006 + t * .004) * .2;\n}\nfunction draw(){\nt++;\ncx.clearRect(0,0,W,H);\n// Deep cool base\nconst bg = cx.createRadialGradient(W*.5, H*.7, 0, W*.5, H*.5, H*.9);\nbg.addColorStop(0,  'rgba(20,10,30,1)');\nbg.addColorStop(.3, 'rgba(15,10,25,1)');\nbg.addColorStop(.7, 'rgba(10,8,20,1)');\nbg.addColorStop(1,  'rgba(5,5,15,1)');\ncx.fillStyle = bg;\ncx.fillRect(0,0,W,H);\n// Slow ethereal columns\nconst cols = 12;\nfor(let i=0;i<cols;i++){\nconst cx_ = (i/(cols-1)) * W;\nconst height = H * (.3 + noise(i*80, 0, t) * .25 + .15);\nconst baseX  = cx_ + noise(i*60, t, 0) * 40;\nconst alpha  = (.04 + Math.abs(noise(i*40, t*1.2, i)) * .06) * (1 - Math.abs((i/(cols-1))-.5)*1.2);\nif(alpha <= 0) continue;\nconst grd = cx.createLinearGradient(baseX, H, baseX + noise(i,t,0)*20, H - height);\ngrd.addColorStop(0,   `rgba(80,150,200,${alpha})`);\ngrd.addColorStop(.35, `rgba(100,180,220,${alpha*.8})`);\ngrd.addColorStop(.65, `rgba(120,200,240,${alpha*.4})`);\ngrd.addColorStop(1,   `rgba(150,220,255,0)`);\ncx.save();\ncx.beginPath();\nconst w = W / cols * (.6 + Math.abs(noise(i*30,t,0)) * .8);\ncx.ellipse(baseX, H, w*.5, height*.6, 0, 0, Math.PI*2);\ncx.fillStyle = grd;\ncx.fill();\ncx.restore();\n}\n// Central glow\nconst cg = cx.createRadialGradient(W*.5, H*.72, 0, W*.5, H*.65, H*.45);\ncg.addColorStop(0,   'rgba(126,232,255,.05)');\ncg.addColorStop(.3,  'rgba(100,180,255,.03)');\ncg.addColorStop(.6,  'rgba(80,150,220,.02)');\ncg.addColorStop(1,   'rgba(0,0,0,0)');\ncx.fillStyle = cg;\ncx.fillRect(0,0,W,H);\nrequestAnimationFrame(draw);\n}\ndraw();\n})();\n/* ══════════════════════════════\nGOLDEN DUST PARTICLES\n══════════════════════════════ */\n(function(){\nconst cv = document.getElementById('cDust');\nconst cx = cv.getContext('2d');\nlet W, H, t = 0;\nfunction resize(){\nW = cv.width = window.innerWidth; H = cv.height = window.innerHeight;\n}\nresize();\nwindow.addEventListener('resize', resize);\nclass Mote {\nconstructor(){ this.reset(true) }\nreset(init){\nthis.x  = Math.random();\nthis.y  = init ? Math.random() : 1.02;\nthis.r  = Math.random() * 1.8 + .4;\nthis.vy = -(Math.random() * .0006 + .0001);\nthis.vx = (Math.random() - .5) * .0003;\nthis.a  = 0;\nthis.maxA = Math.random() * .6 + .15;\nthis.phase = Math.random() * Math.PI * 2;\nthis.speed = Math.random() * .02 + .01;\n// colorful palette\nconst palettes = [\n[126,232,255],[255,221,87],[114,245,168],[162,89,255],[180,200,255],[200,255,180]\n];\nthis.color = palettes[Math.floor(Math.random()*palettes.length)];\n}\nupdate(){\nthis.phase += this.speed;\nthis.y  += this.vy;\nthis.x  += this.vx + Math.sin(this.phase * .4) * .0001;\n// fade in/out\nif(this.y > .7) this.a = Math.min(this.maxA, this.a + .005);\nif(this.y < .2) this.a = Math.max(0, this.a - .003);\nif(this.y < -.03) this.reset(false);\n}\ndraw(cx){\nif(this.a <= 0) return;\nconst px = this.x * W, py = this.y * H;\nconst [r,g,b] = this.color;\nconst glow = (Math.sin(this.phase) * .5 + .5);\ncx.save();\ncx.globalAlpha = this.a * (.6 + glow * .4);\ncx.shadowColor = `rgba(${r},${g},${b},0.9)`;\ncx.shadowBlur  = this.r * 5;\n// alternating shape\nif(this.r > 1.5){\n// tiny cross-sparkle\ncx.strokeStyle = `rgba(${r},${g},${b},1)`;\ncx.lineWidth = .8;\ncx.beginPath();\ncx.moveTo(px - this.r*2, py); cx.lineTo(px + this.r*2, py);\ncx.moveTo(px, py - this.r*2); cx.lineTo(px, py + this.r*2);\ncx.stroke();\n} else {\ncx.beginPath();\ncx.arc(px, py, this.r, 0, Math.PI*2);\ncx.fillStyle = `rgba(${r},${g},${b},1)`;\ncx.fill();\n}\ncx.restore();\n}\n}\n// Slow drifting beam\nclass LightBeam {\nconstructor(){ this.reset() }\nreset(){\nthis.x = Math.random();\nthis.w = Math.random() * .06 + .02;\nthis.a = 0;\nthis.maxA = Math.random() * .04 + .01;\nthis.phase = Math.random() * Math.PI * 2;\nthis.speed = Math.random() * .003 + .001;\nthis.vx = (Math.random() - .5) * .0002;\n}\nupdate(){\nthis.phase += this.speed;\nthis.x += this.vx;\nthis.a = this.maxA * (Math.sin(this.phase) * .5 + .5);\nif(this.x < -.1 || this.x > 1.1) this.vx *= -1;\n}\ndraw(cx){\nif(this.a <= 0) return;\nconst px = this.x * W;\nconst g = cx.createLinearGradient(px - this.w*W*.5, 0, px + this.w*W*.5, 0);\ng.addColorStop(0,   'rgba(126,232,255,0)');\ng.addColorStop(.5,  `rgba(126,232,255,${this.a})`);\ng.addColorStop(1,   'rgba(126,232,255,0)');\ncx.fillStyle = g;\ncx.fillRect(px - this.w*W*.5, 0, this.w*W, H);\n}\n}\nconst motes = Array.from({length:160}, () => new Mote());\nconst beams = Array.from({length:5},  () => new LightBeam());\nfunction draw(){\nt++;\ncx.clearRect(0,0,W,H);\nbeams.forEach(b => { b.update(); b.draw(cx); });\nmotes.forEach(m => { m.update(); m.draw(cx); });\nrequestAnimationFrame(draw);\n}\ndraw();\n})();\n</script>\n</body>\n</html>\n"
    },
    {
      "id": 1775933223980.9812,
      "type": "html",
      "name": "Bishop Title",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Thor Style Lightning Title - Sequential</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #020611; }\n    \n    .stage { \n      width: 100vw; height: 100vh; position: relative; overflow: hidden;\n      perspective: 1000px;\n    }\n\n    /* Background video is now much more visible */\n    .video-bg {\n      position: absolute; inset: 0; z-index: 0;\n      width: 100%; height: 100%; object-fit: cover;\n      opacity: 0.8; /* Increased visibility */\n    }\n\n    /* Subtle vignette just to keep the text readable, not hiding the video */\n    .overlay {\n      position: absolute; inset: 0; z-index: 1;\n      background: radial-gradient(circle at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);\n    }\n\n    /* --- Localized Lightning Strikes --- */\n    .lightning {\n      position: absolute; z-index: 2;\n      border-radius: 50%;\n      mix-blend-mode: overlay;\n      pointer-events: none;\n      opacity: 0;\n    }\n    \n    .strike-top-left {\n      top: -20%; left: -10%; width: 60vw; height: 60vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 60%);\n      animation: localizedFlash 4s infinite 1.5s;\n    }\n    \n    .strike-right {\n      top: 20%; right: -20%; width: 70vw; height: 70vw;\n      background: radial-gradient(circle, #b3e5fc 0%, transparent 60%);\n      animation: localizedFlash 5.5s infinite 3s;\n    }\n    \n    .strike-bottom {\n      bottom: -30%; left: 20%; width: 80vw; height: 50vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 70%);\n      animation: localizedFlash 6s infinite 0.5s;\n    }\n\n    /* Container for the text */\n    .content {\n      position: absolute; inset: 0; z-index: 10;\n      display: flex; flex-direction: column;\n      align-items: center; justify-content: center;\n    }\n\n    /* Base styling for all words */\n    .word {\n      display: inline-block;\n      color: #ffffff;\n      white-space: nowrap;\n      opacity: 0; /* Hidden initially */\n      /* Reduced, sharper glow for readability */\n      text-shadow: \n        0 0 4px #fff,\n        0 0 10px #00e5ff,\n        0 0 20px #008cff;\n    }\n\n    .title-small {\n      font-size: clamp(16px, 3vw, 40px);\n      letter-spacing: 20px;\n      font-family: 'Cinzel', serif;\n      font-weight: 700;\n      margin-bottom: 10px;\n      margin-right: -20px; /* Offset for letter spacing */\n    }\n\n    .title-large {\n      font-size: clamp(30px, 8vw, 120px);\n      font-weight: 900;\n      font-family: 'Montserrat', sans-serif;\n      letter-spacing: 5px;\n      display: flex;\n      gap: 2vw; /* Space between PAUL and YUVARAJ */\n    }\n\n    /* \n      Word-by-Word Sequential Animations \n      Using animation delays to bring them in one after the other \n    */\n    .w-bishop {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 0.5s,\n        subtleFlicker 3s infinite alternate 1.7s;\n    }\n\n    .w-paul {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 1.7s,\n        subtleFlicker 3s infinite alternate 2.9s;\n    }\n\n    .w-yuvaraj {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 2.6s,\n        subtleFlicker 3s infinite alternate 3.8s;\n    }\n\n    /* \n      The Animation: Starts as a distant glowing star, zooms in, \n      bounces slightly (impact), and clears up perfectly.\n    */\n    @keyframes starZoomSlam {\n      0% {\n        opacity: 0;\n        transform: translateZ(-2000px) scale(0.01);\n        filter: blur(10px);\n        text-shadow: 0 0 100px #fff, 0 0 300px #00e5ff;\n        color: transparent;\n      }\n      40% {\n        opacity: 1;\n        transform: translateZ(-500px) scale(0.5);\n        filter: blur(4px);\n        color: #fff;\n      }\n      80% {\n        transform: translateZ(50px) scale(1.1); /* Slams past normal size */\n        filter: blur(0px);\n      }\n      90% {\n        transform: translateZ(-10px) scale(0.97); /* Bounces back */\n      }\n      100% {\n        opacity: 1;\n        transform: translateZ(0) scale(1); /* Settles perfectly clear */\n        filter: blur(0px);\n      }\n    }\n\n    /* Random sharp flashes for the background lightning */\n    @keyframes localizedFlash {\n      0%, 9%, 11%, 49%, 51%, 100% { opacity: 0; }\n      10% { opacity: 0.8; } /* Bright flash */\n      12% { opacity: 0.2; } /* Fade out */\n      15% { opacity: 0.6; } /* Secondary crackle */\n      50% { opacity: 0.4; } /* Random mid-animation flash */\n    }\n\n    /* A very subtle crisp electric flicker for the text after it lands */\n    @keyframes subtleFlicker {\n      0%, 100% {\n        text-shadow: 0 0 4px #fff, 0 0 10px #00e5ff, 0 0 20px #008cff;\n      }\n      50% {\n        text-shadow: 0 0 2px #fff, 0 0 5px #00e5ff, 0 0 10px #008cff;\n      }\n      55% {\n        text-shadow: 0 0 8px #fff, 0 0 15px #00e5ff, 0 0 30px #008cff;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\">\n    <!-- Background video (Now much clearer) -->\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"earthbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <!-- Thunder strikes happening in different areas -->\n    <div class=\"lightning strike-top-left\"></div>\n    <div class=\"lightning strike-right\"></div>\n    <div class=\"lightning strike-bottom\"></div>\n    \n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <!-- First word -->\n      <div class=\"title-small\">\n        <span class=\"word w-bishop\">பிஷப்</span>\n      </div>\n\n      <!-- Second and Third words -->\n      <div class=\"title-large\">\n        <span class=\"word w-paul\">வி. பால்</span>\n        <span class=\"word w-yuvaraj\">யுவராஜ்</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
      "bookmarked": false,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Thor Style Lightning Title - Sequential</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@900&display=swap\" rel=\"stylesheet\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #020611; }\n    \n    .stage { \n      width: 100vw; height: 100vh; position: relative; overflow: hidden;\n      perspective: 1000px;\n    }\n\n    /* Background video is now much more visible */\n    .video-bg {\n      position: absolute; inset: 0; z-index: 0;\n      width: 100%; height: 100%; object-fit: cover;\n      opacity: 0.8; /* Increased visibility */\n    }\n\n    /* Subtle vignette just to keep the text readable, not hiding the video */\n    .overlay {\n      position: absolute; inset: 0; z-index: 1;\n      background: radial-gradient(circle at center, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);\n    }\n\n    /* --- Localized Lightning Strikes --- */\n    .lightning {\n      position: absolute; z-index: 2;\n      border-radius: 50%;\n      mix-blend-mode: overlay;\n      pointer-events: none;\n      opacity: 0;\n    }\n    \n    .strike-top-left {\n      top: -20%; left: -10%; width: 60vw; height: 60vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 60%);\n      animation: localizedFlash 4s infinite 1.5s;\n    }\n    \n    .strike-right {\n      top: 20%; right: -20%; width: 70vw; height: 70vw;\n      background: radial-gradient(circle, #b3e5fc 0%, transparent 60%);\n      animation: localizedFlash 5.5s infinite 3s;\n    }\n    \n    .strike-bottom {\n      bottom: -30%; left: 20%; width: 80vw; height: 50vw;\n      background: radial-gradient(circle, #e0f7fa 0%, transparent 70%);\n      animation: localizedFlash 6s infinite 0.5s;\n    }\n\n    /* Container for the text */\n    .content {\n      position: absolute; inset: 0; z-index: 10;\n      display: flex; flex-direction: column;\n      align-items: center; justify-content: center;\n    }\n\n    /* Base styling for all words */\n    .word {\n      display: inline-block;\n      color: #ffffff;\n      white-space: nowrap;\n      opacity: 0; /* Hidden initially */\n      /* Reduced, sharper glow for readability */\n      text-shadow: \n        0 0 4px #fff,\n        0 0 10px #00e5ff,\n        0 0 20px #008cff;\n    }\n\n    .title-small {\n      font-size: clamp(16px, 3vw, 40px);\n      letter-spacing: 20px;\n      font-family: 'Cinzel', serif;\n      font-weight: 700;\n      margin-bottom: 10px;\n      margin-right: -20px; /* Offset for letter spacing */\n    }\n\n    .title-large {\n      font-size: clamp(30px, 8vw, 120px);\n      font-weight: 900;\n      font-family: 'Montserrat', sans-serif;\n      letter-spacing: 5px;\n      display: flex;\n      gap: 2vw; /* Space between PAUL and YUVARAJ */\n    }\n\n    /* \n      Word-by-Word Sequential Animations \n      Using animation delays to bring them in one after the other \n    */\n    .w-bishop {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 0.5s,\n        subtleFlicker 3s infinite alternate 1.7s;\n    }\n\n    .w-paul {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 1.7s,\n        subtleFlicker 3s infinite alternate 2.9s;\n    }\n\n    .w-yuvaraj {\n      animation: \n        starZoomSlam 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards 2.6s,\n        subtleFlicker 3s infinite alternate 3.8s;\n    }\n\n    /* \n      The Animation: Starts as a distant glowing star, zooms in, \n      bounces slightly (impact), and clears up perfectly.\n    */\n    @keyframes starZoomSlam {\n      0% {\n        opacity: 0;\n        transform: translateZ(-2000px) scale(0.01);\n        filter: blur(10px);\n        text-shadow: 0 0 100px #fff, 0 0 300px #00e5ff;\n        color: transparent;\n      }\n      40% {\n        opacity: 1;\n        transform: translateZ(-500px) scale(0.5);\n        filter: blur(4px);\n        color: #fff;\n      }\n      80% {\n        transform: translateZ(50px) scale(1.1); /* Slams past normal size */\n        filter: blur(0px);\n      }\n      90% {\n        transform: translateZ(-10px) scale(0.97); /* Bounces back */\n      }\n      100% {\n        opacity: 1;\n        transform: translateZ(0) scale(1); /* Settles perfectly clear */\n        filter: blur(0px);\n      }\n    }\n\n    /* Random sharp flashes for the background lightning */\n    @keyframes localizedFlash {\n      0%, 9%, 11%, 49%, 51%, 100% { opacity: 0; }\n      10% { opacity: 0.8; } /* Bright flash */\n      12% { opacity: 0.2; } /* Fade out */\n      15% { opacity: 0.6; } /* Secondary crackle */\n      50% { opacity: 0.4; } /* Random mid-animation flash */\n    }\n\n    /* A very subtle crisp electric flicker for the text after it lands */\n    @keyframes subtleFlicker {\n      0%, 100% {\n        text-shadow: 0 0 4px #fff, 0 0 10px #00e5ff, 0 0 20px #008cff;\n      }\n      50% {\n        text-shadow: 0 0 2px #fff, 0 0 5px #00e5ff, 0 0 10px #008cff;\n      }\n      55% {\n        text-shadow: 0 0 8px #fff, 0 0 15px #00e5ff, 0 0 30px #008cff;\n      }\n    }\n  </style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n  <div class=\"stage\">\n    <!-- Background video (Now much clearer) -->\n    <video class=\"video-bg\" autoplay muted loop playsinline>\n      <source src=\"earthbgv.mp4\" type=\"video/mp4\" />\n    </video>\n\n    <!-- Thunder strikes happening in different areas -->\n    <div class=\"lightning strike-top-left\"></div>\n    <div class=\"lightning strike-right\"></div>\n    <div class=\"lightning strike-bottom\"></div>\n    \n    <div class=\"overlay\"></div>\n\n    <div class=\"content\">\n      <!-- First word -->\n      <div class=\"title-small\">\n        <span class=\"word w-bishop\">பிஷப்</span>\n      </div>\n\n      <!-- Second and Third words -->\n      <div class=\"title-large\">\n        <span class=\"word w-paul\">வி. பால்</span>\n        <span class=\"word w-yuvaraj\">யுவராஜ்</span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
