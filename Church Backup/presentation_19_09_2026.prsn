    {
      "id": 1774107161738.447,
      "type": "html",
      "name": "Testimony",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>சாட்சி நேரம் – Testimony Time</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+Tamil:ital,wght@0,400;0,600;0,700;1,400&display=swap');\n\n* { \n    margin: 0; \n    padding: 0; \n    box-sizing: border-box; \n}\n\nhtml, body {\n    width: 100%;\n    height: 100%;\n    background: #0d0c18;\n    font-family: 'Noto Serif Tamil', serif;\n    overflow: hidden;\n}\n\n/* ─── SLIDE CANVAS ─── */\n.slide {\n    position: fixed;\n    inset: 0;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n}\n\n/* ─── HEAVEN SKY BACKGROUND ─── */\n.sky {\n    position: absolute; \n    inset: 0;\n    background: radial-gradient(ellipse 100% 80% at 50% 0%,\n        #e8dfc8 0%, #c4a96d 20%, #8a6f3e 40%,\n        #4a3520 60%, #1e1510 80%, #0d0c18 100%);\n}\n\n.clouds-layer {\n    position: absolute; \n    inset: 0;\n    background-image:\n        radial-gradient(ellipse 300px 60px at 20% 15%, rgba(255,248,235,0.18) 0%, transparent 100%),\n        radial-gradient(ellipse 200px 40px at 70% 10%, rgba(255,248,235,0.12) 0%, transparent 100%),\n        radial-gradient(ellipse 400px 80px at 50% 20%, rgba(255,245,225,0.08) 0%, transparent 100%),\n        radial-gradient(ellipse 150px 35px at 85% 18%, rgba(255,248,235,0.10) 0%, transparent 100%);\n    animation: cloudDrift 20s ease-in-out infinite alternate;\n}\n\n@keyframes cloudDrift {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(18px); }\n}\n\n.light-beam {\n    position: absolute;\n    top: 0; \n    left: 50%; \n    transform: translateX(-50%);\n    width: min(92vw, 900px);\n    height: 100%;\n    background: conic-gradient(from 270deg at 50% 0%,\n        transparent 0deg,\n        rgba(255,245,200,0.04) 8deg,\n        rgba(255,245,200,0.09) 12deg,\n        rgba(255,245,200,0.04) 16deg,\n        transparent 24deg,\n        rgba(255,245,200,0.06) 30deg,\n        rgba(255,245,200,0.10) 34deg,\n        rgba(255,245,200,0.06) 38deg,\n        transparent 46deg,\n        rgba(255,245,200,0.04) 52deg,\n        rgba(255,245,200,0.08) 56deg,\n        rgba(255,245,200,0.04) 60deg,\n        transparent 68deg);\n    animation: beamPulse 5s ease-in-out infinite;\n}\n\n@keyframes beamPulse {\n    0%, 100% { opacity: 0.7; }\n    50% { opacity: 1; }\n}\n\n.vignette-bottom {\n    position: absolute;\n    bottom: 0; \n    left: 0; \n    right: 0; \n    height: 55%;\n    background: linear-gradient(0deg, rgba(13,12,24,0.97) 0%, rgba(13,12,24,0.6) 55%, transparent 100%);\n}\n\n.vignette-sides {\n    position: absolute; \n    inset: 0;\n    background: radial-gradient(ellipse 80% 100% at 50% 50%, transparent 55%, rgba(13,12,24,0.7) 100%);\n}\n\n.motes { \n    position: absolute; \n    inset: 0; \n    pointer-events: none; \n    overflow: hidden; \n}\n\n.mote {\n    position: absolute;\n    border-radius: 50%;\n    background: rgba(255, 245, 200, 0.85);\n    animation: moteFloat linear infinite;\n}\n\n@keyframes moteFloat {\n    0%   { opacity: 0; transform: translateY(0) scale(0.5); }\n    15%  { opacity: 1; }\n    85%  { opacity: 0.6; }\n    100% { opacity: 0; transform: translateY(-90vh) scale(1.5); }\n}\n\n.content {\n    position: relative; \n    z-index: 10;\n    display: flex; \n    flex-direction: column;\n    align-items: center; \n    gap: 0;\n    width: 100%;\n    max-width: 1400px;\n    padding: 0 40px;\n    margin-top: 12vh;\n}\n\n.church-label {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(16px, 1.8vw, 24px);\n    letter-spacing: 5px;\n    color: rgba(255, 245, 220, 0.95);\n    text-transform: uppercase;\n    margin-bottom: 24px;\n    animation: fadeIn 1.5s ease forwards;\n    text-align: center;\n    background: rgba(20, 15, 30, 0.65);\n    padding: 12px 40px;\n    border-radius: 8px;\n    backdrop-filter: blur(8px);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);\n}\n\n.divider {\n    width: 240px; \n    height: 2px;\n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.6), transparent);\n    margin-bottom: 40px;\n    animation: fadeIn 1.8s ease forwards;\n}\n\n.title-ta {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(72px, 12vw, 160px);\n    font-weight: 700;\n    color: #ffffff;\n    text-align: center;\n    line-height: 1.2;\n    letter-spacing: 6px;\n    text-shadow:\n        0 0 40px rgba(212,178,100,0.6),\n        0 0 80px rgba(212,178,100,0.3),\n        0 8px 50px rgba(0,0,0,0.9);\n    animation: titleReveal 1.2s ease forwards;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 32px;\n    flex-wrap: wrap;\n}\n\n@keyframes titleReveal {\n    from { opacity:0; transform: translateY(24px); }\n    to   { opacity:1; transform: translateY(0); }\n}\n\n.title-en {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(24px, 3.5vw, 42px);\n    color: rgba(212, 178, 100, 0.9);\n    letter-spacing: 8px;\n    text-transform: uppercase;\n    text-shadow: 0 0 25px rgba(212,178,100,0.5);\n    animation: fadeIn 1.6s ease forwards;\n    margin-bottom: 40px;\n    text-align: center;\n}\n\n.divider-bottom {\n    display: flex; \n    align-items: center; \n    gap: 18px;\n    margin-bottom: 32px;\n    animation: fadeIn 2s ease forwards;\n}\n\n.dl { \n    width: 100px; \n    height: 2px; \n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.5)); \n}\n\n.dr { \n    width: 100px; \n    height: 2px; \n    background: linear-gradient(90deg, rgba(212,178,100,0.5), transparent); \n}\n\n.dot {\n    width: 6px; \n    height: 6px; \n    border-radius: 50%;\n    background: rgba(212,178,100,0.85);\n    box-shadow: 0 0 10px rgba(212,178,100,0.7);\n}\n\n.scripture {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(18px, 2.2vw, 28px);\n    font-style: italic;\n    color: rgba(255, 245, 220, 0.95);\n    letter-spacing: 1.5px;\n    text-align: center;\n    animation: fadeIn 2.2s ease forwards;\n    max-width: 90vw;\n    line-height: 1.6;\n    background: rgba(20, 15, 30, 0.7);\n    padding: 20px 50px;\n    border-radius: 12px;\n    backdrop-filter: blur(10px);\n    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.5);\n}\n\n@keyframes fadeIn { \n    from { opacity:0; } \n    to { opacity:1; } \n}\n\n/* Responsive adjustments */\n@media (max-width: 768px) {\n    .content {\n        margin-top: 8vh;\n    }\n    \n    .title-ta {\n        gap: 20px;\n    }\n}\n</style>\n</head>\n<body>\n<div class=\"slide\">\n    <div class=\"sky\"></div>\n    <div class=\"clouds-layer\"></div>\n    <div class=\"light-beam\"></div>\n    \n    <svg style=\"position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:900px;height:auto;z-index:2;opacity:0.22;pointer-events:none\"\n         viewBox=\"0 0 900 420\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n            <linearGradient id=\"wg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n                <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n                <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n            </linearGradient>\n            <linearGradient id=\"wg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n                <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n                <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n            </linearGradient>\n        </defs>\n        <g transform=\"translate(450,30) scale(-1,1)\">\n            <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.9\"/>\n            <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.7\"/>\n            <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.55\"/>\n        </g>\n        <g transform=\"translate(450,30)\">\n            <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.9\"/>\n            <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.7\"/>\n            <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.55\"/>\n        </g>\n        <ellipse cx=\"450\" cy=\"30\" rx=\"55\" ry=\"22\" fill=\"#fff8d0\" opacity=\"0.18\"/>\n        <ellipse cx=\"450\" cy=\"30\" rx=\"40\" ry=\"15\" fill=\"#fff8d0\" opacity=\"0.22\"/>\n        <circle cx=\"450\" cy=\"30\" r=\"10\" fill=\"#fffae0\" opacity=\"0.35\"/>\n    </svg>\n    \n    <svg style=\"position:absolute;top:12%;left:50%;transform:translate(-50%,-50%);width:100px;z-index:5;opacity:0;animation:doveAppear 2s 0.5s ease forwards;pointer-events:none\"\n         viewBox=\"0 0 80 55\" xmlns=\"http://www.w3.org/2000/svg\">\n        <style>\n            @keyframes doveAppear{\n                from{opacity:0;transform:translate(-50%,-60%)}\n                to{opacity:0.85;transform:translate(-50%,-50%)}\n            }\n        </style>\n        <ellipse cx=\"38\" cy=\"30\" rx=\"18\" ry=\"10\" fill=\"#fffcf0\"/>\n        <circle cx=\"54\" cy=\"23\" r=\"7\" fill=\"#fffcf0\"/>\n        <path d=\"M60,22 L67,21 L60,24Z\" fill=\"#e8c870\"/>\n        <path d=\"M30,28 Q15,14 8,20 Q18,22 26,30Z\" fill=\"#fff8e0\" opacity=\"0.95\"/>\n        <path d=\"M32,26 Q20,8 10,12 Q22,18 28,28Z\" fill=\"#fff8e0\" opacity=\"0.75\"/>\n        <path d=\"M20,32 Q10,38 6,36 Q14,33 20,30Z\" fill=\"#fffcf0\"/>\n        <circle cx=\"57\" cy=\"22\" r=\"2\" fill=\"#2a1a08\"/>\n        <circle cx=\"57.7\" cy=\"21.3\" r=\"0.7\" fill=\"#fff\"/>\n    </svg>\n    \n    <div class=\"vignette-bottom\"></div>\n    <div class=\"vignette-sides\"></div>\n    <div class=\"motes\" id=\"motes\"></div>\n    \n    <div class=\"content\">\n        <div class=\"church-label\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n        <div class=\"divider\"></div>\n        \n        <div class=\"title-ta\">\n            <span>சாட்சி</span>\n            <svg width=\"70\" height=\"90\" viewBox=\"0 0 60 80\" xmlns=\"http://www.w3.org/2000/svg\" \n                 style=\"flex-shrink:0;opacity:0.92;filter:drop-shadow(0 0 12px rgba(212,168,67,0.6))\">\n                <defs>\n                    <linearGradient id=\"mg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                        <stop offset=\"0%\" stop-color=\"#fff5d0\"/>\n                        <stop offset=\"100%\" stop-color=\"#d4a843\"/>\n                    </linearGradient>\n                </defs>\n                <rect x=\"18\" y=\"4\" width=\"24\" height=\"38\" rx=\"12\" fill=\"url(#mg2)\" stroke=\"rgba(212,168,67,0.5)\" stroke-width=\"1\"/>\n                <line x1=\"18\" y1=\"18\" x2=\"42\" y2=\"18\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n                <line x1=\"18\" y1=\"25\" x2=\"42\" y2=\"25\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n                <line x1=\"18\" y1=\"32\" x2=\"42\" y2=\"32\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n                <path d=\"M12,38 Q10,52 30,52 Q50,52 48,38\" fill=\"none\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n                <line x1=\"30\" y1=\"52\" x2=\"30\" y2=\"68\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n                <rect x=\"14\" y=\"67\" width=\"32\" height=\"5\" rx=\"2.5\" fill=\"url(#mg2)\"/>\n            </svg>\n            <span>நேரம்</span>\n        </div>\n        \n        <div class=\"title-en\">Testimony Time</div>\n        \n        <div class=\"divider-bottom\">\n            <div class=\"dl\"></div>\n            <div class=\"dot\"></div>\n            <div class=\"dr\"></div>\n        </div>\n        \n        <div class=\"scripture\">\"உங்கள் வாயால் சொல்லுங்கள், கர்த்தர் என்னை இரட்சித்தார்\" — ஏசாயா 38:20</div>\n    </div>\n</div>\n\n<script>\nconst container = document.getElementById('motes');\nfor (let i = 0; i < 50; i++) {\n    const m = document.createElement('div');\n    m.classList.add('mote');\n    const size = 1 + Math.random() * 3;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.bottom = (Math.random() * 30) + '%';\n    m.style.animationDuration = (8 + Math.random() * 14) + 's';\n    m.style.animationDelay = (Math.random() * 10) + 's';\n    m.style.opacity = 0;\n    container.appendChild(m);\n}\n</script>\n</body>\n</html>",
      "bookmarked": false,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>சாட்சி நேரம் – Testimony Time</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+Tamil:ital,wght@0,400;0,600;0,700;1,400&display=swap');\n\n* { \n    margin: 0; \n    padding: 0; \n    box-sizing: border-box; \n}\n\nhtml, body {\n    width: 100%;\n    height: 100%;\n    background: #0d0c18;\n    font-family: 'Noto Serif Tamil', serif;\n    overflow: hidden;\n}\n\n/* ─── SLIDE CANVAS ─── */\n.slide {\n    position: fixed;\n    inset: 0;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n}\n\n/* ─── HEAVEN SKY BACKGROUND ─── */\n.sky {\n    position: absolute; \n    inset: 0;\n    background: radial-gradient(ellipse 100% 80% at 50% 0%,\n        #e8dfc8 0%, #c4a96d 20%, #8a6f3e 40%,\n        #4a3520 60%, #1e1510 80%, #0d0c18 100%);\n}\n\n.clouds-layer {\n    position: absolute; \n    inset: 0;\n    background-image:\n        radial-gradient(ellipse 300px 60px at 20% 15%, rgba(255,248,235,0.18) 0%, transparent 100%),\n        radial-gradient(ellipse 200px 40px at 70% 10%, rgba(255,248,235,0.12) 0%, transparent 100%),\n        radial-gradient(ellipse 400px 80px at 50% 20%, rgba(255,245,225,0.08) 0%, transparent 100%),\n        radial-gradient(ellipse 150px 35px at 85% 18%, rgba(255,248,235,0.10) 0%, transparent 100%);\n    animation: cloudDrift 20s ease-in-out infinite alternate;\n}\n\n@keyframes cloudDrift {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(18px); }\n}\n\n.light-beam {\n    position: absolute;\n    top: 0; \n    left: 50%; \n    transform: translateX(-50%);\n    width: min(92vw, 900px);\n    height: 100%;\n    background: conic-gradient(from 270deg at 50% 0%,\n        transparent 0deg,\n        rgba(255,245,200,0.04) 8deg,\n        rgba(255,245,200,0.09) 12deg,\n        rgba(255,245,200,0.04) 16deg,\n        transparent 24deg,\n        rgba(255,245,200,0.06) 30deg,\n        rgba(255,245,200,0.10) 34deg,\n        rgba(255,245,200,0.06) 38deg,\n        transparent 46deg,\n        rgba(255,245,200,0.04) 52deg,\n        rgba(255,245,200,0.08) 56deg,\n        rgba(255,245,200,0.04) 60deg,\n        transparent 68deg);\n    animation: beamPulse 5s ease-in-out infinite;\n}\n\n@keyframes beamPulse {\n    0%, 100% { opacity: 0.7; }\n    50% { opacity: 1; }\n}\n\n.vignette-bottom {\n    position: absolute;\n    bottom: 0; \n    left: 0; \n    right: 0; \n    height: 55%;\n    background: linear-gradient(0deg, rgba(13,12,24,0.97) 0%, rgba(13,12,24,0.6) 55%, transparent 100%);\n}\n\n.vignette-sides {\n    position: absolute; \n    inset: 0;\n    background: radial-gradient(ellipse 80% 100% at 50% 50%, transparent 55%, rgba(13,12,24,0.7) 100%);\n}\n\n.motes { \n    position: absolute; \n    inset: 0; \n    pointer-events: none; \n    overflow: hidden; \n}\n\n.mote {\n    position: absolute;\n    border-radius: 50%;\n    background: rgba(255, 245, 200, 0.85);\n    animation: moteFloat linear infinite;\n}\n\n@keyframes moteFloat {\n    0%   { opacity: 0; transform: translateY(0) scale(0.5); }\n    15%  { opacity: 1; }\n    85%  { opacity: 0.6; }\n    100% { opacity: 0; transform: translateY(-90vh) scale(1.5); }\n}\n\n.content {\n    position: relative; \n    z-index: 10;\n    display: flex; \n    flex-direction: column;\n    align-items: center; \n    gap: 0;\n    width: 100%;\n    max-width: 1400px;\n    padding: 0 40px;\n    margin-top: 12vh;\n}\n\n.church-label {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(16px, 1.8vw, 24px);\n    letter-spacing: 5px;\n    color: rgba(255, 245, 220, 0.95);\n    text-transform: uppercase;\n    margin-bottom: 24px;\n    animation: fadeIn 1.5s ease forwards;\n    text-align: center;\n    background: rgba(20, 15, 30, 0.65);\n    padding: 12px 40px;\n    border-radius: 8px;\n    backdrop-filter: blur(8px);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);\n}\n\n.divider {\n    width: 240px; \n    height: 2px;\n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.6), transparent);\n    margin-bottom: 40px;\n    animation: fadeIn 1.8s ease forwards;\n}\n\n.title-ta {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(72px, 12vw, 160px);\n    font-weight: 700;\n    color: #ffffff;\n    text-align: center;\n    line-height: 1.2;\n    letter-spacing: 6px;\n    text-shadow:\n        0 0 40px rgba(212,178,100,0.6),\n        0 0 80px rgba(212,178,100,0.3),\n        0 8px 50px rgba(0,0,0,0.9);\n    animation: titleReveal 1.2s ease forwards;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 32px;\n    flex-wrap: wrap;\n}\n\n@keyframes titleReveal {\n    from { opacity:0; transform: translateY(24px); }\n    to   { opacity:1; transform: translateY(0); }\n}\n\n.title-en {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(24px, 3.5vw, 42px);\n    color: rgba(212, 178, 100, 0.9);\n    letter-spacing: 8px;\n    text-transform: uppercase;\n    text-shadow: 0 0 25px rgba(212,178,100,0.5);\n    animation: fadeIn 1.6s ease forwards;\n    margin-bottom: 40px;\n    text-align: center;\n}\n\n.divider-bottom {\n    display: flex; \n    align-items: center; \n    gap: 18px;\n    margin-bottom: 32px;\n    animation: fadeIn 2s ease forwards;\n}\n\n.dl { \n    width: 100px; \n    height: 2px; \n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.5)); \n}\n\n.dr { \n    width: 100px; \n    height: 2px; \n    background: linear-gradient(90deg, rgba(212,178,100,0.5), transparent); \n}\n\n.dot {\n    width: 6px; \n    height: 6px; \n    border-radius: 50%;\n    background: rgba(212,178,100,0.85);\n    box-shadow: 0 0 10px rgba(212,178,100,0.7);\n}\n\n.scripture {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(18px, 2.2vw, 28px);\n    font-style: italic;\n    color: rgba(255, 245, 220, 0.95);\n    letter-spacing: 1.5px;\n    text-align: center;\n    animation: fadeIn 2.2s ease forwards;\n    max-width: 90vw;\n    line-height: 1.6;\n    background: rgba(20, 15, 30, 0.7);\n    padding: 20px 50px;\n    border-radius: 12px;\n    backdrop-filter: blur(10px);\n    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.5);\n}\n\n@keyframes fadeIn { \n    from { opacity:0; } \n    to { opacity:1; } \n}\n\n/* Responsive adjustments */\n@media (max-width: 768px) {\n    .content {\n        margin-top: 8vh;\n    }\n    \n    .title-ta {\n        gap: 20px;\n    }\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"slide\">\n    <div class=\"sky\"></div>\n    <div class=\"clouds-layer\"></div>\n    <div class=\"light-beam\"></div>\n    \n    <svg style=\"position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:900px;height:auto;z-index:2;opacity:0.22;pointer-events:none\"\n         viewBox=\"0 0 900 420\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n            <linearGradient id=\"wg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n                <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n                <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n            </linearGradient>\n            <linearGradient id=\"wg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n                <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n                <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n            </linearGradient>\n        </defs>\n        <g transform=\"translate(450,30) scale(-1,1)\">\n            <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.9\"/>\n            <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.7\"/>\n            <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.55\"/>\n        </g>\n        <g transform=\"translate(450,30)\">\n            <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.9\"/>\n            <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.7\"/>\n            <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.55\"/>\n        </g>\n        <ellipse cx=\"450\" cy=\"30\" rx=\"55\" ry=\"22\" fill=\"#fff8d0\" opacity=\"0.18\"/>\n        <ellipse cx=\"450\" cy=\"30\" rx=\"40\" ry=\"15\" fill=\"#fff8d0\" opacity=\"0.22\"/>\n        <circle cx=\"450\" cy=\"30\" r=\"10\" fill=\"#fffae0\" opacity=\"0.35\"/>\n    </svg>\n    \n    <svg style=\"position:absolute;top:12%;left:50%;transform:translate(-50%,-50%);width:100px;z-index:5;opacity:0;animation:doveAppear 2s 0.5s ease forwards;pointer-events:none\"\n         viewBox=\"0 0 80 55\" xmlns=\"http://www.w3.org/2000/svg\">\n        <style>\n            @keyframes doveAppear{\n                from{opacity:0;transform:translate(-50%,-60%)}\n                to{opacity:0.85;transform:translate(-50%,-50%)}\n            }\n        </style>\n        <ellipse cx=\"38\" cy=\"30\" rx=\"18\" ry=\"10\" fill=\"#fffcf0\"/>\n        <circle cx=\"54\" cy=\"23\" r=\"7\" fill=\"#fffcf0\"/>\n        <path d=\"M60,22 L67,21 L60,24Z\" fill=\"#e8c870\"/>\n        <path d=\"M30,28 Q15,14 8,20 Q18,22 26,30Z\" fill=\"#fff8e0\" opacity=\"0.95\"/>\n        <path d=\"M32,26 Q20,8 10,12 Q22,18 28,28Z\" fill=\"#fff8e0\" opacity=\"0.75\"/>\n        <path d=\"M20,32 Q10,38 6,36 Q14,33 20,30Z\" fill=\"#fffcf0\"/>\n        <circle cx=\"57\" cy=\"22\" r=\"2\" fill=\"#2a1a08\"/>\n        <circle cx=\"57.7\" cy=\"21.3\" r=\"0.7\" fill=\"#fff\"/>\n    </svg>\n    \n    <div class=\"vignette-bottom\"></div>\n    <div class=\"vignette-sides\"></div>\n    <div class=\"motes\" id=\"motes\"></div>\n    \n    <div class=\"content\">\n        <div class=\"church-label\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n        <div class=\"divider\"></div>\n        \n        <div class=\"title-ta\">\n            <span>சாட்சி</span>\n            <svg width=\"70\" height=\"90\" viewBox=\"0 0 60 80\" xmlns=\"http://www.w3.org/2000/svg\" \n                 style=\"flex-shrink:0;opacity:0.92;filter:drop-shadow(0 0 12px rgba(212,168,67,0.6))\">\n                <defs>\n                    <linearGradient id=\"mg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                        <stop offset=\"0%\" stop-color=\"#fff5d0\"/>\n                        <stop offset=\"100%\" stop-color=\"#d4a843\"/>\n                    </linearGradient>\n                </defs>\n                <rect x=\"18\" y=\"4\" width=\"24\" height=\"38\" rx=\"12\" fill=\"url(#mg2)\" stroke=\"rgba(212,168,67,0.5)\" stroke-width=\"1\"/>\n                <line x1=\"18\" y1=\"18\" x2=\"42\" y2=\"18\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n                <line x1=\"18\" y1=\"25\" x2=\"42\" y2=\"25\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n                <line x1=\"18\" y1=\"32\" x2=\"42\" y2=\"32\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n                <path d=\"M12,38 Q10,52 30,52 Q50,52 48,38\" fill=\"none\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n                <line x1=\"30\" y1=\"52\" x2=\"30\" y2=\"68\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n                <rect x=\"14\" y=\"67\" width=\"32\" height=\"5\" rx=\"2.5\" fill=\"url(#mg2)\"/>\n            </svg>\n            <span>நேரம்</span>\n        </div>\n        \n        <div class=\"title-en\">Testimony Time</div>\n        \n        <div class=\"divider-bottom\">\n            <div class=\"dl\"></div>\n            <div class=\"dot\"></div>\n            <div class=\"dr\"></div>\n        </div>\n        \n        <div class=\"scripture\">\"உங்கள் வாயால் சொல்லுங்கள், கர்த்தர் என்னை இரட்சித்தார்\" — ஏசாயா 38:20</div>\n    </div>\n</div>\n\n<script>\nconst container = document.getElementById('motes');\nfor (let i = 0; i < 50; i++) {\n    const m = document.createElement('div');\n    m.classList.add('mote');\n    const size = 1 + Math.random() * 3;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.bottom = (Math.random() * 30) + '%';\n    m.style.animationDuration = (8 + Math.random() * 14) + 's';\n    m.style.animationDelay = (Math.random() * 10) + 's';\n    m.style.opacity = 0;\n    container.appendChild(m);\n}\n</script>\n</body>\n</html>"
    },
    {
      "id": 1774106242517.191,
      "type": "html",
      "name": "Information",
      "html": "<!doctype html>\n<html lang=\"ta\">\n    <head>\n        <meta charset=\"UTF-8\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n        <title>அறிவிப்பு - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n        <link\n            href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\"\n            rel=\"stylesheet\"\n        />\n        <style>\n            * {\n                margin: 0;\n                padding: 0;\n                box-sizing: border-box;\n            }\n            html,\n            body {\n                width: 100%;\n                height: 100%;\n                overflow: hidden;\n            }\n            .stage {\n                width: 100vw;\n                height: 100vh;\n                position: relative;\n                overflow: hidden;\n            } /* ── SKY GRADIENT — deep royal blue to golden dawn (announcement feel) ── */\n            .sky {\n                position: absolute;\n                inset: 0;\n                background: linear-gradient(\n                    170deg,\n                    #05102a 0%,\n                    #0e2257 12%,\n                    #1a4a8a 26%,\n                    #2e6db4 40%,\n                    #5299d3 54%,\n                    #8ac4e8 68%,\n                    #c9e8f7 82%,\n                    #f0f8ff 92%,\n                    #ffffff 100%\n                );\n                z-index: 0;\n            } /* ── MEGAPHONE / BELL GLOW ── */\n            .bell-glow {\n                position: absolute;\n                top: -10vh;\n                left: 50%;\n                transform: translateX(-50%);\n                width: 55vw;\n                height: 55vw;\n                border-radius: 50%;\n                background: radial-gradient(\n                    circle,\n                    rgba(180, 220, 255, 0.55) 0%,\n                    rgba(100, 170, 255, 0.3) 30%,\n                    rgba(50, 120, 220, 0.1) 60%,\n                    transparent 100%\n                );\n                z-index: 1;\n                animation: bellPulse 3.5s ease-in-out infinite;\n            }\n            @keyframes bellPulse {\n                0%,\n                100% {\n                    transform: translateX(-50%) scale(1);\n                    opacity: 0.8;\n                }\n                50% {\n                    transform: translateX(-50%) scale(1.08);\n                    opacity: 1;\n                }\n            } /* ── CANVASES ── */\n            canvas.rays {\n                position: absolute;\n                inset: 0;\n                z-index: 2;\n                pointer-events: none;\n            }\n            canvas.stars {\n                position: absolute;\n                inset: 0;\n                z-index: 3;\n                pointer-events: none;\n            }\n            canvas.bells {\n                position: absolute;\n                inset: 0;\n                z-index: 5;\n                pointer-events: none;\n            } /* ── MIST ── */\n            .mist {\n                position: absolute;\n                bottom: 0;\n                left: 0;\n                right: 0;\n                height: 28vh;\n                background: linear-gradient(\n                    to top,\n                    rgba(240, 248, 255, 0.65) 0%,\n                    rgba(200, 230, 255, 0.25) 50%,\n                    transparent 100%\n                );\n                z-index: 4;\n            } /* ── CONTENT ── */\n            .content {\n                position: absolute;\n                inset: 0;\n                z-index: 10;\n                display: flex;\n                flex-direction: column;\n                align-items: center;\n                justify-content: center;\n            } /* ── CARD ── */\n            .card {\n                background: rgba(255, 255, 255, 0.14);\n                backdrop-filter: blur(20px);\n                -webkit-backdrop-filter: blur(20px);\n                border: 1px solid rgba(255, 255, 255, 0.4);\n                border-radius: 26px;\n                padding: clamp(28px, 4.5vh, 55px) clamp(40px, 6.5vw, 95px);\n                display: flex;\n                flex-direction: column;\n                align-items: center;\n                gap: 0;\n                box-shadow:\n                    0 8px 60px rgba(20, 60, 140, 0.3),\n                    0 2px 20px rgba(100, 180, 255, 0.2),\n                    inset 0 1px 0 rgba(255, 255, 255, 0.55);\n                opacity: 0;\n                animation: cardReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards 0.4s;\n                position: relative;\n                overflow: hidden;\n            }\n            .card::before {\n                content: \"\";\n                position: absolute;\n                inset: 0;\n                background: linear-gradient(\n                    135deg,\n                    rgba(255, 255, 255, 0.2) 0%,\n                    rgba(150, 210, 255, 0.08) 50%,\n                    rgba(255, 255, 255, 0.05) 100%\n                );\n                border-radius: 26px;\n                pointer-events: none;\n            }\n            @keyframes cardReveal {\n                from {\n                    opacity: 0;\n                    transform: translateY(30px) scale(0.97);\n                }\n                to {\n                    opacity: 1;\n                    transform: translateY(0) scale(1);\n                }\n            } /* ── ICON ROW ── */\n            .icon-row {\n                display: flex;\n                align-items: center;\n                gap: 2vw;\n                margin-bottom: 0.8vh;\n                opacity: 0;\n                animation: fadeUp 0.9s ease forwards 0.8s;\n            }\n            .icon-emoji {\n                font-size: clamp(32px, 4.5vw, 64px);\n                animation: iconBounce 2.8s ease-in-out infinite;\n                filter: drop-shadow(0 2px 8px rgba(30, 80, 200, 0.4));\n            }\n            .icon-emoji:nth-child(1) {\n                animation-delay: 0s;\n            }\n            .icon-emoji:nth-child(2) {\n                animation-delay: 0.35s;\n            }\n            .icon-emoji:nth-child(3) {\n                animation-delay: 0.7s;\n            }\n            @keyframes iconBounce {\n                0%,\n                100% {\n                    transform: translateY(0) rotate(-4deg);\n                }\n                50% {\n                    transform: translateY(-9px) rotate(4deg);\n                }\n            } /* ── TOP SCRIPT ── */\n            .script-top {\n                font-family: \"Lora\", serif;\n                font-style: italic;\n                font-weight: 400;\n                font-size: clamp(14px, 1.8vw, 24px);\n                letter-spacing: 8px;\n                text-transform: uppercase;\n                color: rgba(20, 60, 140, 0.7);\n                margin-bottom: 0.8vh;\n                opacity: 0;\n                animation: fadeUp 0.8s ease forwards 1s;\n            } /* ── DIVIDER ── */\n            .divider {\n                display: flex;\n                align-items: center;\n                gap: 1.5vw;\n                margin-bottom: 1.2vh;\n                opacity: 0;\n                animation: fadeUp 0.8s ease forwards 1.2s;\n                width: 100%;\n            }\n            .div-line {\n                flex: 1;\n                height: 1px;\n                background: linear-gradient(90deg, transparent, rgba(40, 100, 220, 0.45), transparent);\n            }\n            .div-icon {\n                font-size: clamp(14px, 1.8vw, 24px);\n                color: rgba(40, 100, 200, 0.65);\n            } /* ── MAIN WORD ── */\n            .main-word {\n                font-family: \"Noto Serif Tamil\", serif;\n                font-size: clamp(90px, 14vw, 220px);\n                font-weight: 900;\n                line-height: 1.1;\n                letter-spacing: 8px;\n                padding-top: 0.1em;\n                background: linear-gradient(\n                    155deg,\n                    #0a2a6e 0%,\n                    #1a4fbb 18%,\n                    #2e8de8 34%,\n                    #56c2f5 50%,\n                    #1a6fcc 66%,\n                    #0d3590 82%,\n                    #1a4fbb 100%\n                );\n                background-size: 260% auto;\n                -webkit-background-clip: text;\n                -webkit-text-fill-color: transparent;\n                background-clip: text;\n                filter: drop-shadow(0 4px 22px rgba(30, 90, 220, 0.35));\n                opacity: 0;\n                animation:\n                    wordReveal 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 1.4s,\n                    wordFlow 5s ease-in-out infinite 2.5s;\n                margin-bottom: 0.3vh;\n            }\n            @keyframes wordReveal {\n                from {\n                    opacity: 0;\n                    transform: scale(0.6);\n                    filter: blur(15px) drop-shadow(0 4px 22px rgba(30, 90, 220, 0.35));\n                }\n                to {\n                    opacity: 1;\n                    transform: scale(1);\n                    filter: blur(0) drop-shadow(0 4px 22px rgba(30, 90, 220, 0.35));\n                }\n            }\n            @keyframes wordFlow {\n                0%,\n                100% {\n                    background-position: 0% center;\n                }\n                50% {\n                    background-position: 100% center;\n                }\n            } /* ── SUBTITLE ── */\n            .subtitle {\n                font-family: \"Noto Serif Tamil\", serif;\n                font-size: clamp(20px, 3.2vw, 42px);\n                font-weight: 700;\n                color: rgba(15, 45, 120, 0.85);\n                letter-spacing: 5px;\n                margin-bottom: 1.2vh;\n                opacity: 0;\n                animation: fadeUp 0.9s ease forwards 1.9s;\n                text-shadow: 0 1px 10px rgba(100, 180, 255, 0.4);\n            } /* ── VERSE BOX ── */\n            .verse-box {\n                background: rgba(180, 220, 255, 0.2);\n                border: 1px solid rgba(60, 130, 220, 0.3);\n                border-radius: 14px;\n                padding: clamp(14px, 2vh, 22px) clamp(24px, 3.5vw, 48px);\n                margin-bottom: 1vh;\n                opacity: 0;\n                animation: fadeUp 0.9s ease forwards 2.2s;\n                max-width: 80vw;\n                text-align: center;\n            }\n            .verse-text {\n                font-family: \"Lora\", serif;\n                font-style: italic;\n                font-size: clamp(18px, 2.3vw, 32px);\n                color: rgba(10, 35, 100, 0.9);\n                line-height: 1.85;\n                letter-spacing: 1.5px;\n            }\n            .verse-ref {\n                font-family: \"Lora\", serif;\n                font-size: clamp(15px, 1.7vw, 24px);\n                color: rgba(30, 80, 180, 0.65);\n                letter-spacing: 3px;\n                margin-top: 0.6vh;\n            } /* ── CHURCH BADGE ── */\n            .church-wrapper {\n                position: relative;\n                display: inline-flex;\n                align-items: center;\n                justify-content: center;\n                opacity: 0;\n                animation: churchEntrance 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 2.7s;\n                margin-top: 0.2vh;\n            }\n            @keyframes churchEntrance {\n                from {\n                    opacity: 0;\n                    transform: scale(0.5) rotate(-12deg);\n                }\n                to {\n                    opacity: 1;\n                    transform: scale(1) rotate(0deg);\n                }\n            }\n            .church-bg {\n                position: absolute;\n                inset: 3px;\n                border-radius: 46px;\n                background: rgba(5, 12, 40, 0.9);\n                z-index: 1;\n            }\n            .church {\n                position: relative;\n                z-index: 2;\n                font-family: \"Noto Serif Tamil\", serif;\n                font-weight: 900;\n                font-size: clamp(18px, 2.3vw, 32px);\n                letter-spacing: 4px;\n                padding: clamp(10px, 1.5vh, 18px) clamp(28px, 3.6vw, 50px);\n                white-space: nowrap;\n                background: linear-gradient(\n                    90deg,\n                    #7ee8ff 0%,\n                    #ffdd57 18%,\n                    #72f5a8 36%,\n                    #a259ff 54%,\n                    #7ee8ff 72%,\n                    #ffdd57 90%,\n                    #72f5a8 100%\n                );\n                background-size: 300% auto;\n                -webkit-background-clip: text;\n                -webkit-text-fill-color: transparent;\n                background-clip: text;\n                animation: rainbowShift 3s linear infinite;\n                filter: drop-shadow(0 0 6px rgba(100, 220, 255, 0.7)) drop-shadow(0 0 14px rgba(162, 89, 255, 0.5));\n            }\n            @keyframes rainbowShift {\n                0% {\n                    background-position: 0% center;\n                }\n                100% {\n                    background-position: 300% center;\n                }\n            } /* sparkles - REMOVED */ /* ── BOTTOM DECORATION ── */\n            .deco-row {\n                position: absolute;\n                bottom: -2px;\n                left: 0;\n                right: 0;\n                display: flex;\n                justify-content: center;\n                gap: 0.6vw;\n                overflow: hidden;\n                z-index: 11;\n                pointer-events: none;\n            }\n            .deco-item {\n                font-size: clamp(20px, 3vw, 42px);\n                opacity: 0.5;\n                animation: decoSway 3.2s ease-in-out infinite;\n                transform-origin: bottom center;\n            }\n            .deco-item:nth-child(2n) {\n                animation-delay: 0.5s;\n            }\n            .deco-item:nth-child(3n) {\n                animation-delay: 1s;\n            }\n            .deco-item:nth-child(4n) {\n                animation-delay: 1.5s;\n            }\n            @keyframes decoSway {\n                0%,\n                100% {\n                    transform: rotate(-6deg);\n                }\n                50% {\n                    transform: rotate(6deg);\n                }\n            }\n            @keyframes fadeUp {\n                from {\n                    opacity: 0;\n                    transform: translateY(18px);\n                }\n                to {\n                    opacity: 1;\n                    transform: translateY(0);\n                }\n            } /* Responsive */\n            @media (max-width: 768px) {\n                .card {\n                    padding: clamp(24px, 4vh, 50px) clamp(32px, 5.5vw, 85px);\n                }\n                .icon-emoji {\n                    font-size: clamp(28px, 4vw, 56px);\n                }\n                .script-top {\n                    font-size: clamp(12px, 1.6vw, 20px);\n                }\n                .main-word {\n                    font-size: clamp(75px, 12vw, 190px);\n                }\n                .subtitle {\n                    font-size: clamp(18px, 2.8vw, 38px);\n                }\n                .verse-text {\n                    font-size: clamp(16px, 2vw, 28px);\n                }\n                .verse-ref {\n                    font-size: clamp(14px, 1.6vw, 22px);\n                }\n                .church {\n                    font-size: clamp(16px, 2vw, 28px);\n                }\n            }\n        </style>\n    </head>\n    <body>\n        <div class=\"stage\">\n            <div class=\"sky\"></div>\n            <div class=\"bell-glow\"></div>\n            <canvas class=\"rays\" id=\"cRays\"></canvas><canvas class=\"stars\" id=\"cStars\"></canvas>\n            <div class=\"mist\"></div>\n            <canvas class=\"bells\" id=\"cBells\"></canvas>\n            <div class=\"content\">\n                <div class=\"card\">\n                    <!-- Icon row: megaphone / bell / cross -->\n                    <div class=\"icon-row\">\n                        <span class=\"icon-emoji\">📣</span><span class=\"icon-emoji\">✝</span\n                        ><span class=\"icon-emoji\">🔔</span>\n                    </div>\n                    <div class=\"script-top\">கவனியுங்கள் • Please Note</div>\n                    <div class=\"divider\">\n                        <div class=\"div-line\"></div>\n                        <span class=\"div-icon\">📢</span>\n                        <div class=\"div-line\"></div>\n                    </div>\n                    <!-- BIG WORD -->\n                    <div class=\"main-word\">அறிவிப்பு</div>\n                    <div class=\"subtitle\">Announcement · Information</div>\n                    <div class=\"verse-box\">\n                        <div class=\"verse-text\">❝ உங்கள் கோரிக்கைகளை தேவனுக்கு தெரிவியுங்கள் ❞</div>\n                        <div class=\"verse-ref\">— பிலிப்பியர் 4:6</div>\n                    </div>\n                    <!-- CHURCH BADGE -->\n                    <div class=\"church-wrapper\">\n                        <div class=\"church-bg\"></div>\n                        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n                    </div>\n                </div>\n            </div>\n            <!-- bottom deco -->\n            <div class=\"deco-row\">\n                <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span><span class=\"deco-item\">⭐</span\n                ><span class=\"deco-item\">🌟</span><span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span\n                ><span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span><span class=\"deco-item\">⭐</span\n                ><span class=\"deco-item\">✨</span><span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span\n                ><span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span><span class=\"deco-item\">⭐</span>\n            </div>\n        </div>\n        <script>\n            /* ── LIGHT RAYS (blue tone) ── */ (function () {\n                const cv = document.getElementById(\"cRays\");\n                const cx = cv.getContext(\"2d\");\n                let W,\n                    H,\n                    t = 0;\n                function resize() {\n                    W = cv.width = innerWidth;\n                    H = cv.height = innerHeight;\n                }\n                resize();\n                addEventListener(\"resize\", resize);\n                const RAYS = Array.from({ length: 20 }, (_, i) => ({\n                    angle: (i / 20) * Math.PI - Math.PI / 2 + (Math.random() - 0.5) * 0.3,\n                    width: 2 + Math.random() * 5,\n                    alpha: 0.035 + Math.random() * 0.07,\n                    speed: (0.002 + Math.random() * 0.003) * (Math.random() > 0.5 ? 1 : -1),\n                    length: 0.55 + Math.random() * 0.55,\n                }));\n                const OX = W * 0.5,\n                    OY = H * -0.05;\n                function draw() {\n                    t++;\n                    cx.clearRect(0, 0, W, H);\n                    RAYS.forEach((r) => {\n                        r.angle += r.speed;\n                        const ax = Math.cos(r.angle) * W * r.length + OX;\n                        const ay = Math.sin(r.angle) * W * r.length + OY;\n                        const bx = Math.cos(r.angle + 0.04) * W * r.length + OX;\n                        const by = Math.sin(r.angle + 0.04) * W * r.length + OY;\n                        cx.save();\n                        const g = cx.createLinearGradient(OX, OY, ax, ay);\n                        g.addColorStop(0, `rgba(150,210,255,${r.alpha * 2})`);\n                        g.addColorStop(0.4, `rgba(100,180,255,${r.alpha})`);\n                        g.addColorStop(1, \"rgba(100,180,255,0)\");\n                        cx.beginPath();\n                        cx.moveTo(OX, OY);\n                        cx.lineTo(ax, ay);\n                        cx.lineTo(bx, by);\n                        cx.closePath();\n                        cx.fillStyle = g;\n                        cx.fill();\n                        cx.restore();\n                    });\n                    requestAnimationFrame(draw);\n                }\n                draw();\n            })();\n            /* ── TWINKLING STARS ── */ (function () {\n                const cv = document.getElementById(\"cStars\");\n                const cx = cv.getContext(\"2d\");\n                let W,\n                    H,\n                    t = 0;\n                function resize() {\n                    W = cv.width = innerWidth;\n                    H = cv.height = innerHeight;\n                }\n                resize();\n                addEventListener(\"resize\", resize);\n                const STARS = Array.from({ length: 55 }, () => ({\n                    x: Math.random(),\n                    y: Math.random() * 0.55,\n                    r: Math.random() * 2.2 + 0.5,\n                    phase: Math.random() * Math.PI * 2,\n                    speed: Math.random() * 0.025 + 0.012,\n                }));\n                function draw() {\n                    t++;\n                    cx.clearRect(0, 0, W, H);\n                    STARS.forEach((s) => {\n                        const alpha = 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(t * s.speed + s.phase));\n                        cx.save();\n                        cx.globalAlpha = alpha;\n                        cx.fillStyle = \"rgba(200,230,255,1)\";\n                        cx.shadowColor = \"rgba(150,210,255,.9)\";\n                        cx.shadowBlur = s.r * 4;\n                        cx.beginPath();\n                        cx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);\n                        cx.fill();\n                        cx.restore();\n                    });\n                    requestAnimationFrame(draw);\n                }\n                draw();\n            })();\n            /* ── FLOATING BELL RINGS ── */ (function () {\n                const cv = document.getElementById(\"cBells\");\n                const cx = cv.getContext(\"2d\");\n                let W,\n                    H,\n                    t = 0;\n                function resize() {\n                    W = cv.width = innerWidth;\n                    H = cv.height = innerHeight;\n                }\n                resize();\n                addEventListener(\"resize\", resize);\n                class Ring {\n                    constructor() {\n                        this.reset(true);\n                    }\n                    reset(rand) {\n                        this.x = (0.25 + Math.random() * 0.5) * W;\n                        this.y = rand ? Math.random() * H : H + 30;\n                        this.vy = -(Math.random() * 0.6 + 0.25);\n                        this.r = Math.random() * 18 + 8;\n                        this.maxR = this.r * 5;\n                        this.alpha = Math.random() * 0.4 + 0.2;\n                        this.growing = true;\n                    }\n                    update() {\n                        this.y += this.vy;\n                        this.r += 0.4;\n                        this.alpha -= 0.004;\n                        if (this.alpha <= 0 || this.y < -50) this.reset(false);\n                    }\n                    draw(cx) {\n                        cx.save();\n                        cx.globalAlpha = Math.max(0, this.alpha);\n                        cx.strokeStyle = \"rgba(100,180,255,0.7)\";\n                        cx.lineWidth = 1.5;\n                        cx.shadowColor = \"rgba(100,200,255,0.5)\";\n                        cx.shadowBlur = 6;\n                        cx.beginPath();\n                        cx.arc(this.x, this.y, this.r, 0, Math.PI * 2);\n                        cx.stroke();\n                        cx.restore();\n                    }\n                }\n                const rings = Array.from({ length: 12 }, () => new Ring());\n                function draw() {\n                    t++;\n                    cx.clearRect(0, 0, W, H);\n                    if (t % 40 === 0 && rings.length < 18) rings.push(new Ring());\n                    rings.forEach((r) => {\n                        r.update();\n                        r.draw(cx);\n                    });\n                    requestAnimationFrame(draw);\n                }\n                draw();\n            })();\n        </script>\n    </body>\n</html>\n",
      "bookmarked": false,
      "_rev": 0,
      "_thumbHtml": "<!doctype html>\n<html lang=\"ta\">\n    <head>\n        <meta charset=\"UTF-8\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n        <title>அறிவிப்பு - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n        <link\n            href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\"\n            rel=\"stylesheet\"\n        />\n        <style>\n            * {\n                margin: 0;\n                padding: 0;\n                box-sizing: border-box;\n            }\n            html,\n            body {\n                width: 100%;\n                height: 100%;\n                overflow: hidden;\n            }\n            .stage {\n                width: 100vw;\n                height: 100vh;\n                position: relative;\n                overflow: hidden;\n            } /* ── SKY GRADIENT — deep royal blue to golden dawn (announcement feel) ── */\n            .sky {\n                position: absolute;\n                inset: 0;\n                background: linear-gradient(\n                    170deg,\n                    #05102a 0%,\n                    #0e2257 12%,\n                    #1a4a8a 26%,\n                    #2e6db4 40%,\n                    #5299d3 54%,\n                    #8ac4e8 68%,\n                    #c9e8f7 82%,\n                    #f0f8ff 92%,\n                    #ffffff 100%\n                );\n                z-index: 0;\n            } /* ── MEGAPHONE / BELL GLOW ── */\n            .bell-glow {\n                position: absolute;\n                top: -10vh;\n                left: 50%;\n                transform: translateX(-50%);\n                width: 55vw;\n                height: 55vw;\n                border-radius: 50%;\n                background: radial-gradient(\n                    circle,\n                    rgba(180, 220, 255, 0.55) 0%,\n                    rgba(100, 170, 255, 0.3) 30%,\n                    rgba(50, 120, 220, 0.1) 60%,\n                    transparent 100%\n                );\n                z-index: 1;\n                animation: bellPulse 3.5s ease-in-out infinite;\n            }\n            @keyframes bellPulse {\n                0%,\n                100% {\n                    transform: translateX(-50%) scale(1);\n                    opacity: 0.8;\n                }\n                50% {\n                    transform: translateX(-50%) scale(1.08);\n                    opacity: 1;\n                }\n            } /* ── CANVASES ── */\n            canvas.rays {\n                position: absolute;\n                inset: 0;\n                z-index: 2;\n                pointer-events: none;\n            }\n            canvas.stars {\n                position: absolute;\n                inset: 0;\n                z-index: 3;\n                pointer-events: none;\n            }\n            canvas.bells {\n                position: absolute;\n                inset: 0;\n                z-index: 5;\n                pointer-events: none;\n            } /* ── MIST ── */\n            .mist {\n                position: absolute;\n                bottom: 0;\n                left: 0;\n                right: 0;\n                height: 28vh;\n                background: linear-gradient(\n                    to top,\n                    rgba(240, 248, 255, 0.65) 0%,\n                    rgba(200, 230, 255, 0.25) 50%,\n                    transparent 100%\n                );\n                z-index: 4;\n            } /* ── CONTENT ── */\n            .content {\n                position: absolute;\n                inset: 0;\n                z-index: 10;\n                display: flex;\n                flex-direction: column;\n                align-items: center;\n                justify-content: center;\n            } /* ── CARD ── */\n            .card {\n                background: rgba(255, 255, 255, 0.14);\n                backdrop-filter: blur(20px);\n                -webkit-backdrop-filter: blur(20px);\n                border: 1px solid rgba(255, 255, 255, 0.4);\n                border-radius: 26px;\n                padding: clamp(28px, 4.5vh, 55px) clamp(40px, 6.5vw, 95px);\n                display: flex;\n                flex-direction: column;\n                align-items: center;\n                gap: 0;\n                box-shadow:\n                    0 8px 60px rgba(20, 60, 140, 0.3),\n                    0 2px 20px rgba(100, 180, 255, 0.2),\n                    inset 0 1px 0 rgba(255, 255, 255, 0.55);\n                opacity: 0;\n                animation: cardReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards 0.4s;\n                position: relative;\n                overflow: hidden;\n            }\n            .card::before {\n                content: \"\";\n                position: absolute;\n                inset: 0;\n                background: linear-gradient(\n                    135deg,\n                    rgba(255, 255, 255, 0.2) 0%,\n                    rgba(150, 210, 255, 0.08) 50%,\n                    rgba(255, 255, 255, 0.05) 100%\n                );\n                border-radius: 26px;\n                pointer-events: none;\n            }\n            @keyframes cardReveal {\n                from {\n                    opacity: 0;\n                    transform: translateY(30px) scale(0.97);\n                }\n                to {\n                    opacity: 1;\n                    transform: translateY(0) scale(1);\n                }\n            } /* ── ICON ROW ── */\n            .icon-row {\n                display: flex;\n                align-items: center;\n                gap: 2vw;\n                margin-bottom: 0.8vh;\n                opacity: 0;\n                animation: fadeUp 0.9s ease forwards 0.8s;\n            }\n            .icon-emoji {\n                font-size: clamp(32px, 4.5vw, 64px);\n                animation: iconBounce 2.8s ease-in-out infinite;\n                filter: drop-shadow(0 2px 8px rgba(30, 80, 200, 0.4));\n            }\n            .icon-emoji:nth-child(1) {\n                animation-delay: 0s;\n            }\n            .icon-emoji:nth-child(2) {\n                animation-delay: 0.35s;\n            }\n            .icon-emoji:nth-child(3) {\n                animation-delay: 0.7s;\n            }\n            @keyframes iconBounce {\n                0%,\n                100% {\n                    transform: translateY(0) rotate(-4deg);\n                }\n                50% {\n                    transform: translateY(-9px) rotate(4deg);\n                }\n            } /* ── TOP SCRIPT ── */\n            .script-top {\n                font-family: \"Lora\", serif;\n                font-style: italic;\n                font-weight: 400;\n                font-size: clamp(14px, 1.8vw, 24px);\n                letter-spacing: 8px;\n                text-transform: uppercase;\n                color: rgba(20, 60, 140, 0.7);\n                margin-bottom: 0.8vh;\n                opacity: 0;\n                animation: fadeUp 0.8s ease forwards 1s;\n            } /* ── DIVIDER ── */\n            .divider {\n                display: flex;\n                align-items: center;\n                gap: 1.5vw;\n                margin-bottom: 1.2vh;\n                opacity: 0;\n                animation: fadeUp 0.8s ease forwards 1.2s;\n                width: 100%;\n            }\n            .div-line {\n                flex: 1;\n                height: 1px;\n                background: linear-gradient(90deg, transparent, rgba(40, 100, 220, 0.45), transparent);\n            }\n            .div-icon {\n                font-size: clamp(14px, 1.8vw, 24px);\n                color: rgba(40, 100, 200, 0.65);\n            } /* ── MAIN WORD ── */\n            .main-word {\n                font-family: \"Noto Serif Tamil\", serif;\n                font-size: clamp(90px, 14vw, 220px);\n                font-weight: 900;\n                line-height: 1.1;\n                letter-spacing: 8px;\n                padding-top: 0.1em;\n                background: linear-gradient(\n                    155deg,\n                    #0a2a6e 0%,\n                    #1a4fbb 18%,\n                    #2e8de8 34%,\n                    #56c2f5 50%,\n                    #1a6fcc 66%,\n                    #0d3590 82%,\n                    #1a4fbb 100%\n                );\n                background-size: 260% auto;\n                -webkit-background-clip: text;\n                -webkit-text-fill-color: transparent;\n                background-clip: text;\n                filter: drop-shadow(0 4px 22px rgba(30, 90, 220, 0.35));\n                opacity: 0;\n                animation:\n                    wordReveal 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 1.4s,\n                    wordFlow 5s ease-in-out infinite 2.5s;\n                margin-bottom: 0.3vh;\n            }\n            @keyframes wordReveal {\n                from {\n                    opacity: 0;\n                    transform: scale(0.6);\n                    filter: blur(15px) drop-shadow(0 4px 22px rgba(30, 90, 220, 0.35));\n                }\n                to {\n                    opacity: 1;\n                    transform: scale(1);\n                    filter: blur(0) drop-shadow(0 4px 22px rgba(30, 90, 220, 0.35));\n                }\n            }\n            @keyframes wordFlow {\n                0%,\n                100% {\n                    background-position: 0% center;\n                }\n                50% {\n                    background-position: 100% center;\n                }\n            } /* ── SUBTITLE ── */\n            .subtitle {\n                font-family: \"Noto Serif Tamil\", serif;\n                font-size: clamp(20px, 3.2vw, 42px);\n                font-weight: 700;\n                color: rgba(15, 45, 120, 0.85);\n                letter-spacing: 5px;\n                margin-bottom: 1.2vh;\n                opacity: 0;\n                animation: fadeUp 0.9s ease forwards 1.9s;\n                text-shadow: 0 1px 10px rgba(100, 180, 255, 0.4);\n            } /* ── VERSE BOX ── */\n            .verse-box {\n                background: rgba(180, 220, 255, 0.2);\n                border: 1px solid rgba(60, 130, 220, 0.3);\n                border-radius: 14px;\n                padding: clamp(14px, 2vh, 22px) clamp(24px, 3.5vw, 48px);\n                margin-bottom: 1vh;\n                opacity: 0;\n                animation: fadeUp 0.9s ease forwards 2.2s;\n                max-width: 80vw;\n                text-align: center;\n            }\n            .verse-text {\n                font-family: \"Lora\", serif;\n                font-style: italic;\n                font-size: clamp(18px, 2.3vw, 32px);\n                color: rgba(10, 35, 100, 0.9);\n                line-height: 1.85;\n                letter-spacing: 1.5px;\n            }\n            .verse-ref {\n                font-family: \"Lora\", serif;\n                font-size: clamp(15px, 1.7vw, 24px);\n                color: rgba(30, 80, 180, 0.65);\n                letter-spacing: 3px;\n                margin-top: 0.6vh;\n            } /* ── CHURCH BADGE ── */\n            .church-wrapper {\n                position: relative;\n                display: inline-flex;\n                align-items: center;\n                justify-content: center;\n                opacity: 0;\n                animation: churchEntrance 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 2.7s;\n                margin-top: 0.2vh;\n            }\n            @keyframes churchEntrance {\n                from {\n                    opacity: 0;\n                    transform: scale(0.5) rotate(-12deg);\n                }\n                to {\n                    opacity: 1;\n                    transform: scale(1) rotate(0deg);\n                }\n            }\n            .church-bg {\n                position: absolute;\n                inset: 3px;\n                border-radius: 46px;\n                background: rgba(5, 12, 40, 0.9);\n                z-index: 1;\n            }\n            .church {\n                position: relative;\n                z-index: 2;\n                font-family: \"Noto Serif Tamil\", serif;\n                font-weight: 900;\n                font-size: clamp(18px, 2.3vw, 32px);\n                letter-spacing: 4px;\n                padding: clamp(10px, 1.5vh, 18px) clamp(28px, 3.6vw, 50px);\n                white-space: nowrap;\n                background: linear-gradient(\n                    90deg,\n                    #7ee8ff 0%,\n                    #ffdd57 18%,\n                    #72f5a8 36%,\n                    #a259ff 54%,\n                    #7ee8ff 72%,\n                    #ffdd57 90%,\n                    #72f5a8 100%\n                );\n                background-size: 300% auto;\n                -webkit-background-clip: text;\n                -webkit-text-fill-color: transparent;\n                background-clip: text;\n                animation: rainbowShift 3s linear infinite;\n                filter: drop-shadow(0 0 6px rgba(100, 220, 255, 0.7)) drop-shadow(0 0 14px rgba(162, 89, 255, 0.5));\n            }\n            @keyframes rainbowShift {\n                0% {\n                    background-position: 0% center;\n                }\n                100% {\n                    background-position: 300% center;\n                }\n            } /* sparkles - REMOVED */ /* ── BOTTOM DECORATION ── */\n            .deco-row {\n                position: absolute;\n                bottom: -2px;\n                left: 0;\n                right: 0;\n                display: flex;\n                justify-content: center;\n                gap: 0.6vw;\n                overflow: hidden;\n                z-index: 11;\n                pointer-events: none;\n            }\n            .deco-item {\n                font-size: clamp(20px, 3vw, 42px);\n                opacity: 0.5;\n                animation: decoSway 3.2s ease-in-out infinite;\n                transform-origin: bottom center;\n            }\n            .deco-item:nth-child(2n) {\n                animation-delay: 0.5s;\n            }\n            .deco-item:nth-child(3n) {\n                animation-delay: 1s;\n            }\n            .deco-item:nth-child(4n) {\n                animation-delay: 1.5s;\n            }\n            @keyframes decoSway {\n                0%,\n                100% {\n                    transform: rotate(-6deg);\n                }\n                50% {\n                    transform: rotate(6deg);\n                }\n            }\n            @keyframes fadeUp {\n                from {\n                    opacity: 0;\n                    transform: translateY(18px);\n                }\n                to {\n                    opacity: 1;\n                    transform: translateY(0);\n                }\n            } /* Responsive */\n            @media (max-width: 768px) {\n                .card {\n                    padding: clamp(24px, 4vh, 50px) clamp(32px, 5.5vw, 85px);\n                }\n                .icon-emoji {\n                    font-size: clamp(28px, 4vw, 56px);\n                }\n                .script-top {\n                    font-size: clamp(12px, 1.6vw, 20px);\n                }\n                .main-word {\n                    font-size: clamp(75px, 12vw, 190px);\n                }\n                .subtitle {\n                    font-size: clamp(18px, 2.8vw, 38px);\n                }\n                .verse-text {\n                    font-size: clamp(16px, 2vw, 28px);\n                }\n                .verse-ref {\n                    font-size: clamp(14px, 1.6vw, 22px);\n                }\n                .church {\n                    font-size: clamp(16px, 2vw, 28px);\n                }\n            }\n        </style>\n    <style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n    <body>\n        <div class=\"stage\">\n            <div class=\"sky\"></div>\n            <div class=\"bell-glow\"></div>\n            <canvas class=\"rays\" id=\"cRays\"></canvas><canvas class=\"stars\" id=\"cStars\"></canvas>\n            <div class=\"mist\"></div>\n            <canvas class=\"bells\" id=\"cBells\"></canvas>\n            <div class=\"content\">\n                <div class=\"card\">\n                    <!-- Icon row: megaphone / bell / cross -->\n                    <div class=\"icon-row\">\n                        <span class=\"icon-emoji\">📣</span><span class=\"icon-emoji\">✝</span\n                        ><span class=\"icon-emoji\">🔔</span>\n                    </div>\n                    <div class=\"script-top\">கவனியுங்கள் • Please Note</div>\n                    <div class=\"divider\">\n                        <div class=\"div-line\"></div>\n                        <span class=\"div-icon\">📢</span>\n                        <div class=\"div-line\"></div>\n                    </div>\n                    <!-- BIG WORD -->\n                    <div class=\"main-word\">அறிவிப்பு</div>\n                    <div class=\"subtitle\">Announcement · Information</div>\n                    <div class=\"verse-box\">\n                        <div class=\"verse-text\">❝ உங்கள் கோரிக்கைகளை தேவனுக்கு தெரிவியுங்கள் ❞</div>\n                        <div class=\"verse-ref\">— பிலிப்பியர் 4:6</div>\n                    </div>\n                    <!-- CHURCH BADGE -->\n                    <div class=\"church-wrapper\">\n                        <div class=\"church-bg\"></div>\n                        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n                    </div>\n                </div>\n            </div>\n            <!-- bottom deco -->\n            <div class=\"deco-row\">\n                <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span><span class=\"deco-item\">⭐</span\n                ><span class=\"deco-item\">🌟</span><span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span\n                ><span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span><span class=\"deco-item\">⭐</span\n                ><span class=\"deco-item\">✨</span><span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span\n                ><span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span><span class=\"deco-item\">⭐</span>\n            </div>\n        </div>\n        <script>\n            /* ── LIGHT RAYS (blue tone) ── */ (function () {\n                const cv = document.getElementById(\"cRays\");\n                const cx = cv.getContext(\"2d\");\n                let W,\n                    H,\n                    t = 0;\n                function resize() {\n                    W = cv.width = innerWidth;\n                    H = cv.height = innerHeight;\n                }\n                resize();\n                addEventListener(\"resize\", resize);\n                const RAYS = Array.from({ length: 20 }, (_, i) => ({\n                    angle: (i / 20) * Math.PI - Math.PI / 2 + (Math.random() - 0.5) * 0.3,\n                    width: 2 + Math.random() * 5,\n                    alpha: 0.035 + Math.random() * 0.07,\n                    speed: (0.002 + Math.random() * 0.003) * (Math.random() > 0.5 ? 1 : -1),\n                    length: 0.55 + Math.random() * 0.55,\n                }));\n                const OX = W * 0.5,\n                    OY = H * -0.05;\n                function draw() {\n                    t++;\n                    cx.clearRect(0, 0, W, H);\n                    RAYS.forEach((r) => {\n                        r.angle += r.speed;\n                        const ax = Math.cos(r.angle) * W * r.length + OX;\n                        const ay = Math.sin(r.angle) * W * r.length + OY;\n                        const bx = Math.cos(r.angle + 0.04) * W * r.length + OX;\n                        const by = Math.sin(r.angle + 0.04) * W * r.length + OY;\n                        cx.save();\n                        const g = cx.createLinearGradient(OX, OY, ax, ay);\n                        g.addColorStop(0, `rgba(150,210,255,${r.alpha * 2})`);\n                        g.addColorStop(0.4, `rgba(100,180,255,${r.alpha})`);\n                        g.addColorStop(1, \"rgba(100,180,255,0)\");\n                        cx.beginPath();\n                        cx.moveTo(OX, OY);\n                        cx.lineTo(ax, ay);\n                        cx.lineTo(bx, by);\n                        cx.closePath();\n                        cx.fillStyle = g;\n                        cx.fill();\n                        cx.restore();\n                    });\n                    requestAnimationFrame(draw);\n                }\n                draw();\n            })();\n            /* ── TWINKLING STARS ── */ (function () {\n                const cv = document.getElementById(\"cStars\");\n                const cx = cv.getContext(\"2d\");\n                let W,\n                    H,\n                    t = 0;\n                function resize() {\n                    W = cv.width = innerWidth;\n                    H = cv.height = innerHeight;\n                }\n                resize();\n                addEventListener(\"resize\", resize);\n                const STARS = Array.from({ length: 55 }, () => ({\n                    x: Math.random(),\n                    y: Math.random() * 0.55,\n                    r: Math.random() * 2.2 + 0.5,\n                    phase: Math.random() * Math.PI * 2,\n                    speed: Math.random() * 0.025 + 0.012,\n                }));\n                function draw() {\n                    t++;\n                    cx.clearRect(0, 0, W, H);\n                    STARS.forEach((s) => {\n                        const alpha = 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(t * s.speed + s.phase));\n                        cx.save();\n                        cx.globalAlpha = alpha;\n                        cx.fillStyle = \"rgba(200,230,255,1)\";\n                        cx.shadowColor = \"rgba(150,210,255,.9)\";\n                        cx.shadowBlur = s.r * 4;\n                        cx.beginPath();\n                        cx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);\n                        cx.fill();\n                        cx.restore();\n                    });\n                    requestAnimationFrame(draw);\n                }\n                draw();\n            })();\n            /* ── FLOATING BELL RINGS ── */ (function () {\n                const cv = document.getElementById(\"cBells\");\n                const cx = cv.getContext(\"2d\");\n                let W,\n                    H,\n                    t = 0;\n                function resize() {\n                    W = cv.width = innerWidth;\n                    H = cv.height = innerHeight;\n                }\n                resize();\n                addEventListener(\"resize\", resize);\n                class Ring {\n                    constructor() {\n                        this.reset(true);\n                    }\n                    reset(rand) {\n                        this.x = (0.25 + Math.random() * 0.5) * W;\n                        this.y = rand ? Math.random() * H : H + 30;\n                        this.vy = -(Math.random() * 0.6 + 0.25);\n                        this.r = Math.random() * 18 + 8;\n                        this.maxR = this.r * 5;\n                        this.alpha = Math.random() * 0.4 + 0.2;\n                        this.growing = true;\n                    }\n                    update() {\n                        this.y += this.vy;\n                        this.r += 0.4;\n                        this.alpha -= 0.004;\n                        if (this.alpha <= 0 || this.y < -50) this.reset(false);\n                    }\n                    draw(cx) {\n                        cx.save();\n                        cx.globalAlpha = Math.max(0, this.alpha);\n                        cx.strokeStyle = \"rgba(100,180,255,0.7)\";\n                        cx.lineWidth = 1.5;\n                        cx.shadowColor = \"rgba(100,200,255,0.5)\";\n                        cx.shadowBlur = 6;\n                        cx.beginPath();\n                        cx.arc(this.x, this.y, this.r, 0, Math.PI * 2);\n                        cx.stroke();\n                        cx.restore();\n                    }\n                }\n                const rings = Array.from({ length: 12 }, () => new Ring());\n                function draw() {\n                    t++;\n                    cx.clearRect(0, 0, W, H);\n                    if (t % 40 === 0 && rings.length < 18) rings.push(new Ring());\n                    rings.forEach((r) => {\n                        r.update();\n                        r.draw(cx);\n                    });\n                    requestAnimationFrame(draw);\n                }\n                draw();\n            })();\n        </script>\n    </body>\n</html>\n"
    },
    {
      "id": 1774106221452.1304,
      "type": "html",
      "name": "BDay",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>பிறந்தநாள் & திருமண நாள் ஆசீர்வாதம்</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:wght@700;900&family=Dancing+Script:wght@600;700&display=swap\" rel=\"stylesheet\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nhtml, body {\n  width: 100%; height: 100%;\n  overflow: hidden;\n  font-family: 'Noto Serif Tamil', serif;\n}\n\n.stage {\n  width: 100vw; height: 100vh;\n  position: relative;\n  background: linear-gradient(135deg, \n    #0f0c29 0%, \n    #302b63 40%, \n    #24243e 100%);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── Animated gradient overlay - REMOVED ── */\n\n/* ── Floating balloons ── */\n.balloons {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n  overflow: hidden;\n}\n\n.balloon {\n  position: absolute;\n  font-size: clamp(40px, 5vw, 80px);\n  animation: balloonFloat linear infinite;\n  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));\n}\n\n@keyframes balloonFloat {\n  0% { \n    transform: translateY(110vh) translateX(0) rotate(0deg); \n    opacity: 0; \n  }\n  10% { opacity: 1; }\n  90% { opacity: 0.8; }\n  100% { \n    transform: translateY(-20vh) translateX(var(--drift)) rotate(var(--rotate)); \n    opacity: 0; \n  }\n}\n\n/* ── Sparkle particles ── */\ncanvas#sparkles {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  pointer-events: none;\n}\n\n/* ── Main content card ── */\n.content-card {\n  position: relative;\n  z-index: 10;\n  background: transparent;\n  border: none;\n  border-radius: 0;\n  padding: clamp(25px, 3.5vh, 50px) clamp(30px, 4.5vw, 80px);\n  box-shadow: none;\n  max-width: 95vw;\n  width: auto;\n  opacity: 0;\n  animation: cardEntrance 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 0.3s;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n@keyframes cardEntrance {\n  from { \n    opacity: 0; \n    transform: scale(0.85) translateY(40px); \n    filter: blur(12px);\n  }\n  to { \n    opacity: 1; \n    transform: scale(1) translateY(0); \n    filter: blur(0);\n  }\n}\n\n/* ── Top icon section ── */\n.celebration-icons {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(20px, 3vw, 45px);\n  margin-bottom: clamp(8px, 1.2vh, 16px);\n  opacity: 0;\n  animation: fadeSlideDown 1s ease forwards 0.8s;\n}\n\n@keyframes fadeSlideDown {\n  from { opacity: 0; transform: translateY(-25px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.celebration-icon {\n  font-size: clamp(50px, 7vw, 100px);\n  animation: iconBounce 2.5s ease-in-out infinite;\n  filter: drop-shadow(0 0 18px rgba(255, 215, 0, 0.8));\n}\n\n.celebration-icon:nth-child(1) { animation-delay: 0s; }\n.celebration-icon:nth-child(2) { animation-delay: 0.3s; }\n.celebration-icon:nth-child(3) { animation-delay: 0.6s; }\n\n@keyframes iconBounce {\n  0%, 100% { transform: translateY(0) scale(1); }\n  50% { transform: translateY(-12px) scale(1.1); }\n}\n\n/* ── Decorative divider ── */\n.divider-fancy {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(12px, 2vw, 25px);\n  margin-bottom: clamp(8px, 1.2vh, 16px);\n  opacity: 0;\n  animation: fadeSlideDown 1s ease forwards 1s;\n}\n\n.divider-line {\n  width: clamp(60px, 10vw, 140px);\n  height: 2px;\n  background: linear-gradient(90deg, \n    transparent, \n    rgba(255, 215, 0, 0.7), \n    rgba(255, 182, 193, 0.7), \n    transparent);\n}\n\n.divider-gem {\n  font-size: clamp(16px, 2vw, 28px);\n  color: #ffd700;\n  filter: drop-shadow(0 0 8px #ffd700);\n}\n\n/* ── Main title ── */\n.main-title {\n  text-align: center;\n  margin-bottom: clamp(6px, 1vh, 12px);\n  opacity: 0;\n  animation: titleReveal 1.3s cubic-bezier(0.22, 1, 0.36, 1) forwards 1.2s;\n}\n\n@keyframes titleReveal {\n  from { \n    opacity: 0; \n    transform: scale(0.9); \n    filter: blur(8px);\n  }\n  to { \n    opacity: 1; \n    transform: scale(1); \n    filter: blur(0);\n  }\n}\n\n.title-tamil {\n  font-size: clamp(56px, 8.5vw, 130px);\n  font-weight: 900;\n  line-height: 1.2;\n  letter-spacing: 3px;\n  background: linear-gradient(135deg, \n    #ffd700 0%, \n    #ffed4e 20%, \n    #ffa500 40%, \n    #ff69b4 60%, \n    #ff1493 80%, \n    #ffd700 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  filter: drop-shadow(0 4px 30px rgba(255, 215, 0, 0.6));\n  text-shadow: none;\n  max-width: 100%;\n}\n\n.title-english {\n  font-family: 'Dancing Script', cursive;\n  font-size: clamp(28px, 4.2vw, 58px);\n  font-weight: 700;\n  color: rgba(255, 215, 0, 0.95);\n  letter-spacing: 2px;\n  margin-top: clamp(4px, 0.8vh, 10px);\n  text-shadow: 0 2px 20px rgba(255, 215, 0, 0.8);\n  max-width: 100%;\n}\n\n/* ── Subtitle label ── */\n.subtitle-label {\n  text-align: center;\n  font-family: 'Playfair Display', serif;\n  font-size: clamp(16px, 2.2vw, 32px);\n  font-weight: 700;\n  color: rgba(255, 255, 255, 0.85);\n  letter-spacing: 6px;\n  text-transform: uppercase;\n  margin-bottom: clamp(10px, 1.8vh, 24px);\n  opacity: 0;\n  animation: fadeSlideDown 1s ease forwards 1.5s;\n  max-width: 100%;\n  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.3);\n}\n\n/* ── Message box ── */\n.message-box {\n  background: transparent;\n  border: 2px solid rgba(255, 215, 0, 0.5);\n  border-radius: 18px;\n  padding: clamp(14px, 2.2vh, 28px) clamp(22px, 3.5vw, 48px);\n  margin-bottom: clamp(12px, 2vh, 28px);\n  text-align: center;\n  opacity: 0;\n  animation: fadeSlideUp 1s ease forwards 1.8s;\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  max-width: 100%;\n}\n\n.message-box::before {\n  content: '';\n  position: absolute;\n  top: 0; left: -100%;\n  width: 100%; height: 100%;\n  background: linear-gradient(90deg, \n    transparent, \n    rgba(255, 255, 255, 0.15), \n    transparent);\n  animation: shimmerSweep 3s ease-in-out infinite;\n  animation-delay: 2.5s;\n}\n\n@keyframes shimmerSweep {\n  0% { left: -100%; }\n  50%, 100% { left: 100%; }\n}\n\n@keyframes fadeSlideUp {\n  from { opacity: 0; transform: translateY(25px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.message-text {\n  font-size: clamp(20px, 2.6vw, 38px);\n  color: rgba(255, 255, 255, 0.95);\n  line-height: 1.7;\n  letter-spacing: 1.5px;\n  max-width: 100%;\n}\n\n.message-highlight {\n  color: #ff69b4;\n  font-weight: 700;\n  text-shadow: 0 0 15px rgba(255, 105, 180, 0.8);\n}\n\n/* ── Call to action ── */\n.call-to-action {\n  text-align: center;\n  font-size: clamp(18px, 2.5vw, 36px);\n  color: rgba(255, 215, 0, 0.95);\n  font-weight: 700;\n  letter-spacing: 2px;\n  margin-bottom: clamp(16px, 2.5vh, 35px);\n  opacity: 0;\n  animation: fadeSlideUp 1s ease forwards 2.1s;\n  text-shadow: 0 2px 15px rgba(255, 215, 0, 0.6);\n  max-width: 100%;\n}\n\n/* ── Prayer section ── */\n.prayer-section {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(15px, 2.5vw, 35px);\n  opacity: 0;\n  animation: fadeSlideUp 1s ease forwards 2.4s;\n}\n\n.prayer-emoji {\n  font-size: clamp(32px, 4.5vw, 65px);\n  animation: prayerPulse 2s ease-in-out infinite;\n  filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.7));\n}\n\n@keyframes prayerPulse {\n  0%, 100% { transform: scale(1) rotate(-5deg); }\n  50% { transform: scale(1.15) rotate(5deg); }\n}\n\n.prayer-text {\n  font-family: 'Dancing Script', cursive;\n  font-size: clamp(22px, 3.2vw, 46px);\n  color: rgba(255, 255, 255, 0.95);\n  font-style: italic;\n  letter-spacing: 1px;\n  text-shadow: 0 2px 20px rgba(255, 255, 255, 0.5);\n  max-width: 100%;\n  text-align: center;\n}\n\n/* ── Floating hearts ── */\n.hearts-container {\n  position: absolute;\n  inset: 0;\n  z-index: 4;\n  pointer-events: none;\n  overflow: hidden;\n}\n\n.heart {\n  position: absolute;\n  font-size: clamp(18px, 2.5vw, 40px);\n  animation: heartFloat linear infinite;\n  opacity: 0;\n}\n\n@keyframes heartFloat {\n  0% { \n    transform: translateY(110vh) scale(0.5) rotate(0deg); \n    opacity: 0; \n  }\n  10% { opacity: 0.8; }\n  90% { opacity: 0.5; }\n  100% { \n    transform: translateY(-10vh) scale(1.2) rotate(360deg); \n    opacity: 0; \n  }\n}\n\n/* ── Confetti burst ── */\n.confetti {\n  position: absolute;\n  width: 10px;\n  height: 10px;\n  z-index: 5;\n  animation: confettiBurst 4s ease-out forwards;\n}\n\n@keyframes confettiBurst {\n  0% {\n    transform: translate(0, 0) rotate(0deg);\n    opacity: 1;\n  }\n  100% {\n    transform: translate(var(--x), var(--y)) rotate(720deg);\n    opacity: 0;\n  }\n}\n\n/* ── Responsive adjustments ── */\n@media (max-width: 1200px) {\n  .title-tamil {\n    font-size: clamp(48px, 7.5vw, 110px);\n  }\n  \n  .title-english {\n    font-size: clamp(24px, 3.8vw, 50px);\n  }\n}\n\n@media (max-width: 768px) {\n  .content-card {\n    padding: clamp(28px, 4.5vh, 55px) clamp(32px, 5.5vw, 85px);\n    max-width: 96vw;\n  }\n  \n  .title-tamil {\n    font-size: clamp(40px, 7vw, 95px);\n  }\n  \n  .title-english {\n    font-size: clamp(22px, 3.5vw, 45px);\n  }\n  \n  .message-text {\n    font-size: clamp(18px, 2.5vw, 32px);\n  }\n  \n  .celebration-icon {\n    font-size: clamp(42px, 6vw, 80px);\n  }\n  \n  .subtitle-label {\n    font-size: clamp(14px, 2vw, 28px);\n    letter-spacing: 4px;\n  }\n}\n</style>\n</head>\n<body>\n\n<div class=\"stage\">\n  <!-- Sparkle canvas -->\n  <canvas id=\"sparkles\"></canvas>\n  \n  <!-- Floating balloons -->\n  <div class=\"balloons\" id=\"balloons\"></div>\n  \n  <!-- Floating hearts -->\n  <div class=\"hearts-container\" id=\"hearts\"></div>\n  \n  <!-- Main content card -->\n  <div class=\"content-card\">\n    <!-- Celebration icons -->\n    <div class=\"celebration-icons\">\n      <span class=\"celebration-icon\">🎂</span>\n      <span class=\"celebration-icon\">🎉</span>\n      <span class=\"celebration-icon\">💍</span>\n    </div>\n    \n    <!-- Decorative divider -->\n    <div class=\"divider-fancy\">\n      <div class=\"divider-line\"></div>\n      <span class=\"divider-gem\">✦</span>\n      <div class=\"divider-line\"></div>\n    </div>\n    \n    <!-- Main title -->\n    <div class=\"main-title\">\n      <div class=\"title-tamil\">பிறந்தநாள் & திருமண நாள்</div>\n      <div class=\"title-english\">Birthday & Anniversary</div>\n    </div>\n    \n    <!-- Subtitle -->\n    <div class=\"subtitle-label\">Special Blessing Time</div>\n    \n    <!-- Message box -->\n    <div class=\"message-box\">\n      <div class=\"message-text\">\n        இந்த வாரம் / இன்று <span class=\"message-highlight\">பிறந்தநாள்</span> அல்லது<br>\n        <span class=\"message-highlight\">திருமண நாள்</span> உள்ளவர்கள்<br>\n        தயவுசெய்து எழுந்து நிற்கவும்\n      </div>\n    </div>\n    \n    <!-- Call to action -->\n    <div class=\"call-to-action\">\n      நாம் உங்களுக்காக ஜெபிப்போம்! 🙌\n    </div>\n    \n    <!-- Prayer section -->\n    <div class=\"prayer-section\">\n      <span class=\"prayer-emoji\">🙏</span>\n      <span class=\"prayer-text\">கர்த்தர் உங்களை ஆசீர்வதிப்பார்</span>\n      <span class=\"prayer-emoji\">🙏</span>\n    </div>\n  </div>\n</div>\n\n<script>\n/* ── Sparkle particles ── */\nconst sparkleCanvas = document.getElementById('sparkles');\nconst sparkleCtx = sparkleCanvas.getContext('2d');\n\nfunction resizeSparkle() {\n  sparkleCanvas.width = window.innerWidth;\n  sparkleCanvas.height = window.innerHeight;\n}\nresizeSparkle();\nwindow.addEventListener('resize', resizeSparkle);\n\nconst sparkles = Array.from({length: 60}, () => ({\n  x: Math.random() * sparkleCanvas.width,\n  y: Math.random() * sparkleCanvas.height,\n  size: Math.random() * 3 + 0.5,\n  speedX: (Math.random() - 0.5) * 0.4,\n  speedY: (Math.random() - 0.5) * 0.4,\n  alpha: Math.random(),\n  alphaSpeed: (Math.random() - 0.5) * 0.01,\n  color: Math.random() > 0.5 ? 'rgba(255,215,0,' : 'rgba(255,182,193,'\n}));\n\nfunction animateSparkles() {\n  sparkleCtx.clearRect(0, 0, sparkleCanvas.width, sparkleCanvas.height);\n  \n  sparkles.forEach(s => {\n    sparkleCtx.beginPath();\n    sparkleCtx.arc(s.x, s.y, s.size, 0, Math.PI * 2);\n    sparkleCtx.fillStyle = s.color + s.alpha + ')';\n    sparkleCtx.shadowBlur = 8;\n    sparkleCtx.shadowColor = s.color + '0.8)';\n    sparkleCtx.fill();\n    \n    s.x += s.speedX;\n    s.y += s.speedY;\n    s.alpha += s.alphaSpeed;\n    \n    if (s.alpha <= 0 || s.alpha >= 1) s.alphaSpeed *= -1;\n    if (s.x < 0 || s.x > sparkleCanvas.width) s.speedX *= -1;\n    if (s.y < 0 || s.y > sparkleCanvas.height) s.speedY *= -1;\n  });\n  \n  requestAnimationFrame(animateSparkles);\n}\nanimateSparkles();\n\n/* ── Floating balloons ── */\nconst balloonsContainer = document.getElementById('balloons');\nconst balloonEmojis = ['🎈', '🎈', '🎈', '🎊', '🎉'];\n\nfor (let i = 0; i < 8; i++) {\n  const balloon = document.createElement('div');\n  balloon.className = 'balloon';\n  balloon.textContent = balloonEmojis[Math.floor(Math.random() * balloonEmojis.length)];\n  balloon.style.left = Math.random() * 100 + 'vw';\n  balloon.style.setProperty('--drift', (Math.random() - 0.5) * 200 + 'px');\n  balloon.style.setProperty('--rotate', (Math.random() - 0.5) * 360 + 'deg');\n  balloon.style.animationDuration = (12 + Math.random() * 10) + 's';\n  balloon.style.animationDelay = Math.random() * 6 + 's';\n  balloonsContainer.appendChild(balloon);\n}\n\n/* ── Floating hearts ── */\nconst heartsContainer = document.getElementById('hearts');\nconst heartEmojis = ['💖', '💕', '💗', '💝', '❤️', '💛'];\n\nfor (let i = 0; i < 10; i++) {\n  const heart = document.createElement('div');\n  heart.className = 'heart';\n  heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];\n  heart.style.left = Math.random() * 100 + 'vw';\n  heart.style.animationDuration = (10 + Math.random() * 8) + 's';\n  heart.style.animationDelay = Math.random() * 5 + 's';\n  heartsContainer.appendChild(heart);\n}\n\n/* ── Confetti burst on load ── */\nsetTimeout(() => {\n  const colors = ['#ffd700', '#ff69b4', '#ff1493', '#00bfff', '#7fff00', '#ff4500'];\n  for (let i = 0; i < 50; i++) {\n    const confetti = document.createElement('div');\n    confetti.className = 'confetti';\n    confetti.style.left = '50%';\n    confetti.style.top = '50%';\n    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];\n    confetti.style.setProperty('--x', (Math.random() - 0.5) * 1000 + 'px');\n    confetti.style.setProperty('--y', (Math.random() - 0.5) * 1000 + 'px');\n    confetti.style.animationDelay = Math.random() * 0.3 + 's';\n    document.body.appendChild(confetti);\n    \n    setTimeout(() => confetti.remove(), 4000);\n  }\n}, 1500);\n</script>\n\n</body>\n</html>",
      "bookmarked": false,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>பிறந்தநாள் & திருமண நாள் ஆசீர்வாதம்</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:wght@700;900&family=Dancing+Script:wght@600;700&display=swap\" rel=\"stylesheet\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nhtml, body {\n  width: 100%; height: 100%;\n  overflow: hidden;\n  font-family: 'Noto Serif Tamil', serif;\n}\n\n.stage {\n  width: 100vw; height: 100vh;\n  position: relative;\n  background: linear-gradient(135deg, \n    #0f0c29 0%, \n    #302b63 40%, \n    #24243e 100%);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── Animated gradient overlay - REMOVED ── */\n\n/* ── Floating balloons ── */\n.balloons {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n  overflow: hidden;\n}\n\n.balloon {\n  position: absolute;\n  font-size: clamp(40px, 5vw, 80px);\n  animation: balloonFloat linear infinite;\n  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));\n}\n\n@keyframes balloonFloat {\n  0% { \n    transform: translateY(110vh) translateX(0) rotate(0deg); \n    opacity: 0; \n  }\n  10% { opacity: 1; }\n  90% { opacity: 0.8; }\n  100% { \n    transform: translateY(-20vh) translateX(var(--drift)) rotate(var(--rotate)); \n    opacity: 0; \n  }\n}\n\n/* ── Sparkle particles ── */\ncanvas#sparkles {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  pointer-events: none;\n}\n\n/* ── Main content card ── */\n.content-card {\n  position: relative;\n  z-index: 10;\n  background: transparent;\n  border: none;\n  border-radius: 0;\n  padding: clamp(25px, 3.5vh, 50px) clamp(30px, 4.5vw, 80px);\n  box-shadow: none;\n  max-width: 95vw;\n  width: auto;\n  opacity: 0;\n  animation: cardEntrance 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 0.3s;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n@keyframes cardEntrance {\n  from { \n    opacity: 0; \n    transform: scale(0.85) translateY(40px); \n    filter: blur(12px);\n  }\n  to { \n    opacity: 1; \n    transform: scale(1) translateY(0); \n    filter: blur(0);\n  }\n}\n\n/* ── Top icon section ── */\n.celebration-icons {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(20px, 3vw, 45px);\n  margin-bottom: clamp(8px, 1.2vh, 16px);\n  opacity: 0;\n  animation: fadeSlideDown 1s ease forwards 0.8s;\n}\n\n@keyframes fadeSlideDown {\n  from { opacity: 0; transform: translateY(-25px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.celebration-icon {\n  font-size: clamp(50px, 7vw, 100px);\n  animation: iconBounce 2.5s ease-in-out infinite;\n  filter: drop-shadow(0 0 18px rgba(255, 215, 0, 0.8));\n}\n\n.celebration-icon:nth-child(1) { animation-delay: 0s; }\n.celebration-icon:nth-child(2) { animation-delay: 0.3s; }\n.celebration-icon:nth-child(3) { animation-delay: 0.6s; }\n\n@keyframes iconBounce {\n  0%, 100% { transform: translateY(0) scale(1); }\n  50% { transform: translateY(-12px) scale(1.1); }\n}\n\n/* ── Decorative divider ── */\n.divider-fancy {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(12px, 2vw, 25px);\n  margin-bottom: clamp(8px, 1.2vh, 16px);\n  opacity: 0;\n  animation: fadeSlideDown 1s ease forwards 1s;\n}\n\n.divider-line {\n  width: clamp(60px, 10vw, 140px);\n  height: 2px;\n  background: linear-gradient(90deg, \n    transparent, \n    rgba(255, 215, 0, 0.7), \n    rgba(255, 182, 193, 0.7), \n    transparent);\n}\n\n.divider-gem {\n  font-size: clamp(16px, 2vw, 28px);\n  color: #ffd700;\n  filter: drop-shadow(0 0 8px #ffd700);\n}\n\n/* ── Main title ── */\n.main-title {\n  text-align: center;\n  margin-bottom: clamp(6px, 1vh, 12px);\n  opacity: 0;\n  animation: titleReveal 1.3s cubic-bezier(0.22, 1, 0.36, 1) forwards 1.2s;\n}\n\n@keyframes titleReveal {\n  from { \n    opacity: 0; \n    transform: scale(0.9); \n    filter: blur(8px);\n  }\n  to { \n    opacity: 1; \n    transform: scale(1); \n    filter: blur(0);\n  }\n}\n\n.title-tamil {\n  font-size: clamp(56px, 8.5vw, 130px);\n  font-weight: 900;\n  line-height: 1.2;\n  letter-spacing: 3px;\n  background: linear-gradient(135deg, \n    #ffd700 0%, \n    #ffed4e 20%, \n    #ffa500 40%, \n    #ff69b4 60%, \n    #ff1493 80%, \n    #ffd700 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  filter: drop-shadow(0 4px 30px rgba(255, 215, 0, 0.6));\n  text-shadow: none;\n  max-width: 100%;\n}\n\n.title-english {\n  font-family: 'Dancing Script', cursive;\n  font-size: clamp(28px, 4.2vw, 58px);\n  font-weight: 700;\n  color: rgba(255, 215, 0, 0.95);\n  letter-spacing: 2px;\n  margin-top: clamp(4px, 0.8vh, 10px);\n  text-shadow: 0 2px 20px rgba(255, 215, 0, 0.8);\n  max-width: 100%;\n}\n\n/* ── Subtitle label ── */\n.subtitle-label {\n  text-align: center;\n  font-family: 'Playfair Display', serif;\n  font-size: clamp(16px, 2.2vw, 32px);\n  font-weight: 700;\n  color: rgba(255, 255, 255, 0.85);\n  letter-spacing: 6px;\n  text-transform: uppercase;\n  margin-bottom: clamp(10px, 1.8vh, 24px);\n  opacity: 0;\n  animation: fadeSlideDown 1s ease forwards 1.5s;\n  max-width: 100%;\n  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.3);\n}\n\n/* ── Message box ── */\n.message-box {\n  background: transparent;\n  border: 2px solid rgba(255, 215, 0, 0.5);\n  border-radius: 18px;\n  padding: clamp(14px, 2.2vh, 28px) clamp(22px, 3.5vw, 48px);\n  margin-bottom: clamp(12px, 2vh, 28px);\n  text-align: center;\n  opacity: 0;\n  animation: fadeSlideUp 1s ease forwards 1.8s;\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  max-width: 100%;\n}\n\n.message-box::before {\n  content: '';\n  position: absolute;\n  top: 0; left: -100%;\n  width: 100%; height: 100%;\n  background: linear-gradient(90deg, \n    transparent, \n    rgba(255, 255, 255, 0.15), \n    transparent);\n  animation: shimmerSweep 3s ease-in-out infinite;\n  animation-delay: 2.5s;\n}\n\n@keyframes shimmerSweep {\n  0% { left: -100%; }\n  50%, 100% { left: 100%; }\n}\n\n@keyframes fadeSlideUp {\n  from { opacity: 0; transform: translateY(25px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.message-text {\n  font-size: clamp(20px, 2.6vw, 38px);\n  color: rgba(255, 255, 255, 0.95);\n  line-height: 1.7;\n  letter-spacing: 1.5px;\n  max-width: 100%;\n}\n\n.message-highlight {\n  color: #ff69b4;\n  font-weight: 700;\n  text-shadow: 0 0 15px rgba(255, 105, 180, 0.8);\n}\n\n/* ── Call to action ── */\n.call-to-action {\n  text-align: center;\n  font-size: clamp(18px, 2.5vw, 36px);\n  color: rgba(255, 215, 0, 0.95);\n  font-weight: 700;\n  letter-spacing: 2px;\n  margin-bottom: clamp(16px, 2.5vh, 35px);\n  opacity: 0;\n  animation: fadeSlideUp 1s ease forwards 2.1s;\n  text-shadow: 0 2px 15px rgba(255, 215, 0, 0.6);\n  max-width: 100%;\n}\n\n/* ── Prayer section ── */\n.prayer-section {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(15px, 2.5vw, 35px);\n  opacity: 0;\n  animation: fadeSlideUp 1s ease forwards 2.4s;\n}\n\n.prayer-emoji {\n  font-size: clamp(32px, 4.5vw, 65px);\n  animation: prayerPulse 2s ease-in-out infinite;\n  filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.7));\n}\n\n@keyframes prayerPulse {\n  0%, 100% { transform: scale(1) rotate(-5deg); }\n  50% { transform: scale(1.15) rotate(5deg); }\n}\n\n.prayer-text {\n  font-family: 'Dancing Script', cursive;\n  font-size: clamp(22px, 3.2vw, 46px);\n  color: rgba(255, 255, 255, 0.95);\n  font-style: italic;\n  letter-spacing: 1px;\n  text-shadow: 0 2px 20px rgba(255, 255, 255, 0.5);\n  max-width: 100%;\n  text-align: center;\n}\n\n/* ── Floating hearts ── */\n.hearts-container {\n  position: absolute;\n  inset: 0;\n  z-index: 4;\n  pointer-events: none;\n  overflow: hidden;\n}\n\n.heart {\n  position: absolute;\n  font-size: clamp(18px, 2.5vw, 40px);\n  animation: heartFloat linear infinite;\n  opacity: 0;\n}\n\n@keyframes heartFloat {\n  0% { \n    transform: translateY(110vh) scale(0.5) rotate(0deg); \n    opacity: 0; \n  }\n  10% { opacity: 0.8; }\n  90% { opacity: 0.5; }\n  100% { \n    transform: translateY(-10vh) scale(1.2) rotate(360deg); \n    opacity: 0; \n  }\n}\n\n/* ── Confetti burst ── */\n.confetti {\n  position: absolute;\n  width: 10px;\n  height: 10px;\n  z-index: 5;\n  animation: confettiBurst 4s ease-out forwards;\n}\n\n@keyframes confettiBurst {\n  0% {\n    transform: translate(0, 0) rotate(0deg);\n    opacity: 1;\n  }\n  100% {\n    transform: translate(var(--x), var(--y)) rotate(720deg);\n    opacity: 0;\n  }\n}\n\n/* ── Responsive adjustments ── */\n@media (max-width: 1200px) {\n  .title-tamil {\n    font-size: clamp(48px, 7.5vw, 110px);\n  }\n  \n  .title-english {\n    font-size: clamp(24px, 3.8vw, 50px);\n  }\n}\n\n@media (max-width: 768px) {\n  .content-card {\n    padding: clamp(28px, 4.5vh, 55px) clamp(32px, 5.5vw, 85px);\n    max-width: 96vw;\n  }\n  \n  .title-tamil {\n    font-size: clamp(40px, 7vw, 95px);\n  }\n  \n  .title-english {\n    font-size: clamp(22px, 3.5vw, 45px);\n  }\n  \n  .message-text {\n    font-size: clamp(18px, 2.5vw, 32px);\n  }\n  \n  .celebration-icon {\n    font-size: clamp(42px, 6vw, 80px);\n  }\n  \n  .subtitle-label {\n    font-size: clamp(14px, 2vw, 28px);\n    letter-spacing: 4px;\n  }\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n\n<div class=\"stage\">\n  <!-- Sparkle canvas -->\n  <canvas id=\"sparkles\"></canvas>\n  \n  <!-- Floating balloons -->\n  <div class=\"balloons\" id=\"balloons\"></div>\n  \n  <!-- Floating hearts -->\n  <div class=\"hearts-container\" id=\"hearts\"></div>\n  \n  <!-- Main content card -->\n  <div class=\"content-card\">\n    <!-- Celebration icons -->\n    <div class=\"celebration-icons\">\n      <span class=\"celebration-icon\">🎂</span>\n      <span class=\"celebration-icon\">🎉</span>\n      <span class=\"celebration-icon\">💍</span>\n    </div>\n    \n    <!-- Decorative divider -->\n    <div class=\"divider-fancy\">\n      <div class=\"divider-line\"></div>\n      <span class=\"divider-gem\">✦</span>\n      <div class=\"divider-line\"></div>\n    </div>\n    \n    <!-- Main title -->\n    <div class=\"main-title\">\n      <div class=\"title-tamil\">பிறந்தநாள் & திருமண நாள்</div>\n      <div class=\"title-english\">Birthday & Anniversary</div>\n    </div>\n    \n    <!-- Subtitle -->\n    <div class=\"subtitle-label\">Special Blessing Time</div>\n    \n    <!-- Message box -->\n    <div class=\"message-box\">\n      <div class=\"message-text\">\n        இந்த வாரம் / இன்று <span class=\"message-highlight\">பிறந்தநாள்</span> அல்லது<br>\n        <span class=\"message-highlight\">திருமண நாள்</span> உள்ளவர்கள்<br>\n        தயவுசெய்து எழுந்து நிற்கவும்\n      </div>\n    </div>\n    \n    <!-- Call to action -->\n    <div class=\"call-to-action\">\n      நாம் உங்களுக்காக ஜெபிப்போம்! 🙌\n    </div>\n    \n    <!-- Prayer section -->\n    <div class=\"prayer-section\">\n      <span class=\"prayer-emoji\">🙏</span>\n      <span class=\"prayer-text\">கர்த்தர் உங்களை ஆசீர்வதிப்பார்</span>\n      <span class=\"prayer-emoji\">🙏</span>\n    </div>\n  </div>\n</div>\n\n<script>\n/* ── Sparkle particles ── */\nconst sparkleCanvas = document.getElementById('sparkles');\nconst sparkleCtx = sparkleCanvas.getContext('2d');\n\nfunction resizeSparkle() {\n  sparkleCanvas.width = window.innerWidth;\n  sparkleCanvas.height = window.innerHeight;\n}\nresizeSparkle();\nwindow.addEventListener('resize', resizeSparkle);\n\nconst sparkles = Array.from({length: 60}, () => ({\n  x: Math.random() * sparkleCanvas.width,\n  y: Math.random() * sparkleCanvas.height,\n  size: Math.random() * 3 + 0.5,\n  speedX: (Math.random() - 0.5) * 0.4,\n  speedY: (Math.random() - 0.5) * 0.4,\n  alpha: Math.random(),\n  alphaSpeed: (Math.random() - 0.5) * 0.01,\n  color: Math.random() > 0.5 ? 'rgba(255,215,0,' : 'rgba(255,182,193,'\n}));\n\nfunction animateSparkles() {\n  sparkleCtx.clearRect(0, 0, sparkleCanvas.width, sparkleCanvas.height);\n  \n  sparkles.forEach(s => {\n    sparkleCtx.beginPath();\n    sparkleCtx.arc(s.x, s.y, s.size, 0, Math.PI * 2);\n    sparkleCtx.fillStyle = s.color + s.alpha + ')';\n    sparkleCtx.shadowBlur = 8;\n    sparkleCtx.shadowColor = s.color + '0.8)';\n    sparkleCtx.fill();\n    \n    s.x += s.speedX;\n    s.y += s.speedY;\n    s.alpha += s.alphaSpeed;\n    \n    if (s.alpha <= 0 || s.alpha >= 1) s.alphaSpeed *= -1;\n    if (s.x < 0 || s.x > sparkleCanvas.width) s.speedX *= -1;\n    if (s.y < 0 || s.y > sparkleCanvas.height) s.speedY *= -1;\n  });\n  \n  requestAnimationFrame(animateSparkles);\n}\nanimateSparkles();\n\n/* ── Floating balloons ── */\nconst balloonsContainer = document.getElementById('balloons');\nconst balloonEmojis = ['🎈', '🎈', '🎈', '🎊', '🎉'];\n\nfor (let i = 0; i < 8; i++) {\n  const balloon = document.createElement('div');\n  balloon.className = 'balloon';\n  balloon.textContent = balloonEmojis[Math.floor(Math.random() * balloonEmojis.length)];\n  balloon.style.left = Math.random() * 100 + 'vw';\n  balloon.style.setProperty('--drift', (Math.random() - 0.5) * 200 + 'px');\n  balloon.style.setProperty('--rotate', (Math.random() - 0.5) * 360 + 'deg');\n  balloon.style.animationDuration = (12 + Math.random() * 10) + 's';\n  balloon.style.animationDelay = Math.random() * 6 + 's';\n  balloonsContainer.appendChild(balloon);\n}\n\n/* ── Floating hearts ── */\nconst heartsContainer = document.getElementById('hearts');\nconst heartEmojis = ['💖', '💕', '💗', '💝', '❤️', '💛'];\n\nfor (let i = 0; i < 10; i++) {\n  const heart = document.createElement('div');\n  heart.className = 'heart';\n  heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];\n  heart.style.left = Math.random() * 100 + 'vw';\n  heart.style.animationDuration = (10 + Math.random() * 8) + 's';\n  heart.style.animationDelay = Math.random() * 5 + 's';\n  heartsContainer.appendChild(heart);\n}\n\n/* ── Confetti burst on load ── */\nsetTimeout(() => {\n  const colors = ['#ffd700', '#ff69b4', '#ff1493', '#00bfff', '#7fff00', '#ff4500'];\n  for (let i = 0; i < 50; i++) {\n    const confetti = document.createElement('div');\n    confetti.className = 'confetti';\n    confetti.style.left = '50%';\n    confetti.style.top = '50%';\n    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];\n    confetti.style.setProperty('--x', (Math.random() - 0.5) * 1000 + 'px');\n    confetti.style.setProperty('--y', (Math.random() - 0.5) * 1000 + 'px');\n    confetti.style.animationDelay = Math.random() * 0.3 + 's';\n    document.body.appendChild(confetti);\n    \n    setTimeout(() => confetti.remove(), 4000);\n  }\n}, 1500);\n</script>\n\n</body>\n</html>"
    },
    {
      "id": 1774107463465.8792,
      "type": "html",
      "name": "Offering",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>காணிக்கை - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml, body {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n}\n\n.stage {\n  width: 100vw;\n  height: 100vh;\n  position: relative;\n  overflow: hidden;\n}\n\n/* ── WARM HARVEST SKY — deep olive → amber → golden cream ── */\n.sky {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(168deg,\n    #1a1200 0%,\n    #3b2600 10%,\n    #6b3d00 22%,\n    #a05c00 34%,\n    #c8820a 46%,\n    #e8ad30 58%,\n    #f5d06a 70%,\n    #faeaa0 82%,\n    #fff8d6 92%,\n    #fffdf0 100%\n  );\n  z-index: 0;\n}\n\n/* ── GOLDEN GLOW from bottom center — like altar lamp ── */\n.altar-glow {\n  position: absolute;\n  bottom: -18vh;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 70vw;\n  height: 70vw;\n  border-radius: 50%;\n  background: radial-gradient(circle,\n    rgba(255,220,80,0.75) 0%,\n    rgba(255,180,30,0.45) 28%,\n    rgba(220,130,10,0.2) 55%,\n    transparent 78%\n  );\n  z-index: 1;\n  animation: glowPulse 4s ease-in-out infinite;\n}\n\n@keyframes glowPulse {\n  0%, 100% {\n    transform: translateX(-50%) scale(1);\n    opacity: .85;\n  }\n  50% {\n    transform: translateX(-50%) scale(1.1);\n    opacity: 1;\n  }\n}\n\n/* canvases */\ncanvas.rays {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n}\n\ncanvas.coins {\n  position: absolute;\n  inset: 0;\n  z-index: 4;\n  pointer-events: none;\n}\n\ncanvas.sparkle {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  pointer-events: none;\n}\n\n.mist {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 28vh;\n  background: linear-gradient(to top,\n    rgba(255,248,210,0.65) 0%,\n    rgba(255,235,150,0.25) 55%,\n    transparent 100%\n  );\n  z-index: 3;\n}\n\n/* ── CONTENT ── */\n.content {\n  position: absolute;\n  inset: 0;\n  z-index: 10;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n}\n\n/* ── CARD ── */\n.card {\n  background: rgba(255,248,210,0.18);\n  backdrop-filter: blur(22px);\n  -webkit-backdrop-filter: blur(22px);\n  border: 1px solid rgba(255,220,100,0.45);\n  border-radius: 20px;\n  padding: clamp(20px, 3vh, 50px) clamp(30px, 4vw, 80px);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(8px, 1.2vh, 18px);\n  text-align: center;\n  width: 100vw;\n  height: 100vh;\n  max-width: 100vw;\n  max-height: 100vh;\n  overflow: hidden;\n  box-shadow: 0 8px 60px rgba(140,80,0,0.3),\n              0 2px 24px rgba(255,180,30,0.25),\n              inset 0 1px 0 rgba(255,255,255,0.6);\n  opacity: 0;\n  animation: cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n  position: relative;\n}\n\n.card::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(135deg,\n    rgba(255,255,200,0.22) 0%,\n    rgba(255,200,80,0.08) 50%,\n    rgba(255,255,200,0.05) 100%\n  );\n  border-radius: 28px;\n  pointer-events: none;\n}\n\n@keyframes cardReveal {\n  from {\n    opacity: 0;\n    transform: translateY(28px) scale(.97);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n/* ── ICON ROW ── */\n.icon-row {\n  display: flex;\n  align-items: center;\n  gap: 3vw;\n  margin-bottom: 0.5vh;\n  opacity: 0;\n  animation: fadeUp .9s ease forwards .8s;\n}\n\n.icon-emoji {\n  font-size: clamp(32px, 5.5vmin, 65px);\n  animation: iconFloat 3s ease-in-out infinite;\n  filter: drop-shadow(0 3px 10px rgba(180,100,0,.45));\n}\n\n.icon-emoji:nth-child(1) { animation-delay: 0s; }\n.icon-emoji:nth-child(2) { animation-delay: .4s; }\n.icon-emoji:nth-child(3) { animation-delay: .8s; }\n\n@keyframes iconFloat {\n  0%, 100% {\n    transform: translateY(0) scale(1);\n  }\n  50% {\n    transform: translateY(-10px) scale(1.08);\n  }\n}\n\n/* ── SCRIPT TOP ── */\n.script-top {\n  font-family: 'Lora', serif;\n  font-style: italic;\n  font-weight: 400;\n  font-size: clamp(14px, 2.2vmin, 22px);\n  letter-spacing: 5px;\n  text-transform: uppercase;\n  color: rgba(100,55,0,0.72);\n  margin-bottom: 0.5vh;\n  opacity: 0;\n  animation: fadeUp .8s ease forwards 1s;\n  text-align: center;\n  line-height: 1.4;\n}\n\n/* ── DIVIDER ── */\n.divider {\n  display: flex;\n  align-items: center;\n  gap: 2vw;\n  margin-bottom: 0.8vh;\n  opacity: 0;\n  animation: fadeUp .8s ease forwards 1.2s;\n  width: 100%;\n}\n\n.div-line {\n  flex: 1;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, rgba(180,110,0,.5), transparent);\n}\n\n.div-icon {\n  font-size: clamp(16px, 2.2vw, 28px);\n}\n\n/* ── MAIN TAMIL WORD ── */\n.main-word {\n  font-family: 'Noto Serif Tamil', serif;\n  font-size: clamp(70px, 13vmin, 180px);\n  font-weight: 900;\n  line-height: 1.1;\n  letter-spacing: 4px;\n  background: linear-gradient(150deg,\n    #5c2e00 0%,\n    #9c5200 16%,\n    #d48000 30%,\n    #f5b800 46%,\n    #ffe066 58%,\n    #d48000 72%,\n    #9c5200 85%,\n    #5c2e00 100%\n  );\n  background-size: 280% auto;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  filter: drop-shadow(0 4px 22px rgba(200,120,0,.4));\n  opacity: 0;\n  animation: wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n             wordFlow 5s ease-in-out infinite 2.6s;\n  margin-bottom: 0.8vh;\n  text-align: center;\n}\n\n@keyframes wordReveal {\n  from {\n    opacity: 0;\n    transform: scale(.6);\n    filter: blur(16px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n    filter: blur(0) drop-shadow(0 4px 22px rgba(200,120,0,.4));\n  }\n}\n\n@keyframes wordFlow {\n  0%, 100% {\n    background-position: 0% center;\n  }\n  50% {\n    background-position: 100% center;\n  }\n}\n\n/* ── ENGLISH SUBTITLE ── */\n.subtitle {\n  font-family: 'Noto Serif Tamil', serif;\n  font-size: clamp(22px, 4.5vmin, 45px);\n  font-weight: 700;\n  color: rgba(90,45,0,0.88);\n  letter-spacing: 6px;\n  margin-bottom: 1vh;\n  opacity: 0;\n  animation: fadeUp .9s ease forwards 1.9s;\n  text-shadow: 0 1px 10px rgba(255,200,80,.5);\n  text-transform: uppercase;\n  text-align: center;\n}\n\n/* ── VERSE BOX ── */\n.verse-box {\n  background: rgba(255,220,100,0.2);\n  border: 1px solid rgba(180,120,0,.32);\n  border-radius: 16px;\n  padding: clamp(14px, 2vh, 24px) clamp(24px, 3.5vw, 50px);\n  margin-bottom: 1vh;\n  opacity: 0;\n  animation: fadeUp .9s ease forwards 2.2s;\n  max-width: 90vw;\n  text-align: center;\n}\n\n.verse-text {\n  font-family: 'Lora', serif;\n  font-style: italic;\n  font-size: clamp(16px, 2.6vmin, 28px);\n  color: rgba(70,30,0,0.92);\n  line-height: 1.65;\n  letter-spacing: 0.5px;\n  text-align: center;\n}\n\n.verse-ref {\n  font-family: 'Lora', serif;\n  font-size: clamp(14px, 2vmin, 20px);\n  color: rgba(130,70,0,.72);\n  letter-spacing: 2px;\n  margin-top: 0.6vh;\n}\n\n/* ── CHURCH BADGE ── */\n.church-wrapper {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  animation: churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n  margin-top: 0.2vh;\n}\n\n@keyframes churchEntrance {\n  from {\n    opacity: 0;\n    transform: scale(.5) rotate(-10deg);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) rotate(0deg);\n  }\n}\n\n.church-bg {\n  position: absolute;\n  inset: -2px;\n  border-radius: 46px;\n  background: rgba(8,4,0,0.92);\n  box-shadow: 0 4px 20px rgba(0,0,0,0.4);\n  z-index: 1;\n}\n\n.church {\n  position: relative;\n  z-index: 2;\n  font-family: 'Noto Serif Tamil', serif;\n  font-weight: 900;\n  font-size: clamp(16px, 3vmin, 28px);\n  letter-spacing: 3px;\n  padding: clamp(10px, 1.5vh, 18px) clamp(28px, 3.5vw, 50px);\n  white-space: nowrap;\n  background: linear-gradient(90deg,\n    #ffe066 0%,\n    #ff9f1c 18%,\n    #ffdd57 36%,\n    #ff6b6b 54%,\n    #ffe066 72%,\n    #ff9f1c 90%,\n    #ffdd57 100%\n  );\n  background-size: 300% auto;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  animation: goldShift 3s linear infinite;\n  filter: drop-shadow(0 0 8px rgba(255,180,30,.9))\n          drop-shadow(0 0 18px rgba(255,120,0,.5));\n  text-align: center;\n}\n\n@keyframes goldShift {\n  0% {\n    background-position: 0% center;\n  }\n  100% {\n    background-position: 300% center;\n  }\n}\n\n@keyframes fadeUp {\n  from {\n    opacity: 0;\n    transform: translateY(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Responsive for smaller screens */\n@media (max-height: 700px) {\n  .card {\n    padding: clamp(16px, 2.5vh, 40px) clamp(25px, 3.5vw, 70px);\n    gap: clamp(6px, 0.8vh, 14px);\n  }\n  \n  .icon-emoji {\n    font-size: clamp(28px, 4.5vmin, 55px);\n  }\n  \n  .script-top {\n    font-size: clamp(12px, 2vmin, 20px);\n    letter-spacing: 4px;\n  }\n  \n  .main-word {\n    font-size: clamp(60px, 11vmin, 160px);\n    letter-spacing: 3px;\n  }\n  \n  .subtitle {\n    font-size: clamp(20px, 4vmin, 40px);\n    letter-spacing: 5px;\n  }\n  \n  .verse-text {\n    font-size: clamp(14px, 2.4vmin, 26px);\n    line-height: 1.6;\n  }\n  \n  .verse-ref {\n    font-size: clamp(12px, 1.8vmin, 18px);\n  }\n  \n  .church {\n    font-size: clamp(14px, 2.8vmin, 26px);\n    letter-spacing: 2.5px;\n    padding: clamp(9px, 1.3vh, 16px) clamp(26px, 3.2vw, 46px);\n  }\n}\n\n/* Responsive for mobile */\n@media (max-width: 768px) {\n  .card {\n    padding: clamp(22px, 3.5vh, 50px) clamp(32px, 5.5vw, 80px);\n  }\n  \n  .icon-emoji {\n    font-size: clamp(30px, 5vw, 60px);\n  }\n  \n  .script-top {\n    font-size: clamp(13px, 2vw, 22px);\n  }\n  \n  .main-word {\n    font-size: clamp(68px, 12vw, 170px);\n  }\n  \n  .subtitle {\n    font-size: clamp(20px, 3.5vw, 42px);\n  }\n  \n  .verse-text {\n    font-size: clamp(15px, 2.4vw, 28px);\n  }\n  \n  .verse-ref {\n    font-size: clamp(13px, 1.8vw, 20px);\n  }\n  \n  .church {\n    font-size: clamp(15px, 2.4vw, 28px);\n  }\n}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n  <div class=\"sky\"></div>\n  <div class=\"altar-glow\"></div>\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"sparkle\" id=\"cSparkle\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"coins\" id=\"cCoins\"></canvas>\n  \n  <div class=\"content\">\n    <div class=\"card\">\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">🙌</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">💛</span>\n      </div>\n      \n      <div class=\"script-top\">கர்த்தருக்கு செலுத்துவோம் • Give Unto the Lord</div>\n      \n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">🌾</span>\n        <div class=\"div-line\"></div>\n      </div>\n      \n      <div class=\"main-word\">காணிக்கை</div>\n      \n      <div class=\"subtitle\">Offering</div>\n      \n      <div class=\"verse-box\">\n        <div class=\"verse-text\">\n          ❝ அவரவர் மனதில் குறித்துக்கொண்டபடி கொடுக்கட்டும்;<br>\n          சலிப்போடு அல்ல, கட்டாயமாக அல்ல;<br>\n          சந்தோஷமாய்க் கொடுக்கிறவனிடத்தில் தேவன் பிரியப்படுகிறார். ❞\n        </div>\n        <div class=\"verse-ref\">— 2 கொரிந்தியர் 9:7</div>\n      </div>\n      \n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n/* ── GOLDEN RAYS from bottom ── */\n(function() {\n  const cv = document.getElementById('cRays');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  \n  function resize() {\n    W = cv.width = innerWidth;\n    H = cv.height = innerHeight;\n  }\n  resize();\n  addEventListener('resize', resize);\n  \n  const RAYS = Array.from({length: 22}, (_, i) => ({\n    angle: (i / 22) * Math.PI * 1.4 - Math.PI * .7 + (Math.random() - .5) * .25,\n    alpha: .04 + Math.random() * .08,\n    speed: (.0018 + Math.random() * .003) * (Math.random() > .5 ? 1 : -1),\n    length: .5 + Math.random() * .6\n  }));\n  \n  const OX = W * .5, OY = H * 1.05;\n  \n  function draw() {\n    t++;\n    cx.clearRect(0, 0, W, H);\n    RAYS.forEach(r => {\n      r.angle += r.speed;\n      const ax = Math.cos(r.angle) * W * r.length + OX;\n      const ay = Math.sin(r.angle) * W * r.length + OY;\n      const bx = Math.cos(r.angle + .035) * W * r.length + OX;\n      const by = Math.sin(r.angle + .035) * W * r.length + OY;\n      cx.save();\n      const g = cx.createLinearGradient(OX, OY, ax, ay);\n      g.addColorStop(0, `rgba(255,210,60,${r.alpha * 2.2})`);\n      g.addColorStop(.35, `rgba(255,175,30,${r.alpha})`);\n      g.addColorStop(1, 'rgba(255,210,60,0)');\n      cx.beginPath();\n      cx.moveTo(OX, OY);\n      cx.lineTo(ax, ay);\n      cx.lineTo(bx, by);\n      cx.closePath();\n      cx.fillStyle = g;\n      cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── GOLDEN SPARKLE DUST ── */\n(function() {\n  const cv = document.getElementById('cSparkle');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  \n  function resize() {\n    W = cv.width = innerWidth;\n    H = cv.height = innerHeight;\n  }\n  resize();\n  addEventListener('resize', resize);\n  \n  const SPARKS = Array.from({length: 70}, () => ({\n    x: Math.random() * W,\n    y: Math.random() * H,\n    r: Math.random() * 2 + .5,\n    phase: Math.random() * Math.PI * 2,\n    speed: Math.random() * .03 + .015,\n    vy: -(Math.random() * .3 + .1),\n    vx: (Math.random() - .5) * .15\n  }));\n  \n  function draw() {\n    t++;\n    cx.clearRect(0, 0, W, H);\n    SPARKS.forEach(s => {\n      s.y += s.vy;\n      s.x += s.vx;\n      if (s.y < -10) {\n        s.y = H + 10;\n        s.x = Math.random() * W;\n      }\n      const a = .2 + .6 * (.5 + .5 * Math.sin(t * s.speed + s.phase));\n      cx.save();\n      cx.globalAlpha = a;\n      cx.fillStyle = 'rgba(255,220,80,1)';\n      cx.shadowColor = 'rgba(255,180,0,.8)';\n      cx.shadowBlur = s.r * 5;\n      cx.beginPath();\n      cx.arc(s.x, s.y, s.r, 0, Math.PI * 2);\n      cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING COINS ── */\n(function() {\n  const cv = document.getElementById('cCoins');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  \n  function resize() {\n    W = cv.width = innerWidth;\n    H = cv.height = innerHeight;\n  }\n  resize();\n  addEventListener('resize', resize);\n  \n  class Coin {\n    constructor(rand) {\n      this.x = Math.random() * W;\n      this.y = rand ? (Math.random() * H) : (H + 30);\n      this.r = Math.random() * 9 + 5;\n      this.vy = -(Math.random() * .5 + .2);\n      this.vx = (Math.random() - .5) * .3;\n      this.rot = Math.random() * Math.PI * 2;\n      this.rotV = (Math.random() - .5) * .04;\n      this.alpha = Math.random() * .55 + .25;\n      this.phase = Math.random() * Math.PI * 2;\n    }\n    \n    update() {\n      this.y += this.vy;\n      this.x += this.vx;\n      this.rot += this.rotV;\n      this.alpha -= .0015;\n      if (this.alpha <= 0 || this.y < -30) {\n        Object.assign(this, new Coin(false));\n      }\n    }\n    \n    draw(cx) {\n      cx.save();\n      cx.translate(this.x, this.y);\n      cx.rotate(this.rot);\n      cx.globalAlpha = Math.max(0, this.alpha);\n      \n      /* coin body */\n      const g = cx.createRadialGradient(-this.r * .3, -this.r * .3, 0, 0, 0, this.r);\n      g.addColorStop(0, 'rgba(255,240,120,1)');\n      g.addColorStop(.5, 'rgba(220,170,20,1)');\n      g.addColorStop(1, 'rgba(160,100,0,1)');\n      cx.fillStyle = g;\n      cx.shadowColor = 'rgba(255,200,0,.6)';\n      cx.shadowBlur = 8;\n      cx.beginPath();\n      cx.ellipse(0, 0, this.r, this.r * .35, 0, 0, Math.PI * 2);\n      cx.fill();\n      \n      /* shine */\n      cx.fillStyle = 'rgba(255,255,180,.45)';\n      cx.beginPath();\n      cx.ellipse(-this.r * .25, -this.r * .05, this.r * .3, this.r * .1, -.3, 0, Math.PI * 2);\n      cx.fill();\n      \n      cx.restore();\n    }\n  }\n  \n  const coins = Array.from({length: 20}, () => new Coin(true));\n  \n  function draw() {\n    t++;\n    cx.clearRect(0, 0, W, H);\n    if (t % 55 === 0 && coins.length < 28) {\n      coins.push(new Coin(false));\n    }\n    coins.forEach(c => {\n      c.update();\n      c.draw(cx);\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>\n",
      "bookmarked": false,
      "_rev": 0,
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>காணிக்கை - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml, body {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n}\n\n.stage {\n  width: 100vw;\n  height: 100vh;\n  position: relative;\n  overflow: hidden;\n}\n\n/* ── WARM HARVEST SKY — deep olive → amber → golden cream ── */\n.sky {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(168deg,\n    #1a1200 0%,\n    #3b2600 10%,\n    #6b3d00 22%,\n    #a05c00 34%,\n    #c8820a 46%,\n    #e8ad30 58%,\n    #f5d06a 70%,\n    #faeaa0 82%,\n    #fff8d6 92%,\n    #fffdf0 100%\n  );\n  z-index: 0;\n}\n\n/* ── GOLDEN GLOW from bottom center — like altar lamp ── */\n.altar-glow {\n  position: absolute;\n  bottom: -18vh;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 70vw;\n  height: 70vw;\n  border-radius: 50%;\n  background: radial-gradient(circle,\n    rgba(255,220,80,0.75) 0%,\n    rgba(255,180,30,0.45) 28%,\n    rgba(220,130,10,0.2) 55%,\n    transparent 78%\n  );\n  z-index: 1;\n  animation: glowPulse 4s ease-in-out infinite;\n}\n\n@keyframes glowPulse {\n  0%, 100% {\n    transform: translateX(-50%) scale(1);\n    opacity: .85;\n  }\n  50% {\n    transform: translateX(-50%) scale(1.1);\n    opacity: 1;\n  }\n}\n\n/* canvases */\ncanvas.rays {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  pointer-events: none;\n}\n\ncanvas.coins {\n  position: absolute;\n  inset: 0;\n  z-index: 4;\n  pointer-events: none;\n}\n\ncanvas.sparkle {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  pointer-events: none;\n}\n\n.mist {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 28vh;\n  background: linear-gradient(to top,\n    rgba(255,248,210,0.65) 0%,\n    rgba(255,235,150,0.25) 55%,\n    transparent 100%\n  );\n  z-index: 3;\n}\n\n/* ── CONTENT ── */\n.content {\n  position: absolute;\n  inset: 0;\n  z-index: 10;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n}\n\n/* ── CARD ── */\n.card {\n  background: rgba(255,248,210,0.18);\n  backdrop-filter: blur(22px);\n  -webkit-backdrop-filter: blur(22px);\n  border: 1px solid rgba(255,220,100,0.45);\n  border-radius: 20px;\n  padding: clamp(20px, 3vh, 50px) clamp(30px, 4vw, 80px);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(8px, 1.2vh, 18px);\n  text-align: center;\n  width: 100vw;\n  height: 100vh;\n  max-width: 100vw;\n  max-height: 100vh;\n  overflow: hidden;\n  box-shadow: 0 8px 60px rgba(140,80,0,0.3),\n              0 2px 24px rgba(255,180,30,0.25),\n              inset 0 1px 0 rgba(255,255,255,0.6);\n  opacity: 0;\n  animation: cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n  position: relative;\n}\n\n.card::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(135deg,\n    rgba(255,255,200,0.22) 0%,\n    rgba(255,200,80,0.08) 50%,\n    rgba(255,255,200,0.05) 100%\n  );\n  border-radius: 28px;\n  pointer-events: none;\n}\n\n@keyframes cardReveal {\n  from {\n    opacity: 0;\n    transform: translateY(28px) scale(.97);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n/* ── ICON ROW ── */\n.icon-row {\n  display: flex;\n  align-items: center;\n  gap: 3vw;\n  margin-bottom: 0.5vh;\n  opacity: 0;\n  animation: fadeUp .9s ease forwards .8s;\n}\n\n.icon-emoji {\n  font-size: clamp(32px, 5.5vmin, 65px);\n  animation: iconFloat 3s ease-in-out infinite;\n  filter: drop-shadow(0 3px 10px rgba(180,100,0,.45));\n}\n\n.icon-emoji:nth-child(1) { animation-delay: 0s; }\n.icon-emoji:nth-child(2) { animation-delay: .4s; }\n.icon-emoji:nth-child(3) { animation-delay: .8s; }\n\n@keyframes iconFloat {\n  0%, 100% {\n    transform: translateY(0) scale(1);\n  }\n  50% {\n    transform: translateY(-10px) scale(1.08);\n  }\n}\n\n/* ── SCRIPT TOP ── */\n.script-top {\n  font-family: 'Lora', serif;\n  font-style: italic;\n  font-weight: 400;\n  font-size: clamp(14px, 2.2vmin, 22px);\n  letter-spacing: 5px;\n  text-transform: uppercase;\n  color: rgba(100,55,0,0.72);\n  margin-bottom: 0.5vh;\n  opacity: 0;\n  animation: fadeUp .8s ease forwards 1s;\n  text-align: center;\n  line-height: 1.4;\n}\n\n/* ── DIVIDER ── */\n.divider {\n  display: flex;\n  align-items: center;\n  gap: 2vw;\n  margin-bottom: 0.8vh;\n  opacity: 0;\n  animation: fadeUp .8s ease forwards 1.2s;\n  width: 100%;\n}\n\n.div-line {\n  flex: 1;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, rgba(180,110,0,.5), transparent);\n}\n\n.div-icon {\n  font-size: clamp(16px, 2.2vw, 28px);\n}\n\n/* ── MAIN TAMIL WORD ── */\n.main-word {\n  font-family: 'Noto Serif Tamil', serif;\n  font-size: clamp(70px, 13vmin, 180px);\n  font-weight: 900;\n  line-height: 1.1;\n  letter-spacing: 4px;\n  background: linear-gradient(150deg,\n    #5c2e00 0%,\n    #9c5200 16%,\n    #d48000 30%,\n    #f5b800 46%,\n    #ffe066 58%,\n    #d48000 72%,\n    #9c5200 85%,\n    #5c2e00 100%\n  );\n  background-size: 280% auto;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  filter: drop-shadow(0 4px 22px rgba(200,120,0,.4));\n  opacity: 0;\n  animation: wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n             wordFlow 5s ease-in-out infinite 2.6s;\n  margin-bottom: 0.8vh;\n  text-align: center;\n}\n\n@keyframes wordReveal {\n  from {\n    opacity: 0;\n    transform: scale(.6);\n    filter: blur(16px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n    filter: blur(0) drop-shadow(0 4px 22px rgba(200,120,0,.4));\n  }\n}\n\n@keyframes wordFlow {\n  0%, 100% {\n    background-position: 0% center;\n  }\n  50% {\n    background-position: 100% center;\n  }\n}\n\n/* ── ENGLISH SUBTITLE ── */\n.subtitle {\n  font-family: 'Noto Serif Tamil', serif;\n  font-size: clamp(22px, 4.5vmin, 45px);\n  font-weight: 700;\n  color: rgba(90,45,0,0.88);\n  letter-spacing: 6px;\n  margin-bottom: 1vh;\n  opacity: 0;\n  animation: fadeUp .9s ease forwards 1.9s;\n  text-shadow: 0 1px 10px rgba(255,200,80,.5);\n  text-transform: uppercase;\n  text-align: center;\n}\n\n/* ── VERSE BOX ── */\n.verse-box {\n  background: rgba(255,220,100,0.2);\n  border: 1px solid rgba(180,120,0,.32);\n  border-radius: 16px;\n  padding: clamp(14px, 2vh, 24px) clamp(24px, 3.5vw, 50px);\n  margin-bottom: 1vh;\n  opacity: 0;\n  animation: fadeUp .9s ease forwards 2.2s;\n  max-width: 90vw;\n  text-align: center;\n}\n\n.verse-text {\n  font-family: 'Lora', serif;\n  font-style: italic;\n  font-size: clamp(16px, 2.6vmin, 28px);\n  color: rgba(70,30,0,0.92);\n  line-height: 1.65;\n  letter-spacing: 0.5px;\n  text-align: center;\n}\n\n.verse-ref {\n  font-family: 'Lora', serif;\n  font-size: clamp(14px, 2vmin, 20px);\n  color: rgba(130,70,0,.72);\n  letter-spacing: 2px;\n  margin-top: 0.6vh;\n}\n\n/* ── CHURCH BADGE ── */\n.church-wrapper {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  animation: churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n  margin-top: 0.2vh;\n}\n\n@keyframes churchEntrance {\n  from {\n    opacity: 0;\n    transform: scale(.5) rotate(-10deg);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) rotate(0deg);\n  }\n}\n\n.church-bg {\n  position: absolute;\n  inset: -2px;\n  border-radius: 46px;\n  background: rgba(8,4,0,0.92);\n  box-shadow: 0 4px 20px rgba(0,0,0,0.4);\n  z-index: 1;\n}\n\n.church {\n  position: relative;\n  z-index: 2;\n  font-family: 'Noto Serif Tamil', serif;\n  font-weight: 900;\n  font-size: clamp(16px, 3vmin, 28px);\n  letter-spacing: 3px;\n  padding: clamp(10px, 1.5vh, 18px) clamp(28px, 3.5vw, 50px);\n  white-space: nowrap;\n  background: linear-gradient(90deg,\n    #ffe066 0%,\n    #ff9f1c 18%,\n    #ffdd57 36%,\n    #ff6b6b 54%,\n    #ffe066 72%,\n    #ff9f1c 90%,\n    #ffdd57 100%\n  );\n  background-size: 300% auto;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  animation: goldShift 3s linear infinite;\n  filter: drop-shadow(0 0 8px rgba(255,180,30,.9))\n          drop-shadow(0 0 18px rgba(255,120,0,.5));\n  text-align: center;\n}\n\n@keyframes goldShift {\n  0% {\n    background-position: 0% center;\n  }\n  100% {\n    background-position: 300% center;\n  }\n}\n\n@keyframes fadeUp {\n  from {\n    opacity: 0;\n    transform: translateY(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Responsive for smaller screens */\n@media (max-height: 700px) {\n  .card {\n    padding: clamp(16px, 2.5vh, 40px) clamp(25px, 3.5vw, 70px);\n    gap: clamp(6px, 0.8vh, 14px);\n  }\n  \n  .icon-emoji {\n    font-size: clamp(28px, 4.5vmin, 55px);\n  }\n  \n  .script-top {\n    font-size: clamp(12px, 2vmin, 20px);\n    letter-spacing: 4px;\n  }\n  \n  .main-word {\n    font-size: clamp(60px, 11vmin, 160px);\n    letter-spacing: 3px;\n  }\n  \n  .subtitle {\n    font-size: clamp(20px, 4vmin, 40px);\n    letter-spacing: 5px;\n  }\n  \n  .verse-text {\n    font-size: clamp(14px, 2.4vmin, 26px);\n    line-height: 1.6;\n  }\n  \n  .verse-ref {\n    font-size: clamp(12px, 1.8vmin, 18px);\n  }\n  \n  .church {\n    font-size: clamp(14px, 2.8vmin, 26px);\n    letter-spacing: 2.5px;\n    padding: clamp(9px, 1.3vh, 16px) clamp(26px, 3.2vw, 46px);\n  }\n}\n\n/* Responsive for mobile */\n@media (max-width: 768px) {\n  .card {\n    padding: clamp(22px, 3.5vh, 50px) clamp(32px, 5.5vw, 80px);\n  }\n  \n  .icon-emoji {\n    font-size: clamp(30px, 5vw, 60px);\n  }\n  \n  .script-top {\n    font-size: clamp(13px, 2vw, 22px);\n  }\n  \n  .main-word {\n    font-size: clamp(68px, 12vw, 170px);\n  }\n  \n  .subtitle {\n    font-size: clamp(20px, 3.5vw, 42px);\n  }\n  \n  .verse-text {\n    font-size: clamp(15px, 2.4vw, 28px);\n  }\n  \n  .verse-ref {\n    font-size: clamp(13px, 1.8vw, 20px);\n  }\n  \n  .church {\n    font-size: clamp(15px, 2.4vw, 28px);\n  }\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n  <div class=\"sky\"></div>\n  <div class=\"altar-glow\"></div>\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"sparkle\" id=\"cSparkle\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"coins\" id=\"cCoins\"></canvas>\n  \n  <div class=\"content\">\n    <div class=\"card\">\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">🙌</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">💛</span>\n      </div>\n      \n      <div class=\"script-top\">கர்த்தருக்கு செலுத்துவோம் • Give Unto the Lord</div>\n      \n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">🌾</span>\n        <div class=\"div-line\"></div>\n      </div>\n      \n      <div class=\"main-word\">காணிக்கை</div>\n      \n      <div class=\"subtitle\">Offering</div>\n      \n      <div class=\"verse-box\">\n        <div class=\"verse-text\"><br>          ❝ அவரவர் மனதில் குறித்துக்கொண்டபடி கொடுக்கட்டும்;<br><br>          சலிப்போடு அல்ல, கட்டாயமாக அல்ல;<br><br>          சந்தோஷமாய்க் கொடுக்கிறவனிடத்தில் தேவன் பிரியப்படுகிறார். ❞<br></div>\n        <div class=\"verse-ref\">— 2 கொரிந்தியர் 9:7</div>\n      </div>\n      \n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n/* ── GOLDEN RAYS from bottom ── */\n(function() {\n  const cv = document.getElementById('cRays');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  \n  function resize() {\n    W = cv.width = innerWidth;\n    H = cv.height = innerHeight;\n  }\n  resize();\n  addEventListener('resize', resize);\n  \n  const RAYS = Array.from({length: 22}, (_, i) => ({\n    angle: (i / 22) * Math.PI * 1.4 - Math.PI * .7 + (Math.random() - .5) * .25,\n    alpha: .04 + Math.random() * .08,\n    speed: (.0018 + Math.random() * .003) * (Math.random() > .5 ? 1 : -1),\n    length: .5 + Math.random() * .6\n  }));\n  \n  const OX = W * .5, OY = H * 1.05;\n  \n  function draw() {\n    t++;\n    cx.clearRect(0, 0, W, H);\n    RAYS.forEach(r => {\n      r.angle += r.speed;\n      const ax = Math.cos(r.angle) * W * r.length + OX;\n      const ay = Math.sin(r.angle) * W * r.length + OY;\n      const bx = Math.cos(r.angle + .035) * W * r.length + OX;\n      const by = Math.sin(r.angle + .035) * W * r.length + OY;\n      cx.save();\n      const g = cx.createLinearGradient(OX, OY, ax, ay);\n      g.addColorStop(0, `rgba(255,210,60,${r.alpha * 2.2})`);\n      g.addColorStop(.35, `rgba(255,175,30,${r.alpha})`);\n      g.addColorStop(1, 'rgba(255,210,60,0)');\n      cx.beginPath();\n      cx.moveTo(OX, OY);\n      cx.lineTo(ax, ay);\n      cx.lineTo(bx, by);\n      cx.closePath();\n      cx.fillStyle = g;\n      cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── GOLDEN SPARKLE DUST ── */\n(function() {\n  const cv = document.getElementById('cSparkle');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  \n  function resize() {\n    W = cv.width = innerWidth;\n    H = cv.height = innerHeight;\n  }\n  resize();\n  addEventListener('resize', resize);\n  \n  const SPARKS = Array.from({length: 70}, () => ({\n    x: Math.random() * W,\n    y: Math.random() * H,\n    r: Math.random() * 2 + .5,\n    phase: Math.random() * Math.PI * 2,\n    speed: Math.random() * .03 + .015,\n    vy: -(Math.random() * .3 + .1),\n    vx: (Math.random() - .5) * .15\n  }));\n  \n  function draw() {\n    t++;\n    cx.clearRect(0, 0, W, H);\n    SPARKS.forEach(s => {\n      s.y += s.vy;\n      s.x += s.vx;\n      if (s.y < -10) {\n        s.y = H + 10;\n        s.x = Math.random() * W;\n      }\n      const a = .2 + .6 * (.5 + .5 * Math.sin(t * s.speed + s.phase));\n      cx.save();\n      cx.globalAlpha = a;\n      cx.fillStyle = 'rgba(255,220,80,1)';\n      cx.shadowColor = 'rgba(255,180,0,.8)';\n      cx.shadowBlur = s.r * 5;\n      cx.beginPath();\n      cx.arc(s.x, s.y, s.r, 0, Math.PI * 2);\n      cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING COINS ── */\n(function() {\n  const cv = document.getElementById('cCoins');\n  const cx = cv.getContext('2d');\n  let W, H, t = 0;\n  \n  function resize() {\n    W = cv.width = innerWidth;\n    H = cv.height = innerHeight;\n  }\n  resize();\n  addEventListener('resize', resize);\n  \n  class Coin {\n    constructor(rand) {\n      this.x = Math.random() * W;\n      this.y = rand ? (Math.random() * H) : (H + 30);\n      this.r = Math.random() * 9 + 5;\n      this.vy = -(Math.random() * .5 + .2);\n      this.vx = (Math.random() - .5) * .3;\n      this.rot = Math.random() * Math.PI * 2;\n      this.rotV = (Math.random() - .5) * .04;\n      this.alpha = Math.random() * .55 + .25;\n      this.phase = Math.random() * Math.PI * 2;\n    }\n    \n    update() {\n      this.y += this.vy;\n      this.x += this.vx;\n      this.rot += this.rotV;\n      this.alpha -= .0015;\n      if (this.alpha <= 0 || this.y < -30) {\n        Object.assign(this, new Coin(false));\n      }\n    }\n    \n    draw(cx) {\n      cx.save();\n      cx.translate(this.x, this.y);\n      cx.rotate(this.rot);\n      cx.globalAlpha = Math.max(0, this.alpha);\n      \n      /* coin body */\n      const g = cx.createRadialGradient(-this.r * .3, -this.r * .3, 0, 0, 0, this.r);\n      g.addColorStop(0, 'rgba(255,240,120,1)');\n      g.addColorStop(.5, 'rgba(220,170,20,1)');\n      g.addColorStop(1, 'rgba(160,100,0,1)');\n      cx.fillStyle = g;\n      cx.shadowColor = 'rgba(255,200,0,.6)';\n      cx.shadowBlur = 8;\n      cx.beginPath();\n      cx.ellipse(0, 0, this.r, this.r * .35, 0, 0, Math.PI * 2);\n      cx.fill();\n      \n      /* shine */\n      cx.fillStyle = 'rgba(255,255,180,.45)';\n      cx.beginPath();\n      cx.ellipse(-this.r * .25, -this.r * .05, this.r * .3, this.r * .1, -.3, 0, Math.PI * 2);\n      cx.fill();\n      \n      cx.restore();\n    }\n  }\n  \n  const coins = Array.from({length: 20}, () => new Coin(true));\n  \n  function draw() {\n    t++;\n    cx.clearRect(0, 0, W, H);\n    if (t % 55 === 0 && coins.length < 28) {\n      coins.push(new Coin(false));\n    }\n    coins.forEach(c => {\n      c.update();\n      c.draw(cx);\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>\n"
    },
    {
      "id": 1789839971970.272,
      "type": "html",
      "name": "தாவீதைப் போல நடனமாடி - 1",
      "html": "<!DOCTYPE html><html lang=\"ta\"><head><meta charset=\"UTF-8\">\n<style>\n@font-face{font-family:'Noto Serif Tamil';src:local('Noto Serif Tamil'),local('Nirmala UI'),local('Vijaya'),local('Latha'),local('Tamil Sangam MN');font-weight:400 900;}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{width:100%;height:100%;overflow:hidden;}\nbody{background:linear-gradient(180deg,#0b0f26 0%,#111936 52%,#1a2647 100%);font-family:'Noto Serif Tamil',serif;color:#f8fafc;}\n.wrap{width:100%;height:100%;padding:2.4vw 2.6vw 1.6vw;display:flex;flex-direction:column;gap:0.8vh;}\n.lyrics-wrap{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;}\n.lyrics{\n  width:100%;text-align:center;line-height:1.2;white-space:pre-wrap;word-break:break-word;\n  text-shadow:0 3px 12px rgba(0,0,0,0.62);font-weight:900;-webkit-text-stroke:0.04em currentColor;\n}\n.lyrics.rainbow-active{\n  background:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\n  background-size:300% auto;\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n  animation:rainbowShift 3s linear infinite;\n  -webkit-text-stroke:0;\n}\n.ref{font-size:1.9vh;opacity:0.78;text-align:right;letter-spacing:0.03em;}\n.ref.rainbow-active{\n  background:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\n  background-size:300% auto;\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n  animation:rainbowShift 3s linear infinite;\n}\n@keyframes rainbowShift{\n  0%{background-position:0% center;}\n  100%{background-position:300% center;}\n}\n</style></head><body>\n  <div class=\"wrap\" id=\"wrap\">\n    <div class=\"lyrics-wrap\" id=\"lyricsWrap\"><div class=\"lyrics\" id=\"lyrics\">தாவீதைப் போல நடனமாடி\nஅப்பாவை ஸ்தோத்தரிப்பேன்</div></div>\n    <div class=\"ref\" id=\"ref\">தாவீதைப் போல நடனமாடி  (Song #5407)</div>\n  </div>\n<script>\nvar MAX_FONT = 148;\nfunction autoFit() {\n  var lyricsWrap = document.getElementById('lyricsWrap');\n  var lyrics = document.getElementById('lyrics');\n  var ref = document.getElementById('ref');\n  if (!lyricsWrap || !lyrics) return;\n  var availW = lyricsWrap.clientWidth || window.innerWidth;\n  var availH = lyricsWrap.clientHeight || window.innerHeight;\n  if (availH < 10 || availW < 10) { setTimeout(autoFit, 100); return; }\n  var lo = 8, hi = Math.min(availH * 0.98, MAX_FONT);\n  for (var i = 0; i < 28; i++) {\n    var mid = (lo + hi) / 2;\n    lyrics.style.fontSize = mid + 'px';\n    if (ref) ref.style.fontSize = Math.max(12, mid * 0.18) + 'px';\n    if (lyrics.scrollHeight > availH || lyrics.scrollWidth > availW) {\n      hi = mid;\n    } else {\n      lo = mid;\n    }\n  }\n  lyrics.style.fontSize = lo + 'px';\n  if (ref) ref.style.fontSize = Math.max(12, lo * 0.18) + 'px';\n}\ndocument.addEventListener('keydown', function(e) {\n  if (e.key === 'g' || e.key === 'G') {\n    var lyrics = document.getElementById('lyrics');\n    var ref = document.getElementById('ref');\n    if (lyrics) lyrics.classList.toggle('rainbow-active');\n    if (ref) ref.classList.toggle('rainbow-active');\n    e.preventDefault();\n  }\n});\ndocument.fonts ? document.fonts.ready.then(autoFit) : window.addEventListener('load', autoFit);\nwindow.addEventListener('resize', autoFit);\n</script>\n</body></html>",
      "bookmarked": true,
      "songGroupId": "song_1789839971970_lgdh8jwp6",
      "songGroupIndex": 0,
      "songGroupTotal": 16,
      "songGroupName": "தாவீதைப் போல நடனமாடி",
      "_thumbHtml": "<!DOCTYPE html><html lang=\"ta\"><head><meta charset=\"UTF-8\">\n<style>\n@font-face{font-family:'Noto Serif Tamil';src:local('Noto Serif Tamil'),local('Nirmala UI'),local('Vijaya'),local('Latha'),local('Tamil Sangam MN');font-weight:400 900;}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{width:100%;height:100%;overflow:hidden;}\nbody{background:linear-gradient(180deg,#0b0f26 0%,#111936 52%,#1a2647 100%);font-family:'Noto Serif Tamil',serif;color:#f8fafc;}\n.wrap{width:100%;height:100%;padding:2.4vw 2.6vw 1.6vw;display:flex;flex-direction:column;gap:0.8vh;}\n.lyrics-wrap{flex:1;display:flex;align-items:center;justify-content:center;min-height:0;}\n.lyrics{\n  width:100%;text-align:center;line-height:1.2;white-space:pre-wrap;word-break:break-word;\n  text-shadow:0 3px 12px rgba(0,0,0,0.62);font-weight:900;-webkit-text-stroke:0.04em currentColor;\n}\n.lyrics.rainbow-active{\n  background:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\n  background-size:300% auto;\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n  animation:rainbowShift 3s linear infinite;\n  -webkit-text-stroke:0;\n}\n.ref{font-size:1.9vh;opacity:0.78;text-align:right;letter-spacing:0.03em;}\n.ref.rainbow-active{\n  background:linear-gradient(90deg,#7ee8ff 0%,#ffdd57 18%,#72f5a8 36%,#a259ff 54%,#7ee8ff 72%,#ffdd57 90%,#72f5a8 100%);\n  background-size:300% auto;\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n  animation:rainbowShift 3s linear infinite;\n}\n@keyframes rainbowShift{\n  0%{background-position:0% center;}\n  100%{background-position:300% center;}\n}\n</style><style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head><body>\n  <div class=\"wrap\" id=\"wrap\">\n    <div class=\"lyrics-wrap\" id=\"lyricsWrap\"><div class=\"lyrics\" id=\"lyrics\">தாவீதைப் போல நடனமாடி\nஅப்பாவை ஸ்தோத்தரிப்பேன்</div></div>\n    <div class=\"ref\" id=\"ref\">தாவீதைப் போல நடனமாடி  (Song #5407)</div>\n  </div>\n<script>\nvar MAX_FONT = 148;\nfunction autoFit() {\n  var lyricsWrap = document.getElementById('lyricsWrap');\n  var lyrics = document.getElementById('lyrics');\n  var ref = document.getElementById('ref');\n  if (!lyricsWrap || !lyrics) return;\n  var availW = lyricsWrap.clientWidth || window.innerWidth;\n  var availH = lyricsWrap.clientHeight || window.innerHeight;\n  if (availH < 10 || availW < 10) { setTimeout(autoFit, 100); return; }\n  var lo = 8, hi = Math.min(availH * 0.98, MAX_FONT);\n  for (var i = 0; i < 28; i++) {\n    var mid = (lo + hi) / 2;\n    lyrics.style.fontSize = mid + 'px';\n    if (ref) ref.style.fontSize = Math.max(12, mid * 0.18) + 'px';\n    if (lyrics.scrollHeight > availH || lyrics.scrollWidth > availW) {\n      hi = mid;\n    } else {\n      lo = mid;\n    }\n  }\n  lyrics.style.fontSize = lo + 'px';\n  if (ref) ref.style.fontSize = Math.max(12, lo * 0.18) + 'px';\n}\ndocument.addEventListener('keydown', function(e) {\n  if (e.key === 'g' || e.key === 'G') {\n    var lyrics = document.getElementById('lyrics');\n    var ref = document.getElementById('ref');\n    if (lyrics) lyrics.classList.toggle('rainbow-active');\n    if (ref) ref.classList.toggle('rainbow-active');\n    e.preventDefault();\n  }\n});\ndocument.fonts ? document.fonts.ready.then(autoFit) : window.addEventListener('load', autoFit);\nwindow.addEventListener('resize', autoFit);\n</script>\n</body></html>"
