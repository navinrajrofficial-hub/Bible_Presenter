{
  "version": 1,
  "slides": [
    {
      "id": 1774107563826.375,
      "type": "html",
      "name": "Good Friday",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>புனித வெள்ளி - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel+Decorative:wght@700;900&family=Noto+Serif+Tamil:wght@400;700;900&family=IM+Fell+English:ital@1&family=Playfair+Display:wght@700;900&display=swap\" rel=\"stylesheet\">\n\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#020106}\n.stage{position:relative;width:100vw;height:100vh;overflow:hidden;background:#020106}\n\n.sky{\n  position:absolute;inset:0;z-index:0;\n  background:\n    radial-gradient(ellipse 120% 80% at 50% 110%, rgba(120,80,200,.18) 0%, transparent 65%),\n    radial-gradient(ellipse 80% 60% at 50% 105%, rgba(180,120,255,.12) 0%, transparent 55%),\n    linear-gradient(175deg,#010008 0%,#060014 10%,#0c0025 20%,#130035 30%,#1c0050 40%,#280070 50%,#1a0055 60%,#0c0030 72%,#04000f 85%,#010008 100%);\n}\n\ncanvas{position:absolute;inset:0;pointer-events:none}\n#cRays{z-index:1}\n#cDoves{z-index:2}\n#cGlow{z-index:3}\n#cSparkle{z-index:5}\n#cTears{z-index:6}\n\n.ground-mist{\n  position:absolute;left:0;right:0;bottom:0;height:22vh;z-index:4;\n  background:linear-gradient(to top, rgba(140,100,220,.13) 0%, rgba(100,60,180,.06) 50%, transparent 100%);\n}\n\n.content{\n  position:absolute;inset:0;z-index:10;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;\n  padding:0;\n}\n\n/* Bigger full-screen feel */\n.verse-banner{\n  width:min(99vw,1500px);\n  text-align:center;\n  padding:.8vh 1.2vw;\n  margin-bottom:.5vh;\n  border-top:1px solid rgba(180,140,255,.25);\n  border-bottom:1px solid rgba(180,140,255,.25);\n  background:linear-gradient(90deg, rgba(80,40,140,0) 0%, rgba(140,80,220,.18) 20%, rgba(160,100,255,.22) 50%, rgba(140,80,220,.18) 80%, rgba(80,40,140,0) 100%);\n  opacity:0;animation:fadeDown .9s ease forwards .3s;\n}\n.verse-ta{font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1.05vw,18px);color:rgba(210,190,255,.92);line-height:1.5}\n.verse-ref{font-family:'IM Fell English',serif;font-style:italic;font-size:clamp(11px,.9vw,14px);color:rgba(180,150,255,.7);margin-top:.15vh}\n\n.card{\n  width:min(99vw,1500px);\n  max-height:96vh;\n  overflow-y:auto;\n  scrollbar-width:none;\n  position:relative;\n  display:flex;flex-direction:column;align-items:center;gap:0;\n  padding:clamp(10px,1.2vh,18px) clamp(16px,1.6vw,26px);\n  border-radius:12px;\n  border:1px solid rgba(160,110,255,.28);\n  background:rgba(6,2,18,.78);\n  backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);\n  box-shadow:0 0 60px rgba(120,60,220,.22),0 0 120px rgba(100,40,200,.1),inset 0 1px 0 rgba(200,170,255,.18),inset 0 -1px 0 rgba(160,100,255,.12);\n  opacity:0;animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .6s;\n}\n.card::-webkit-scrollbar{display:none}\n.card::before{\n  content:'';position:absolute;inset:0;pointer-events:none;border-radius:12px;\n  background:\n    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(160,100,255,.07) 0%, transparent 60%),\n    radial-gradient(ellipse 60% 40% at 50% 100%, rgba(120,60,220,.06) 0%, transparent 60%);\n}\n.card::after{\n  content:'';position:absolute;top:2px;left:2px;right:2px;bottom:2px;\n  border-radius:9px;border:1px solid rgba(180,140,255,.10);pointer-events:none;\n}\n\n.church-top{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.75vw,12px);color:rgba(200,170,255,.6);letter-spacing:2px;margin-bottom:.5vh;opacity:0;animation:fadeUp .8s ease forwards 1s}\n.div-row{display:flex;align-items:center;gap:1vw;width:100%;margin-bottom:.45vh;opacity:0;animation:fadeUp .7s ease forwards 1.1s}\n.div-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(160,100,220,.50),transparent)}\n.div-gem{color:rgba(200,160,255,.8);font-size:clamp(10px,.9vw,14px)}\n.event-tag{font-family:'Noto Serif Tamil',serif;font-size:clamp(9px,.85vw,12px);color:rgba(200,170,255,.85);letter-spacing:3px;margin-bottom:.3vh;opacity:0;animation:fadeUp .8s ease forwards 1.2s}\n\n.palm-title{\n  font-family:'Noto Serif Tamil',serif;font-weight:900;\n  font-size:clamp(32px,4.2vw,74px);line-height:1.08;letter-spacing:1px;\n  margin-bottom:.25vh;text-align:center;opacity:0;\n  background:linear-gradient(150deg,#c8b0ff 0%,#e8d8ff 18%,#f5eeff 32%,#d0b8ff 48%,#a880ee 64%,#7a50c8 80%,#a880ee 100%);\n  background-size:250% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 4px 18px rgba(160,80,255,.45));\n  animation:palmReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.3s,palmFlow 6s ease-in-out infinite 2.5s;\n}\n.service-text{\n  font-family:'Noto Serif Tamil',serif;font-size:clamp(20px,2vw,34px);font-weight:700;letter-spacing:4px;\n  margin:.15vh 0;opacity:0;\n  background:linear-gradient(90deg,#9060cc 0%,#c8a0ff 25%,#e8d0ff 50%,#c8a0ff 75%,#9060cc 100%);\n  background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  animation:fadeUp .8s ease forwards 1.6s,purpleShift 3s linear infinite 2.5s;\n}\n.service-subtext{font-family:'Noto Serif Tamil',serif;font-size:clamp(11px,.95vw,15px);color:rgba(200,170,255,.55);letter-spacing:3px;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 1.75s}\n\n.cross-wrap{position:relative;margin:.7vh 0;opacity:0;animation:crossReveal 1.2s cubic-bezier(.34,1.56,.64,1) forwards 1.8s}\n.cross-wrap svg{\n  display:block;width:auto;height:clamp(80px,13vh,150px);\n  filter:drop-shadow(0 0 14px rgba(180,120,255,.9)) drop-shadow(0 0 30px rgba(140,80,220,.6));\n  animation:crossGlow 3s ease-in-out infinite;\n}\n\n.info-row{display:flex;align-items:center;gap:2.5vw;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 2s}\n.info-box{text-align:center}\n.info-label{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(180,150,255,.60);letter-spacing:2px;margin-bottom:.2vh}\n.info-value{font-family:'Playfair Display',serif;font-size:clamp(18px,1.5vw,28px);font-weight:700;color:rgba(220,200,255,.95);text-shadow:0 0 18px rgba(160,100,255,.5)}\n.info-sep{font-size:clamp(15px,1.4vw,24px);color:rgba(180,130,255,.35)}\n\n.bishop-block{\n  width:100%;position:relative;overflow:hidden;text-align:center;margin-bottom:.8vh;\n  border-radius:16px;padding:clamp(8px,1vh,12px) clamp(10px,2vw,24px);\n  background:linear-gradient(160deg, rgba(30,10,60,.75) 0%, rgba(8,2,20,.92) 100%);\n  border:1px solid rgba(160,110,255,.15);box-shadow:0 12px 30px rgba(0,0,0,.6), inset 0 1px 1px rgba(255,255,255,.06);\n  opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n}\n.bishop-block::before{content:'';position:absolute;top:0;left:20%;right:20%;height:1.5px;background:linear-gradient(90deg,transparent,rgba(200,160,255,.80),transparent);box-shadow:0 0 12px rgba(180,120,255,.8)}\n.bishop-block::after{content:'';position:absolute;top:0;left:-100%;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(200,170,255,.06),transparent);transform:skewX(-20deg);animation:blockSweep 5.5s infinite;pointer-events:none;z-index:1}\n.bishop-role{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(180,150,255,.60);letter-spacing:3px;margin-bottom:.2vh}\n.bishop-name-wrapper{position:relative;display:inline-block;z-index:2;padding:0 10px}\n.bishop-name-wrapper::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:140%;height:160%;background:radial-gradient(ellipse, rgba(180,120,255,.15) 0%, transparent 60%);animation:auraPulse 3s ease-in-out infinite;pointer-events:none}\n.bishop-name-en{\n  position:relative;font-family:'Alex Brush',cursive;font-weight:400;\n  font-size:clamp(36px,3.2vw,56px);line-height:1.15;letter-spacing:1px;\n  background:linear-gradient(90deg,#9060cc 0%,#e0c8ff 25%,#c8a0ff 50%,#e0c8ff 75%,#9060cc 100%);background-size:200% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 3px 5px rgba(0,0,0,.95)) drop-shadow(0 0 15px rgba(160,100,255,.5));\n  clip-path:polygon(0 0, 0 0, 0 100%, 0 100%);\n  animation:signatureLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s,purpleShift 4s linear infinite;\n}\n.pen-flare{\n  position:absolute;top:45%;left:0;width:4px;height:4px;border-radius:50%;\n  background:#e8d8ff;opacity:0;z-index:10;pointer-events:none;\n  box-shadow:0 0 10px 4px #d0b8ff,0 0 25px 12px #a880ee,0 0 40px 20px rgba(140,80,220,.6);\n  animation:flareLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s;\n}\n.bishop-name-ta{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1vw,18px);font-weight:700;color:rgba(210,190,255,.85)}\n\n.church-badge{position:relative;display:inline-flex;align-items:center;justify-content:center;opacity:0;animation:churchReveal 1s cubic-bezier(.34,1.56,.64,1) forwards 2.5s}\n.church-bg-inner{position:absolute;inset:3px;background:rgba(4,1,12,.92);border-radius:50px;z-index:1}\n.church-name{\n  position:relative;z-index:2;white-space:nowrap;font-family:'Noto Serif Tamil',serif;font-weight:900;\n  font-size:clamp(12px,.95vw,16px);letter-spacing:1px;padding:clamp(5px,.55vh,7px) clamp(16px,1.5vw,28px);\n  background:linear-gradient(90deg,#9060cc,#c8a0ff,#e8d0ff,#c8a0ff,#9060cc,#c8a0ff,#e8d0ff);background-size:300% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:purpleShift 3s linear infinite;\n  filter:drop-shadow(0 0 8px rgba(160,100,255,.7));\n}\n\n.ornament{position:absolute;font-size:clamp(14px,1.2vw,21px);opacity:.35;animation:ornSway 4s ease-in-out infinite}\n.orn-tl{top:10px;left:12px}.orn-tr{top:10px;right:12px;animation-delay:.5s}.orn-bl{bottom:10px;left:12px;animation-delay:1s}.orn-br{bottom:10px;right:12px;animation-delay:1.5s}\n\n.deco-row{position:absolute;left:0;right:0;bottom:0;z-index:11;display:flex;justify-content:center;gap:.5vw;padding-bottom:2px;pointer-events:none}\n.deco-item{font-size:clamp(12px,1.8vw,20px);opacity:.4;animation:decoSway 3.6s ease-in-out infinite;transform-origin:bottom center}\n.deco-item:nth-child(2n){animation-delay:.6s}.deco-item:nth-child(3n){animation-delay:1.2s}.deco-item:nth-child(4n){animation-delay:1.8s}\n\n@keyframes cardReveal{from{opacity:0;transform:translateY(30px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}\n@keyframes fadeDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes palmReveal{from{opacity:0;transform:scale(.7);filter:blur(14px)}to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 18px rgba(160,80,255,.45))}}\n@keyframes palmFlow{0%,100%{background-position:0% center}50%{background-position:100% center}}\n@keyframes purpleShift{0%{background-position:0% center}100%{background-position:300% center}}\n@keyframes crossReveal{from{opacity:0;transform:scale(.3) rotate(-15deg)}to{opacity:1;transform:scale(1) rotate(0)}}\n@keyframes crossGlow{0%,100%{filter:drop-shadow(0 0 14px rgba(180,120,255,.9)) drop-shadow(0 0 30px rgba(140,80,220,.6))}50%{filter:drop-shadow(0 0 26px rgba(220,180,255,1)) drop-shadow(0 0 55px rgba(160,100,255,.9))}}\n@keyframes blockSweep{0%,30%{left:-100%}70%,100%{left:200%}}\n@keyframes auraPulse{0%,100%{opacity:.5;transform:translate(-50%,-50%) scale(.9)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}}\n@keyframes signatureLoop{0%,5%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:1}30%,85%{clip-path:polygon(0 0,100% 0,100% 100%,0 100%);opacity:1}95%{opacity:0}100%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:0}}\n@keyframes flareLoop{0%,5%{left:0%;opacity:0;transform:scale(.5) translateY(0)}8%{opacity:1;transform:scale(1.2) translateY(-4px)}15%{transform:scale(.9) translateY(4px)}22%{transform:scale(1.4) translateY(-2px)}28%{transform:scale(1) translateY(3px)}29%{opacity:1;transform:scale(1.2) translateY(-1px)}30%,100%{left:100%;opacity:0;transform:scale(.5) translateY(0)}}\n@keyframes churchReveal{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}\n@keyframes ornSway{0%,100%{transform:rotate(-5deg) scale(1)}50%{transform:rotate(5deg) scale(1.1)}}\n@keyframes decoSway{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}\n\n/* Mobile tuning */\n@media (max-width:900px){\n  .card,.verse-banner{width:99.5vw}\n  .palm-title{font-size:clamp(28px,10vw,56px)}\n  .service-text{font-size:clamp(18px,6vw,28px)}\n  .bishop-name-en{font-size:clamp(30px,9vw,44px)}\n  .info-value{font-size:clamp(15px,4.4vw,24px)}\n}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n  <div class=\"sky\"></div>\n  <canvas id=\"cRays\"></canvas>\n  <canvas id=\"cDoves\"></canvas>\n  <canvas id=\"cGlow\"></canvas>\n  <div class=\"ground-mist\"></div>\n  <canvas id=\"cSparkle\"></canvas>\n  <canvas id=\"cTears\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"verse-banner\">\n      <div class=\"verse-ta\">அவர் நம்முடைய மீறுதல்களினிமித்தம் காயப்பட்டு, நம்முடைய அக்கிரமங்களினிமித்தம் நொறுக்கப்பட்டார்</div>\n      <div class=\"verse-ref\">— ஏசாயா 53:5</div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"ornament orn-tl\">✝️</span>\n      <span class=\"ornament orn-tr\">✝️</span>\n      <span class=\"ornament orn-bl\">🕊️</span>\n      <span class=\"ornament orn-br\">🕊️</span>\n\n      <div class=\"church-top\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n\n      <div class=\"div-row\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-gem\">✦</span>\n        <span class=\"div-gem\" style=\"font-size:clamp(11px,1.4vw,16px);color:rgba(180,140,255,0.5)\">✝</span>\n        <span class=\"div-gem\">✦</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"event-tag\">✝ Good Friday ✝</div>\n      <div class=\"palm-title\">புனித வெள்ளி</div>\n      <div class=\"service-text\">ஆராதனை</div>\n      <div class=\"service-subtext\">சிலுவையின் நினைவு · ஜெபம்</div>\n\n      <div class=\"cross-wrap\">\n        <svg viewBox=\"0 0 120 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#f0eaff\"/>\n              <stop offset=\"15%\" stop-color=\"#c8a8ff\"/>\n              <stop offset=\"35%\" stop-color=\"#7040b8\"/>\n              <stop offset=\"50%\" stop-color=\"#dcc8ff\"/>\n              <stop offset=\"65%\" stop-color=\"#8a50cc\"/>\n              <stop offset=\"85%\" stop-color=\"#b890ff\"/>\n              <stop offset=\"100%\" stop-color=\"#5030a0\"/>\n            </linearGradient>\n            <linearGradient id=\"cg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#e8daff\"/>\n              <stop offset=\"50%\" stop-color=\"#7040b8\"/>\n              <stop offset=\"100%\" stop-color=\"#dcc8ff\"/>\n            </linearGradient>\n            <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n              <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n            <radialGradient id=\"shine\" cx=\"35%\" cy=\"30%\" r=\"60%\">\n              <stop offset=\"0%\" stop-color=\"rgba(240,230,255,0.6)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(240,230,255,0)\"/>\n            </radialGradient>\n          </defs>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#cg1)\" filter=\"url(#glow)\"/>\n          <rect x=\"8\" y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#cg2)\" filter=\"url(#glow)\"/>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#shine)\" opacity=\".7\"/>\n          <rect x=\"8\" y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#shine)\" opacity=\".5\"/>\n          <rect x=\"54\" y=\"8\" width=\"6\" height=\"144\" rx=\"3\" fill=\"rgba(230,220,255,0.3)\"/>\n          <rect x=\"8\" y=\"46\" width=\"104\" height=\"6\" rx=\"3\" fill=\"rgba(230,220,255,0.25)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"10\" fill=\"url(#cg1)\" stroke=\"rgba(200,170,255,.6)\" stroke-width=\"1.5\" filter=\"url(#glow)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"5\" fill=\"rgba(240,230,255,0.85)\"/>\n        </svg>\n      </div>\n\n      <div class=\"info-row\">\n        <div class=\"info-box\">\n          <div class=\"info-label\">தேதி</div>\n          <div class=\"info-value\">03 · 04 · 2026</div>\n        </div>\n        <div class=\"info-sep\">✦</div>\n        <div class=\"info-box\">\n          <div class=\"info-label\">நேரம்</div>\n          <div class=\"info-value\">காலை 11:00</div>\n        </div>\n      </div>\n\n      <div class=\"bishop-block\">\n        <div class=\"bishop-role\">பிஷப்</div>\n        <div class=\"bishop-name-wrapper\">\n          <div class=\"pen-flare\"></div>\n          <div class=\"bishop-name-en\">Bp. V. Paul Yuvaraj</div>\n        </div>\n        <div class=\"bishop-name-ta\">பி. வி. பால் யுவராஜ்</div>\n      </div>\n\n      <div class=\"church-badge\">\n        <div class=\"church-bg-inner\"></div>\n        <div class=\"church-name\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span>\n  </div>\n</div>\n\n<script>\n(function(){\n  const cv=document.getElementById('cRays'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const R=Array.from({length:24},(_,i)=>({a:(i/24)*Math.PI*1.6-Math.PI*.8+(Math.random()-.5)*.3,al:.025+Math.random()*.06,sp:(.0012+Math.random()*.0025)*(Math.random()>.5?1:-1),ln:.4+Math.random()*.6}));\n  function draw(){t++;cx.clearRect(0,0,W,H);R.forEach(r=>{r.a+=r.sp;const ax=Math.cos(r.a)*W*r.ln+W*.5,ay=Math.sin(r.a)*W*r.ln+H*1.08,bx=Math.cos(r.a+.025)*W*r.ln+W*.5,by=Math.sin(r.a+.025)*W*r.ln+H*1.08,g=cx.createLinearGradient(W*.5,H*1.08,ax,ay);g.addColorStop(0,`rgba(180,120,255,${r.al*2})`);g.addColorStop(.4,`rgba(140,80,220,${r.al})`);g.addColorStop(1,'rgba(100,50,180,0)');cx.save();cx.beginPath();cx.moveTo(W*.5,H*1.08);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();cx.fillStyle=g;cx.fill();cx.restore()});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cDoves'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function drawDove(cx,x,y,size,alpha,flap){\n    cx.save();cx.globalAlpha=alpha;cx.fillStyle='rgba(220,200,255,0.85)';cx.shadowColor='rgba(180,140,255,0.8)';cx.shadowBlur=size*3;\n    const wingAngle=Math.sin(flap)*0.4;\n    cx.beginPath();cx.ellipse(x,y,size*1.2,size*0.5,0,0,Math.PI*2);cx.fill();\n    cx.save();cx.translate(x,y);cx.rotate(-wingAngle);cx.beginPath();cx.ellipse(-size*.5,-size*.2,size*1.1,size*.38,-0.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.save();cx.translate(x,y);cx.rotate(wingAngle);cx.beginPath();cx.ellipse(size*.5,-size*.2,size*1.1,size*.38,0.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.beginPath();cx.arc(x+size*1.1,y-size*.1,size*.35,0,Math.PI*2);cx.fill();cx.restore();\n  }\n  const doves=Array.from({length:6},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight*.6+innerHeight*.05,size:5+Math.random()*7,vx:(Math.random()*.6+.3)*(Math.random()>.5?1:-1),vy:(Math.random()-.5)*.18,flapSpeed:.04+Math.random()*.04,flapOffset:Math.random()*Math.PI*2,alpha:.12+Math.random()*.18}));\n  function draw(){t++;cx.clearRect(0,0,W,H);doves.forEach(d=>{d.x+=d.vx;d.y+=d.vy;if(d.x>W+40)d.x=-40;if(d.x<-40)d.x=W+40;if(d.y<0)d.y=H*.5;if(d.y>H*.7)d.y=H*.1;drawDove(cx,d.x,d.y,d.size,d.alpha,t*d.flapSpeed+d.flapOffset)});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cGlow'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function draw(){t++;cx.clearRect(0,0,W,H);const pulse=.85+.15*Math.sin(t*.025),g=cx.createRadialGradient(W*.5,H*.62,0,W*.5,H*.62,W*.38*pulse);g.addColorStop(0,'rgba(160,100,255,.12)');g.addColorStop(.35,'rgba(120,70,220,.06)');g.addColorStop(.65,'rgba(90,50,180,.03)');g.addColorStop(1,'transparent');cx.fillStyle=g;cx.fillRect(0,0,W,H);requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cSparkle'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const S=Array.from({length:70},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:.4+Math.random()*1.8,ph:Math.random()*Math.PI*2,sp:.018+Math.random()*.035,vy:-(Math.random()*.22+.06),vx:(Math.random()-.5)*.1,col:Math.random()>.5?'200,170,255':'240,230,255'}));\n  function draw(){t++;cx.clearRect(0,0,W,H);S.forEach(s=>{s.y+=s.vy;s.x+=s.vx;if(s.y<-10){s.y=H+10;s.x=Math.random()*W}const a=.12+.65*(.5+.5*Math.sin(t*s.sp+s.ph));cx.save();cx.globalAlpha=a;cx.fillStyle=`rgba(${s.col},1)`;cx.shadowColor=`rgba(${s.col},.7)`;cx.shadowBlur=s.r*6;cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();cx.restore()});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cTears'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n\n  class Tear{\n    constructor(rand){\n      this.x=Math.random()*innerWidth;this.y=rand?(Math.random()*innerHeight):(-20);this.r=Math.random()*5+2.5;\n      this.vy=Math.random()*.4+.12;this.vx=(Math.random()-.5)*.15;this.alpha=Math.random()*.35+.12;\n      this.wobble=Math.random()*Math.PI*2;this.wobbleSpeed=.018+Math.random()*.025;\n    }\n    update(){this.y+=this.vy;this.wobble+=this.wobbleSpeed;this.x+=Math.sin(this.wobble)*.4+this.vx;this.alpha-=.0008;if(this.alpha<=0||this.y>innerHeight+30)Object.assign(this,new Tear(false))}\n    draw(cx){\n      cx.save();cx.globalAlpha=Math.max(0,this.alpha);\n      const g=cx.createRadialGradient(this.x,this.y-this.r*.3,0,this.x,this.y,this.r);\n      g.addColorStop(0,'rgba(240,230,255,1)');g.addColorStop(.5,'rgba(180,140,255,1)');g.addColorStop(1,'rgba(120,80,220,0)');\n      cx.fillStyle=g;cx.shadowColor='rgba(200,160,255,.7)';cx.shadowBlur=8;\n      cx.beginPath();cx.arc(this.x,this.y,this.r,0,Math.PI*2);cx.fill();\n      cx.beginPath();cx.moveTo(this.x,this.y-this.r);cx.quadraticCurveTo(this.x+this.r*.6,this.y-this.r*1.4,this.x,this.y-this.r*2.2);cx.quadraticCurveTo(this.x-this.r*.6,this.y-this.r*1.4,this.x,this.y-this.r);cx.fillStyle='rgba(200,170,255,0.4)';cx.fill();\n      cx.restore();\n    }\n  }\n\n  const tears=Array.from({length:16},()=>new Tear(true));\n  function draw(){t++;cx.clearRect(0,0,W,H);if(t%90===0&&tears.length<22)tears.push(new Tear(false));tears.forEach(d=>{d.update();d.draw(cx)});requestAnimationFrame(draw)}\n  draw();\n})();\n</script>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>புனித வெள்ளி - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel+Decorative:wght@700;900&family=Noto+Serif+Tamil:wght@400;700;900&family=IM+Fell+English:ital@1&family=Playfair+Display:wght@700;900&display=swap\" rel=\"stylesheet\">\n\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#020106}\n.stage{position:relative;width:100vw;height:100vh;overflow:hidden;background:#020106}\n\n.sky{\n  position:absolute;inset:0;z-index:0;\n  background:\n    radial-gradient(ellipse 120% 80% at 50% 110%, rgba(120,80,200,.18) 0%, transparent 65%),\n    radial-gradient(ellipse 80% 60% at 50% 105%, rgba(180,120,255,.12) 0%, transparent 55%),\n    linear-gradient(175deg,#010008 0%,#060014 10%,#0c0025 20%,#130035 30%,#1c0050 40%,#280070 50%,#1a0055 60%,#0c0030 72%,#04000f 85%,#010008 100%);\n}\n\ncanvas{position:absolute;inset:0;pointer-events:none}\n#cRays{z-index:1}\n#cDoves{z-index:2}\n#cGlow{z-index:3}\n#cSparkle{z-index:5}\n#cTears{z-index:6}\n\n.ground-mist{\n  position:absolute;left:0;right:0;bottom:0;height:22vh;z-index:4;\n  background:linear-gradient(to top, rgba(140,100,220,.13) 0%, rgba(100,60,180,.06) 50%, transparent 100%);\n}\n\n.content{\n  position:absolute;inset:0;z-index:10;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;\n  padding:0;\n}\n\n/* Bigger full-screen feel */\n.verse-banner{\n  width:min(99vw,1500px);\n  text-align:center;\n  padding:.8vh 1.2vw;\n  margin-bottom:.5vh;\n  border-top:1px solid rgba(180,140,255,.25);\n  border-bottom:1px solid rgba(180,140,255,.25);\n  background:linear-gradient(90deg, rgba(80,40,140,0) 0%, rgba(140,80,220,.18) 20%, rgba(160,100,255,.22) 50%, rgba(140,80,220,.18) 80%, rgba(80,40,140,0) 100%);\n  opacity:0;animation:fadeDown .9s ease forwards .3s;\n}\n.verse-ta{font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1.05vw,18px);color:rgba(210,190,255,.92);line-height:1.5}\n.verse-ref{font-family:'IM Fell English',serif;font-style:italic;font-size:clamp(11px,.9vw,14px);color:rgba(180,150,255,.7);margin-top:.15vh}\n\n.card{\n  width:min(99vw,1500px);\n  max-height:96vh;\n  overflow-y:auto;\n  scrollbar-width:none;\n  position:relative;\n  display:flex;flex-direction:column;align-items:center;gap:0;\n  padding:clamp(10px,1.2vh,18px) clamp(16px,1.6vw,26px);\n  border-radius:12px;\n  border:1px solid rgba(160,110,255,.28);\n  background:rgba(6,2,18,.78);\n  backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);\n  box-shadow:0 0 60px rgba(120,60,220,.22),0 0 120px rgba(100,40,200,.1),inset 0 1px 0 rgba(200,170,255,.18),inset 0 -1px 0 rgba(160,100,255,.12);\n  opacity:0;animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .6s;\n}\n.card::-webkit-scrollbar{display:none}\n.card::before{\n  content:'';position:absolute;inset:0;pointer-events:none;border-radius:12px;\n  background:\n    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(160,100,255,.07) 0%, transparent 60%),\n    radial-gradient(ellipse 60% 40% at 50% 100%, rgba(120,60,220,.06) 0%, transparent 60%);\n}\n.card::after{\n  content:'';position:absolute;top:2px;left:2px;right:2px;bottom:2px;\n  border-radius:9px;border:1px solid rgba(180,140,255,.10);pointer-events:none;\n}\n\n.church-top{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.75vw,12px);color:rgba(200,170,255,.6);letter-spacing:2px;margin-bottom:.5vh;opacity:0;animation:fadeUp .8s ease forwards 1s}\n.div-row{display:flex;align-items:center;gap:1vw;width:100%;margin-bottom:.45vh;opacity:0;animation:fadeUp .7s ease forwards 1.1s}\n.div-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(160,100,220,.50),transparent)}\n.div-gem{color:rgba(200,160,255,.8);font-size:clamp(10px,.9vw,14px)}\n.event-tag{font-family:'Noto Serif Tamil',serif;font-size:clamp(9px,.85vw,12px);color:rgba(200,170,255,.85);letter-spacing:3px;margin-bottom:.3vh;opacity:0;animation:fadeUp .8s ease forwards 1.2s}\n\n.palm-title{\n  font-family:'Noto Serif Tamil',serif;font-weight:900;\n  font-size:clamp(32px,4.2vw,74px);line-height:1.08;letter-spacing:1px;\n  margin-bottom:.25vh;text-align:center;opacity:0;\n  background:linear-gradient(150deg,#c8b0ff 0%,#e8d8ff 18%,#f5eeff 32%,#d0b8ff 48%,#a880ee 64%,#7a50c8 80%,#a880ee 100%);\n  background-size:250% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 4px 18px rgba(160,80,255,.45));\n  animation:palmReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.3s,palmFlow 6s ease-in-out infinite 2.5s;\n}\n.service-text{\n  font-family:'Noto Serif Tamil',serif;font-size:clamp(20px,2vw,34px);font-weight:700;letter-spacing:4px;\n  margin:.15vh 0;opacity:0;\n  background:linear-gradient(90deg,#9060cc 0%,#c8a0ff 25%,#e8d0ff 50%,#c8a0ff 75%,#9060cc 100%);\n  background-size:300% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  animation:fadeUp .8s ease forwards 1.6s,purpleShift 3s linear infinite 2.5s;\n}\n.service-subtext{font-family:'Noto Serif Tamil',serif;font-size:clamp(11px,.95vw,15px);color:rgba(200,170,255,.55);letter-spacing:3px;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 1.75s}\n\n.cross-wrap{position:relative;margin:.7vh 0;opacity:0;animation:crossReveal 1.2s cubic-bezier(.34,1.56,.64,1) forwards 1.8s}\n.cross-wrap svg{\n  display:block;width:auto;height:clamp(80px,13vh,150px);\n  filter:drop-shadow(0 0 14px rgba(180,120,255,.9)) drop-shadow(0 0 30px rgba(140,80,220,.6));\n  animation:crossGlow 3s ease-in-out infinite;\n}\n\n.info-row{display:flex;align-items:center;gap:2.5vw;margin-bottom:.8vh;opacity:0;animation:fadeUp .8s ease forwards 2s}\n.info-box{text-align:center}\n.info-label{font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(180,150,255,.60);letter-spacing:2px;margin-bottom:.2vh}\n.info-value{font-family:'Playfair Display',serif;font-size:clamp(18px,1.5vw,28px);font-weight:700;color:rgba(220,200,255,.95);text-shadow:0 0 18px rgba(160,100,255,.5)}\n.info-sep{font-size:clamp(15px,1.4vw,24px);color:rgba(180,130,255,.35)}\n\n.bishop-block{\n  width:100%;position:relative;overflow:hidden;text-align:center;margin-bottom:.8vh;\n  border-radius:16px;padding:clamp(8px,1vh,12px) clamp(10px,2vw,24px);\n  background:linear-gradient(160deg, rgba(30,10,60,.75) 0%, rgba(8,2,20,.92) 100%);\n  border:1px solid rgba(160,110,255,.15);box-shadow:0 12px 30px rgba(0,0,0,.6), inset 0 1px 1px rgba(255,255,255,.06);\n  opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n}\n.bishop-block::before{content:'';position:absolute;top:0;left:20%;right:20%;height:1.5px;background:linear-gradient(90deg,transparent,rgba(200,160,255,.80),transparent);box-shadow:0 0 12px rgba(180,120,255,.8)}\n.bishop-block::after{content:'';position:absolute;top:0;left:-100%;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(200,170,255,.06),transparent);transform:skewX(-20deg);animation:blockSweep 5.5s infinite;pointer-events:none;z-index:1}\n.bishop-role{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(8px,.65vw,10px);color:rgba(180,150,255,.60);letter-spacing:3px;margin-bottom:.2vh}\n.bishop-name-wrapper{position:relative;display:inline-block;z-index:2;padding:0 10px}\n.bishop-name-wrapper::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:140%;height:160%;background:radial-gradient(ellipse, rgba(180,120,255,.15) 0%, transparent 60%);animation:auraPulse 3s ease-in-out infinite;pointer-events:none}\n.bishop-name-en{\n  position:relative;font-family:'Alex Brush',cursive;font-weight:400;\n  font-size:clamp(36px,3.2vw,56px);line-height:1.15;letter-spacing:1px;\n  background:linear-gradient(90deg,#9060cc 0%,#e0c8ff 25%,#c8a0ff 50%,#e0c8ff 75%,#9060cc 100%);background-size:200% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 3px 5px rgba(0,0,0,.95)) drop-shadow(0 0 15px rgba(160,100,255,.5));\n  clip-path:polygon(0 0, 0 0, 0 100%, 0 100%);\n  animation:signatureLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s,purpleShift 4s linear infinite;\n}\n.pen-flare{\n  position:absolute;top:45%;left:0;width:4px;height:4px;border-radius:50%;\n  background:#e8d8ff;opacity:0;z-index:10;pointer-events:none;\n  box-shadow:0 0 10px 4px #d0b8ff,0 0 25px 12px #a880ee,0 0 40px 20px rgba(140,80,220,.6);\n  animation:flareLoop 8s cubic-bezier(.39,.57,.56,1) infinite 2.5s;\n}\n.bishop-name-ta{position:relative;z-index:2;font-family:'Noto Serif Tamil',serif;font-size:clamp(12px,1vw,18px);font-weight:700;color:rgba(210,190,255,.85)}\n\n.church-badge{position:relative;display:inline-flex;align-items:center;justify-content:center;opacity:0;animation:churchReveal 1s cubic-bezier(.34,1.56,.64,1) forwards 2.5s}\n.church-bg-inner{position:absolute;inset:3px;background:rgba(4,1,12,.92);border-radius:50px;z-index:1}\n.church-name{\n  position:relative;z-index:2;white-space:nowrap;font-family:'Noto Serif Tamil',serif;font-weight:900;\n  font-size:clamp(12px,.95vw,16px);letter-spacing:1px;padding:clamp(5px,.55vh,7px) clamp(16px,1.5vw,28px);\n  background:linear-gradient(90deg,#9060cc,#c8a0ff,#e8d0ff,#c8a0ff,#9060cc,#c8a0ff,#e8d0ff);background-size:300% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:purpleShift 3s linear infinite;\n  filter:drop-shadow(0 0 8px rgba(160,100,255,.7));\n}\n\n.ornament{position:absolute;font-size:clamp(14px,1.2vw,21px);opacity:.35;animation:ornSway 4s ease-in-out infinite}\n.orn-tl{top:10px;left:12px}.orn-tr{top:10px;right:12px;animation-delay:.5s}.orn-bl{bottom:10px;left:12px;animation-delay:1s}.orn-br{bottom:10px;right:12px;animation-delay:1.5s}\n\n.deco-row{position:absolute;left:0;right:0;bottom:0;z-index:11;display:flex;justify-content:center;gap:.5vw;padding-bottom:2px;pointer-events:none}\n.deco-item{font-size:clamp(12px,1.8vw,20px);opacity:.4;animation:decoSway 3.6s ease-in-out infinite;transform-origin:bottom center}\n.deco-item:nth-child(2n){animation-delay:.6s}.deco-item:nth-child(3n){animation-delay:1.2s}.deco-item:nth-child(4n){animation-delay:1.8s}\n\n@keyframes cardReveal{from{opacity:0;transform:translateY(30px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}\n@keyframes fadeDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}\n@keyframes palmReveal{from{opacity:0;transform:scale(.7);filter:blur(14px)}to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 18px rgba(160,80,255,.45))}}\n@keyframes palmFlow{0%,100%{background-position:0% center}50%{background-position:100% center}}\n@keyframes purpleShift{0%{background-position:0% center}100%{background-position:300% center}}\n@keyframes crossReveal{from{opacity:0;transform:scale(.3) rotate(-15deg)}to{opacity:1;transform:scale(1) rotate(0)}}\n@keyframes crossGlow{0%,100%{filter:drop-shadow(0 0 14px rgba(180,120,255,.9)) drop-shadow(0 0 30px rgba(140,80,220,.6))}50%{filter:drop-shadow(0 0 26px rgba(220,180,255,1)) drop-shadow(0 0 55px rgba(160,100,255,.9))}}\n@keyframes blockSweep{0%,30%{left:-100%}70%,100%{left:200%}}\n@keyframes auraPulse{0%,100%{opacity:.5;transform:translate(-50%,-50%) scale(.9)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}}\n@keyframes signatureLoop{0%,5%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:1}30%,85%{clip-path:polygon(0 0,100% 0,100% 100%,0 100%);opacity:1}95%{opacity:0}100%{clip-path:polygon(0 0,0 0,0 100%,0 100%);opacity:0}}\n@keyframes flareLoop{0%,5%{left:0%;opacity:0;transform:scale(.5) translateY(0)}8%{opacity:1;transform:scale(1.2) translateY(-4px)}15%{transform:scale(.9) translateY(4px)}22%{transform:scale(1.4) translateY(-2px)}28%{transform:scale(1) translateY(3px)}29%{opacity:1;transform:scale(1.2) translateY(-1px)}30%,100%{left:100%;opacity:0;transform:scale(.5) translateY(0)}}\n@keyframes churchReveal{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}\n@keyframes ornSway{0%,100%{transform:rotate(-5deg) scale(1)}50%{transform:rotate(5deg) scale(1.1)}}\n@keyframes decoSway{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}\n\n/* Mobile tuning */\n@media (max-width:900px){\n  .card,.verse-banner{width:99.5vw}\n  .palm-title{font-size:clamp(28px,10vw,56px)}\n  .service-text{font-size:clamp(18px,6vw,28px)}\n  .bishop-name-en{font-size:clamp(30px,9vw,44px)}\n  .info-value{font-size:clamp(15px,4.4vw,24px)}\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n  <div class=\"sky\"></div>\n  <canvas id=\"cRays\"></canvas>\n  <canvas id=\"cDoves\"></canvas>\n  <canvas id=\"cGlow\"></canvas>\n  <div class=\"ground-mist\"></div>\n  <canvas id=\"cSparkle\"></canvas>\n  <canvas id=\"cTears\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"verse-banner\">\n      <div class=\"verse-ta\">அவர் நம்முடைய மீறுதல்களினிமித்தம் காயப்பட்டு, நம்முடைய அக்கிரமங்களினிமித்தம் நொறுக்கப்பட்டார்</div>\n      <div class=\"verse-ref\">— ஏசாயா 53:5</div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"ornament orn-tl\">✝️</span>\n      <span class=\"ornament orn-tr\">✝️</span>\n      <span class=\"ornament orn-bl\">🕊️</span>\n      <span class=\"ornament orn-br\">🕊️</span>\n\n      <div class=\"church-top\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n\n      <div class=\"div-row\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-gem\">✦</span>\n        <span class=\"div-gem\" style=\"font-size:clamp(11px,1.4vw,16px);color:rgba(180,140,255,0.5)\">✝</span>\n        <span class=\"div-gem\">✦</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"event-tag\">✝ Good Friday ✝</div>\n      <div class=\"palm-title\">புனித வெள்ளி</div>\n      <div class=\"service-text\">ஆராதனை</div>\n      <div class=\"service-subtext\">சிலுவையின் நினைவு · ஜெபம்</div>\n\n      <div class=\"cross-wrap\">\n        <svg viewBox=\"0 0 120 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#f0eaff\"/>\n              <stop offset=\"15%\" stop-color=\"#c8a8ff\"/>\n              <stop offset=\"35%\" stop-color=\"#7040b8\"/>\n              <stop offset=\"50%\" stop-color=\"#dcc8ff\"/>\n              <stop offset=\"65%\" stop-color=\"#8a50cc\"/>\n              <stop offset=\"85%\" stop-color=\"#b890ff\"/>\n              <stop offset=\"100%\" stop-color=\"#5030a0\"/>\n            </linearGradient>\n            <linearGradient id=\"cg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#e8daff\"/>\n              <stop offset=\"50%\" stop-color=\"#7040b8\"/>\n              <stop offset=\"100%\" stop-color=\"#dcc8ff\"/>\n            </linearGradient>\n            <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n              <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n            <radialGradient id=\"shine\" cx=\"35%\" cy=\"30%\" r=\"60%\">\n              <stop offset=\"0%\" stop-color=\"rgba(240,230,255,0.6)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(240,230,255,0)\"/>\n            </radialGradient>\n          </defs>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#cg1)\" filter=\"url(#glow)\"/>\n          <rect x=\"8\" y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#cg2)\" filter=\"url(#glow)\"/>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#shine)\" opacity=\".7\"/>\n          <rect x=\"8\" y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#shine)\" opacity=\".5\"/>\n          <rect x=\"54\" y=\"8\" width=\"6\" height=\"144\" rx=\"3\" fill=\"rgba(230,220,255,0.3)\"/>\n          <rect x=\"8\" y=\"46\" width=\"104\" height=\"6\" rx=\"3\" fill=\"rgba(230,220,255,0.25)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"10\" fill=\"url(#cg1)\" stroke=\"rgba(200,170,255,.6)\" stroke-width=\"1.5\" filter=\"url(#glow)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"5\" fill=\"rgba(240,230,255,0.85)\"/>\n        </svg>\n      </div>\n\n      <div class=\"info-row\">\n        <div class=\"info-box\">\n          <div class=\"info-label\">தேதி</div>\n          <div class=\"info-value\">03 · 04 · 2026</div>\n        </div>\n        <div class=\"info-sep\">✦</div>\n        <div class=\"info-box\">\n          <div class=\"info-label\">நேரம்</div>\n          <div class=\"info-value\">காலை 11:00</div>\n        </div>\n      </div>\n\n      <div class=\"bishop-block\">\n        <div class=\"bishop-role\">பிஷப்</div>\n        <div class=\"bishop-name-wrapper\">\n          <div class=\"pen-flare\"></div>\n          <div class=\"bishop-name-en\">Bp. V. Paul Yuvaraj</div>\n        </div>\n        <div class=\"bishop-name-ta\">பி. வி. பால் யுவராஜ்</div>\n      </div>\n\n      <div class=\"church-badge\">\n        <div class=\"church-bg-inner\"></div>\n        <div class=\"church-name\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">✝</span><span class=\"deco-item\">🕊️</span><span class=\"deco-item\">🌿</span>\n  </div>\n</div>\n\n<script>\n(function(){\n  const cv=document.getElementById('cRays'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const R=Array.from({length:24},(_,i)=>({a:(i/24)*Math.PI*1.6-Math.PI*.8+(Math.random()-.5)*.3,al:.025+Math.random()*.06,sp:(.0012+Math.random()*.0025)*(Math.random()>.5?1:-1),ln:.4+Math.random()*.6}));\n  function draw(){t++;cx.clearRect(0,0,W,H);R.forEach(r=>{r.a+=r.sp;const ax=Math.cos(r.a)*W*r.ln+W*.5,ay=Math.sin(r.a)*W*r.ln+H*1.08,bx=Math.cos(r.a+.025)*W*r.ln+W*.5,by=Math.sin(r.a+.025)*W*r.ln+H*1.08,g=cx.createLinearGradient(W*.5,H*1.08,ax,ay);g.addColorStop(0,`rgba(180,120,255,${r.al*2})`);g.addColorStop(.4,`rgba(140,80,220,${r.al})`);g.addColorStop(1,'rgba(100,50,180,0)');cx.save();cx.beginPath();cx.moveTo(W*.5,H*1.08);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();cx.fillStyle=g;cx.fill();cx.restore()});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cDoves'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function drawDove(cx,x,y,size,alpha,flap){\n    cx.save();cx.globalAlpha=alpha;cx.fillStyle='rgba(220,200,255,0.85)';cx.shadowColor='rgba(180,140,255,0.8)';cx.shadowBlur=size*3;\n    const wingAngle=Math.sin(flap)*0.4;\n    cx.beginPath();cx.ellipse(x,y,size*1.2,size*0.5,0,0,Math.PI*2);cx.fill();\n    cx.save();cx.translate(x,y);cx.rotate(-wingAngle);cx.beginPath();cx.ellipse(-size*.5,-size*.2,size*1.1,size*.38,-0.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.save();cx.translate(x,y);cx.rotate(wingAngle);cx.beginPath();cx.ellipse(size*.5,-size*.2,size*1.1,size*.38,0.5,0,Math.PI*2);cx.fill();cx.restore();\n    cx.beginPath();cx.arc(x+size*1.1,y-size*.1,size*.35,0,Math.PI*2);cx.fill();cx.restore();\n  }\n  const doves=Array.from({length:6},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight*.6+innerHeight*.05,size:5+Math.random()*7,vx:(Math.random()*.6+.3)*(Math.random()>.5?1:-1),vy:(Math.random()-.5)*.18,flapSpeed:.04+Math.random()*.04,flapOffset:Math.random()*Math.PI*2,alpha:.12+Math.random()*.18}));\n  function draw(){t++;cx.clearRect(0,0,W,H);doves.forEach(d=>{d.x+=d.vx;d.y+=d.vy;if(d.x>W+40)d.x=-40;if(d.x<-40)d.x=W+40;if(d.y<0)d.y=H*.5;if(d.y>H*.7)d.y=H*.1;drawDove(cx,d.x,d.y,d.size,d.alpha,t*d.flapSpeed+d.flapOffset)});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cGlow'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function draw(){t++;cx.clearRect(0,0,W,H);const pulse=.85+.15*Math.sin(t*.025),g=cx.createRadialGradient(W*.5,H*.62,0,W*.5,H*.62,W*.38*pulse);g.addColorStop(0,'rgba(160,100,255,.12)');g.addColorStop(.35,'rgba(120,70,220,.06)');g.addColorStop(.65,'rgba(90,50,180,.03)');g.addColorStop(1,'transparent');cx.fillStyle=g;cx.fillRect(0,0,W,H);requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cSparkle'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  const S=Array.from({length:70},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:.4+Math.random()*1.8,ph:Math.random()*Math.PI*2,sp:.018+Math.random()*.035,vy:-(Math.random()*.22+.06),vx:(Math.random()-.5)*.1,col:Math.random()>.5?'200,170,255':'240,230,255'}));\n  function draw(){t++;cx.clearRect(0,0,W,H);S.forEach(s=>{s.y+=s.vy;s.x+=s.vx;if(s.y<-10){s.y=H+10;s.x=Math.random()*W}const a=.12+.65*(.5+.5*Math.sin(t*s.sp+s.ph));cx.save();cx.globalAlpha=a;cx.fillStyle=`rgba(${s.col},1)`;cx.shadowColor=`rgba(${s.col},.7)`;cx.shadowBlur=s.r*6;cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();cx.restore()});requestAnimationFrame(draw)}\n  draw();\n})();\n\n(function(){\n  const cv=document.getElementById('cTears'); if(!cv) return;\n  const cx=cv.getContext('2d'); let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight}\n  resize();addEventListener('resize',resize);\n\n  class Tear{\n    constructor(rand){\n      this.x=Math.random()*innerWidth;this.y=rand?(Math.random()*innerHeight):(-20);this.r=Math.random()*5+2.5;\n      this.vy=Math.random()*.4+.12;this.vx=(Math.random()-.5)*.15;this.alpha=Math.random()*.35+.12;\n      this.wobble=Math.random()*Math.PI*2;this.wobbleSpeed=.018+Math.random()*.025;\n    }\n    update(){this.y+=this.vy;this.wobble+=this.wobbleSpeed;this.x+=Math.sin(this.wobble)*.4+this.vx;this.alpha-=.0008;if(this.alpha<=0||this.y>innerHeight+30)Object.assign(this,new Tear(false))}\n    draw(cx){\n      cx.save();cx.globalAlpha=Math.max(0,this.alpha);\n      const g=cx.createRadialGradient(this.x,this.y-this.r*.3,0,this.x,this.y,this.r);\n      g.addColorStop(0,'rgba(240,230,255,1)');g.addColorStop(.5,'rgba(180,140,255,1)');g.addColorStop(1,'rgba(120,80,220,0)');\n      cx.fillStyle=g;cx.shadowColor='rgba(200,160,255,.7)';cx.shadowBlur=8;\n      cx.beginPath();cx.arc(this.x,this.y,this.r,0,Math.PI*2);cx.fill();\n      cx.beginPath();cx.moveTo(this.x,this.y-this.r);cx.quadraticCurveTo(this.x+this.r*.6,this.y-this.r*1.4,this.x,this.y-this.r*2.2);cx.quadraticCurveTo(this.x-this.r*.6,this.y-this.r*1.4,this.x,this.y-this.r);cx.fillStyle='rgba(200,170,255,0.4)';cx.fill();\n      cx.restore();\n    }\n  }\n\n  const tears=Array.from({length:16},()=>new Tear(true));\n  function draw(){t++;cx.clearRect(0,0,W,H);if(t%90===0&&tears.length<22)tears.push(new Tear(false));tears.forEach(d=>{d.update();d.draw(cx)});requestAnimationFrame(draw)}\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1772937978152.9502,
      "type": "html",
      "name": "Title",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,600;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  .video-bg{\n    position:absolute;inset:0;z-index:0;\n    width:100%;height:100%;\n    object-fit:cover;object-position:center;\n  }\n\n  .photo-fallback{\n    position:absolute;inset:0;z-index:0;\n    background:linear-gradient(160deg,#1a0f05 0%,#3d2210 30%,#1c1408 55%,#0a0810 100%);\n  }\n\n  /* slightly stronger overlay so text always pops */\n  .overlay{\n    position:absolute;inset:0;z-index:2;\n    background:\n      linear-gradient(\n        170deg,\n        rgba(10,5,0,.70)  0%,\n        rgba(8,4,0,.35)   38%,\n        rgba(8,4,0,.32)   60%,\n        rgba(4,2,0,.85)  100%\n      );\n  }\n\n  .glow-center{\n    position:absolute;\n    left:50%;top:48%;\n    transform:translate(-50%,-50%);\n    width:82vw;height:58vh;\n    background:radial-gradient(ellipse,\n      rgba(255,165,40,.08) 0%,\n      rgba(200,100,20,.03) 45%,\n      transparent 70%\n    );\n    z-index:3;\n    animation:divineGlow 8s ease-in-out infinite;\n  }\n  @keyframes divineGlow{\n    0%,100%{opacity:.7;transform:translate(-50%,-50%) scale(1)}\n    50%    {opacity:1; transform:translate(-50%,-50%) scale(1.10)}\n  }\n\n  .rays{\n    position:absolute;inset:0;z-index:2;\n    background:conic-gradient(\n      from 270deg at 50% 42%,\n      transparent 0deg,\n      rgba(255,185,50,.025) 3deg,\n      transparent 6deg,\n      transparent 20deg,\n      rgba(255,185,50,.02) 23deg,\n      transparent 26deg,\n      transparent 45deg,\n      rgba(255,185,50,.018) 48deg,\n      transparent 51deg,\n      transparent 360deg\n    );\n    animation:raysPulse 10s ease-in-out infinite;\n  }\n  @keyframes raysPulse{\n    0%,100%{opacity:.5}\n    50%    {opacity:1}\n  }\n\n  .vignette{\n    position:absolute;inset:0;z-index:4;\n    background:radial-gradient(ellipse at center,transparent 34%,rgba(0,0,0,.82) 100%);\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:11;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* welcome — gold accent, small so it works */\n  .welcome{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(11px,1.3vw,19px);\n    letter-spacing:16px;text-transform:uppercase;\n    color:rgba(238,200,120,.90);\n    text-shadow:\n      0 0 16px rgba(160,100,20,.60),\n      0 2px 8px rgba(0,0,0,.95);\n    margin-bottom:1.4vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.1s;\n  }\n\n  /* orn 1 — gold accent line */\n  .orn{\n    width:50vw;height:1px;margin-bottom:1.8vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 1.5s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.40) 20%,\n      rgba(255,215,80,.85) 50%,\n      rgba(200,150,40,.40) 80%,\n      transparent\n    );\n    position:relative;\n  }\n  .orn::before,.orn::after{\n    content:'✦';position:absolute;top:-7px;\n    font-size:11px;color:rgba(255,210,75,.90);\n    text-shadow:0 0 10px rgba(200,150,35,.80);\n  }\n  .orn::before{left:-6px}.orn::after{right:-6px}\n\n  /* ── TITLE 1 ──\n     Pure white core shimmer — maximum contrast against sepia brown.\n     Thin gold edges so it still feels warm/holy, not cold.\n  ── */\n  .t1-wrap{\n    margin-bottom:.3vh;\n    opacity:0;animation:fadeUp 1s ease forwards 1.8s;\n  }\n  .t1{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(30px,5.5vw,86px);\n    font-weight:900;line-height:1.15;\n    white-space:nowrap;letter-spacing:3px;\n    background:linear-gradient(90deg,\n      #d4a820 0%,    /* warm gold edge */\n      #ffffff 18%,   /* pure white */\n      #ffffff 38%,   /* pure white */\n      #fffef5 50%,   /* near-white centre */\n      #ffffff 62%,   /* pure white */\n      #ffffff 80%,   /* pure white */\n      #d4a820 100%   /* warm gold edge */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 5s linear infinite;\n    /* strong dark drop shadow = crisp edge against brown bg */\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 30px rgba(255,255,255,.15));\n  }\n\n  /* ── TITLE 2 ──\n     Cool silver-white with faint lavender — contrasts warm sepia perfectly.\n  ── */\n  .t2-wrap{\n    opacity:0;animation:fadeUp 1s ease forwards 2.1s;\n  }\n  .t2{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(22px,4.3vw,66px);\n    font-weight:700;line-height:1.3;\n    letter-spacing:14px;white-space:nowrap;\n    background:linear-gradient(90deg,\n      #c8b8f0 0%,    /* soft lavender-silver */\n      #ffffff 20%,   /* white */\n      #e8e0ff 38%,   /* silver-lavender */\n      #ffffff 50%,   /* white */\n      #e8e0ff 62%,   /* silver-lavender */\n      #ffffff 80%,   /* white */\n      #c8b8f0 100%   /* soft lavender-silver */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 4s linear infinite;\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 25px rgba(200,185,255,.20));\n  }\n\n  @keyframes whiteShimmer{\n    0%  {background-position:0%   center}\n    100%{background-position:200% center}\n  }\n\n  /* orn 2 */\n  .orn2{\n    width:34vw;height:1px;\n    margin-top:1.8vh;margin-bottom:1.6vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 2.6s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.45) 35%,\n      rgba(255,215,80,.68) 65%,\n      transparent\n    );\n  }\n\n  /* verse — bright white-ivory, clearly readable */\n  .verse{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:600;\n    font-size:clamp(11px,1.2vw,17px);\n    letter-spacing:2px;text-align:center;\n    padding:0 12vw;\n    color:rgba(255,248,225,.92);\n    text-shadow:\n      0 1px 3px rgba(0,0,0,1),\n      0 3px 12px rgba(0,0,0,.96),\n      0 0 20px rgba(0,0,0,.80);\n    opacity:0;animation:fadeUp .9s ease forwards 2.9s;\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(15px)}\n    to  {opacity:1;transform:translateY(0)}\n  }\n  @keyframes lineExpand{to{opacity:1;transform:scaleX(1)}}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"photo-fallback\"></div>\n\n  <video class=\"video-bg\" autoplay muted loop playsinline>\n    <source src=\"bgv.mp4\" type=\"video/mp4\">\n  </video>\n\n  <div class=\"overlay\"></div>\n  <div class=\"rays\"></div>\n  <div class=\"glow-center\"></div>\n  <div class=\"vignette\"></div>\n\n  <div class=\"content\">\n    <div class=\"welcome\">Welcome to</div>\n    <div class=\"orn\"></div>\n    <div class=\"t1-wrap\"><span class=\"t1\">நல்ல சமாரியன் இயேசு</span></div>\n    <div class=\"t2-wrap\"><span class=\"t2\">ஜெப வீடு</span></div>\n    <div class=\"orn2\"></div>\n    <div class=\"verse\">❝ என்னுடைய வீடு ஜெபவீடு என்னப்படும் ❞ — மத்தேயு 21:13</div>\n  </div>\n\n</div>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,600;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  .video-bg{\n    position:absolute;inset:0;z-index:0;\n    width:100%;height:100%;\n    object-fit:cover;object-position:center;\n  }\n\n  .photo-fallback{\n    position:absolute;inset:0;z-index:0;\n    background:linear-gradient(160deg,#1a0f05 0%,#3d2210 30%,#1c1408 55%,#0a0810 100%);\n  }\n\n  /* slightly stronger overlay so text always pops */\n  .overlay{\n    position:absolute;inset:0;z-index:2;\n    background:\n      linear-gradient(\n        170deg,\n        rgba(10,5,0,.70)  0%,\n        rgba(8,4,0,.35)   38%,\n        rgba(8,4,0,.32)   60%,\n        rgba(4,2,0,.85)  100%\n      );\n  }\n\n  .glow-center{\n    position:absolute;\n    left:50%;top:48%;\n    transform:translate(-50%,-50%);\n    width:82vw;height:58vh;\n    background:radial-gradient(ellipse,\n      rgba(255,165,40,.08) 0%,\n      rgba(200,100,20,.03) 45%,\n      transparent 70%\n    );\n    z-index:3;\n    animation:divineGlow 8s ease-in-out infinite;\n  }\n  @keyframes divineGlow{\n    0%,100%{opacity:.7;transform:translate(-50%,-50%) scale(1)}\n    50%    {opacity:1; transform:translate(-50%,-50%) scale(1.10)}\n  }\n\n  .rays{\n    position:absolute;inset:0;z-index:2;\n    background:conic-gradient(\n      from 270deg at 50% 42%,\n      transparent 0deg,\n      rgba(255,185,50,.025) 3deg,\n      transparent 6deg,\n      transparent 20deg,\n      rgba(255,185,50,.02) 23deg,\n      transparent 26deg,\n      transparent 45deg,\n      rgba(255,185,50,.018) 48deg,\n      transparent 51deg,\n      transparent 360deg\n    );\n    animation:raysPulse 10s ease-in-out infinite;\n  }\n  @keyframes raysPulse{\n    0%,100%{opacity:.5}\n    50%    {opacity:1}\n  }\n\n  .vignette{\n    position:absolute;inset:0;z-index:4;\n    background:radial-gradient(ellipse at center,transparent 34%,rgba(0,0,0,.82) 100%);\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:11;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* welcome — gold accent, small so it works */\n  .welcome{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(11px,1.3vw,19px);\n    letter-spacing:16px;text-transform:uppercase;\n    color:rgba(238,200,120,.90);\n    text-shadow:\n      0 0 16px rgba(160,100,20,.60),\n      0 2px 8px rgba(0,0,0,.95);\n    margin-bottom:1.4vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.1s;\n  }\n\n  /* orn 1 — gold accent line */\n  .orn{\n    width:50vw;height:1px;margin-bottom:1.8vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 1.5s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.40) 20%,\n      rgba(255,215,80,.85) 50%,\n      rgba(200,150,40,.40) 80%,\n      transparent\n    );\n    position:relative;\n  }\n  .orn::before,.orn::after{\n    content:'✦';position:absolute;top:-7px;\n    font-size:11px;color:rgba(255,210,75,.90);\n    text-shadow:0 0 10px rgba(200,150,35,.80);\n  }\n  .orn::before{left:-6px}.orn::after{right:-6px}\n\n  /* ── TITLE 1 ──\n     Pure white core shimmer — maximum contrast against sepia brown.\n     Thin gold edges so it still feels warm/holy, not cold.\n  ── */\n  .t1-wrap{\n    margin-bottom:.3vh;\n    opacity:0;animation:fadeUp 1s ease forwards 1.8s;\n  }\n  .t1{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(30px,5.5vw,86px);\n    font-weight:900;line-height:1.15;\n    white-space:nowrap;letter-spacing:3px;\n    background:linear-gradient(90deg,\n      #d4a820 0%,    /* warm gold edge */\n      #ffffff 18%,   /* pure white */\n      #ffffff 38%,   /* pure white */\n      #fffef5 50%,   /* near-white centre */\n      #ffffff 62%,   /* pure white */\n      #ffffff 80%,   /* pure white */\n      #d4a820 100%   /* warm gold edge */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 5s linear infinite;\n    /* strong dark drop shadow = crisp edge against brown bg */\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 30px rgba(255,255,255,.15));\n  }\n\n  /* ── TITLE 2 ──\n     Cool silver-white with faint lavender — contrasts warm sepia perfectly.\n  ── */\n  .t2-wrap{\n    opacity:0;animation:fadeUp 1s ease forwards 2.1s;\n  }\n  .t2{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(22px,4.3vw,66px);\n    font-weight:700;line-height:1.3;\n    letter-spacing:14px;white-space:nowrap;\n    background:linear-gradient(90deg,\n      #c8b8f0 0%,    /* soft lavender-silver */\n      #ffffff 20%,   /* white */\n      #e8e0ff 38%,   /* silver-lavender */\n      #ffffff 50%,   /* white */\n      #e8e0ff 62%,   /* silver-lavender */\n      #ffffff 80%,   /* white */\n      #c8b8f0 100%   /* soft lavender-silver */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 4s linear infinite;\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 25px rgba(200,185,255,.20));\n  }\n\n  @keyframes whiteShimmer{\n    0%  {background-position:0%   center}\n    100%{background-position:200% center}\n  }\n\n  /* orn 2 */\n  .orn2{\n    width:34vw;height:1px;\n    margin-top:1.8vh;margin-bottom:1.6vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 2.6s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.45) 35%,\n      rgba(255,215,80,.68) 65%,\n      transparent\n    );\n  }\n\n  /* verse — bright white-ivory, clearly readable */\n  .verse{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:600;\n    font-size:clamp(11px,1.2vw,17px);\n    letter-spacing:2px;text-align:center;\n    padding:0 12vw;\n    color:rgba(255,248,225,.92);\n    text-shadow:\n      0 1px 3px rgba(0,0,0,1),\n      0 3px 12px rgba(0,0,0,.96),\n      0 0 20px rgba(0,0,0,.80);\n    opacity:0;animation:fadeUp .9s ease forwards 2.9s;\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(15px)}\n    to  {opacity:1;transform:translateY(0)}\n  }\n  @keyframes lineExpand{to{opacity:1;transform:scaleX(1)}}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"photo-fallback\"></div>\n\n  <video class=\"video-bg\" autoplay muted loop playsinline>\n    <source src=\"bgv.mp4\" type=\"video/mp4\">\n  </video>\n\n  <div class=\"overlay\"></div>\n  <div class=\"rays\"></div>\n  <div class=\"glow-center\"></div>\n  <div class=\"vignette\"></div>\n\n  <div class=\"content\">\n    <div class=\"welcome\">Welcome to</div>\n    <div class=\"orn\"></div>\n    <div class=\"t1-wrap\"><span class=\"t1\">நல்ல சமாரியன் இயேசு</span></div>\n    <div class=\"t2-wrap\"><span class=\"t2\">ஜெப வீடு</span></div>\n    <div class=\"orn2\"></div>\n    <div class=\"verse\">❝ என்னுடைய வீடு ஜெபவீடு என்னப்படும் ❞ — மத்தேயு 21:13</div>\n  </div>\n\n</div>\n</body>\n</html>"
    },
    {
      "id": 1774107161738.447,
      "type": "html",
      "name": "Testimony",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>சாட்சி நேரம் – Testimony Time</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+Tamil:ital,wght@0,400;0,600;0,700;1,400&display=swap');\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    background: #0d0c18;\n    font-family: 'Noto Serif Tamil', serif;\n    overflow: hidden;\n  }\n\n  /* ─── SLIDE CANVAS ─── */\n  .slide {\n    position: fixed;\n    inset: 0;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* ─── HEAVEN SKY BACKGROUND ─── */\n  .sky {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 100% 80% at 50% 0%,\n      #e8dfc8 0%, #c4a96d 20%, #8a6f3e 40%,\n      #4a3520 60%, #1e1510 80%, #0d0c18 100%);\n  }\n\n  .clouds-layer {\n    position: absolute; inset: 0;\n    background-image:\n      radial-gradient(ellipse 300px 60px at 20% 15%, rgba(255,248,235,0.18) 0%, transparent 100%),\n      radial-gradient(ellipse 200px 40px at 70% 10%, rgba(255,248,235,0.12) 0%, transparent 100%),\n      radial-gradient(ellipse 400px 80px at 50% 20%, rgba(255,245,225,0.08) 0%, transparent 100%),\n      radial-gradient(ellipse 150px 35px at 85% 18%, rgba(255,248,235,0.10) 0%, transparent 100%);\n    animation: cloudDrift 20s ease-in-out infinite alternate;\n  }\n  @keyframes cloudDrift {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(18px); }\n  }\n\n  .light-beam {\n    position: absolute;\n    top: 0; left: 50%; transform: translateX(-50%);\n    width: min(92vw, 900px);\n    height: 100%;\n    background: conic-gradient(\n      from 270deg at 50% 0%,\n      transparent 0deg,\n      rgba(255,245,200,0.04) 8deg,\n      rgba(255,245,200,0.09) 12deg,\n      rgba(255,245,200,0.04) 16deg,\n      transparent 24deg,\n      rgba(255,245,200,0.06) 30deg,\n      rgba(255,245,200,0.10) 34deg,\n      rgba(255,245,200,0.06) 38deg,\n      transparent 46deg,\n      rgba(255,245,200,0.04) 52deg,\n      rgba(255,245,200,0.08) 56deg,\n      rgba(255,245,200,0.04) 60deg,\n      transparent 68deg\n    );\n    animation: beamPulse 5s ease-in-out infinite;\n  }\n  @keyframes beamPulse {\n    0%, 100% { opacity: 0.7; }\n    50% { opacity: 1; }\n  }\n\n  .vignette-bottom {\n    position: absolute;\n    bottom: 0; left: 0; right: 0; height: 55%;\n    background: linear-gradient(0deg, rgba(13,12,24,0.97) 0%, rgba(13,12,24,0.6) 55%, transparent 100%);\n  }\n  .vignette-sides {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 80% 100% at 50% 50%, transparent 55%, rgba(13,12,24,0.7) 100%);\n  }\n\n  .motes { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }\n  .mote {\n    position: absolute;\n    border-radius: 50%;\n    background: rgba(255, 245, 200, 0.85);\n    animation: moteFloat linear infinite;\n  }\n  @keyframes moteFloat {\n    0%   { opacity: 0; transform: translateY(0) scale(0.5); }\n    15%  { opacity: 1; }\n    85%  { opacity: 0.6; }\n    100% { opacity: 0; transform: translateY(-90vh) scale(1.5); }\n  }\n\n  .content {\n    position: relative; z-index: 10;\n    display: flex; flex-direction: column;\n    align-items: center; gap: 0;\n    width: 100%;\n    padding: 0 12px; /* reduced from 40px */\n    margin-top: 14vh;\n  }\n\n  .church-label {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(9px, 1.1vw, 13px);\n    letter-spacing: 4px;\n    color: rgba(212, 178, 100, 0.75);\n    text-transform: uppercase;\n    margin-bottom: 14px;\n    animation: fadeIn 1.5s ease forwards;\n    text-align: center;\n  }\n\n  .divider {\n    width: 180px; height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.5), transparent);\n    margin-bottom: 28px;\n    animation: fadeIn 1.8s ease forwards;\n  }\n\n  .title-ta {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(42px, 8vw, 96px);\n    font-weight: 700;\n    color: #ffffff;\n    text-align: center;\n    line-height: 1.15;\n    letter-spacing: 3px;\n    text-shadow:\n      0 0 30px rgba(212,178,100,0.55),\n      0 0 70px rgba(212,178,100,0.2),\n      0 6px 40px rgba(0,0,0,0.9);\n    animation: titleReveal 1.2s ease forwards;\n    margin-bottom: 12px;\n    display:flex;align-items:center;justify-content:center;gap:24px;\n    flex-wrap: wrap;\n  }\n\n  @keyframes titleReveal {\n    from { opacity:0; transform: translateY(24px); }\n    to   { opacity:1; transform: translateY(0); }\n  }\n\n  .title-en {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(14px, 2.4vw, 26px);\n    color: rgba(212, 178, 100, 0.9);\n    letter-spacing: 6px;\n    text-transform: uppercase;\n    text-shadow: 0 0 20px rgba(212,178,100,0.4);\n    animation: fadeIn 1.6s ease forwards;\n    margin-bottom: 28px;\n    text-align: center;\n  }\n\n  .divider-bottom {\n    display: flex; align-items: center; gap: 14px;\n    margin-bottom: 22px;\n    animation: fadeIn 2s ease forwards;\n  }\n  .dl { width: 80px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,178,100,0.45)); }\n  .dr { width: 80px; height: 1px; background: linear-gradient(90deg, rgba(212,178,100,0.45), transparent); }\n  .dot {\n    width: 5px; height: 5px; border-radius: 50%;\n    background: rgba(212,178,100,0.85);\n    box-shadow: 0 0 8px rgba(212,178,100,0.6);\n  }\n\n  .scripture {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(11px, 1.4vw, 15px);\n    font-style: italic;\n    color: rgba(212,178,100,0.55);\n    letter-spacing: 1px;\n    text-align: center;\n    animation: fadeIn 2.2s ease forwards;\n    max-width: 95vw;\n  }\n\n  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }\n</style>\n</head>\n<body>\n<div class=\"slide\">\n\n  <div class=\"sky\"></div>\n  <div class=\"clouds-layer\"></div>\n  <div class=\"light-beam\"></div>\n\n  <svg style=\"position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:900px;height:auto;z-index:2;opacity:0.22;pointer-events:none\"\n       viewBox=\"0 0 900 420\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <linearGradient id=\"wg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n      <linearGradient id=\"wg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n    </defs>\n\n    <g transform=\"translate(450,30) scale(-1,1)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.55\"/>\n    </g>\n\n    <g transform=\"translate(450,30)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.55\"/>\n    </g>\n\n    <ellipse cx=\"450\" cy=\"30\" rx=\"55\" ry=\"22\" fill=\"#fff8d0\" opacity=\"0.18\"/>\n    <ellipse cx=\"450\" cy=\"30\" rx=\"40\" ry=\"15\" fill=\"#fff8d0\" opacity=\"0.22\"/>\n    <circle cx=\"450\" cy=\"30\" r=\"10\" fill=\"#fffae0\" opacity=\"0.35\"/>\n  </svg>\n\n  <svg style=\"position:absolute;top:22%;left:50%;transform:translate(-50%,-50%);width:80px;z-index:5;opacity:0;animation:doveAppear 2s 0.5s ease forwards;pointer-events:none\"\n       viewBox=\"0 0 80 55\" xmlns=\"http://www.w3.org/2000/svg\">\n    <style>@keyframes doveAppear{from{opacity:0;transform:translate(-50%,-58%)}to{opacity:0.85;transform:translate(-50%,-50%)}}</style>\n    <ellipse cx=\"38\" cy=\"30\" rx=\"18\" ry=\"10\" fill=\"#fffcf0\"/>\n    <circle cx=\"54\" cy=\"23\" r=\"7\" fill=\"#fffcf0\"/>\n    <path d=\"M60,22 L67,21 L60,24Z\" fill=\"#e8c870\"/>\n    <path d=\"M30,28 Q15,14 8,20 Q18,22 26,30Z\" fill=\"#fff8e0\" opacity=\"0.95\"/>\n    <path d=\"M32,26 Q20,8 10,12 Q22,18 28,28Z\" fill=\"#fff8e0\" opacity=\"0.75\"/>\n    <path d=\"M20,32 Q10,38 6,36 Q14,33 20,30Z\" fill=\"#fffcf0\"/>\n    <circle cx=\"57\" cy=\"22\" r=\"2\" fill=\"#2a1a08\"/>\n    <circle cx=\"57.7\" cy=\"21.3\" r=\"0.7\" fill=\"#fff\"/>\n  </svg>\n\n  <div class=\"vignette-bottom\"></div>\n  <div class=\"vignette-sides\"></div>\n\n  <div class=\"motes\" id=\"motes\"></div>\n\n  <div class=\"content\">\n    <div class=\"church-label\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n    <div class=\"divider\"></div>\n\n    <div class=\"title-ta\">\n      <span>சாட்சி</span>\n      <svg width=\"52\" height=\"70\" viewBox=\"0 0 60 80\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0;opacity:0.92;filter:drop-shadow(0 0 10px rgba(212,168,67,0.5))\">\n        <defs>\n          <linearGradient id=\"mg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#fff5d0\"/>\n            <stop offset=\"100%\" stop-color=\"#d4a843\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"18\" y=\"4\" width=\"24\" height=\"38\" rx=\"12\" fill=\"url(#mg2)\" stroke=\"rgba(212,168,67,0.5)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"18\" x2=\"42\" y2=\"18\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"25\" x2=\"42\" y2=\"25\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"32\" x2=\"42\" y2=\"32\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <path d=\"M12,38 Q10,52 30,52 Q50,52 48,38\" fill=\"none\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <line x1=\"30\" y1=\"52\" x2=\"30\" y2=\"68\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <rect x=\"14\" y=\"67\" width=\"32\" height=\"5\" rx=\"2.5\" fill=\"url(#mg2)\"/>\n      </svg>\n      <span>நேரம்</span>\n    </div>\n\n    <div class=\"title-en\">Testimony Time</div>\n\n    <div class=\"divider-bottom\">\n      <div class=\"dl\"></div>\n      <div class=\"dot\"></div>\n      <div class=\"dr\"></div>\n    </div>\n\n    <div class=\"scripture\">\n      \"உங்கள் வாயால் சொல்லுங்கள், கர்த்தர் என்னை இரட்சித்தார்\" — ஏசாயா 38:20\n    </div>\n  </div>\n</div>\n\n<script>\n  const container = document.getElementById('motes');\n  for (let i = 0; i < 50; i++) {\n    const m = document.createElement('div');\n    m.classList.add('mote');\n    const size = 1 + Math.random() * 3;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.bottom = (Math.random() * 30) + '%';\n    m.style.animationDuration = (8 + Math.random() * 14) + 's';\n    m.style.animationDelay = (Math.random() * 10) + 's';\n    m.style.opacity = 0;\n    container.appendChild(m);\n  }\n</script>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>சாட்சி நேரம் – Testimony Time</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Noto+Serif+Tamil:ital,wght@0,400;0,600;0,700;1,400&display=swap');\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    background: #0d0c18;\n    font-family: 'Noto Serif Tamil', serif;\n    overflow: hidden;\n  }\n\n  /* ─── SLIDE CANVAS ─── */\n  .slide {\n    position: fixed;\n    inset: 0;\n    width: 100vw;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* ─── HEAVEN SKY BACKGROUND ─── */\n  .sky {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 100% 80% at 50% 0%,\n      #e8dfc8 0%, #c4a96d 20%, #8a6f3e 40%,\n      #4a3520 60%, #1e1510 80%, #0d0c18 100%);\n  }\n\n  .clouds-layer {\n    position: absolute; inset: 0;\n    background-image:\n      radial-gradient(ellipse 300px 60px at 20% 15%, rgba(255,248,235,0.18) 0%, transparent 100%),\n      radial-gradient(ellipse 200px 40px at 70% 10%, rgba(255,248,235,0.12) 0%, transparent 100%),\n      radial-gradient(ellipse 400px 80px at 50% 20%, rgba(255,245,225,0.08) 0%, transparent 100%),\n      radial-gradient(ellipse 150px 35px at 85% 18%, rgba(255,248,235,0.10) 0%, transparent 100%);\n    animation: cloudDrift 20s ease-in-out infinite alternate;\n  }\n  @keyframes cloudDrift {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(18px); }\n  }\n\n  .light-beam {\n    position: absolute;\n    top: 0; left: 50%; transform: translateX(-50%);\n    width: min(92vw, 900px);\n    height: 100%;\n    background: conic-gradient(\n      from 270deg at 50% 0%,\n      transparent 0deg,\n      rgba(255,245,200,0.04) 8deg,\n      rgba(255,245,200,0.09) 12deg,\n      rgba(255,245,200,0.04) 16deg,\n      transparent 24deg,\n      rgba(255,245,200,0.06) 30deg,\n      rgba(255,245,200,0.10) 34deg,\n      rgba(255,245,200,0.06) 38deg,\n      transparent 46deg,\n      rgba(255,245,200,0.04) 52deg,\n      rgba(255,245,200,0.08) 56deg,\n      rgba(255,245,200,0.04) 60deg,\n      transparent 68deg\n    );\n    animation: beamPulse 5s ease-in-out infinite;\n  }\n  @keyframes beamPulse {\n    0%, 100% { opacity: 0.7; }\n    50% { opacity: 1; }\n  }\n\n  .vignette-bottom {\n    position: absolute;\n    bottom: 0; left: 0; right: 0; height: 55%;\n    background: linear-gradient(0deg, rgba(13,12,24,0.97) 0%, rgba(13,12,24,0.6) 55%, transparent 100%);\n  }\n  .vignette-sides {\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse 80% 100% at 50% 50%, transparent 55%, rgba(13,12,24,0.7) 100%);\n  }\n\n  .motes { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }\n  .mote {\n    position: absolute;\n    border-radius: 50%;\n    background: rgba(255, 245, 200, 0.85);\n    animation: moteFloat linear infinite;\n  }\n  @keyframes moteFloat {\n    0%   { opacity: 0; transform: translateY(0) scale(0.5); }\n    15%  { opacity: 1; }\n    85%  { opacity: 0.6; }\n    100% { opacity: 0; transform: translateY(-90vh) scale(1.5); }\n  }\n\n  .content {\n    position: relative; z-index: 10;\n    display: flex; flex-direction: column;\n    align-items: center; gap: 0;\n    width: 100%;\n    padding: 0 12px; /* reduced from 40px */\n    margin-top: 14vh;\n  }\n\n  .church-label {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(9px, 1.1vw, 13px);\n    letter-spacing: 4px;\n    color: rgba(212, 178, 100, 0.75);\n    text-transform: uppercase;\n    margin-bottom: 14px;\n    animation: fadeIn 1.5s ease forwards;\n    text-align: center;\n  }\n\n  .divider {\n    width: 180px; height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(212,178,100,0.5), transparent);\n    margin-bottom: 28px;\n    animation: fadeIn 1.8s ease forwards;\n  }\n\n  .title-ta {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(42px, 8vw, 96px);\n    font-weight: 700;\n    color: #ffffff;\n    text-align: center;\n    line-height: 1.15;\n    letter-spacing: 3px;\n    text-shadow:\n      0 0 30px rgba(212,178,100,0.55),\n      0 0 70px rgba(212,178,100,0.2),\n      0 6px 40px rgba(0,0,0,0.9);\n    animation: titleReveal 1.2s ease forwards;\n    margin-bottom: 12px;\n    display:flex;align-items:center;justify-content:center;gap:24px;\n    flex-wrap: wrap;\n  }\n\n  @keyframes titleReveal {\n    from { opacity:0; transform: translateY(24px); }\n    to   { opacity:1; transform: translateY(0); }\n  }\n\n  .title-en {\n    font-family: 'Cinzel', serif;\n    font-size: clamp(14px, 2.4vw, 26px);\n    color: rgba(212, 178, 100, 0.9);\n    letter-spacing: 6px;\n    text-transform: uppercase;\n    text-shadow: 0 0 20px rgba(212,178,100,0.4);\n    animation: fadeIn 1.6s ease forwards;\n    margin-bottom: 28px;\n    text-align: center;\n  }\n\n  .divider-bottom {\n    display: flex; align-items: center; gap: 14px;\n    margin-bottom: 22px;\n    animation: fadeIn 2s ease forwards;\n  }\n  .dl { width: 80px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,178,100,0.45)); }\n  .dr { width: 80px; height: 1px; background: linear-gradient(90deg, rgba(212,178,100,0.45), transparent); }\n  .dot {\n    width: 5px; height: 5px; border-radius: 50%;\n    background: rgba(212,178,100,0.85);\n    box-shadow: 0 0 8px rgba(212,178,100,0.6);\n  }\n\n  .scripture {\n    font-family: 'Noto Serif Tamil', serif;\n    font-size: clamp(11px, 1.4vw, 15px);\n    font-style: italic;\n    color: rgba(212,178,100,0.55);\n    letter-spacing: 1px;\n    text-align: center;\n    animation: fadeIn 2.2s ease forwards;\n    max-width: 95vw;\n  }\n\n  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"slide\">\n\n  <div class=\"sky\"></div>\n  <div class=\"clouds-layer\"></div>\n  <div class=\"light-beam\"></div>\n\n  <svg style=\"position:absolute;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:900px;height:auto;z-index:2;opacity:0.22;pointer-events:none\"\n       viewBox=\"0 0 900 420\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <linearGradient id=\"wg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n      <linearGradient id=\"wg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#fff8e0\" stop-opacity=\"1\"/>\n        <stop offset=\"70%\" stop-color=\"#e8d090\" stop-opacity=\"0.7\"/>\n        <stop offset=\"100%\" stop-color=\"#c4a060\" stop-opacity=\"0\"/>\n      </linearGradient>\n    </defs>\n\n    <g transform=\"translate(450,30) scale(-1,1)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg1)\" opacity=\"0.55\"/>\n    </g>\n\n    <g transform=\"translate(450,30)\">\n      <path d=\"M0,0 Q120,80 280,180 Q320,210 340,250 Q310,230 290,200 Q200,140 80,60 Q40,35 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.9\"/>\n      <path d=\"M0,0 Q90,70 200,150 Q250,185 280,230 Q240,200 210,170 Q130,110 50,50 Q25,30 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.7\"/>\n      <path d=\"M0,0 Q60,50 140,110 Q185,145 210,190 Q170,155 140,130 Q80,90 30,45 Q15,25 0,0Z\" fill=\"url(#wg2)\" opacity=\"0.55\"/>\n    </g>\n\n    <ellipse cx=\"450\" cy=\"30\" rx=\"55\" ry=\"22\" fill=\"#fff8d0\" opacity=\"0.18\"/>\n    <ellipse cx=\"450\" cy=\"30\" rx=\"40\" ry=\"15\" fill=\"#fff8d0\" opacity=\"0.22\"/>\n    <circle cx=\"450\" cy=\"30\" r=\"10\" fill=\"#fffae0\" opacity=\"0.35\"/>\n  </svg>\n\n  <svg style=\"position:absolute;top:22%;left:50%;transform:translate(-50%,-50%);width:80px;z-index:5;opacity:0;animation:doveAppear 2s 0.5s ease forwards;pointer-events:none\"\n       viewBox=\"0 0 80 55\" xmlns=\"http://www.w3.org/2000/svg\">\n    <style>@keyframes doveAppear{from{opacity:0;transform:translate(-50%,-58%)}to{opacity:0.85;transform:translate(-50%,-50%)}}</style>\n    <ellipse cx=\"38\" cy=\"30\" rx=\"18\" ry=\"10\" fill=\"#fffcf0\"/>\n    <circle cx=\"54\" cy=\"23\" r=\"7\" fill=\"#fffcf0\"/>\n    <path d=\"M60,22 L67,21 L60,24Z\" fill=\"#e8c870\"/>\n    <path d=\"M30,28 Q15,14 8,20 Q18,22 26,30Z\" fill=\"#fff8e0\" opacity=\"0.95\"/>\n    <path d=\"M32,26 Q20,8 10,12 Q22,18 28,28Z\" fill=\"#fff8e0\" opacity=\"0.75\"/>\n    <path d=\"M20,32 Q10,38 6,36 Q14,33 20,30Z\" fill=\"#fffcf0\"/>\n    <circle cx=\"57\" cy=\"22\" r=\"2\" fill=\"#2a1a08\"/>\n    <circle cx=\"57.7\" cy=\"21.3\" r=\"0.7\" fill=\"#fff\"/>\n  </svg>\n\n  <div class=\"vignette-bottom\"></div>\n  <div class=\"vignette-sides\"></div>\n\n  <div class=\"motes\" id=\"motes\"></div>\n\n  <div class=\"content\">\n    <div class=\"church-label\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n    <div class=\"divider\"></div>\n\n    <div class=\"title-ta\">\n      <span>சாட்சி</span>\n      <svg width=\"52\" height=\"70\" viewBox=\"0 0 60 80\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0;opacity:0.92;filter:drop-shadow(0 0 10px rgba(212,168,67,0.5))\">\n        <defs>\n          <linearGradient id=\"mg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#fff5d0\"/>\n            <stop offset=\"100%\" stop-color=\"#d4a843\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"18\" y=\"4\" width=\"24\" height=\"38\" rx=\"12\" fill=\"url(#mg2)\" stroke=\"rgba(212,168,67,0.5)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"18\" x2=\"42\" y2=\"18\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"25\" x2=\"42\" y2=\"25\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <line x1=\"18\" y1=\"32\" x2=\"42\" y2=\"32\" stroke=\"rgba(180,130,30,0.4)\" stroke-width=\"1\"/>\n        <path d=\"M12,38 Q10,52 30,52 Q50,52 48,38\" fill=\"none\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <line x1=\"30\" y1=\"52\" x2=\"30\" y2=\"68\" stroke=\"url(#mg2)\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <rect x=\"14\" y=\"67\" width=\"32\" height=\"5\" rx=\"2.5\" fill=\"url(#mg2)\"/>\n      </svg>\n      <span>நேரம்</span>\n    </div>\n\n    <div class=\"title-en\">Testimony Time</div>\n\n    <div class=\"divider-bottom\">\n      <div class=\"dl\"></div>\n      <div class=\"dot\"></div>\n      <div class=\"dr\"></div>\n    </div>\n\n    <div class=\"scripture\">\n      \"உங்கள் வாயால் சொல்லுங்கள், கர்த்தர் என்னை இரட்சித்தார்\" — ஏசாயா 38:20\n    </div>\n  </div>\n</div>\n\n<script>\n  const container = document.getElementById('motes');\n  for (let i = 0; i < 50; i++) {\n    const m = document.createElement('div');\n    m.classList.add('mote');\n    const size = 1 + Math.random() * 3;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.bottom = (Math.random() * 30) + '%';\n    m.style.animationDuration = (8 + Math.random() * 14) + 's';\n    m.style.animationDelay = (Math.random() * 10) + 's';\n    m.style.opacity = 0;\n    container.appendChild(m);\n  }\n</script>\n</body>\n</html>"
