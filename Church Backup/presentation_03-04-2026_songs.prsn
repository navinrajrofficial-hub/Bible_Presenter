    {
      "id": 1774106242517.191,
      "type": "html",
      "name": "Information",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>அறிவிப்பு - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── SKY GRADIENT — deep royal blue to golden dawn (announcement feel) ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      170deg,\n      #05102a 0%,\n      #0e2257 12%,\n      #1a4a8a 26%,\n      #2e6db4 40%,\n      #5299d3 54%,\n      #8ac4e8 68%,\n      #c9e8f7 82%,\n      #f0f8ff 92%,\n      #ffffff 100%\n    );\n    z-index:0;\n  }\n\n  /* ── MEGAPHONE / BELL GLOW ── */\n  .bell-glow{\n    position:absolute;\n    top:-10vh;\n    left:50%;\n    transform:translateX(-50%);\n    width:55vw;height:55vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(180,220,255,0.55) 0%,\n      rgba(100,170,255,0.3) 30%,\n      rgba(50,120,220,0.1) 60%,\n      transparent 100%\n    );\n    z-index:1;\n    animation:bellPulse 3.5s ease-in-out infinite;\n  }\n  @keyframes bellPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.8}\n    50%{transform:translateX(-50%) scale(1.08);opacity:1}\n  }\n\n  /* ── CANVASES ── */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.stars{position:absolute;inset:0;z-index:3;pointer-events:none}\n  canvas.bells{position:absolute;inset:0;z-index:5;pointer-events:none}\n\n  /* ── MIST ── */\n  .mist{\n    position:absolute;\n    bottom:0;left:0;right:0;\n    height:28vh;\n    background:linear-gradient(to top,\n      rgba(240,248,255,0.65) 0%,\n      rgba(200,230,255,0.25) 50%,\n      transparent 100%\n    );\n    z-index:4;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,255,255,0.14);\n    backdrop-filter:blur(20px);\n    -webkit-backdrop-filter:blur(20px);\n    border:1px solid rgba(255,255,255,0.4);\n    border-radius:26px;\n    padding:clamp(22px,3.8vh,48px) clamp(30px,5.5vw,85px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(20,60,140,0.3),\n      0 2px 20px rgba(100,180,255,0.2),\n      inset 0 1px 0 rgba(255,255,255,0.55);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:hidden;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,255,0.2) 0%,\n      rgba(150,210,255,0.08) 50%,\n      rgba(255,255,255,0.05) 100%\n    );\n    border-radius:26px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(30px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── ICON ROW ── */\n  .icon-row{\n    display:flex;align-items:center;gap:1.3vw;\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .icon-emoji{\n    font-size:clamp(22px,3.2vw,46px);\n    animation:iconBounce 2.8s ease-in-out infinite;\n    filter:drop-shadow(0 2px 8px rgba(30,80,200,.4));\n  }\n  .icon-emoji:nth-child(1){animation-delay:0s}\n  .icon-emoji:nth-child(2){animation-delay:.35s}\n  .icon-emoji:nth-child(3){animation-delay:.7s}\n  @keyframes iconBounce{\n    0%,100%{transform:translateY(0) rotate(-4deg)}\n    50%{transform:translateY(-9px) rotate(4deg)}\n  }\n\n  /* ── TOP SCRIPT ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.25vw,16px);\n    letter-spacing:8px;\n    text-transform:uppercase;\n    color:rgba(20,60,140,0.7);\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(40,100,220,.45),transparent);\n  }\n  .div-icon{font-size:clamp(10px,1.3vw,17px);color:rgba(40,100,200,.65)}\n\n  /* ── MAIN WORD ── */\n  .main-word{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(52px,9vw,140px);\n    font-weight:900;\n    line-height:1.15;\n    letter-spacing:6px;\n    padding-top:0.1em;\n    background:linear-gradient(\n      155deg,\n      #0a2a6e 0%,\n      #1a4fbb 18%,\n      #2e8de8 34%,\n      #56c2f5 50%,\n      #1a6fcc 66%,\n      #0d3590 82%,\n      #1a4fbb 100%\n    );\n    background-size:260% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 22px rgba(30,90,220,.35));\n    opacity:0;\n    animation:wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              wordFlow 5s ease-in-out infinite 2.5s;\n    margin-bottom:.4vh;\n  }\n  @keyframes wordReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(15px) drop-shadow(0 4px 22px rgba(30,90,220,.35))}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 22px rgba(30,90,220,.35))}\n  }\n  @keyframes wordFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(13px,2vw,28px);\n    font-weight:700;\n    color:rgba(15,45,120,0.85);\n    letter-spacing:4px;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(100,180,255,.4);\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(180,220,255,0.2);\n    border:1px solid rgba(60,130,220,.3);\n    border-radius:14px;\n    padding:clamp(10px,1.4vh,17px) clamp(16px,2.8vw,38px);\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:70vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(11px,1.4vw,19px);\n    color:rgba(10,35,100,0.9);\n    line-height:1.85;\n    letter-spacing:1px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.05vw,14px);\n    color:rgba(30,80,180,.65);\n    letter-spacing:3px;\n    margin-top:.5vh;\n  }\n\n  /* ── CHURCH BADGE ── */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-12deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n  .church-bg{\n    position:absolute;\n    inset:3px;\n    border-radius:46px;\n    background:rgba(5,12,40,0.9);\n    z-index:1;\n  }\n  .church{\n    position:relative;\n    z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.4vw,19px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.4vw,34px);\n    white-space:nowrap;\n    background:linear-gradient(\n      90deg,\n      #7ee8ff 0%,\n      #ffdd57 18%,\n      #72f5a8 36%,\n      #a259ff 54%,\n      #7ee8ff 72%,\n      #ffdd57 90%,\n      #72f5a8 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:rainbowShift 3s linear infinite;\n    filter:drop-shadow(0 0 6px rgba(100,220,255,.7))\n           drop-shadow(0 0 14px rgba(162,89,255,.5));\n  }\n  @keyframes rainbowShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* sparkles */\n  .church-sparks{position:absolute;inset:0;border-radius:50px;z-index:3;pointer-events:none;overflow:visible}\n  .spark{position:absolute;border-radius:50%;top:50%;left:50%;transform-origin:0 0;width:clamp(4px,.55vw,8px);height:clamp(4px,.55vw,8px)}\n  .spark:nth-child(1){background:#7ee8ff;animation:orbitSpark 2.4s linear infinite 0s}\n  .spark:nth-child(2){background:#ffdd57;animation:orbitSpark 2.4s linear infinite .4s}\n  .spark:nth-child(3){background:#72f5a8;animation:orbitSpark 2.4s linear infinite .8s}\n  .spark:nth-child(4){background:#a259ff;animation:orbitSpark 2.4s linear infinite 1.2s}\n  .spark:nth-child(5){background:#ff6ec7;animation:orbitSpark 2.4s linear infinite 1.6s}\n  .spark:nth-child(6){background:#ffbe00;animation:orbitSpark 2.4s linear infinite 2.0s}\n  @keyframes orbitSpark{\n    0%  {transform:rotate(0deg)   translateX(clamp(22px,3.4vw,46px)) scale(1)}\n    50% {transform:rotate(180deg) translateX(clamp(22px,3.4vw,46px)) scale(1.5)}\n    100%{transform:rotate(360deg) translateX(clamp(22px,3.4vw,46px)) scale(1)}\n  }\n\n  /* ── BOTTOM DECORATION ── */\n  .deco-row{\n    position:absolute;\n    bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;\n    gap:.45vw;overflow:hidden;\n    z-index:11;pointer-events:none;\n  }\n  .deco-item{\n    font-size:clamp(15px,2.3vw,34px);\n    opacity:.5;\n    animation:decoSway 3.2s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .deco-item:nth-child(2n){animation-delay:.5s}\n  .deco-item:nth-child(3n){animation-delay:1s}\n  .deco-item:nth-child(4n){animation-delay:1.5s}\n  @keyframes decoSway{\n    0%,100%{transform:rotate(-6deg)}\n    50%{transform:rotate(6deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(18px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n  <div class=\"bell-glow\"></div>\n\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"stars\" id=\"cStars\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"bells\" id=\"cBells\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <!-- Icon row: megaphone / bell / cross -->\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">📣</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">🔔</span>\n      </div>\n\n      <div class=\"script-top\">கவனியுங்கள் • Please Note</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">📢</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <!-- BIG WORD -->\n      <div class=\"main-word\">அறிவிப்பு</div>\n      <div class=\"subtitle\">Announcement · Information</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\">\n          ❝ உங்கள் கோரிக்கைகளை தேவனுக்கு தெரிவியுங்கள் ❞\n        </div>\n        <div class=\"verse-ref\">— பிலிப்பியர் 4:6</div>\n      </div>\n\n      <!-- CHURCH BADGE -->\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- bottom deco -->\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span>\n  </div>\n\n</div>\n\n<script>\n/* ── LIGHT RAYS (blue tone) ── */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const RAYS=Array.from({length:20},(_,i)=>({\n    angle:(i/20)*Math.PI-Math.PI/2+(Math.random()-.5)*.3,\n    width:2+Math.random()*5,\n    alpha:.035+Math.random()*.07,\n    speed:(.002+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length:.55+Math.random()*.55\n  }));\n  const OX=W*.5,OY=H*-.05;\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.04)*W*r.length+OX;\n      const by=Math.sin(r.angle+.04)*W*r.length+OY;\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(150,210,255,${r.alpha*2})`);\n      g.addColorStop(.4,`rgba(100,180,255,${r.alpha})`);\n      g.addColorStop(1,'rgba(100,180,255,0)');\n      cx.beginPath();cx.moveTo(OX,OY);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── TWINKLING STARS ── */\n(function(){\n  const cv=document.getElementById('cStars');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const STARS=Array.from({length:55},()=>({\n    x:Math.random(),y:Math.random()*.55,\n    r:Math.random()*2.2+.5,\n    phase:Math.random()*Math.PI*2,\n    speed:Math.random()*.025+.012\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    STARS.forEach(s=>{\n      const alpha=.3+.7*(.5+.5*Math.sin(t*s.speed+s.phase));\n      cx.save();\n      cx.globalAlpha=alpha;\n      cx.fillStyle='rgba(200,230,255,1)';\n      cx.shadowColor='rgba(150,210,255,.9)';\n      cx.shadowBlur=s.r*4;\n      cx.beginPath();cx.arc(s.x*W,s.y*H,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING BELL RINGS ── */\n(function(){\n  const cv=document.getElementById('cBells');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  class Ring{\n    constructor(){this.reset(true);}\n    reset(rand){\n      this.x=(0.25+Math.random()*.5)*W;\n      this.y=rand?(Math.random()*H):(H+30);\n      this.vy=-(Math.random()*.6+.25);\n      this.r=Math.random()*18+8;\n      this.maxR=this.r*5;\n      this.alpha=Math.random()*.4+.2;\n      this.growing=true;\n    }\n    update(){\n      this.y+=this.vy;\n      this.r+=.4;\n      this.alpha-=.004;\n      if(this.alpha<=0||this.y<-50)this.reset(false);\n    }\n    draw(cx){\n      cx.save();\n      cx.globalAlpha=Math.max(0,this.alpha);\n      cx.strokeStyle='rgba(100,180,255,0.7)';\n      cx.lineWidth=1.5;\n      cx.shadowColor='rgba(100,200,255,0.5)';\n      cx.shadowBlur=6;\n      cx.beginPath();cx.arc(this.x,this.y,this.r,0,Math.PI*2);cx.stroke();\n      cx.restore();\n    }\n  }\n\n  const rings=Array.from({length:12},()=>new Ring());\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%40===0&&rings.length<18)rings.push(new Ring());\n    rings.forEach(r=>{r.update();r.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>அறிவிப்பு - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── SKY GRADIENT — deep royal blue to golden dawn (announcement feel) ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      170deg,\n      #05102a 0%,\n      #0e2257 12%,\n      #1a4a8a 26%,\n      #2e6db4 40%,\n      #5299d3 54%,\n      #8ac4e8 68%,\n      #c9e8f7 82%,\n      #f0f8ff 92%,\n      #ffffff 100%\n    );\n    z-index:0;\n  }\n\n  /* ── MEGAPHONE / BELL GLOW ── */\n  .bell-glow{\n    position:absolute;\n    top:-10vh;\n    left:50%;\n    transform:translateX(-50%);\n    width:55vw;height:55vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(180,220,255,0.55) 0%,\n      rgba(100,170,255,0.3) 30%,\n      rgba(50,120,220,0.1) 60%,\n      transparent 100%\n    );\n    z-index:1;\n    animation:bellPulse 3.5s ease-in-out infinite;\n  }\n  @keyframes bellPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.8}\n    50%{transform:translateX(-50%) scale(1.08);opacity:1}\n  }\n\n  /* ── CANVASES ── */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.stars{position:absolute;inset:0;z-index:3;pointer-events:none}\n  canvas.bells{position:absolute;inset:0;z-index:5;pointer-events:none}\n\n  /* ── MIST ── */\n  .mist{\n    position:absolute;\n    bottom:0;left:0;right:0;\n    height:28vh;\n    background:linear-gradient(to top,\n      rgba(240,248,255,0.65) 0%,\n      rgba(200,230,255,0.25) 50%,\n      transparent 100%\n    );\n    z-index:4;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,255,255,0.14);\n    backdrop-filter:blur(20px);\n    -webkit-backdrop-filter:blur(20px);\n    border:1px solid rgba(255,255,255,0.4);\n    border-radius:26px;\n    padding:clamp(22px,3.8vh,48px) clamp(30px,5.5vw,85px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(20,60,140,0.3),\n      0 2px 20px rgba(100,180,255,0.2),\n      inset 0 1px 0 rgba(255,255,255,0.55);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:hidden;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,255,0.2) 0%,\n      rgba(150,210,255,0.08) 50%,\n      rgba(255,255,255,0.05) 100%\n    );\n    border-radius:26px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(30px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── ICON ROW ── */\n  .icon-row{\n    display:flex;align-items:center;gap:1.3vw;\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .icon-emoji{\n    font-size:clamp(22px,3.2vw,46px);\n    animation:iconBounce 2.8s ease-in-out infinite;\n    filter:drop-shadow(0 2px 8px rgba(30,80,200,.4));\n  }\n  .icon-emoji:nth-child(1){animation-delay:0s}\n  .icon-emoji:nth-child(2){animation-delay:.35s}\n  .icon-emoji:nth-child(3){animation-delay:.7s}\n  @keyframes iconBounce{\n    0%,100%{transform:translateY(0) rotate(-4deg)}\n    50%{transform:translateY(-9px) rotate(4deg)}\n  }\n\n  /* ── TOP SCRIPT ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.25vw,16px);\n    letter-spacing:8px;\n    text-transform:uppercase;\n    color:rgba(20,60,140,0.7);\n    margin-bottom:1.2vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(40,100,220,.45),transparent);\n  }\n  .div-icon{font-size:clamp(10px,1.3vw,17px);color:rgba(40,100,200,.65)}\n\n  /* ── MAIN WORD ── */\n  .main-word{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(52px,9vw,140px);\n    font-weight:900;\n    line-height:1.15;\n    letter-spacing:6px;\n    padding-top:0.1em;\n    background:linear-gradient(\n      155deg,\n      #0a2a6e 0%,\n      #1a4fbb 18%,\n      #2e8de8 34%,\n      #56c2f5 50%,\n      #1a6fcc 66%,\n      #0d3590 82%,\n      #1a4fbb 100%\n    );\n    background-size:260% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 22px rgba(30,90,220,.35));\n    opacity:0;\n    animation:wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              wordFlow 5s ease-in-out infinite 2.5s;\n    margin-bottom:.4vh;\n  }\n  @keyframes wordReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(15px) drop-shadow(0 4px 22px rgba(30,90,220,.35))}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 22px rgba(30,90,220,.35))}\n  }\n  @keyframes wordFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(13px,2vw,28px);\n    font-weight:700;\n    color:rgba(15,45,120,0.85);\n    letter-spacing:4px;\n    margin-bottom:1.8vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(100,180,255,.4);\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(180,220,255,0.2);\n    border:1px solid rgba(60,130,220,.3);\n    border-radius:14px;\n    padding:clamp(10px,1.4vh,17px) clamp(16px,2.8vw,38px);\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:70vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(11px,1.4vw,19px);\n    color:rgba(10,35,100,0.9);\n    line-height:1.85;\n    letter-spacing:1px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.05vw,14px);\n    color:rgba(30,80,180,.65);\n    letter-spacing:3px;\n    margin-top:.5vh;\n  }\n\n  /* ── CHURCH BADGE ── */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-12deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n  .church-bg{\n    position:absolute;\n    inset:3px;\n    border-radius:46px;\n    background:rgba(5,12,40,0.9);\n    z-index:1;\n  }\n  .church{\n    position:relative;\n    z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.4vw,19px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.4vw,34px);\n    white-space:nowrap;\n    background:linear-gradient(\n      90deg,\n      #7ee8ff 0%,\n      #ffdd57 18%,\n      #72f5a8 36%,\n      #a259ff 54%,\n      #7ee8ff 72%,\n      #ffdd57 90%,\n      #72f5a8 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:rainbowShift 3s linear infinite;\n    filter:drop-shadow(0 0 6px rgba(100,220,255,.7))\n           drop-shadow(0 0 14px rgba(162,89,255,.5));\n  }\n  @keyframes rainbowShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* sparkles */\n  .church-sparks{position:absolute;inset:0;border-radius:50px;z-index:3;pointer-events:none;overflow:visible}\n  .spark{position:absolute;border-radius:50%;top:50%;left:50%;transform-origin:0 0;width:clamp(4px,.55vw,8px);height:clamp(4px,.55vw,8px)}\n  .spark:nth-child(1){background:#7ee8ff;animation:orbitSpark 2.4s linear infinite 0s}\n  .spark:nth-child(2){background:#ffdd57;animation:orbitSpark 2.4s linear infinite .4s}\n  .spark:nth-child(3){background:#72f5a8;animation:orbitSpark 2.4s linear infinite .8s}\n  .spark:nth-child(4){background:#a259ff;animation:orbitSpark 2.4s linear infinite 1.2s}\n  .spark:nth-child(5){background:#ff6ec7;animation:orbitSpark 2.4s linear infinite 1.6s}\n  .spark:nth-child(6){background:#ffbe00;animation:orbitSpark 2.4s linear infinite 2.0s}\n  @keyframes orbitSpark{\n    0%  {transform:rotate(0deg)   translateX(clamp(22px,3.4vw,46px)) scale(1)}\n    50% {transform:rotate(180deg) translateX(clamp(22px,3.4vw,46px)) scale(1.5)}\n    100%{transform:rotate(360deg) translateX(clamp(22px,3.4vw,46px)) scale(1)}\n  }\n\n  /* ── BOTTOM DECORATION ── */\n  .deco-row{\n    position:absolute;\n    bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;\n    gap:.45vw;overflow:hidden;\n    z-index:11;pointer-events:none;\n  }\n  .deco-item{\n    font-size:clamp(15px,2.3vw,34px);\n    opacity:.5;\n    animation:decoSway 3.2s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .deco-item:nth-child(2n){animation-delay:.5s}\n  .deco-item:nth-child(3n){animation-delay:1s}\n  .deco-item:nth-child(4n){animation-delay:1.5s}\n  @keyframes decoSway{\n    0%,100%{transform:rotate(-6deg)}\n    50%{transform:rotate(6deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(18px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n  <div class=\"bell-glow\"></div>\n\n  <canvas class=\"rays\" id=\"cRays\"></canvas>\n  <canvas class=\"stars\" id=\"cStars\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"bells\" id=\"cBells\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <!-- Icon row: megaphone / bell / cross -->\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">📣</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">🔔</span>\n      </div>\n\n      <div class=\"script-top\">கவனியுங்கள் • Please Note</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">📢</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <!-- BIG WORD -->\n      <div class=\"main-word\">அறிவிப்பு</div>\n      <div class=\"subtitle\">Announcement · Information</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\"><br>          ❝ உங்கள் கோரிக்கைகளை தேவனுக்கு தெரிவியுங்கள் ❞<br></div>\n        <div class=\"verse-ref\">— பிலிப்பியர் 4:6</div>\n      </div>\n\n      <!-- CHURCH BADGE -->\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- bottom deco -->\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">🌟</span>\n    <span class=\"deco-item\">⭐</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">⭐</span>\n  </div>\n\n</div>\n\n<script>\n/* ── LIGHT RAYS (blue tone) ── */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const RAYS=Array.from({length:20},(_,i)=>({\n    angle:(i/20)*Math.PI-Math.PI/2+(Math.random()-.5)*.3,\n    width:2+Math.random()*5,\n    alpha:.035+Math.random()*.07,\n    speed:(.002+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length:.55+Math.random()*.55\n  }));\n  const OX=W*.5,OY=H*-.05;\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.04)*W*r.length+OX;\n      const by=Math.sin(r.angle+.04)*W*r.length+OY;\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(150,210,255,${r.alpha*2})`);\n      g.addColorStop(.4,`rgba(100,180,255,${r.alpha})`);\n      g.addColorStop(1,'rgba(100,180,255,0)');\n      cx.beginPath();cx.moveTo(OX,OY);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── TWINKLING STARS ── */\n(function(){\n  const cv=document.getElementById('cStars');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const STARS=Array.from({length:55},()=>({\n    x:Math.random(),y:Math.random()*.55,\n    r:Math.random()*2.2+.5,\n    phase:Math.random()*Math.PI*2,\n    speed:Math.random()*.025+.012\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    STARS.forEach(s=>{\n      const alpha=.3+.7*(.5+.5*Math.sin(t*s.speed+s.phase));\n      cx.save();\n      cx.globalAlpha=alpha;\n      cx.fillStyle='rgba(200,230,255,1)';\n      cx.shadowColor='rgba(150,210,255,.9)';\n      cx.shadowBlur=s.r*4;\n      cx.beginPath();cx.arc(s.x*W,s.y*H,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING BELL RINGS ── */\n(function(){\n  const cv=document.getElementById('cBells');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  class Ring{\n    constructor(){this.reset(true);}\n    reset(rand){\n      this.x=(0.25+Math.random()*.5)*W;\n      this.y=rand?(Math.random()*H):(H+30);\n      this.vy=-(Math.random()*.6+.25);\n      this.r=Math.random()*18+8;\n      this.maxR=this.r*5;\n      this.alpha=Math.random()*.4+.2;\n      this.growing=true;\n    }\n    update(){\n      this.y+=this.vy;\n      this.r+=.4;\n      this.alpha-=.004;\n      if(this.alpha<=0||this.y<-50)this.reset(false);\n    }\n    draw(cx){\n      cx.save();\n      cx.globalAlpha=Math.max(0,this.alpha);\n      cx.strokeStyle='rgba(100,180,255,0.7)';\n      cx.lineWidth=1.5;\n      cx.shadowColor='rgba(100,200,255,0.5)';\n      cx.shadowBlur=6;\n      cx.beginPath();cx.arc(this.x,this.y,this.r,0,Math.PI*2);cx.stroke();\n      cx.restore();\n    }\n  }\n\n  const rings=Array.from({length:12},()=>new Ring());\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%40===0&&rings.length<18)rings.push(new Ring());\n    rings.forEach(r=>{r.update();r.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1774106221452.1304,
      "type": "html",
      "name": "BDay",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>ஜெப நேரம் — பிறந்தநாள் & திருமண நாள்</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cinzel+Decorative:wght@700;900&family=Great+Vibes&display=swap\" rel=\"stylesheet\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nhtml, body {\n  width: 100%; height: 100%;\n  overflow: hidden;\n  background: #000;\n  font-family: 'Noto Serif Tamil', serif;\n}\n\n.slide {\n  width: 100vw; height: 100vh;\n  position: relative;\n  background: radial-gradient(ellipse at 30% 40%, #12000a 0%, #0a0005 40%, #000000 100%);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── Particle canvas ── */\n#particles { position: absolute; inset: 0; z-index: 1; }\n\n/* ── Ambient glow blobs ── */\n.blob {\n  position: absolute;\n  border-radius: 50%;\n  filter: blur(80px);\n  z-index: 2;\n  animation: blobPulse 5s ease-in-out infinite;\n}\n.blob1 { width: 50vw; height: 50vh; background: rgba(180,20,80,0.18); top: -10vh; left: -10vw; animation-delay: 0s; }\n.blob2 { width: 40vw; height: 40vh; background: rgba(212,160,23,0.15); bottom: -5vh; right: -5vw; animation-delay: 2s; }\n.blob3 { width: 30vw; height: 30vh; background: rgba(255,80,120,0.1); top: 30vh; left: 35vw; animation-delay: 3.5s; }\n\n@keyframes blobPulse {\n  0%,100% { transform: scale(1); opacity: 0.8; }\n  50% { transform: scale(1.15); opacity: 1; }\n}\n\n/* ── Golden border lines ── */\n.line-top, .line-bottom {\n  position: absolute;\n  width: 80%; height: 1.5px;\n  left: 10%; z-index: 5;\n  background: linear-gradient(90deg, transparent, #c8952a, #f5d97a, #fff5c0, #f5d97a, #c8952a, transparent);\n  transform: scaleX(0);\n  transform-origin: center;\n  animation: lineExpand 1.2s cubic-bezier(0.4,0,0.2,1) forwards;\n}\n.line-top { top: 12vh; animation-delay: 0.2s; }\n.line-bottom { bottom: 12vh; animation-delay: 0.4s; }\n\n.line-top::before, .line-top::after,\n.line-bottom::before, .line-bottom::after {\n  content: '◆';\n  position: absolute;\n  top: -9px;\n  font-size: 14px;\n  color: #f5d97a;\n  text-shadow: 0 0 12px #ffd700, 0 0 24px #ffd700;\n}\n.line-top::before, .line-bottom::before { left: -7px; }\n.line-top::after, .line-bottom::after { right: -7px; }\n\n@keyframes lineExpand { to { transform: scaleX(1); } }\n\n/* ── Corner ornaments ── */\n.corner {\n  position: absolute;\n  width: clamp(55px, 6vw, 90px);\n  height: clamp(55px, 6vw, 90px);\n  z-index: 5;\n  opacity: 0;\n  animation: fadeIn 1s ease forwards 1.2s;\n}\n.corner svg { width: 100%; height: 100%; }\n.tl { top: 18px; left: 18px; }\n.tr { top: 18px; right: 18px; transform: scaleX(-1); }\n.bl { bottom: 18px; left: 18px; transform: scaleY(-1); }\n.br { bottom: 18px; right: 18px; transform: scale(-1,-1); }\n\n/* ── Floating icons row ── */\n.icons-row {\n  position: relative; z-index: 6;\n  display: flex; gap: 3vw;\n  align-items: center;\n  margin-bottom: 2.5vh;\n  opacity: 0;\n  animation: dropIn 1s cubic-bezier(0.34,1.56,0.64,1) forwards 0.5s;\n}\n\n.icon-wrap {\n  position: relative;\n  display: flex; flex-direction: column; align-items: center;\n}\n\n.icon-emoji {\n  font-size: clamp(36px, 5.5vw, 72px);\n  filter: drop-shadow(0 0 14px rgba(255,120,160,0.9)) drop-shadow(0 0 30px rgba(255,80,120,0.5));\n  animation: iconFloat 3s ease-in-out infinite;\n}\n.icon-emoji.rings {\n  filter: drop-shadow(0 0 14px rgba(255,215,0,0.9)) drop-shadow(0 0 30px rgba(255,180,0,0.5));\n  animation-delay: 1s;\n}\n\n@keyframes iconFloat {\n  0%,100% { transform: translateY(0); }\n  50% { transform: translateY(-8px); }\n}\n\n.divider-dot {\n  font-size: clamp(20px, 2.5vw, 36px);\n  color: #f5d97a;\n  opacity: 0.5;\n}\n\n/* ── Main heading ── */\n.heading {\n  position: relative; z-index: 6;\n  text-align: center;\n  padding: 0 8vw;\n  opacity: 0;\n  animation: revealBlur 1.3s cubic-bezier(0.22,1,0.36,1) forwards 0.8s;\n}\n\n@keyframes revealBlur {\n  from { opacity:0; transform: scale(0.88) translateY(24px); filter: blur(10px); }\n  to   { opacity:1; transform: scale(1) translateY(0); filter: blur(0); }\n}\n\n.heading-sub {\n  font-family: 'Cinzel Decorative', serif;\n  font-size: clamp(9px, 1.1vw, 15px);\n  letter-spacing: 10px;\n  color: #c8952a;\n  text-transform: uppercase;\n  margin-bottom: 1.2vh;\n}\n\n.heading-main {\n  font-size: clamp(32px, 5.5vw, 78px);\n  font-weight: 900;\n  line-height: 1.15;\n  background: linear-gradient(180deg, #fff5c0 0%, #f5d97a 30%, #e87fa0 60%, #c0305a 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  filter: drop-shadow(0 4px 20px rgba(255,100,140,0.4));\n  letter-spacing: 2px;\n}\n\n.heading-eng {\n  font-family: 'Great Vibes', cursive;\n  font-size: clamp(22px, 3.2vw, 48px);\n  color: rgba(245,217,122,0.6);\n  margin-top: 0.5vh;\n  letter-spacing: 3px;\n}\n\n/* ── Invitation strip ── */\n.invite-strip {\n  position: relative; z-index: 6;\n  margin-top: 3vh;\n  padding: 1.4vh 4vw;\n  border: 1px solid rgba(245,217,122,0.3);\n  border-radius: 4px;\n  background: rgba(255,255,255,0.03);\n  backdrop-filter: blur(4px);\n  text-align: center;\n  opacity: 0;\n  animation: fadeUp 1s ease forwards 1.5s;\n  max-width: 80vw;\n}\n\n.invite-strip::before, .invite-strip::after {\n  content: '';\n  position: absolute;\n  left: 0; right: 0;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(255,120,160,0.6), transparent);\n}\n.invite-strip::before { top: 0; }\n.invite-strip::after  { bottom: 0; }\n\n.invite-text {\n  font-size: clamp(12px, 1.6vw, 22px);\n  color: #f5d97a;\n  letter-spacing: 1.5px;\n  line-height: 1.7;\n}\n.invite-highlight {\n  color: #ff8fb0;\n  font-weight: 700;\n  text-shadow: 0 0 12px rgba(255,80,120,0.7);\n}\n\n/* ── Prayer call ── */\n.prayer-call {\n  position: relative; z-index: 6;\n  margin-top: 2.5vh;\n  display: flex;\n  align-items: center;\n  gap: 1.2vw;\n  opacity: 0;\n  animation: fadeUp 1s ease forwards 1.9s;\n}\n\n.prayer-hands {\n  font-size: clamp(20px, 2.8vw, 40px);\n  animation: handsWave 2.5s ease-in-out infinite;\n}\n\n@keyframes handsWave {\n  0%,100% { transform: rotate(-5deg) scale(1); }\n  50% { transform: rotate(5deg) scale(1.1); }\n}\n\n.prayer-text {\n  font-size: clamp(11px, 1.3vw, 18px);\n  color: rgba(245,217,122,0.65);\n  letter-spacing: 2px;\n  font-style: italic;\n}\n\n/* ── Confetti hearts & stars ── */\n.confetti-piece {\n  position: absolute;\n  z-index: 3;\n  font-size: clamp(12px, 1.6vw, 22px);\n  animation: confettiFall linear infinite;\n  opacity: 0;\n}\n\n@keyframes confettiFall {\n  0%   { transform: translateY(-5vh) rotate(0deg); opacity: 0; }\n  10%  { opacity: 1; }\n  90%  { opacity: 0.7; }\n  100% { transform: translateY(105vh) rotate(720deg); opacity: 0; }\n}\n\n/* ── Shimmer sweep on heading ── */\n.heading::after {\n  content: '';\n  position: absolute;\n  top: 0; left: -200%;\n  width: 60%; height: 100%;\n  background: linear-gradient(110deg, transparent 30%, rgba(255,255,220,0.18) 50%, transparent 70%);\n  animation: shimmer 5s ease-in-out infinite;\n  animation-delay: 2.5s;\n  pointer-events: none;\n}\n@keyframes shimmer {\n  0%   { left: -200%; }\n  60%  { left: 200%; }\n  100% { left: 200%; }\n}\n\n/* ── Candles ── */\n.candle {\n  position: absolute;\n  z-index: 4;\n  font-size: clamp(28px, 3.5vw, 52px);\n  opacity: 0;\n  animation: candleAppear 1s ease forwards 1.4s;\n}\n.candle.left  { left: 5vw;  top: 50%; transform: translateY(-50%); }\n.candle.right { right: 5vw; top: 50%; transform: translateY(-50%); animation-delay: 1.5s; }\n\n@keyframes candleAppear {\n  from { opacity:0; transform: translateY(calc(-50% + 12px)); }\n  to   { opacity:1; transform: translateY(-50%); }\n}\n\n.flame {\n  display: inline-block;\n  animation: flicker 1.1s ease-in-out infinite alternate;\n  filter: drop-shadow(0 0 10px #ff4400) drop-shadow(0 0 22px #ff8800);\n}\n@keyframes flicker {\n  0%   { transform: rotate(-4deg) scaleY(1); }\n  100% { transform: rotate(4deg) scaleY(1.12); }\n}\n\n/* ── Utilities ── */\n@keyframes dropIn {\n  from { opacity:0; transform: translateY(-30px) scale(0.7); }\n  to   { opacity:1; transform: translateY(0) scale(1); }\n}\n@keyframes fadeUp {\n  from { opacity:0; transform: translateY(18px); }\n  to   { opacity:1; transform: translateY(0); }\n}\n@keyframes fadeIn {\n  to { opacity:1; }\n}\n</style>\n</head>\n<body>\n<div class=\"slide\">\n\n  <canvas id=\"particles\"></canvas>\n\n  <!-- Ambient blobs -->\n  <div class=\"blob blob1\"></div>\n  <div class=\"blob blob2\"></div>\n  <div class=\"blob blob3\"></div>\n\n  <!-- Confetti generated by JS -->\n  <div id=\"confettiBox\"></div>\n\n  <!-- Gold lines -->\n  <div class=\"line-top\"></div>\n  <div class=\"line-bottom\"></div>\n\n  <!-- Corners -->\n  <div class=\"corner tl\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg1)\" stroke-width=\"2\"/>\n      <path d=\"M5 5L25 25\" stroke=\"url(#cg1)\" stroke-width=\"1.5\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <circle cx=\"5\" cy=\"75\" r=\"3\" fill=\"#c8952a\"/>\n      <circle cx=\"75\" cy=\"5\" r=\"3\" fill=\"#c8952a\"/>\n      <defs><linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n  <div class=\"corner tr\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg2)\" stroke-width=\"2\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <defs><linearGradient id=\"cg2\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n  <div class=\"corner bl\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg3)\" stroke-width=\"2\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <defs><linearGradient id=\"cg3\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n  <div class=\"corner br\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg4)\" stroke-width=\"2\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <defs><linearGradient id=\"cg4\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n\n  <!-- Icons -->\n  <div class=\"icons-row\">\n    <div class=\"icon-wrap\">\n      <span class=\"icon-emoji\">🎂</span>\n    </div>\n    <span class=\"divider-dot\">✦</span>\n    <div class=\"icon-wrap\">\n      <span class=\"icon-emoji rings\">💍</span>\n    </div>\n  </div>\n\n  <!-- Heading -->\n  <div class=\"heading\">\n    <div class=\"heading-sub\">Special Blessing Time</div>\n    <div class=\"heading-main\">பிறந்தநாள் & திருமண நாள்</div>\n    <div class=\"heading-eng\">Birthday & Wedding Anniversary</div>\n  </div>\n\n  <!-- Invite strip -->\n  <div class=\"invite-strip\">\n    <div class=\"invite-text\">\n      இந்த வாரம் / இன்று <span class=\"invite-highlight\">பிறந்தநாள்</span> அல்லது <span class=\"invite-highlight\">திருமண நாள்</span> உள்ளவர்கள்<br>\n      தயவுசெய்து எழுந்து நிற்கவும் — நாம் உங்களுக்காக ஜெபிப்போம்!\n    </div>\n  </div>\n\n  <!-- Prayer call -->\n  <div class=\"prayer-call\">\n    <span class=\"prayer-hands\">🙏</span>\n    <span class=\"prayer-text\">❝ கர்த்தர் உங்களை ஆசீர்வதிப்பார் ❞</span>\n    <span class=\"prayer-hands\">🙏</span>\n  </div>\n\n</div>\n\n<script>\n/* ── Particles ── */\nconst canvas = document.getElementById('particles');\nconst ctx = canvas.getContext('2d');\n\nfunction resize() { canvas.width = innerWidth; canvas.height = innerHeight; }\nresize();\nwindow.addEventListener('resize', resize);\n\nconst pts = Array.from({length: 180}, () => ({\n  x: Math.random() * innerWidth,\n  y: Math.random() * innerHeight,\n  r: Math.random() * 2 + 0.4,\n  dx: (Math.random() - 0.5) * 0.35,\n  dy: -Math.random() * 0.5 - 0.1,\n  alpha: Math.random(),\n  aDir: Math.random() > 0.5 ? 0.007 : -0.007,\n  pink: Math.random() > 0.55\n}));\n\n(function loop() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  pts.forEach(p => {\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);\n    ctx.fillStyle = p.pink\n      ? `rgba(255,140,180,${p.alpha * 0.7})`\n      : `rgba(245,217,122,${p.alpha})`;\n    ctx.fill();\n    p.x += p.dx; p.y += p.dy;\n    p.alpha += p.aDir;\n    if (p.alpha >= 1 || p.alpha <= 0) p.aDir *= -1;\n    if (p.y < -5) p.y = canvas.height + 5;\n    if (p.x < -5) p.x = canvas.width + 5;\n    if (p.x > canvas.width + 5) p.x = -5;\n  });\n  requestAnimationFrame(loop);\n})();\n\n/* ── Confetti ── */\nconst confettiSymbols = ['🎉','✨','💛','💖','🌟','🎊','❤️','🌸','⭐','💕'];\nconst box = document.getElementById('confettiBox');\nconst COUNT = 28;\n\nfor (let i = 0; i < COUNT; i++) {\n  const el = document.createElement('div');\n  el.className = 'confetti-piece';\n  el.textContent = confettiSymbols[Math.floor(Math.random() * confettiSymbols.length)];\n  el.style.left = Math.random() * 100 + 'vw';\n  const dur = 5 + Math.random() * 7;\n  el.style.animationDuration = dur + 's';\n  el.style.animationDelay = (Math.random() * 6) + 's';\n  el.style.fontSize = (14 + Math.random() * 22) + 'px';\n  box.appendChild(el);\n}\n</script>\n</body>\n</html>\n",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>ஜெப நேரம் — பிறந்தநாள் & திருமண நாள்</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cinzel+Decorative:wght@700;900&family=Great+Vibes&display=swap\" rel=\"stylesheet\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nhtml, body {\n  width: 100%; height: 100%;\n  overflow: hidden;\n  background: #000;\n  font-family: 'Noto Serif Tamil', serif;\n}\n\n.slide {\n  width: 100vw; height: 100vh;\n  position: relative;\n  background: radial-gradient(ellipse at 30% 40%, #12000a 0%, #0a0005 40%, #000000 100%);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── Particle canvas ── */\n#particles { position: absolute; inset: 0; z-index: 1; }\n\n/* ── Ambient glow blobs ── */\n.blob {\n  position: absolute;\n  border-radius: 50%;\n  filter: blur(80px);\n  z-index: 2;\n  animation: blobPulse 5s ease-in-out infinite;\n}\n.blob1 { width: 50vw; height: 50vh; background: rgba(180,20,80,0.18); top: -10vh; left: -10vw; animation-delay: 0s; }\n.blob2 { width: 40vw; height: 40vh; background: rgba(212,160,23,0.15); bottom: -5vh; right: -5vw; animation-delay: 2s; }\n.blob3 { width: 30vw; height: 30vh; background: rgba(255,80,120,0.1); top: 30vh; left: 35vw; animation-delay: 3.5s; }\n\n@keyframes blobPulse {\n  0%,100% { transform: scale(1); opacity: 0.8; }\n  50% { transform: scale(1.15); opacity: 1; }\n}\n\n/* ── Golden border lines ── */\n.line-top, .line-bottom {\n  position: absolute;\n  width: 80%; height: 1.5px;\n  left: 10%; z-index: 5;\n  background: linear-gradient(90deg, transparent, #c8952a, #f5d97a, #fff5c0, #f5d97a, #c8952a, transparent);\n  transform: scaleX(0);\n  transform-origin: center;\n  animation: lineExpand 1.2s cubic-bezier(0.4,0,0.2,1) forwards;\n}\n.line-top { top: 12vh; animation-delay: 0.2s; }\n.line-bottom { bottom: 12vh; animation-delay: 0.4s; }\n\n.line-top::before, .line-top::after,\n.line-bottom::before, .line-bottom::after {\n  content: '◆';\n  position: absolute;\n  top: -9px;\n  font-size: 14px;\n  color: #f5d97a;\n  text-shadow: 0 0 12px #ffd700, 0 0 24px #ffd700;\n}\n.line-top::before, .line-bottom::before { left: -7px; }\n.line-top::after, .line-bottom::after { right: -7px; }\n\n@keyframes lineExpand { to { transform: scaleX(1); } }\n\n/* ── Corner ornaments ── */\n.corner {\n  position: absolute;\n  width: clamp(55px, 6vw, 90px);\n  height: clamp(55px, 6vw, 90px);\n  z-index: 5;\n  opacity: 0;\n  animation: fadeIn 1s ease forwards 1.2s;\n}\n.corner svg { width: 100%; height: 100%; }\n.tl { top: 18px; left: 18px; }\n.tr { top: 18px; right: 18px; transform: scaleX(-1); }\n.bl { bottom: 18px; left: 18px; transform: scaleY(-1); }\n.br { bottom: 18px; right: 18px; transform: scale(-1,-1); }\n\n/* ── Floating icons row ── */\n.icons-row {\n  position: relative; z-index: 6;\n  display: flex; gap: 3vw;\n  align-items: center;\n  margin-bottom: 2.5vh;\n  opacity: 0;\n  animation: dropIn 1s cubic-bezier(0.34,1.56,0.64,1) forwards 0.5s;\n}\n\n.icon-wrap {\n  position: relative;\n  display: flex; flex-direction: column; align-items: center;\n}\n\n.icon-emoji {\n  font-size: clamp(36px, 5.5vw, 72px);\n  filter: drop-shadow(0 0 14px rgba(255,120,160,0.9)) drop-shadow(0 0 30px rgba(255,80,120,0.5));\n  animation: iconFloat 3s ease-in-out infinite;\n}\n.icon-emoji.rings {\n  filter: drop-shadow(0 0 14px rgba(255,215,0,0.9)) drop-shadow(0 0 30px rgba(255,180,0,0.5));\n  animation-delay: 1s;\n}\n\n@keyframes iconFloat {\n  0%,100% { transform: translateY(0); }\n  50% { transform: translateY(-8px); }\n}\n\n.divider-dot {\n  font-size: clamp(20px, 2.5vw, 36px);\n  color: #f5d97a;\n  opacity: 0.5;\n}\n\n/* ── Main heading ── */\n.heading {\n  position: relative; z-index: 6;\n  text-align: center;\n  padding: 0 8vw;\n  opacity: 0;\n  animation: revealBlur 1.3s cubic-bezier(0.22,1,0.36,1) forwards 0.8s;\n}\n\n@keyframes revealBlur {\n  from { opacity:0; transform: scale(0.88) translateY(24px); filter: blur(10px); }\n  to   { opacity:1; transform: scale(1) translateY(0); filter: blur(0); }\n}\n\n.heading-sub {\n  font-family: 'Cinzel Decorative', serif;\n  font-size: clamp(9px, 1.1vw, 15px);\n  letter-spacing: 10px;\n  color: #c8952a;\n  text-transform: uppercase;\n  margin-bottom: 1.2vh;\n}\n\n.heading-main {\n  font-size: clamp(32px, 5.5vw, 78px);\n  font-weight: 900;\n  line-height: 1.15;\n  background: linear-gradient(180deg, #fff5c0 0%, #f5d97a 30%, #e87fa0 60%, #c0305a 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  filter: drop-shadow(0 4px 20px rgba(255,100,140,0.4));\n  letter-spacing: 2px;\n}\n\n.heading-eng {\n  font-family: 'Great Vibes', cursive;\n  font-size: clamp(22px, 3.2vw, 48px);\n  color: rgba(245,217,122,0.6);\n  margin-top: 0.5vh;\n  letter-spacing: 3px;\n}\n\n/* ── Invitation strip ── */\n.invite-strip {\n  position: relative; z-index: 6;\n  margin-top: 3vh;\n  padding: 1.4vh 4vw;\n  border: 1px solid rgba(245,217,122,0.3);\n  border-radius: 4px;\n  background: rgba(255,255,255,0.03);\n  backdrop-filter: blur(4px);\n  text-align: center;\n  opacity: 0;\n  animation: fadeUp 1s ease forwards 1.5s;\n  max-width: 80vw;\n}\n\n.invite-strip::before, .invite-strip::after {\n  content: '';\n  position: absolute;\n  left: 0; right: 0;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(255,120,160,0.6), transparent);\n}\n.invite-strip::before { top: 0; }\n.invite-strip::after  { bottom: 0; }\n\n.invite-text {\n  font-size: clamp(12px, 1.6vw, 22px);\n  color: #f5d97a;\n  letter-spacing: 1.5px;\n  line-height: 1.7;\n}\n.invite-highlight {\n  color: #ff8fb0;\n  font-weight: 700;\n  text-shadow: 0 0 12px rgba(255,80,120,0.7);\n}\n\n/* ── Prayer call ── */\n.prayer-call {\n  position: relative; z-index: 6;\n  margin-top: 2.5vh;\n  display: flex;\n  align-items: center;\n  gap: 1.2vw;\n  opacity: 0;\n  animation: fadeUp 1s ease forwards 1.9s;\n}\n\n.prayer-hands {\n  font-size: clamp(20px, 2.8vw, 40px);\n  animation: handsWave 2.5s ease-in-out infinite;\n}\n\n@keyframes handsWave {\n  0%,100% { transform: rotate(-5deg) scale(1); }\n  50% { transform: rotate(5deg) scale(1.1); }\n}\n\n.prayer-text {\n  font-size: clamp(11px, 1.3vw, 18px);\n  color: rgba(245,217,122,0.65);\n  letter-spacing: 2px;\n  font-style: italic;\n}\n\n/* ── Confetti hearts & stars ── */\n.confetti-piece {\n  position: absolute;\n  z-index: 3;\n  font-size: clamp(12px, 1.6vw, 22px);\n  animation: confettiFall linear infinite;\n  opacity: 0;\n}\n\n@keyframes confettiFall {\n  0%   { transform: translateY(-5vh) rotate(0deg); opacity: 0; }\n  10%  { opacity: 1; }\n  90%  { opacity: 0.7; }\n  100% { transform: translateY(105vh) rotate(720deg); opacity: 0; }\n}\n\n/* ── Shimmer sweep on heading ── */\n.heading::after {\n  content: '';\n  position: absolute;\n  top: 0; left: -200%;\n  width: 60%; height: 100%;\n  background: linear-gradient(110deg, transparent 30%, rgba(255,255,220,0.18) 50%, transparent 70%);\n  animation: shimmer 5s ease-in-out infinite;\n  animation-delay: 2.5s;\n  pointer-events: none;\n}\n@keyframes shimmer {\n  0%   { left: -200%; }\n  60%  { left: 200%; }\n  100% { left: 200%; }\n}\n\n/* ── Candles ── */\n.candle {\n  position: absolute;\n  z-index: 4;\n  font-size: clamp(28px, 3.5vw, 52px);\n  opacity: 0;\n  animation: candleAppear 1s ease forwards 1.4s;\n}\n.candle.left  { left: 5vw;  top: 50%; transform: translateY(-50%); }\n.candle.right { right: 5vw; top: 50%; transform: translateY(-50%); animation-delay: 1.5s; }\n\n@keyframes candleAppear {\n  from { opacity:0; transform: translateY(calc(-50% + 12px)); }\n  to   { opacity:1; transform: translateY(-50%); }\n}\n\n.flame {\n  display: inline-block;\n  animation: flicker 1.1s ease-in-out infinite alternate;\n  filter: drop-shadow(0 0 10px #ff4400) drop-shadow(0 0 22px #ff8800);\n}\n@keyframes flicker {\n  0%   { transform: rotate(-4deg) scaleY(1); }\n  100% { transform: rotate(4deg) scaleY(1.12); }\n}\n\n/* ── Utilities ── */\n@keyframes dropIn {\n  from { opacity:0; transform: translateY(-30px) scale(0.7); }\n  to   { opacity:1; transform: translateY(0) scale(1); }\n}\n@keyframes fadeUp {\n  from { opacity:0; transform: translateY(18px); }\n  to   { opacity:1; transform: translateY(0); }\n}\n@keyframes fadeIn {\n  to { opacity:1; }\n}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"slide\">\n\n  <canvas id=\"particles\"></canvas>\n\n  <!-- Ambient blobs -->\n  <div class=\"blob blob1\"></div>\n  <div class=\"blob blob2\"></div>\n  <div class=\"blob blob3\"></div>\n\n  <!-- Confetti generated by JS -->\n  <div id=\"confettiBox\"></div>\n\n  <!-- Gold lines -->\n  <div class=\"line-top\"></div>\n  <div class=\"line-bottom\"></div>\n\n  <!-- Corners -->\n  <div class=\"corner tl\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg1)\" stroke-width=\"2\"/>\n      <path d=\"M5 5L25 25\" stroke=\"url(#cg1)\" stroke-width=\"1.5\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <circle cx=\"5\" cy=\"75\" r=\"3\" fill=\"#c8952a\"/>\n      <circle cx=\"75\" cy=\"5\" r=\"3\" fill=\"#c8952a\"/>\n      <defs><linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n  <div class=\"corner tr\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg2)\" stroke-width=\"2\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <defs><linearGradient id=\"cg2\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n  <div class=\"corner bl\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg3)\" stroke-width=\"2\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <defs><linearGradient id=\"cg3\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n  <div class=\"corner br\">\n    <svg viewBox=\"0 0 80 80\" fill=\"none\">\n      <path d=\"M5 75L5 5L75 5\" stroke=\"url(#cg4)\" stroke-width=\"2\"/>\n      <circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"#f5d97a\"/>\n      <defs><linearGradient id=\"cg4\" x1=\"0\" y1=\"0\" x2=\"80\" y2=\"80\">\n        <stop offset=\"0%\" stop-color=\"#f5d97a\"/><stop offset=\"100%\" stop-color=\"#c8952a\"/>\n      </linearGradient></defs>\n    </svg>\n  </div>\n\n  <!-- Icons -->\n  <div class=\"icons-row\">\n    <div class=\"icon-wrap\">\n      <span class=\"icon-emoji\">🎂</span>\n    </div>\n    <span class=\"divider-dot\">✦</span>\n    <div class=\"icon-wrap\">\n      <span class=\"icon-emoji rings\">💍</span>\n    </div>\n  </div>\n\n  <!-- Heading -->\n  <div class=\"heading\">\n    <div class=\"heading-sub\">Special Blessing Time</div>\n    <div class=\"heading-main\">பிறந்தநாள் & திருமண நாள்</div>\n    <div class=\"heading-eng\">Birthday & Wedding Anniversary</div>\n  </div>\n\n  <!-- Invite strip -->\n  <div class=\"invite-strip\">\n    <div class=\"invite-text\">\n      இந்த வாரம் / இன்று <span class=\"invite-highlight\">பிறந்தநாள்</span> அல்லது <span class=\"invite-highlight\">திருமண நாள்</span> உள்ளவர்கள்<br>\n      தயவுசெய்து எழுந்து நிற்கவும் — நாம் உங்களுக்காக ஜெபிப்போம்!\n    </div>\n  </div>\n\n  <!-- Prayer call -->\n  <div class=\"prayer-call\">\n    <span class=\"prayer-hands\">🙏</span>\n    <span class=\"prayer-text\">❝ கர்த்தர் உங்களை ஆசீர்வதிப்பார் ❞</span>\n    <span class=\"prayer-hands\">🙏</span>\n  </div>\n\n</div>\n\n<script>\n/* ── Particles ── */\nconst canvas = document.getElementById('particles');\nconst ctx = canvas.getContext('2d');\n\nfunction resize() { canvas.width = innerWidth; canvas.height = innerHeight; }\nresize();\nwindow.addEventListener('resize', resize);\n\nconst pts = Array.from({length: 180}, () => ({\n  x: Math.random() * innerWidth,\n  y: Math.random() * innerHeight,\n  r: Math.random() * 2 + 0.4,\n  dx: (Math.random() - 0.5) * 0.35,\n  dy: -Math.random() * 0.5 - 0.1,\n  alpha: Math.random(),\n  aDir: Math.random() > 0.5 ? 0.007 : -0.007,\n  pink: Math.random() > 0.55\n}));\n\n(function loop() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  pts.forEach(p => {\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);\n    ctx.fillStyle = p.pink\n      ? `rgba(255,140,180,${p.alpha * 0.7})`\n      : `rgba(245,217,122,${p.alpha})`;\n    ctx.fill();\n    p.x += p.dx; p.y += p.dy;\n    p.alpha += p.aDir;\n    if (p.alpha >= 1 || p.alpha <= 0) p.aDir *= -1;\n    if (p.y < -5) p.y = canvas.height + 5;\n    if (p.x < -5) p.x = canvas.width + 5;\n    if (p.x > canvas.width + 5) p.x = -5;\n  });\n  requestAnimationFrame(loop);\n})();\n\n/* ── Confetti ── */\nconst confettiSymbols = ['🎉','✨','💛','💖','🌟','🎊','❤️','🌸','⭐','💕'];\nconst box = document.getElementById('confettiBox');\nconst COUNT = 28;\n\nfor (let i = 0; i < COUNT; i++) {\n  const el = document.createElement('div');\n  el.className = 'confetti-piece';\n  el.textContent = confettiSymbols[Math.floor(Math.random() * confettiSymbols.length)];\n  el.style.left = Math.random() * 100 + 'vw';\n  const dur = 5 + Math.random() * 7;\n  el.style.animationDuration = dur + 's';\n  el.style.animationDelay = (Math.random() * 6) + 's';\n  el.style.fontSize = (14 + Math.random() * 22) + 'px';\n  box.appendChild(el);\n}\n</script>\n</body>\n</html>\n"
    },
    {
      "id": 1774107463465.8792,
      "type": "html",
      "name": "Offering",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>காணிக்கை - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── WARM HARVEST SKY — deep olive → amber → golden cream ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      168deg,\n      #1a1200 0%,\n      #3b2600 10%,\n      #6b3d00 22%,\n      #a05c00 34%,\n      #c8820a 46%,\n      #e8ad30 58%,\n      #f5d06a 70%,\n      #faeaa0 82%,\n      #fff8d6 92%,\n      #fffdf0 100%\n    );\n    z-index:0;\n  }\n\n  /* ── GOLDEN GLOW from bottom center — like altar lamp ── */\n  .altar-glow{\n    position:absolute;\n    bottom:-18vh;left:50%;\n    transform:translateX(-50%);\n    width:70vw;height:70vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(255,220,80,0.75) 0%,\n      rgba(255,180,30,0.45) 28%,\n      rgba(220,130,10,0.2) 55%,\n      transparent 78%\n    );\n    z-index:1;\n    animation:glowPulse 4s ease-in-out infinite;\n  }\n  @keyframes glowPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.85}\n    50%{transform:translateX(-50%) scale(1.1);opacity:1}\n  }\n\n  /* canvases */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.coins{position:absolute;inset:0;z-index:4;pointer-events:none}\n  canvas.sparkle{position:absolute;inset:0;z-index:3;pointer-events:none}\n\n  .mist{\n    position:absolute;bottom:0;left:0;right:0;height:28vh;\n    background:linear-gradient(to top,\n      rgba(255,248,210,0.65) 0%,\n      rgba(255,235,150,0.25) 55%,\n      transparent 100%\n    );\n    z-index:3;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n    padding:3vh 2vw;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,248,210,0.18);\n    backdrop-filter:blur(22px);\n    -webkit-backdrop-filter:blur(22px);\n    border:1px solid rgba(255,220,100,0.45);\n    border-radius:28px;\n    padding:clamp(20px,3.5vh,46px) clamp(28px,5vw,82px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(140,80,0,0.3),\n      0 2px 24px rgba(255,180,30,0.25),\n      inset 0 1px 0 rgba(255,255,255,0.6);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:visible;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,200,0.22) 0%,\n      rgba(255,200,80,0.08) 50%,\n      rgba(255,255,200,0.05) 100%\n    );\n    border-radius:28px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(28px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── ICON ROW ── */\n  .icon-row{\n    display:flex;align-items:center;gap:1.4vw;\n    margin-bottom:1.1vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .icon-emoji{\n    font-size:clamp(22px,3.2vw,48px);\n    animation:iconFloat 3s ease-in-out infinite;\n    filter:drop-shadow(0 3px 10px rgba(180,100,0,.45));\n  }\n  .icon-emoji:nth-child(1){animation-delay:0s}\n  .icon-emoji:nth-child(2){animation-delay:.4s}\n  .icon-emoji:nth-child(3){animation-delay:.8s}\n  @keyframes iconFloat{\n    0%,100%{transform:translateY(0) scale(1)}\n    50%{transform:translateY(-10px) scale(1.08)}\n  }\n\n  /* ── SCRIPT TOP ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.2vw,16px);\n    letter-spacing:7px;\n    text-transform:uppercase;\n    color:rgba(100,55,0,0.72);\n    margin-bottom:1.1vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(180,110,0,.5),transparent);\n  }\n  .div-icon{font-size:clamp(10px,1.3vw,17px)}\n\n  /* ── MAIN TAMIL WORD ── */\n  .main-word{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(58px,10.5vw,158px);\n    font-weight:900;\n    line-height:1.05;\n    letter-spacing:5px;\n    background:linear-gradient(\n      150deg,\n      #5c2e00 0%,\n      #9c5200 16%,\n      #d48000 30%,\n      #f5b800 46%,\n      #ffe066 58%,\n      #d48000 72%,\n      #9c5200 85%,\n      #5c2e00 100%\n    );\n    background-size:280% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 22px rgba(200,120,0,.4));\n    opacity:0;\n    animation:wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              wordFlow 5s ease-in-out infinite 2.6s;\n    margin-bottom:.2vh;\n  }\n  @keyframes wordReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(16px)}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 22px rgba(200,120,0,.4))}\n  }\n  @keyframes wordFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── ENGLISH SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(13px,1.9vw,27px);\n    font-weight:700;\n    color:rgba(90,45,0,0.88);\n    letter-spacing:5px;\n    margin-bottom:1.7vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(255,200,80,.5);\n    text-transform:uppercase;\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(255,220,100,0.2);\n    border:1px solid rgba(180,120,0,.32);\n    border-radius:14px;\n    padding:clamp(10px,1.4vh,18px) clamp(14px,2.6vw,36px);\n    margin-bottom:1.5vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:72vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(12px,1.45vw,20px);\n    color:rgba(70,30,0,0.92);\n    line-height:1.9;\n    letter-spacing:.8px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.05vw,14px);\n    color:rgba(130,70,0,.72);\n    letter-spacing:3px;\n    margin-top:.4vh;\n  }\n\n  /* ── CHURCH BADGE ── */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-10deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n  .church-bg{\n    position:absolute;inset:3px;\n    border-radius:46px;\n    background:rgba(8,4,0,0.9);\n    z-index:1;\n  }\n  .church{\n    position:relative;z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.4vw,19px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.4vw,34px);\n    white-space:nowrap;\n    background:linear-gradient(\n      90deg,\n      #ffe066 0%,\n      #ff9f1c 18%,\n      #ffdd57 36%,\n      #ff6b6b 54%,\n      #ffe066 72%,\n      #ff9f1c 90%,\n      #ffdd57 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:goldShift 3s linear infinite;\n    filter:drop-shadow(0 0 7px rgba(255,180,30,.8))\n           drop-shadow(0 0 16px rgba(255,120,0,.4));\n  }\n  @keyframes goldShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* ── BOTTOM DECO ── */\n  .deco-row{\n    position:absolute;bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;gap:.45vw;\n    overflow:hidden;z-index:11;pointer-events:none;\n  }\n  .deco-item{\n    font-size:clamp(15px,2.2vw,32px);opacity:.5;\n    animation:decoSway 3.4s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .deco-item:nth-child(2n){animation-delay:.5s}\n  .deco-item:nth-child(3n){animation-delay:1.1s}\n  .deco-item:nth-child(4n){animation-delay:1.7s}\n  @keyframes decoSway{\n    0%,100%{transform:rotate(-5deg)}\n    50%{transform:rotate(5deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(16px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n  <div class=\"altar-glow\"></div>\n\n  <canvas class=\"rays\"    id=\"cRays\"></canvas>\n  <canvas class=\"sparkle\" id=\"cSparkle\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"coins\"   id=\"cCoins\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">🙌</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">💛</span>\n      </div>\n\n      <div class=\"script-top\">கர்த்தருக்கு செலுத்துவோம் • Give Unto the Lord</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">🌾</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"main-word\">காணிக்கை</div>\n      <div class=\"subtitle\">Offering</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\">\n          ❝ அவரவர் மனதில் குறித்துக்கொண்டபடி கொடுக்கட்டும்;<br>\n          சலிப்போடு அல்ல, கட்டாயமாக அல்ல;<br>\n          சந்தோஷமாய்க் கொடுக்கிறவனிடத்தில் தேவன் பிரியப்படுகிறார். ❞\n        </div>\n        <div class=\"verse-ref\">— 2 கொரிந்தியர் 9:7</div>\n      </div>\n\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span>\n  </div>\n\n</div>\n\n<script>\n/* ── GOLDEN RAYS from bottom ── */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const RAYS=Array.from({length:22},(_,i)=>({\n    angle:(i/22)*Math.PI*1.4 - Math.PI*.7 + (Math.random()-.5)*.25,\n    alpha:.04+Math.random()*.08,\n    speed:(.0018+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length:.5+Math.random()*.6\n  }));\n  const OX=W*.5, OY=H*1.05;\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.035)*W*r.length+OX;\n      const by=Math.sin(r.angle+.035)*W*r.length+OY;\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(255,210,60,${r.alpha*2.2})`);\n      g.addColorStop(.35,`rgba(255,175,30,${r.alpha})`);\n      g.addColorStop(1,'rgba(255,210,60,0)');\n      cx.beginPath();cx.moveTo(OX,OY);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── GOLDEN SPARKLE DUST ── */\n(function(){\n  const cv=document.getElementById('cSparkle');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const SPARKS=Array.from({length:70},()=>({\n    x:Math.random()*W,\n    y:Math.random()*H,\n    r:Math.random()*2+.5,\n    phase:Math.random()*Math.PI*2,\n    speed:Math.random()*.03+.015,\n    vy:-(Math.random()*.3+.1),\n    vx:(Math.random()-.5)*.15\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    SPARKS.forEach(s=>{\n      s.y+=s.vy; s.x+=s.vx;\n      if(s.y<-10){s.y=H+10;s.x=Math.random()*W;}\n      const a=.2+.6*(.5+.5*Math.sin(t*s.speed+s.phase));\n      cx.save();\n      cx.globalAlpha=a;\n      cx.fillStyle='rgba(255,220,80,1)';\n      cx.shadowColor='rgba(255,180,0,.8)';\n      cx.shadowBlur=s.r*5;\n      cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING COINS ── */\n(function(){\n  const cv=document.getElementById('cCoins');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  class Coin{\n    constructor(rand){\n      this.x=Math.random()*W;\n      this.y=rand?(Math.random()*H):(H+30);\n      this.r=Math.random()*9+5;\n      this.vy=-(Math.random()*.5+.2);\n      this.vx=(Math.random()-.5)*.3;\n      this.rot=Math.random()*Math.PI*2;\n      this.rotV=(Math.random()-.5)*.04;\n      this.alpha=Math.random()*.55+.25;\n      this.phase=Math.random()*Math.PI*2;\n    }\n    update(){\n      this.y+=this.vy;this.x+=this.vx;this.rot+=this.rotV;\n      this.alpha-=.0015;\n      if(this.alpha<=0||this.y<-30)Object.assign(this,new Coin(false));\n    }\n    draw(cx){\n      cx.save();\n      cx.translate(this.x,this.y);\n      cx.rotate(this.rot);\n      cx.globalAlpha=Math.max(0,this.alpha);\n      /* coin body */\n      const g=cx.createRadialGradient(-this.r*.3,-this.r*.3,0,0,0,this.r);\n      g.addColorStop(0,'rgba(255,240,120,1)');\n      g.addColorStop(.5,'rgba(220,170,20,1)');\n      g.addColorStop(1,'rgba(160,100,0,1)');\n      cx.fillStyle=g;\n      cx.shadowColor='rgba(255,200,0,.6)';\n      cx.shadowBlur=8;\n      cx.beginPath();cx.ellipse(0,0,this.r,this.r*.35,0,0,Math.PI*2);cx.fill();\n      /* shine */\n      cx.fillStyle='rgba(255,255,180,.45)';\n      cx.beginPath();cx.ellipse(-this.r*.25,-this.r*.05,this.r*.3,this.r*.1,-.3,0,Math.PI*2);cx.fill();\n      cx.restore();\n    }\n  }\n\n  const coins=Array.from({length:20},()=>new Coin(true));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%55===0&&coins.length<28)coins.push(new Coin(false));\n    coins.forEach(c=>{c.update();c.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>காணிக்கை - நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Lora:ital,wght@1,400;1,600&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  /* ── WARM HARVEST SKY — deep olive → amber → golden cream ── */\n  .sky{\n    position:absolute;inset:0;\n    background:linear-gradient(\n      168deg,\n      #1a1200 0%,\n      #3b2600 10%,\n      #6b3d00 22%,\n      #a05c00 34%,\n      #c8820a 46%,\n      #e8ad30 58%,\n      #f5d06a 70%,\n      #faeaa0 82%,\n      #fff8d6 92%,\n      #fffdf0 100%\n    );\n    z-index:0;\n  }\n\n  /* ── GOLDEN GLOW from bottom center — like altar lamp ── */\n  .altar-glow{\n    position:absolute;\n    bottom:-18vh;left:50%;\n    transform:translateX(-50%);\n    width:70vw;height:70vw;\n    border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(255,220,80,0.75) 0%,\n      rgba(255,180,30,0.45) 28%,\n      rgba(220,130,10,0.2) 55%,\n      transparent 78%\n    );\n    z-index:1;\n    animation:glowPulse 4s ease-in-out infinite;\n  }\n  @keyframes glowPulse{\n    0%,100%{transform:translateX(-50%) scale(1);opacity:.85}\n    50%{transform:translateX(-50%) scale(1.1);opacity:1}\n  }\n\n  /* canvases */\n  canvas.rays{position:absolute;inset:0;z-index:2;pointer-events:none}\n  canvas.coins{position:absolute;inset:0;z-index:4;pointer-events:none}\n  canvas.sparkle{position:absolute;inset:0;z-index:3;pointer-events:none}\n\n  .mist{\n    position:absolute;bottom:0;left:0;right:0;height:28vh;\n    background:linear-gradient(to top,\n      rgba(255,248,210,0.65) 0%,\n      rgba(255,235,150,0.25) 55%,\n      transparent 100%\n    );\n    z-index:3;\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:10;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n    padding:3vh 2vw;\n  }\n\n  /* ── CARD ── */\n  .card{\n    background:rgba(255,248,210,0.18);\n    backdrop-filter:blur(22px);\n    -webkit-backdrop-filter:blur(22px);\n    border:1px solid rgba(255,220,100,0.45);\n    border-radius:28px;\n    padding:clamp(20px,3.5vh,46px) clamp(28px,5vw,82px);\n    display:flex;flex-direction:column;\n    align-items:center;gap:0;\n    box-shadow:\n      0 8px 60px rgba(140,80,0,0.3),\n      0 2px 24px rgba(255,180,30,0.25),\n      inset 0 1px 0 rgba(255,255,255,0.6);\n    opacity:0;\n    animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .4s;\n    position:relative;\n    overflow:visible;\n  }\n  .card::before{\n    content:'';\n    position:absolute;inset:0;\n    background:linear-gradient(135deg,\n      rgba(255,255,200,0.22) 0%,\n      rgba(255,200,80,0.08) 50%,\n      rgba(255,255,200,0.05) 100%\n    );\n    border-radius:28px;\n    pointer-events:none;\n  }\n  @keyframes cardReveal{\n    from{opacity:0;transform:translateY(28px) scale(.97)}\n    to{opacity:1;transform:translateY(0) scale(1)}\n  }\n\n  /* ── ICON ROW ── */\n  .icon-row{\n    display:flex;align-items:center;gap:1.4vw;\n    margin-bottom:1.1vh;\n    opacity:0;animation:fadeUp .9s ease forwards .8s;\n  }\n  .icon-emoji{\n    font-size:clamp(22px,3.2vw,48px);\n    animation:iconFloat 3s ease-in-out infinite;\n    filter:drop-shadow(0 3px 10px rgba(180,100,0,.45));\n  }\n  .icon-emoji:nth-child(1){animation-delay:0s}\n  .icon-emoji:nth-child(2){animation-delay:.4s}\n  .icon-emoji:nth-child(3){animation-delay:.8s}\n  @keyframes iconFloat{\n    0%,100%{transform:translateY(0) scale(1)}\n    50%{transform:translateY(-10px) scale(1.08)}\n  }\n\n  /* ── SCRIPT TOP ── */\n  .script-top{\n    font-family:'Lora',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(10px,1.2vw,16px);\n    letter-spacing:7px;\n    text-transform:uppercase;\n    color:rgba(100,55,0,0.72);\n    margin-bottom:1.1vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1s;\n  }\n\n  /* ── DIVIDER ── */\n  .divider{\n    display:flex;align-items:center;gap:1.2vw;\n    margin-bottom:1.6vh;\n    opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n    width:100%;\n  }\n  .div-line{\n    flex:1;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(180,110,0,.5),transparent);\n  }\n  .div-icon{font-size:clamp(10px,1.3vw,17px)}\n\n  /* ── MAIN TAMIL WORD ── */\n  .main-word{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(58px,10.5vw,158px);\n    font-weight:900;\n    line-height:1.05;\n    letter-spacing:5px;\n    background:linear-gradient(\n      150deg,\n      #5c2e00 0%,\n      #9c5200 16%,\n      #d48000 30%,\n      #f5b800 46%,\n      #ffe066 58%,\n      #d48000 72%,\n      #9c5200 85%,\n      #5c2e00 100%\n    );\n    background-size:280% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    filter:drop-shadow(0 4px 22px rgba(200,120,0,.4));\n    opacity:0;\n    animation:wordReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.4s,\n              wordFlow 5s ease-in-out infinite 2.6s;\n    margin-bottom:.2vh;\n  }\n  @keyframes wordReveal{\n    from{opacity:0;transform:scale(.6);filter:blur(16px)}\n    to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 22px rgba(200,120,0,.4))}\n  }\n  @keyframes wordFlow{\n    0%,100%{background-position:0% center}\n    50%{background-position:100% center}\n  }\n\n  /* ── ENGLISH SUBTITLE ── */\n  .subtitle{\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(13px,1.9vw,27px);\n    font-weight:700;\n    color:rgba(90,45,0,0.88);\n    letter-spacing:5px;\n    margin-bottom:1.7vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.9s;\n    text-shadow:0 1px 10px rgba(255,200,80,.5);\n    text-transform:uppercase;\n  }\n\n  /* ── VERSE BOX ── */\n  .verse-box{\n    background:rgba(255,220,100,0.2);\n    border:1px solid rgba(180,120,0,.32);\n    border-radius:14px;\n    padding:clamp(10px,1.4vh,18px) clamp(14px,2.6vw,36px);\n    margin-bottom:1.5vh;\n    opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n    max-width:72vw;\n    text-align:center;\n  }\n  .verse-text{\n    font-family:'Lora',serif;\n    font-style:italic;\n    font-size:clamp(12px,1.45vw,20px);\n    color:rgba(70,30,0,0.92);\n    line-height:1.9;\n    letter-spacing:.8px;\n  }\n  .verse-ref{\n    font-family:'Lora',serif;\n    font-size:clamp(10px,1.05vw,14px);\n    color:rgba(130,70,0,.72);\n    letter-spacing:3px;\n    margin-top:.4vh;\n  }\n\n  /* ── CHURCH BADGE ── */\n  .church-wrapper{\n    position:relative;\n    display:inline-flex;\n    align-items:center;justify-content:center;\n    opacity:0;\n    animation:churchEntrance 1s cubic-bezier(.34,1.56,.64,1) forwards 2.7s;\n    margin-top:.3vh;\n  }\n  @keyframes churchEntrance{\n    from{opacity:0;transform:scale(.5) rotate(-10deg)}\n    to{opacity:1;transform:scale(1) rotate(0deg)}\n  }\n  .church-bg{\n    position:absolute;inset:3px;\n    border-radius:46px;\n    background:rgba(8,4,0,0.9);\n    z-index:1;\n  }\n  .church{\n    position:relative;z-index:2;\n    font-family:'Noto Serif Tamil',serif;\n    font-weight:900;\n    font-size:clamp(11px,1.4vw,19px);\n    letter-spacing:3px;\n    padding:clamp(6px,1vh,12px) clamp(18px,2.4vw,34px);\n    white-space:nowrap;\n    background:linear-gradient(\n      90deg,\n      #ffe066 0%,\n      #ff9f1c 18%,\n      #ffdd57 36%,\n      #ff6b6b 54%,\n      #ffe066 72%,\n      #ff9f1c 90%,\n      #ffdd57 100%\n    );\n    background-size:300% auto;\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    background-clip:text;\n    animation:goldShift 3s linear infinite;\n    filter:drop-shadow(0 0 7px rgba(255,180,30,.8))\n           drop-shadow(0 0 16px rgba(255,120,0,.4));\n  }\n  @keyframes goldShift{\n    0%{background-position:0% center}\n    100%{background-position:300% center}\n  }\n\n  /* ── BOTTOM DECO ── */\n  .deco-row{\n    position:absolute;bottom:-2px;left:0;right:0;\n    display:flex;justify-content:center;gap:.45vw;\n    overflow:hidden;z-index:11;pointer-events:none;\n  }\n  .deco-item{\n    font-size:clamp(15px,2.2vw,32px);opacity:.5;\n    animation:decoSway 3.4s ease-in-out infinite;\n    transform-origin:bottom center;\n  }\n  .deco-item:nth-child(2n){animation-delay:.5s}\n  .deco-item:nth-child(3n){animation-delay:1.1s}\n  .deco-item:nth-child(4n){animation-delay:1.7s}\n  @keyframes decoSway{\n    0%,100%{transform:rotate(-5deg)}\n    50%{transform:rotate(5deg)}\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(16px)}\n    to{opacity:1;transform:translateY(0)}\n  }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n  <div class=\"altar-glow\"></div>\n\n  <canvas class=\"rays\"    id=\"cRays\"></canvas>\n  <canvas class=\"sparkle\" id=\"cSparkle\"></canvas>\n  <div class=\"mist\"></div>\n  <canvas class=\"coins\"   id=\"cCoins\"></canvas>\n\n  <div class=\"content\">\n    <div class=\"card\">\n\n      <div class=\"icon-row\">\n        <span class=\"icon-emoji\">🙌</span>\n        <span class=\"icon-emoji\">✝</span>\n        <span class=\"icon-emoji\">💛</span>\n      </div>\n\n      <div class=\"script-top\">கர்த்தருக்கு செலுத்துவோம் • Give Unto the Lord</div>\n\n      <div class=\"divider\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-icon\">🌾</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"main-word\">காணிக்கை</div>\n      <div class=\"subtitle\">Offering</div>\n\n      <div class=\"verse-box\">\n        <div class=\"verse-text\"><br>          ❝ அவரவர் மனதில் குறித்துக்கொண்டபடி கொடுக்கட்டும்;<br><br>          சலிப்போடு அல்ல, கட்டாயமாக அல்ல;<br><br>          சந்தோஷமாய்க் கொடுக்கிறவனிடத்தில் தேவன் பிரியப்படுகிறார். ❞<br></div>\n        <div class=\"verse-ref\">— 2 கொரிந்தியர் 9:7</div>\n      </div>\n\n      <div class=\"church-wrapper\">\n        <div class=\"church-bg\"></div>\n        <div class=\"church\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌾</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌾</span>\n  </div>\n\n</div>\n\n<script>\n/* ── GOLDEN RAYS from bottom ── */\n(function(){\n  const cv=document.getElementById('cRays');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const RAYS=Array.from({length:22},(_,i)=>({\n    angle:(i/22)*Math.PI*1.4 - Math.PI*.7 + (Math.random()-.5)*.25,\n    alpha:.04+Math.random()*.08,\n    speed:(.0018+Math.random()*.003)*(Math.random()>.5?1:-1),\n    length:.5+Math.random()*.6\n  }));\n  const OX=W*.5, OY=H*1.05;\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    RAYS.forEach(r=>{\n      r.angle+=r.speed;\n      const ax=Math.cos(r.angle)*W*r.length+OX;\n      const ay=Math.sin(r.angle)*W*r.length+OY;\n      const bx=Math.cos(r.angle+.035)*W*r.length+OX;\n      const by=Math.sin(r.angle+.035)*W*r.length+OY;\n      cx.save();\n      const g=cx.createLinearGradient(OX,OY,ax,ay);\n      g.addColorStop(0,`rgba(255,210,60,${r.alpha*2.2})`);\n      g.addColorStop(.35,`rgba(255,175,30,${r.alpha})`);\n      g.addColorStop(1,'rgba(255,210,60,0)');\n      cx.beginPath();cx.moveTo(OX,OY);cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── GOLDEN SPARKLE DUST ── */\n(function(){\n  const cv=document.getElementById('cSparkle');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const SPARKS=Array.from({length:70},()=>({\n    x:Math.random()*W,\n    y:Math.random()*H,\n    r:Math.random()*2+.5,\n    phase:Math.random()*Math.PI*2,\n    speed:Math.random()*.03+.015,\n    vy:-(Math.random()*.3+.1),\n    vx:(Math.random()-.5)*.15\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    SPARKS.forEach(s=>{\n      s.y+=s.vy; s.x+=s.vx;\n      if(s.y<-10){s.y=H+10;s.x=Math.random()*W;}\n      const a=.2+.6*(.5+.5*Math.sin(t*s.speed+s.phase));\n      cx.save();\n      cx.globalAlpha=a;\n      cx.fillStyle='rgba(255,220,80,1)';\n      cx.shadowColor='rgba(255,180,0,.8)';\n      cx.shadowBlur=s.r*5;\n      cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── FLOATING COINS ── */\n(function(){\n  const cv=document.getElementById('cCoins');\n  const cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n\n  class Coin{\n    constructor(rand){\n      this.x=Math.random()*W;\n      this.y=rand?(Math.random()*H):(H+30);\n      this.r=Math.random()*9+5;\n      this.vy=-(Math.random()*.5+.2);\n      this.vx=(Math.random()-.5)*.3;\n      this.rot=Math.random()*Math.PI*2;\n      this.rotV=(Math.random()-.5)*.04;\n      this.alpha=Math.random()*.55+.25;\n      this.phase=Math.random()*Math.PI*2;\n    }\n    update(){\n      this.y+=this.vy;this.x+=this.vx;this.rot+=this.rotV;\n      this.alpha-=.0015;\n      if(this.alpha<=0||this.y<-30)Object.assign(this,new Coin(false));\n    }\n    draw(cx){\n      cx.save();\n      cx.translate(this.x,this.y);\n      cx.rotate(this.rot);\n      cx.globalAlpha=Math.max(0,this.alpha);\n      /* coin body */\n      const g=cx.createRadialGradient(-this.r*.3,-this.r*.3,0,0,0,this.r);\n      g.addColorStop(0,'rgba(255,240,120,1)');\n      g.addColorStop(.5,'rgba(220,170,20,1)');\n      g.addColorStop(1,'rgba(160,100,0,1)');\n      cx.fillStyle=g;\n      cx.shadowColor='rgba(255,200,0,.6)';\n      cx.shadowBlur=8;\n      cx.beginPath();cx.ellipse(0,0,this.r,this.r*.35,0,0,Math.PI*2);cx.fill();\n      /* shine */\n      cx.fillStyle='rgba(255,255,180,.45)';\n      cx.beginPath();cx.ellipse(-this.r*.25,-this.r*.05,this.r*.3,this.r*.1,-.3,0,Math.PI*2);cx.fill();\n      cx.restore();\n    }\n  }\n\n  const coins=Array.from({length:20},()=>new Coin(true));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%55===0&&coins.length<28)coins.push(new Coin(false));\n    coins.forEach(c=>{c.update();c.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1775149447015.1365,
      "type": "html",
      "name": "HTML Slide",
      "html": "",
      "_thumbHtml": "<style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script><style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style>"
    },
    {
      "id": 1775149448759.961,
      "type": "html",
      "name": "HTML Slide",
      "html": "",
      "_thumbHtml": "<style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script><style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style>"
    },
    {
      "id": 1775150493283.4211,
      "type": "html",
      "name": "கல்வாரியை, கல்வாரியை, கண்டு மனம் உருகலையோ - 1",
      "html": "<!DOCTYPE html><html lang=\"ta\"><head><meta charset=\"UTF-8\">\n<style>\n@font-face{font-family:'Noto Serif Tamil';src:local('Noto Serif Tamil'),local('Nirmala UI'),local('Vijaya'),local('Latha'),local('Tamil Sangam MN');font-weight:400 900;}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml,body{width:100%;height:100%;overflow:hidden;}\nbody{\n  background:linear-gradient(180deg,#0b0f26 0%,#111936 52%,#1a2647 100%);\n  display:flex;align-items:center;justify-content:center;\n  font-family:'Noto Serif Tamil',serif;padding:1.2vw;position:relative;\n}\n.verse-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;gap:0.6vh;overflow:hidden;}\n.verse-text{\n  font-weight:900;color:#f8fafc;text-align:center;line-height:1.22;word-break:break-word;width:100%;white-space:pre-wrap;\n}\n.verse-ref{\n  color:#f8fafc;opacity:0.9;font-style:italic;letter-spacing:2px;text-align:right;align-self:flex-end;padding-right:1vw;\n  font-weight:900;\n}\n</style></head><body>\n<div class=\"verse-wrap\" id=\"vwrap\">\n  <div class=\"verse-text\" id=\"vtext\">கல்வாரியை, கல்வாரியை, கண்டு மனம் உருகலையோ\nகர்த்தர் இயேசு கதறிடும் சத்தம் உன் காதில் தொனிக்கலையோ</div>\n  <div class=\"verse-ref\" id=\"vref\">— கல்வாரியை, கல்வாரியை, கண்டு மனம் உருகலையோ  (Song #44540)</div>\n</div>\n<script>\nvar MAX_FONT = 130;\nfunction autoFit() {\n  var wrap = document.getElementById('vwrap');\n  var vt   = document.getElementById('vtext');\n  var vr   = document.getElementById('vref');\n  if (!wrap || !vt) return;\n  var availW = wrap.clientWidth;\n  var availH = wrap.clientHeight;\n  if (availH < 10 || availW < 10) { setTimeout(autoFit, 100); return; }\n  vt.style.width = '100%';\n  var lo = 8, hi = Math.min(availH, MAX_FONT);\n  for (var i = 0; i < 30; i++) {\n    var mid = (lo + hi) / 2;\n    vt.style.fontSize = mid + 'px';\n    if (vr) vr.style.fontSize = (mid * 0.32) + 'px';\n    var needed = vt.scrollHeight + (vr ? vr.offsetHeight + mid * 0.2 : 0);\n    if (needed > availH || vt.scrollWidth > vt.clientWidth + 1) {\n      hi = mid;\n    } else {\n      lo = mid;\n    }\n  }\n  vt.style.fontSize = lo + 'px';\n  if (vr) vr.style.fontSize = (lo * 0.32) + 'px';\n}\ndocument.fonts ? document.fonts.ready.then(autoFit) : window.addEventListener('load', autoFit);\nwindow.addEventListener('resize', autoFit);\n</script>\n</body></html>",
