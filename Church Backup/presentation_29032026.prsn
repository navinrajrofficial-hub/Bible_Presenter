{
  "version": 1,
  "slides": [
    {
      "id": 1774107563826.375,
      "type": "html",
      "name": "palm day",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Palm Sunday - Good Samarian Jesus Prayer House</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel+Decorative:wght@700;900&family=Noto+Serif+Tamil:wght@400;700;900&family=IM+Fell+English:ital@1&family=Playfair+Display:wght@700;900&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden}\n\n.stage{\n  width:100vw;height:100vh;\n  position:relative;overflow:hidden;\n  background:#0a0500;\n}\n\n/* Deep forest-gold sky */\n.sky{\n  position:absolute;inset:0;\n  background:\n    radial-gradient(ellipse 120% 80% at 50% 110%, rgba(255,200,50,0.28) 0%, transparent 65%),\n    radial-gradient(ellipse 80% 60% at 50% 105%, rgba(255,150,20,0.22) 0%, transparent 55%),\n    linear-gradient(175deg,\n      #020100 0%, #0d0800 12%, #1a1000 24%, #2e1d00 36%,\n      #4a2e00 48%, #6b4500 58%, #3d2700 68%, #1a1000 80%, #0a0600 100%\n    );\n  z-index:0;\n}\n\n/* ── CANVASES ── */\ncanvas{position:absolute;inset:0;pointer-events:none;}\n#cRays{z-index:1}\n#cPalms{z-index:2}\n#cGlow{z-index:3}\n#cSparkle{z-index:5}\n#cCoins{z-index:6}\n\n.ground-mist{\n  position:absolute;bottom:0;left:0;right:0;height:22vh;\n  background:linear-gradient(to top, rgba(255,230,120,0.18) 0%, rgba(255,200,60,0.08) 50%, transparent 100%);\n  z-index:4;\n}\n\n/* ── CONTENT ── */\n.content{\n  position:absolute;inset:0;z-index:10;\n  display:flex;flex-direction:column;\n  align-items:center;justify-content:center;\n  padding:1vh 2vw;\n}\n\n/* ── VERSE BANNER (top) ── */\n.verse-banner{\n  width:min(98vw,820px);\n  background:linear-gradient(90deg, rgba(180,110,0,0.0) 0%, rgba(255,190,50,0.22) 20%, rgba(255,210,80,0.28) 50%, rgba(255,190,50,0.22) 80%, rgba(180,110,0,0.0) 100%);\n  border-top:1px solid rgba(255,200,80,0.3);\n  border-bottom:1px solid rgba(255,200,80,0.3);\n  text-align:center;\n  padding:.8vh 2vw; \n  margin-bottom:.8vh; \n  opacity:0;\n  animation:fadeDown .9s ease forwards .3s;\n}\n.verse-ta{\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(11px,1.4vw,16px);\n  color:rgba(255,230,150,0.9);\n  line-height:1.4;\n  letter-spacing:.5px;\n}\n.verse-ref{\n  font-family:'IM Fell English',serif;\n  font-style:italic;\n  font-size:clamp(10px,1.1vw,13px);\n  color:rgba(255,200,80,0.7);\n  margin-top:.1vh;\n  letter-spacing:1px;\n}\n\n/* ── MAIN CARD ── */\n.card{\n  width:min(97vw,760px); \n  max-height: 88vh; \n  overflow-y: auto; \n  scrollbar-width: none; \n  background:rgba(10,6,0,0.72);\n  backdrop-filter:blur(20px);\n  -webkit-backdrop-filter:blur(20px);\n  border-radius:24px;\n  border:1px solid rgba(255,200,70,0.3);\n  box-shadow:\n    0 0 60px rgba(200,130,0,0.25),\n    0 0 120px rgba(180,100,0,0.12),\n    inset 0 1px 0 rgba(255,220,100,0.25),\n    inset 0 -1px 0 rgba(255,180,30,0.15);\n  padding:clamp(10px,1.5vh,20px) clamp(16px,3vw,40px); \n  display:flex;flex-direction:column;\n  align-items:center;gap:0;\n  position:relative;\n  opacity:0;\n  animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .6s;\n}\n.card::-webkit-scrollbar { display: none; } \n\n.card::before{\n  content:'';\n  position:absolute;inset:0;\n  background:\n    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255,210,80,0.07) 0%, transparent 60%),\n    radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255,180,30,0.06) 0%, transparent 60%);\n  pointer-events:none;border-radius:24px;\n}\n\n.card::after{\n  content:'';\n  position:absolute;\n  top:10px;left:10px;right:10px;bottom:10px;\n  border-radius:18px;\n  border:1px solid rgba(255,200,60,0.12);\n  pointer-events:none;\n}\n\n@keyframes cardReveal{\n  from{opacity:0;transform:translateY(30px) scale(.96)}\n  to{opacity:1;transform:translateY(0) scale(1)}\n}\n\n/* ── CHURCH NAME TOP ── */\n.church-top{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(7px,.85vw,11px);\n  color:rgba(255,200,80,0.65);\n  letter-spacing:4px;\n  text-transform:uppercase;\n  margin-bottom:.6vh; \n  opacity:0;animation:fadeUp .8s ease forwards 1s;\n}\n\n/* ── DIVIDER ── */\n.div-row{\n  display:flex;align-items:center;gap:1.5vw;\n  width:100%;margin-bottom:.6vh; \n  opacity:0;animation:fadeUp .7s ease forwards 1.1s;\n}\n.div-line{\n  flex:1;height:1px;\n  background:linear-gradient(90deg,transparent,rgba(200,140,20,0.55),transparent);\n}\n.div-gem{color:rgba(255,200,60,0.8);font-size:clamp(9px,1vw,13px);}\n\n/* ── PALM SUNDAY TAG ── */\n.event-tag{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(8px,1vw,11px);\n  color:rgba(100,200,100,0.85);\n  letter-spacing:5px;\n  text-transform:uppercase;\n  margin-bottom:.4vh;\n  opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n}\n\n/* ── PALM SUNDAY TITLE ── */\n.palm-title{\n  font-family:'Playfair Display',serif;\n  font-style:italic;\n  font-weight:900;\n  font-size:clamp(24px,5.5vw,55px); \n  line-height:1.1;\n  letter-spacing:2px;\n  white-space:nowrap; \n  margin-bottom:.4vh;\n  background:linear-gradient(150deg, #7ab870 0%, #a8d5a2 18%, #c8efc0 32%, #8fce85 48%, #5a9e50 64%, #3d7235 80%, #5a9e50 100%);\n  background-size:250% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 4px 18px rgba(80,160,60,.45));\n  opacity:0;\n  animation:palmReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.3s, palmFlow 6s ease-in-out infinite 2.5s;\n  text-align:center;\n}\n@keyframes palmReveal{\n  from{opacity:0;transform:scale(.7);filter:blur(14px)}\n  to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 18px rgba(80,160,60,.45))}\n}\n@keyframes palmFlow{\n  0%,100%{background-position:0% center}\n  50%{background-position:100% center}\n}\n\n/* ── SERVICE TEXT ── */\n.service-text{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(12px,2vw,24px); \n  font-weight:700;\n  letter-spacing:8px;\n  background:linear-gradient(90deg, #c8960a 0%,#f5d060 25%,#ffe88a 50%,#f5d060 75%,#c8960a 100%);\n  background-size:300% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  opacity:0;animation:fadeUp .8s ease forwards 1.6s, goldShift 3s linear infinite 2.5s;\n  text-transform:uppercase;\n  margin-bottom:.2vh;\n  margin-top:.2vh;\n}\n@keyframes goldShift{ 0%{background-position:0% center}100%{background-position:300% center} }\n\n/* ── SERVICE SUBTEXT ── */\n.service-subtext{\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(10px,1.1vw,13px);\n  color:rgba(255,220,130,0.6);\n  letter-spacing:4px;\n  margin-bottom:1vh; \n  opacity:0;animation:fadeUp .8s ease forwards 1.75s;\n}\n\n/* ── CROSS (Enlarged) ── */\n.cross-wrap{\n  position:relative;\n  margin:1vh 0; \n  opacity:0;\n  animation:crossReveal 1.2s cubic-bezier(.34,1.56,.64,1) forwards 1.8s;\n}\n@keyframes crossReveal{\n  from{opacity:0;transform:scale(.3) rotate(-15deg)}\n  to{opacity:1;transform:scale(1) rotate(0deg)}\n}\n.cross-wrap svg{\n  display:block;\n  /* ✨ Noticeably enlarged cross height */\n  height: clamp(65px, 14vh, 120px);  \n  width: auto;\n  filter: drop-shadow(0 0 14px rgba(255,200,60,0.9)) drop-shadow(0 0 30px rgba(255,160,20,0.6));\n  animation:crossGlow 3s ease-in-out infinite;\n}\n@keyframes crossGlow{\n  0%,100%{filter:drop-shadow(0 0 14px rgba(255,200,60,0.9)) drop-shadow(0 0 30px rgba(255,160,20,0.6))}\n  50%{filter:drop-shadow(0 0 22px rgba(255,230,100,1.0)) drop-shadow(0 0 50px rgba(255,180,40,0.85))}\n}\n\n/* ── INFO ROW ── */\n.info-row{\n  display:flex;align-items:center;gap:3vw;\n  margin-bottom:1vh; \n  opacity:0;animation:fadeUp .8s ease forwards 2s;\n}\n.info-box{ text-align:center; }\n.info-label{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(7px,.75vw,9px);\n  color:rgba(255,200,60,0.65);\n  letter-spacing:3px;\n  text-transform:uppercase;\n  margin-bottom:.2vh;\n}\n.info-value{\n  font-family:'Playfair Display',serif;\n  font-size:clamp(11px,1.5vw,18px);\n  font-weight:700;\n  color:rgba(255,225,130,0.95);\n  letter-spacing:1px;\n  text-shadow:0 0 18px rgba(255,180,30,.5);\n}\n.info-sep{ font-size:clamp(14px,1.8vw,24px); color:rgba(255,200,60,0.35); }\n\n\n/* ══════════════════════════════════════════════\n   ⭐ CINEMATIC BISHOP BLOCK ⭐\n══════════════════════════════════════════════ */\n.bishop-block{\n  width:100%;\n  position:relative;\n  overflow:hidden;\n  background:linear-gradient(160deg, rgba(40,25,5,0.75) 0%, rgba(10,5,0,0.9) 100%);\n  border-radius:16px;\n  padding:clamp(8px,1vh,12px) clamp(10px,2vw,24px); \n  text-align:center;\n  margin-bottom:1vh; \n  box-shadow: 0 12px 30px rgba(0,0,0,0.6), inset 0 1px 1px rgba(255,255,255,0.1);\n  border: 1px solid rgba(255,200,60,0.15);\n  opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n}\n\n/* Glowing Top Edge */\n.bishop-block::before {\n  content:'';\n  position:absolute;\n  top:0; left:20%; right:20%;\n  height:1.5px;\n  background: linear-gradient(90deg, transparent, rgba(255,230,120,0.85), transparent);\n  box-shadow: 0 0 12px rgba(255,200,50,0.8);\n}\n\n/* Sweeping Lens Flare across the block */\n.bishop-block::after {\n  content:'';\n  position:absolute;\n  top:0; left:-100%; width:40%; height:100%;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);\n  transform: skewX(-20deg);\n  animation: blockSweep 5.5s infinite;\n  pointer-events: none;\n  z-index: 1;\n}\n@keyframes blockSweep {\n  0%, 30% { left: -100%; }\n  70%, 100% { left: 200%; }\n}\n\n.bishop-role{\n  position: relative; z-index: 2;\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(7px,.7vw,9px);\n  color:rgba(255,200,60,0.6);\n  letter-spacing:4px;\n  text-transform:uppercase;\n  margin-bottom:.2vh; \n}\n\n\n/* ══════════════════════════════════════════════\n   🖊️ INFINITE LOOPING SIGNATURE WIPE 🖊️\n══════════════════════════════════════════════ */\n.bishop-name-wrapper {\n  position: relative;\n  display: inline-block;\n  z-index: 2;\n  padding: 0 10px; /* Breathing room for italic tails */\n}\n\n/* Pulsing Golden Aura behind name */\n.bishop-name-wrapper::before {\n  content: '';\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 140%; height: 160%;\n  background: radial-gradient(ellipse, rgba(255,200,50,0.15) 0%, transparent 60%);\n  animation: auraPulse 3s ease-in-out infinite;\n  pointer-events: none;\n}\n@keyframes auraPulse {\n  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(0.9); }\n  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }\n}\n\n/* The Signature Reveal Text */\n.bishop-name-en {\n  position: relative;\n  font-family: 'Alex Brush', cursive; /* Elegant Handwriting Font */\n  font-weight: 400; \n  font-size: clamp(28px, 4vw, 44px); /* Larger for script legibility */\n  line-height: 1.2;\n  letter-spacing: 1px;\n  \n  /* Golden Metallic Texture */\n  background: linear-gradient(90deg, #cca231 0%, #fffbe0 25%, #ffcc00 50%, #fffbe0 75%, #cca231 100%);\n  background-size: 200% auto;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  \n  /* Hard drop shadow to lift transparent text off the background */\n  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.95)) drop-shadow(0 0 15px rgba(255,200,0,0.4));\n  \n  /* The Wipe Animation defaults to hidden */\n  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%); \n  \n  /* Loop setup: 8 seconds total, runs forever */\n  animation: \n    signatureLoop 8s cubic-bezier(0.39, 0.57, 0.56, 1) infinite 2.5s, \n    goldShift 4s linear infinite; \n}\n\n/* The Magic Spark at the tip of the pen */\n.pen-flare {\n  position: absolute;\n  top: 45%; \n  left: 0;\n  width: 4px;\n  height: 4px;\n  background: #ffffff;\n  border-radius: 50%;\n  box-shadow: \n    0 0 10px 4px #fffbe0, \n    0 0 25px 12px #ffcc00, \n    0 0 40px 20px rgba(255,150,0,0.6);\n  opacity: 0;\n  z-index: 10;\n  pointer-events: none;\n  \n  /* Matches the duration and delay of the signature wipe */\n  animation: flareLoop 8s cubic-bezier(0.39, 0.57, 0.56, 1) infinite 2.5s;\n}\n\n/* ⭐ CONTINUOUS LOOPING KEYFRAMES ⭐ */\n\n/* 8-second cycle: Wait 0.4s -> Write for 2s -> Hold for 4.4s -> Fade Out for 0.8s -> Repeat */\n@keyframes signatureLoop {\n  0%, 5%   { clip-path: polygon(0 0, 0% 0, 0% 100%, 0 100%); opacity: 1; }\n  30%, 85% { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); opacity: 1; }\n  95%      { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); opacity: 0; }\n  100%     { clip-path: polygon(0 0, 0% 0, 0% 100%, 0 100%); opacity: 0; }\n}\n\n@keyframes flareLoop {\n  0%, 5%    { left: 0%; opacity: 0; transform: scale(0.5) translateY(0); }\n  8%        { opacity: 1; transform: scale(1.2) translateY(-4px); }\n  15%       { transform: scale(0.9) translateY(4px); }\n  22%       { transform: scale(1.4) translateY(-2px); }\n  28%       { transform: scale(1) translateY(3px); }\n  29%       { opacity: 1; transform: scale(1.2) translateY(-1px); }\n  30%, 100% { left: 100%; opacity: 0; transform: scale(0.5) translateY(0); }\n}\n/* ══════════════════════════════════════════════ */\n\n\n.bishop-name-ta{\n  position: relative; z-index: 2;\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(9px,1.1vw,14px);\n  font-weight:700;\n  color:rgba(255,230,160,0.85);\n  letter-spacing:1px;\n}\n\n\n/* ── CHURCH BADGE BOTTOM ── */\n.church-badge{\n  position:relative;\n  display:inline-flex;\n  align-items:center;justify-content:center;\n  opacity:0;\n  animation:churchReveal 1s cubic-bezier(.34,1.56,.64,1) forwards 2.5s;\n}\n@keyframes churchReveal{\n  from{opacity:0;transform:scale(.5)}\n  to{opacity:1;transform:scale(1)}\n}\n.church-bg-inner{\n  position:absolute;inset:3px;\n  background:rgba(5,2,0,0.9);\n  border-radius:50px;z-index:1;\n}\n.church-name{\n  position:relative;z-index:2;\n  font-family:'Noto Serif Tamil',serif;\n  font-weight:900;\n  font-size:clamp(9px,1vw,13px);\n  letter-spacing:2px;\n  padding:clamp(5px,.6vh,6px) clamp(14px,1.8vw,24px);\n  white-space:nowrap;\n  background:linear-gradient(90deg, #ffe066,#ff9f1c,#ffdd57,#f5c842,#ffe066,#ff9f1c,#ffdd57);\n  background-size:300% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  animation:goldShift 3s linear infinite;\n  filter:drop-shadow(0 0 8px rgba(255,180,30,.7));\n}\n\n/* ── CORNER ORNAMENTS ── */\n.ornament{\n  position:absolute;\n  font-size:clamp(12px,1.8vw,20px);\n  opacity:.35;\n  animation:ornSway 4s ease-in-out infinite;\n}\n.orn-tl{top:12px;left:16px;animation-delay:0s}\n.orn-tr{top:12px;right:16px;animation-delay:.5s}\n.orn-bl{bottom:12px;left:16px;animation-delay:1s}\n.orn-br{bottom:12px;right:16px;animation-delay:1.5s}\n@keyframes ornSway{ 0%,100%{transform:rotate(-5deg) scale(1)} 50%{transform:rotate(5deg) scale(1.1)} }\n\n/* ── BOTTOM DECO ── */\n.deco-row{\n  position:absolute;bottom:0;left:0;right:0;\n  display:flex;justify-content:center;gap:.5vw;\n  z-index:11;pointer-events:none;\n  padding-bottom:2px;\n}\n.deco-item{\n  font-size:clamp(12px,1.8vw,20px);opacity:.4;\n  animation:decoSway 3.6s ease-in-out infinite;\n  transform-origin:bottom center;\n}\n.deco-item:nth-child(2n){animation-delay:.6s}\n.deco-item:nth-child(3n){animation-delay:1.2s}\n.deco-item:nth-child(4n){animation-delay:1.8s}\n@keyframes decoSway{ 0%,100%{transform:rotate(-6deg)} 50%{transform:rotate(6deg)} }\n\n@keyframes fadeDown{ from{opacity:0;transform:translateY(-14px)} to{opacity:1;transform:translateY(0)} }\n@keyframes fadeUp{ from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n\n  <canvas id=\"cRays\"></canvas>\n  <canvas id=\"cPalms\"></canvas>\n  <canvas id=\"cGlow\"></canvas>\n  <div class=\"ground-mist\"></div>\n  <canvas id=\"cSparkle\"></canvas>\n  <canvas id=\"cCoins\"></canvas>\n\n  <div class=\"content\">\n\n    <!-- TOP VERSE -->\n    <div class=\"verse-banner\">\n      <div class=\"verse-ta\">\n        ஓசன்னா, கர்த்தருடைய நாமத்தினாலே வருகிற இஸ்ரவேலின் ராஜா ஸ்தோத்திரிக்கப்பட்டவர்\n      </div>\n      <div class=\"verse-ref\">— யோவான் 12:13</div>\n    </div>\n\n    <!-- MAIN CARD -->\n    <div class=\"card\">\n\n      <span class=\"ornament orn-tl\">🌿</span>\n      <span class=\"ornament orn-tr\">🌿</span>\n      <span class=\"ornament orn-bl\">✨</span>\n      <span class=\"ornament orn-br\">✨</span>\n\n      <div class=\"church-top\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n\n      <div class=\"div-row\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-gem\">✦</span>\n        <span class=\"div-gem\" style=\"font-size:clamp(11px,1.4vw,16px);color:rgba(255,200,60,0.5)\">🌴</span>\n        <span class=\"div-gem\">✦</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"event-tag\">🌿 Palm Sunday 🌿</div>\n\n      <div class=\"palm-title\">குருத்தோலை ஞாயிறு</div>\n\n      <div class=\"service-text\">PALM SUNDAY</div>\n\n      <div class=\"service-subtext\">ஆராதனை · Service</div>\n\n      <!-- GOLDEN CROSS SVG (Enlarged) -->\n      <div class=\"cross-wrap\">\n        <svg viewBox=\"0 0 120 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff5c0\"/>\n              <stop offset=\"15%\" stop-color=\"#ffd700\"/>\n              <stop offset=\"35%\" stop-color=\"#c8860a\"/>\n              <stop offset=\"50%\" stop-color=\"#ffe566\"/>\n              <stop offset=\"65%\" stop-color=\"#d4920e\"/>\n              <stop offset=\"85%\" stop-color=\"#ffc200\"/>\n              <stop offset=\"100%\" stop-color=\"#a86200\"/>\n            </linearGradient>\n            <linearGradient id=\"cg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff0a0\"/>\n              <stop offset=\"50%\" stop-color=\"#c8860a\"/>\n              <stop offset=\"100%\" stop-color=\"#ffe566\"/>\n            </linearGradient>\n            <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n              <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n            <radialGradient id=\"shine\" cx=\"35%\" cy=\"30%\" r=\"60%\">\n              <stop offset=\"0%\" stop-color=\"rgba(255,255,220,0.6)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(255,255,220,0)\"/>\n            </radialGradient>\n          </defs>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#cg1)\" filter=\"url(#glow)\"/>\n          <rect x=\"8\"  y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#cg2)\" filter=\"url(#glow)\"/>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#shine)\" opacity=\".7\"/>\n          <rect x=\"8\"  y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#shine)\" opacity=\".5\"/>\n          <rect x=\"54\" y=\"8\" width=\"6\" height=\"144\" rx=\"3\" fill=\"rgba(255,255,200,0.3)\"/>\n          <rect x=\"8\"  y=\"46\" width=\"104\" height=\"6\" rx=\"3\" fill=\"rgba(255,255,200,0.25)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"10\" fill=\"url(#cg1)\" stroke=\"rgba(255,230,100,.6)\" stroke-width=\"1.5\" filter=\"url(#glow)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"5\" fill=\"rgba(255,250,200,0.8)\"/>\n        </svg>\n      </div>\n\n      <!-- DATE & TIME -->\n      <div class=\"info-row\">\n        <div class=\"info-box\">\n          <div class=\"info-label\">தேதி / Date</div>\n          <div class=\"info-value\">29 · 03 · 2026</div>\n        </div>\n        <div class=\"info-sep\">✦</div>\n        <div class=\"info-box\">\n          <div class=\"info-label\">நேரம் / Time</div>\n          <div class=\"info-value\">காலை 6:30</div>\n        </div>\n      </div>\n\n      <!-- CINEMATIC BISHOP BLOCK -->\n      <div class=\"bishop-block\">\n        \n        <div class=\"bishop-role\">பிஷப் / Bishop</div>\n        \n        <!-- ✨ MAGICAL SIGNATURE REVEAL WRAPPER ✨ -->\n        <div class=\"bishop-name-wrapper\">\n          <div class=\"pen-flare\"></div>\n          <div class=\"bishop-name-en\">Bp. V. Paul Yuvaraj</div>\n        </div>\n        \n        <div class=\"bishop-name-ta\">பி. வி. பால் யுவராஜ்</div>\n      </div>\n\n      <!-- CHURCH BADGE -->\n      <div class=\"church-badge\">\n        <div class=\"church-bg-inner\"></div>\n        <div class=\"church-name\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span>\n  </div>\n\n</div>\n\n<script>\n/* ── GOLDEN RAYS ── */\n(function(){\n  const cv=document.getElementById('cRays'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const R=Array.from({length:28},(_,i)=>({\n    a:(i/28)*Math.PI*1.6-Math.PI*.8+(Math.random()-.5)*.3,\n    al:.03+Math.random()*.07,\n    sp:(.0015+Math.random()*.003)*(Math.random()>.5?1:-1),\n    ln:.45+Math.random()*.65\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    R.forEach(r=>{\n      r.a+=r.sp;\n      const ax=Math.cos(r.a)*W*r.ln+W*.5,ay=Math.sin(r.a)*W*r.ln+H*1.08;\n      const bx=Math.cos(r.a+.03)*W*r.ln+W*.5,by=Math.sin(r.a+.03)*W*r.ln+H*1.08;\n      const g=cx.createLinearGradient(W*.5,H*1.08,ax,ay);\n      g.addColorStop(0,`rgba(255,210,50,${r.al*2})`);\n      g.addColorStop(.4,`rgba(255,165,20,${r.al})`);\n      g.addColorStop(1,'rgba(200,140,10,0)');\n      cx.save();cx.beginPath();cx.moveTo(W*.5,H*1.08);\n      cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── PALM SILHOUETTES ── */\n(function(){\n  const cv=document.getElementById('cPalms'),cx=cv.getContext('2d');\n  let W,H;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  function drawPalmLeaf(cx,x,y,angle,len,color){\n    cx.save();cx.translate(x,y);cx.rotate(angle);\n    cx.beginPath();\n    cx.moveTo(0,0);\n    for(let i=0;i<=20;i++){\n      const t=i/20,lx=t*len;\n      const ly=Math.sin(t*Math.PI)*(len*.22)*(1-t*.5);\n      if(i===0)cx.moveTo(lx,ly);else cx.lineTo(lx,ly);\n    }\n    for(let i=20;i>=0;i--){\n      const t=i/20,lx=t*len;\n      const ly=Math.sin(t*Math.PI)*(len*.22)*(1-t*.5);\n      cx.lineTo(lx,-ly*.3);\n    }\n    cx.fillStyle=color;cx.fill();cx.restore();\n  }\n  function draw(){\n    cx.clearRect(0,0,W,H);\n    // left palm\n    const lx=W*.08,ly=H*.85;\n    cx.fillStyle='rgba(30,60,20,0.55)';\n    // trunk\n    cx.save();cx.translate(lx,H);cx.rotate(-.15);\n    cx.beginPath();cx.moveTo(-6,0);cx.lineTo(-3,-H*.55);cx.lineTo(3,-H*.55);cx.lineTo(6,0);\n    cx.fillStyle='rgba(25,45,15,0.45)';cx.fill();cx.restore();\n    // leaves\n    const leafAngles=[-2.0,-1.6,-1.2,-.8,-.4,0,.2,.5,.9,1.3,1.7,2.1];\n    leafAngles.forEach((a,i)=>{\n      const al=.12+.18*(i%2);\n      drawPalmLeaf(cx,lx+Math.sin(-.15)*H*.55*-1,ly-H*.05,a,W*.18,`rgba(20,70,15,${al})`);\n    });\n    // right palm\n    const rx=W*.92,ry=H*.8;\n    cx.save();cx.translate(rx,H);cx.rotate(.18);\n    cx.beginPath();cx.moveTo(-6,0);cx.lineTo(-3,-H*.5);cx.lineTo(3,-H*.5);cx.lineTo(6,0);\n    cx.fillStyle='rgba(25,45,15,0.45)';cx.fill();cx.restore();\n    leafAngles.forEach((a,i)=>{\n      const al=.1+.16*(i%2);\n      drawPalmLeaf(cx,rx+Math.sin(.18)*H*.5*-1,ry,Math.PI-a,W*.16,`rgba(18,60,12,${al})`);\n    });\n  }\n  draw();\n  addEventListener('resize',draw);\n})();\n\n/* ── GLOW HALO ── */\n(function(){\n  const cv=document.getElementById('cGlow'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    const pulse=.85+.15*Math.sin(t*.025);\n    const g=cx.createRadialGradient(W*.5,H*.62,0,W*.5,H*.62,W*.38*pulse);\n    g.addColorStop(0,'rgba(255,220,70,.14)');\n    g.addColorStop(.35,'rgba(255,175,30,.07)');\n    g.addColorStop(.65,'rgba(200,120,10,.04)');\n    g.addColorStop(1,'transparent');\n    cx.fillStyle=g;cx.fillRect(0,0,W,H);\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── SPARKLES ── */\n(function(){\n  const cv=document.getElementById('cSparkle'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const S=Array.from({length:80},()=>({\n    x:Math.random()*innerWidth,y:Math.random()*innerHeight,\n    r:.4+Math.random()*2,ph:Math.random()*Math.PI*2,\n    sp:.018+Math.random()*.035,\n    vy:-(Math.random()*.28+.08),vx:(Math.random()-.5)*.12,\n    col:Math.random()>.5?'255,225,80':'180,255,150'\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    S.forEach(s=>{\n      s.y+=s.vy;s.x+=s.vx;\n      if(s.y<-10){s.y=H+10;s.x=Math.random()*W;}\n      const a=.15+.7*(.5+.5*Math.sin(t*s.sp+s.ph));\n      cx.save();cx.globalAlpha=a;\n      cx.fillStyle=`rgba(${s.col},1)`;\n      cx.shadowColor=`rgba(${s.col},.7)`;cx.shadowBlur=s.r*6;\n      cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── GOLD COINS ── */\n(function(){\n  const cv=document.getElementById('cCoins'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  class Coin{\n    constructor(rand){\n      this.x=Math.random()*innerWidth;\n      this.y=rand?(Math.random()*innerHeight):(innerHeight+30);\n      this.r=Math.random()*8+4;\n      this.vy=-(Math.random()*.45+.18);this.vx=(Math.random()-.5)*.28;\n      this.rot=Math.random()*Math.PI*2;this.rotV=(Math.random()-.5)*.038;\n      this.alpha=Math.random()*.5+.22;\n    }\n    update(){\n      this.y+=this.vy;this.x+=this.vx;this.rot+=this.rotV;\n      this.alpha-=.0014;\n      if(this.alpha<=0||this.y<-30)Object.assign(this,new Coin(false));\n    }\n    draw(cx){\n      cx.save();cx.translate(this.x,this.y);cx.rotate(this.rot);\n      cx.globalAlpha=Math.max(0,this.alpha);\n      const g=cx.createRadialGradient(-this.r*.3,-this.r*.3,0,0,0,this.r);\n      g.addColorStop(0,'rgba(255,245,120,1)');\n      g.addColorStop(.5,'rgba(220,170,20,1)');\n      g.addColorStop(1,'rgba(160,95,0,1)');\n      cx.fillStyle=g;cx.shadowColor='rgba(255,200,0,.55)';cx.shadowBlur=7;\n      cx.beginPath();cx.ellipse(0,0,this.r,this.r*.33,0,0,Math.PI*2);cx.fill();\n      cx.fillStyle='rgba(255,255,180,.4)';\n      cx.beginPath();cx.ellipse(-this.r*.22,-this.r*.05,this.r*.28,this.r*.09,-.3,0,Math.PI*2);cx.fill();\n      cx.restore();\n    }\n  }\n  const coins=Array.from({length:18},()=>new Coin(true));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%60===0&&coins.length<26)coins.push(new Coin(false));\n    coins.forEach(c=>{c.update();c.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Palm Sunday - Good Samarian Jesus Prayer House</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel+Decorative:wght@700;900&family=Noto+Serif+Tamil:wght@400;700;900&family=IM+Fell+English:ital@1&family=Playfair+Display:wght@700;900&display=swap\" rel=\"stylesheet\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden}\n\n.stage{\n  width:100vw;height:100vh;\n  position:relative;overflow:hidden;\n  background:#0a0500;\n}\n\n/* Deep forest-gold sky */\n.sky{\n  position:absolute;inset:0;\n  background:\n    radial-gradient(ellipse 120% 80% at 50% 110%, rgba(255,200,50,0.28) 0%, transparent 65%),\n    radial-gradient(ellipse 80% 60% at 50% 105%, rgba(255,150,20,0.22) 0%, transparent 55%),\n    linear-gradient(175deg,\n      #020100 0%, #0d0800 12%, #1a1000 24%, #2e1d00 36%,\n      #4a2e00 48%, #6b4500 58%, #3d2700 68%, #1a1000 80%, #0a0600 100%\n    );\n  z-index:0;\n}\n\n/* ── CANVASES ── */\ncanvas{position:absolute;inset:0;pointer-events:none;}\n#cRays{z-index:1}\n#cPalms{z-index:2}\n#cGlow{z-index:3}\n#cSparkle{z-index:5}\n#cCoins{z-index:6}\n\n.ground-mist{\n  position:absolute;bottom:0;left:0;right:0;height:22vh;\n  background:linear-gradient(to top, rgba(255,230,120,0.18) 0%, rgba(255,200,60,0.08) 50%, transparent 100%);\n  z-index:4;\n}\n\n/* ── CONTENT ── */\n.content{\n  position:absolute;inset:0;z-index:10;\n  display:flex;flex-direction:column;\n  align-items:center;justify-content:center;\n  padding:1vh 2vw;\n}\n\n/* ── VERSE BANNER (top) ── */\n.verse-banner{\n  width:min(98vw,820px);\n  background:linear-gradient(90deg, rgba(180,110,0,0.0) 0%, rgba(255,190,50,0.22) 20%, rgba(255,210,80,0.28) 50%, rgba(255,190,50,0.22) 80%, rgba(180,110,0,0.0) 100%);\n  border-top:1px solid rgba(255,200,80,0.3);\n  border-bottom:1px solid rgba(255,200,80,0.3);\n  text-align:center;\n  padding:.8vh 2vw; \n  margin-bottom:.8vh; \n  opacity:0;\n  animation:fadeDown .9s ease forwards .3s;\n}\n.verse-ta{\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(11px,1.4vw,16px);\n  color:rgba(255,230,150,0.9);\n  line-height:1.4;\n  letter-spacing:.5px;\n}\n.verse-ref{\n  font-family:'IM Fell English',serif;\n  font-style:italic;\n  font-size:clamp(10px,1.1vw,13px);\n  color:rgba(255,200,80,0.7);\n  margin-top:.1vh;\n  letter-spacing:1px;\n}\n\n/* ── MAIN CARD ── */\n.card{\n  width:min(97vw,760px); \n  max-height: 88vh; \n  overflow-y: auto; \n  scrollbar-width: none; \n  background:rgba(10,6,0,0.72);\n  backdrop-filter:blur(20px);\n  -webkit-backdrop-filter:blur(20px);\n  border-radius:24px;\n  border:1px solid rgba(255,200,70,0.3);\n  box-shadow:\n    0 0 60px rgba(200,130,0,0.25),\n    0 0 120px rgba(180,100,0,0.12),\n    inset 0 1px 0 rgba(255,220,100,0.25),\n    inset 0 -1px 0 rgba(255,180,30,0.15);\n  padding:clamp(10px,1.5vh,20px) clamp(16px,3vw,40px); \n  display:flex;flex-direction:column;\n  align-items:center;gap:0;\n  position:relative;\n  opacity:0;\n  animation:cardReveal 1.2s cubic-bezier(.22,1,.36,1) forwards .6s;\n}\n.card::-webkit-scrollbar { display: none; } \n\n.card::before{\n  content:'';\n  position:absolute;inset:0;\n  background:\n    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255,210,80,0.07) 0%, transparent 60%),\n    radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255,180,30,0.06) 0%, transparent 60%);\n  pointer-events:none;border-radius:24px;\n}\n\n.card::after{\n  content:'';\n  position:absolute;\n  top:10px;left:10px;right:10px;bottom:10px;\n  border-radius:18px;\n  border:1px solid rgba(255,200,60,0.12);\n  pointer-events:none;\n}\n\n@keyframes cardReveal{\n  from{opacity:0;transform:translateY(30px) scale(.96)}\n  to{opacity:1;transform:translateY(0) scale(1)}\n}\n\n/* ── CHURCH NAME TOP ── */\n.church-top{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(7px,.85vw,11px);\n  color:rgba(255,200,80,0.65);\n  letter-spacing:4px;\n  text-transform:uppercase;\n  margin-bottom:.6vh; \n  opacity:0;animation:fadeUp .8s ease forwards 1s;\n}\n\n/* ── DIVIDER ── */\n.div-row{\n  display:flex;align-items:center;gap:1.5vw;\n  width:100%;margin-bottom:.6vh; \n  opacity:0;animation:fadeUp .7s ease forwards 1.1s;\n}\n.div-line{\n  flex:1;height:1px;\n  background:linear-gradient(90deg,transparent,rgba(200,140,20,0.55),transparent);\n}\n.div-gem{color:rgba(255,200,60,0.8);font-size:clamp(9px,1vw,13px);}\n\n/* ── PALM SUNDAY TAG ── */\n.event-tag{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(8px,1vw,11px);\n  color:rgba(100,200,100,0.85);\n  letter-spacing:5px;\n  text-transform:uppercase;\n  margin-bottom:.4vh;\n  opacity:0;animation:fadeUp .8s ease forwards 1.2s;\n}\n\n/* ── PALM SUNDAY TITLE ── */\n.palm-title{\n  font-family:'Playfair Display',serif;\n  font-style:italic;\n  font-weight:900;\n  font-size:clamp(24px,5.5vw,55px); \n  line-height:1.1;\n  letter-spacing:2px;\n  white-space:nowrap; \n  margin-bottom:.4vh;\n  background:linear-gradient(150deg, #7ab870 0%, #a8d5a2 18%, #c8efc0 32%, #8fce85 48%, #5a9e50 64%, #3d7235 80%, #5a9e50 100%);\n  background-size:250% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  filter:drop-shadow(0 4px 18px rgba(80,160,60,.45));\n  opacity:0;\n  animation:palmReveal 1.1s cubic-bezier(.34,1.56,.64,1) forwards 1.3s, palmFlow 6s ease-in-out infinite 2.5s;\n  text-align:center;\n}\n@keyframes palmReveal{\n  from{opacity:0;transform:scale(.7);filter:blur(14px)}\n  to{opacity:1;transform:scale(1);filter:blur(0) drop-shadow(0 4px 18px rgba(80,160,60,.45))}\n}\n@keyframes palmFlow{\n  0%,100%{background-position:0% center}\n  50%{background-position:100% center}\n}\n\n/* ── SERVICE TEXT ── */\n.service-text{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(12px,2vw,24px); \n  font-weight:700;\n  letter-spacing:8px;\n  background:linear-gradient(90deg, #c8960a 0%,#f5d060 25%,#ffe88a 50%,#f5d060 75%,#c8960a 100%);\n  background-size:300% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  opacity:0;animation:fadeUp .8s ease forwards 1.6s, goldShift 3s linear infinite 2.5s;\n  text-transform:uppercase;\n  margin-bottom:.2vh;\n  margin-top:.2vh;\n}\n@keyframes goldShift{ 0%{background-position:0% center}100%{background-position:300% center} }\n\n/* ── SERVICE SUBTEXT ── */\n.service-subtext{\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(10px,1.1vw,13px);\n  color:rgba(255,220,130,0.6);\n  letter-spacing:4px;\n  margin-bottom:1vh; \n  opacity:0;animation:fadeUp .8s ease forwards 1.75s;\n}\n\n/* ── CROSS (Enlarged) ── */\n.cross-wrap{\n  position:relative;\n  margin:1vh 0; \n  opacity:0;\n  animation:crossReveal 1.2s cubic-bezier(.34,1.56,.64,1) forwards 1.8s;\n}\n@keyframes crossReveal{\n  from{opacity:0;transform:scale(.3) rotate(-15deg)}\n  to{opacity:1;transform:scale(1) rotate(0deg)}\n}\n.cross-wrap svg{\n  display:block;\n  /* ✨ Noticeably enlarged cross height */\n  height: clamp(65px, 14vh, 120px);  \n  width: auto;\n  filter: drop-shadow(0 0 14px rgba(255,200,60,0.9)) drop-shadow(0 0 30px rgba(255,160,20,0.6));\n  animation:crossGlow 3s ease-in-out infinite;\n}\n@keyframes crossGlow{\n  0%,100%{filter:drop-shadow(0 0 14px rgba(255,200,60,0.9)) drop-shadow(0 0 30px rgba(255,160,20,0.6))}\n  50%{filter:drop-shadow(0 0 22px rgba(255,230,100,1.0)) drop-shadow(0 0 50px rgba(255,180,40,0.85))}\n}\n\n/* ── INFO ROW ── */\n.info-row{\n  display:flex;align-items:center;gap:3vw;\n  margin-bottom:1vh; \n  opacity:0;animation:fadeUp .8s ease forwards 2s;\n}\n.info-box{ text-align:center; }\n.info-label{\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(7px,.75vw,9px);\n  color:rgba(255,200,60,0.65);\n  letter-spacing:3px;\n  text-transform:uppercase;\n  margin-bottom:.2vh;\n}\n.info-value{\n  font-family:'Playfair Display',serif;\n  font-size:clamp(11px,1.5vw,18px);\n  font-weight:700;\n  color:rgba(255,225,130,0.95);\n  letter-spacing:1px;\n  text-shadow:0 0 18px rgba(255,180,30,.5);\n}\n.info-sep{ font-size:clamp(14px,1.8vw,24px); color:rgba(255,200,60,0.35); }\n\n\n/* ══════════════════════════════════════════════\n   ⭐ CINEMATIC BISHOP BLOCK ⭐\n══════════════════════════════════════════════ */\n.bishop-block{\n  width:100%;\n  position:relative;\n  overflow:hidden;\n  background:linear-gradient(160deg, rgba(40,25,5,0.75) 0%, rgba(10,5,0,0.9) 100%);\n  border-radius:16px;\n  padding:clamp(8px,1vh,12px) clamp(10px,2vw,24px); \n  text-align:center;\n  margin-bottom:1vh; \n  box-shadow: 0 12px 30px rgba(0,0,0,0.6), inset 0 1px 1px rgba(255,255,255,0.1);\n  border: 1px solid rgba(255,200,60,0.15);\n  opacity:0;animation:fadeUp .9s ease forwards 2.2s;\n}\n\n/* Glowing Top Edge */\n.bishop-block::before {\n  content:'';\n  position:absolute;\n  top:0; left:20%; right:20%;\n  height:1.5px;\n  background: linear-gradient(90deg, transparent, rgba(255,230,120,0.85), transparent);\n  box-shadow: 0 0 12px rgba(255,200,50,0.8);\n}\n\n/* Sweeping Lens Flare across the block */\n.bishop-block::after {\n  content:'';\n  position:absolute;\n  top:0; left:-100%; width:40%; height:100%;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);\n  transform: skewX(-20deg);\n  animation: blockSweep 5.5s infinite;\n  pointer-events: none;\n  z-index: 1;\n}\n@keyframes blockSweep {\n  0%, 30% { left: -100%; }\n  70%, 100% { left: 200%; }\n}\n\n.bishop-role{\n  position: relative; z-index: 2;\n  font-family:'Cinzel Decorative',serif;\n  font-size:clamp(7px,.7vw,9px);\n  color:rgba(255,200,60,0.6);\n  letter-spacing:4px;\n  text-transform:uppercase;\n  margin-bottom:.2vh; \n}\n\n\n/* ══════════════════════════════════════════════\n   🖊️ INFINITE LOOPING SIGNATURE WIPE 🖊️\n══════════════════════════════════════════════ */\n.bishop-name-wrapper {\n  position: relative;\n  display: inline-block;\n  z-index: 2;\n  padding: 0 10px; /* Breathing room for italic tails */\n}\n\n/* Pulsing Golden Aura behind name */\n.bishop-name-wrapper::before {\n  content: '';\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: 140%; height: 160%;\n  background: radial-gradient(ellipse, rgba(255,200,50,0.15) 0%, transparent 60%);\n  animation: auraPulse 3s ease-in-out infinite;\n  pointer-events: none;\n}\n@keyframes auraPulse {\n  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(0.9); }\n  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }\n}\n\n/* The Signature Reveal Text */\n.bishop-name-en {\n  position: relative;\n  font-family: 'Alex Brush', cursive; /* Elegant Handwriting Font */\n  font-weight: 400; \n  font-size: clamp(28px, 4vw, 44px); /* Larger for script legibility */\n  line-height: 1.2;\n  letter-spacing: 1px;\n  \n  /* Golden Metallic Texture */\n  background: linear-gradient(90deg, #cca231 0%, #fffbe0 25%, #ffcc00 50%, #fffbe0 75%, #cca231 100%);\n  background-size: 200% auto;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  \n  /* Hard drop shadow to lift transparent text off the background */\n  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.95)) drop-shadow(0 0 15px rgba(255,200,0,0.4));\n  \n  /* The Wipe Animation defaults to hidden */\n  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%); \n  \n  /* Loop setup: 8 seconds total, runs forever */\n  animation: \n    signatureLoop 8s cubic-bezier(0.39, 0.57, 0.56, 1) infinite 2.5s, \n    goldShift 4s linear infinite; \n}\n\n/* The Magic Spark at the tip of the pen */\n.pen-flare {\n  position: absolute;\n  top: 45%; \n  left: 0;\n  width: 4px;\n  height: 4px;\n  background: #ffffff;\n  border-radius: 50%;\n  box-shadow: \n    0 0 10px 4px #fffbe0, \n    0 0 25px 12px #ffcc00, \n    0 0 40px 20px rgba(255,150,0,0.6);\n  opacity: 0;\n  z-index: 10;\n  pointer-events: none;\n  \n  /* Matches the duration and delay of the signature wipe */\n  animation: flareLoop 8s cubic-bezier(0.39, 0.57, 0.56, 1) infinite 2.5s;\n}\n\n/* ⭐ CONTINUOUS LOOPING KEYFRAMES ⭐ */\n\n/* 8-second cycle: Wait 0.4s -> Write for 2s -> Hold for 4.4s -> Fade Out for 0.8s -> Repeat */\n@keyframes signatureLoop {\n  0%, 5%   { clip-path: polygon(0 0, 0% 0, 0% 100%, 0 100%); opacity: 1; }\n  30%, 85% { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); opacity: 1; }\n  95%      { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); opacity: 0; }\n  100%     { clip-path: polygon(0 0, 0% 0, 0% 100%, 0 100%); opacity: 0; }\n}\n\n@keyframes flareLoop {\n  0%, 5%    { left: 0%; opacity: 0; transform: scale(0.5) translateY(0); }\n  8%        { opacity: 1; transform: scale(1.2) translateY(-4px); }\n  15%       { transform: scale(0.9) translateY(4px); }\n  22%       { transform: scale(1.4) translateY(-2px); }\n  28%       { transform: scale(1) translateY(3px); }\n  29%       { opacity: 1; transform: scale(1.2) translateY(-1px); }\n  30%, 100% { left: 100%; opacity: 0; transform: scale(0.5) translateY(0); }\n}\n/* ══════════════════════════════════════════════ */\n\n\n.bishop-name-ta{\n  position: relative; z-index: 2;\n  font-family:'Noto Serif Tamil',serif;\n  font-size:clamp(9px,1.1vw,14px);\n  font-weight:700;\n  color:rgba(255,230,160,0.85);\n  letter-spacing:1px;\n}\n\n\n/* ── CHURCH BADGE BOTTOM ── */\n.church-badge{\n  position:relative;\n  display:inline-flex;\n  align-items:center;justify-content:center;\n  opacity:0;\n  animation:churchReveal 1s cubic-bezier(.34,1.56,.64,1) forwards 2.5s;\n}\n@keyframes churchReveal{\n  from{opacity:0;transform:scale(.5)}\n  to{opacity:1;transform:scale(1)}\n}\n.church-bg-inner{\n  position:absolute;inset:3px;\n  background:rgba(5,2,0,0.9);\n  border-radius:50px;z-index:1;\n}\n.church-name{\n  position:relative;z-index:2;\n  font-family:'Noto Serif Tamil',serif;\n  font-weight:900;\n  font-size:clamp(9px,1vw,13px);\n  letter-spacing:2px;\n  padding:clamp(5px,.6vh,6px) clamp(14px,1.8vw,24px);\n  white-space:nowrap;\n  background:linear-gradient(90deg, #ffe066,#ff9f1c,#ffdd57,#f5c842,#ffe066,#ff9f1c,#ffdd57);\n  background-size:300% auto;\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n  animation:goldShift 3s linear infinite;\n  filter:drop-shadow(0 0 8px rgba(255,180,30,.7));\n}\n\n/* ── CORNER ORNAMENTS ── */\n.ornament{\n  position:absolute;\n  font-size:clamp(12px,1.8vw,20px);\n  opacity:.35;\n  animation:ornSway 4s ease-in-out infinite;\n}\n.orn-tl{top:12px;left:16px;animation-delay:0s}\n.orn-tr{top:12px;right:16px;animation-delay:.5s}\n.orn-bl{bottom:12px;left:16px;animation-delay:1s}\n.orn-br{bottom:12px;right:16px;animation-delay:1.5s}\n@keyframes ornSway{ 0%,100%{transform:rotate(-5deg) scale(1)} 50%{transform:rotate(5deg) scale(1.1)} }\n\n/* ── BOTTOM DECO ── */\n.deco-row{\n  position:absolute;bottom:0;left:0;right:0;\n  display:flex;justify-content:center;gap:.5vw;\n  z-index:11;pointer-events:none;\n  padding-bottom:2px;\n}\n.deco-item{\n  font-size:clamp(12px,1.8vw,20px);opacity:.4;\n  animation:decoSway 3.6s ease-in-out infinite;\n  transform-origin:bottom center;\n}\n.deco-item:nth-child(2n){animation-delay:.6s}\n.deco-item:nth-child(3n){animation-delay:1.2s}\n.deco-item:nth-child(4n){animation-delay:1.8s}\n@keyframes decoSway{ 0%,100%{transform:rotate(-6deg)} 50%{transform:rotate(6deg)} }\n\n@keyframes fadeDown{ from{opacity:0;transform:translateY(-14px)} to{opacity:1;transform:translateY(0)} }\n@keyframes fadeUp{ from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"sky\"></div>\n\n  <canvas id=\"cRays\"></canvas>\n  <canvas id=\"cPalms\"></canvas>\n  <canvas id=\"cGlow\"></canvas>\n  <div class=\"ground-mist\"></div>\n  <canvas id=\"cSparkle\"></canvas>\n  <canvas id=\"cCoins\"></canvas>\n\n  <div class=\"content\">\n\n    <!-- TOP VERSE -->\n    <div class=\"verse-banner\">\n      <div class=\"verse-ta\">\n        ஓசன்னா, கர்த்தருடைய நாமத்தினாலே வருகிற இஸ்ரவேலின் ராஜா ஸ்தோத்திரிக்கப்பட்டவர்\n      </div>\n      <div class=\"verse-ref\">— யோவான் 12:13</div>\n    </div>\n\n    <!-- MAIN CARD -->\n    <div class=\"card\">\n\n      <span class=\"ornament orn-tl\">🌿</span>\n      <span class=\"ornament orn-tr\">🌿</span>\n      <span class=\"ornament orn-bl\">✨</span>\n      <span class=\"ornament orn-br\">✨</span>\n\n      <div class=\"church-top\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n\n      <div class=\"div-row\">\n        <div class=\"div-line\"></div>\n        <span class=\"div-gem\">✦</span>\n        <span class=\"div-gem\" style=\"font-size:clamp(11px,1.4vw,16px);color:rgba(255,200,60,0.5)\">🌴</span>\n        <span class=\"div-gem\">✦</span>\n        <div class=\"div-line\"></div>\n      </div>\n\n      <div class=\"event-tag\">🌿 Palm Sunday 🌿</div>\n\n      <div class=\"palm-title\">குருத்தோலை ஞாயிறு</div>\n\n      <div class=\"service-text\">PALM SUNDAY</div>\n\n      <div class=\"service-subtext\">ஆராதனை · Service</div>\n\n      <!-- GOLDEN CROSS SVG (Enlarged) -->\n      <div class=\"cross-wrap\">\n        <svg viewBox=\"0 0 120 160\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <linearGradient id=\"cg1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff5c0\"/>\n              <stop offset=\"15%\" stop-color=\"#ffd700\"/>\n              <stop offset=\"35%\" stop-color=\"#c8860a\"/>\n              <stop offset=\"50%\" stop-color=\"#ffe566\"/>\n              <stop offset=\"65%\" stop-color=\"#d4920e\"/>\n              <stop offset=\"85%\" stop-color=\"#ffc200\"/>\n              <stop offset=\"100%\" stop-color=\"#a86200\"/>\n            </linearGradient>\n            <linearGradient id=\"cg2\" x1=\"1\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#fff0a0\"/>\n              <stop offset=\"50%\" stop-color=\"#c8860a\"/>\n              <stop offset=\"100%\" stop-color=\"#ffe566\"/>\n            </linearGradient>\n            <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\"/>\n              <feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n            <radialGradient id=\"shine\" cx=\"35%\" cy=\"30%\" r=\"60%\">\n              <stop offset=\"0%\" stop-color=\"rgba(255,255,220,0.6)\"/>\n              <stop offset=\"100%\" stop-color=\"rgba(255,255,220,0)\"/>\n            </radialGradient>\n          </defs>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#cg1)\" filter=\"url(#glow)\"/>\n          <rect x=\"8\"  y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#cg2)\" filter=\"url(#glow)\"/>\n          <rect x=\"46\" y=\"8\" width=\"28\" height=\"144\" rx=\"4\" fill=\"url(#shine)\" opacity=\".7\"/>\n          <rect x=\"8\"  y=\"40\" width=\"104\" height=\"28\" rx=\"4\" fill=\"url(#shine)\" opacity=\".5\"/>\n          <rect x=\"54\" y=\"8\" width=\"6\" height=\"144\" rx=\"3\" fill=\"rgba(255,255,200,0.3)\"/>\n          <rect x=\"8\"  y=\"46\" width=\"104\" height=\"6\" rx=\"3\" fill=\"rgba(255,255,200,0.25)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"10\" fill=\"url(#cg1)\" stroke=\"rgba(255,230,100,.6)\" stroke-width=\"1.5\" filter=\"url(#glow)\"/>\n          <circle cx=\"60\" cy=\"54\" r=\"5\" fill=\"rgba(255,250,200,0.8)\"/>\n        </svg>\n      </div>\n\n      <!-- DATE & TIME -->\n      <div class=\"info-row\">\n        <div class=\"info-box\">\n          <div class=\"info-label\">தேதி / Date</div>\n          <div class=\"info-value\">29 · 03 · 2026</div>\n        </div>\n        <div class=\"info-sep\">✦</div>\n        <div class=\"info-box\">\n          <div class=\"info-label\">நேரம் / Time</div>\n          <div class=\"info-value\">காலை 6:30</div>\n        </div>\n      </div>\n\n      <!-- CINEMATIC BISHOP BLOCK -->\n      <div class=\"bishop-block\">\n        \n        <div class=\"bishop-role\">பிஷப் / Bishop</div>\n        \n        <!-- ✨ MAGICAL SIGNATURE REVEAL WRAPPER ✨ -->\n        <div class=\"bishop-name-wrapper\">\n          <div class=\"pen-flare\"></div>\n          <div class=\"bishop-name-en\">Bp. V. Paul Yuvaraj</div>\n        </div>\n        \n        <div class=\"bishop-name-ta\">பி. வி. பால் யுவராஜ்</div>\n      </div>\n\n      <!-- CHURCH BADGE -->\n      <div class=\"church-badge\">\n        <div class=\"church-bg-inner\"></div>\n        <div class=\"church-name\">நல்ல சமாரியன் இயேசு ஜெப வீடு</div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"deco-row\">\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span><span class=\"deco-item\">💛</span>\n    <span class=\"deco-item\">🌴</span><span class=\"deco-item\">✨</span>\n    <span class=\"deco-item\">🌿</span>\n  </div>\n\n</div>\n\n<script>\n/* ── GOLDEN RAYS ── */\n(function(){\n  const cv=document.getElementById('cRays'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const R=Array.from({length:28},(_,i)=>({\n    a:(i/28)*Math.PI*1.6-Math.PI*.8+(Math.random()-.5)*.3,\n    al:.03+Math.random()*.07,\n    sp:(.0015+Math.random()*.003)*(Math.random()>.5?1:-1),\n    ln:.45+Math.random()*.65\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    R.forEach(r=>{\n      r.a+=r.sp;\n      const ax=Math.cos(r.a)*W*r.ln+W*.5,ay=Math.sin(r.a)*W*r.ln+H*1.08;\n      const bx=Math.cos(r.a+.03)*W*r.ln+W*.5,by=Math.sin(r.a+.03)*W*r.ln+H*1.08;\n      const g=cx.createLinearGradient(W*.5,H*1.08,ax,ay);\n      g.addColorStop(0,`rgba(255,210,50,${r.al*2})`);\n      g.addColorStop(.4,`rgba(255,165,20,${r.al})`);\n      g.addColorStop(1,'rgba(200,140,10,0)');\n      cx.save();cx.beginPath();cx.moveTo(W*.5,H*1.08);\n      cx.lineTo(ax,ay);cx.lineTo(bx,by);cx.closePath();\n      cx.fillStyle=g;cx.fill();cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── PALM SILHOUETTES ── */\n(function(){\n  const cv=document.getElementById('cPalms'),cx=cv.getContext('2d');\n  let W,H;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  function drawPalmLeaf(cx,x,y,angle,len,color){\n    cx.save();cx.translate(x,y);cx.rotate(angle);\n    cx.beginPath();\n    cx.moveTo(0,0);\n    for(let i=0;i<=20;i++){\n      const t=i/20,lx=t*len;\n      const ly=Math.sin(t*Math.PI)*(len*.22)*(1-t*.5);\n      if(i===0)cx.moveTo(lx,ly);else cx.lineTo(lx,ly);\n    }\n    for(let i=20;i>=0;i--){\n      const t=i/20,lx=t*len;\n      const ly=Math.sin(t*Math.PI)*(len*.22)*(1-t*.5);\n      cx.lineTo(lx,-ly*.3);\n    }\n    cx.fillStyle=color;cx.fill();cx.restore();\n  }\n  function draw(){\n    cx.clearRect(0,0,W,H);\n    // left palm\n    const lx=W*.08,ly=H*.85;\n    cx.fillStyle='rgba(30,60,20,0.55)';\n    // trunk\n    cx.save();cx.translate(lx,H);cx.rotate(-.15);\n    cx.beginPath();cx.moveTo(-6,0);cx.lineTo(-3,-H*.55);cx.lineTo(3,-H*.55);cx.lineTo(6,0);\n    cx.fillStyle='rgba(25,45,15,0.45)';cx.fill();cx.restore();\n    // leaves\n    const leafAngles=[-2.0,-1.6,-1.2,-.8,-.4,0,.2,.5,.9,1.3,1.7,2.1];\n    leafAngles.forEach((a,i)=>{\n      const al=.12+.18*(i%2);\n      drawPalmLeaf(cx,lx+Math.sin(-.15)*H*.55*-1,ly-H*.05,a,W*.18,`rgba(20,70,15,${al})`);\n    });\n    // right palm\n    const rx=W*.92,ry=H*.8;\n    cx.save();cx.translate(rx,H);cx.rotate(.18);\n    cx.beginPath();cx.moveTo(-6,0);cx.lineTo(-3,-H*.5);cx.lineTo(3,-H*.5);cx.lineTo(6,0);\n    cx.fillStyle='rgba(25,45,15,0.45)';cx.fill();cx.restore();\n    leafAngles.forEach((a,i)=>{\n      const al=.1+.16*(i%2);\n      drawPalmLeaf(cx,rx+Math.sin(.18)*H*.5*-1,ry,Math.PI-a,W*.16,`rgba(18,60,12,${al})`);\n    });\n  }\n  draw();\n  addEventListener('resize',draw);\n})();\n\n/* ── GLOW HALO ── */\n(function(){\n  const cv=document.getElementById('cGlow'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    const pulse=.85+.15*Math.sin(t*.025);\n    const g=cx.createRadialGradient(W*.5,H*.62,0,W*.5,H*.62,W*.38*pulse);\n    g.addColorStop(0,'rgba(255,220,70,.14)');\n    g.addColorStop(.35,'rgba(255,175,30,.07)');\n    g.addColorStop(.65,'rgba(200,120,10,.04)');\n    g.addColorStop(1,'transparent');\n    cx.fillStyle=g;cx.fillRect(0,0,W,H);\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── SPARKLES ── */\n(function(){\n  const cv=document.getElementById('cSparkle'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  const S=Array.from({length:80},()=>({\n    x:Math.random()*innerWidth,y:Math.random()*innerHeight,\n    r:.4+Math.random()*2,ph:Math.random()*Math.PI*2,\n    sp:.018+Math.random()*.035,\n    vy:-(Math.random()*.28+.08),vx:(Math.random()-.5)*.12,\n    col:Math.random()>.5?'255,225,80':'180,255,150'\n  }));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    S.forEach(s=>{\n      s.y+=s.vy;s.x+=s.vx;\n      if(s.y<-10){s.y=H+10;s.x=Math.random()*W;}\n      const a=.15+.7*(.5+.5*Math.sin(t*s.sp+s.ph));\n      cx.save();cx.globalAlpha=a;\n      cx.fillStyle=`rgba(${s.col},1)`;\n      cx.shadowColor=`rgba(${s.col},.7)`;cx.shadowBlur=s.r*6;\n      cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);cx.fill();\n      cx.restore();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n\n/* ── GOLD COINS ── */\n(function(){\n  const cv=document.getElementById('cCoins'),cx=cv.getContext('2d');\n  let W,H,t=0;\n  function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}\n  resize();addEventListener('resize',resize);\n  class Coin{\n    constructor(rand){\n      this.x=Math.random()*innerWidth;\n      this.y=rand?(Math.random()*innerHeight):(innerHeight+30);\n      this.r=Math.random()*8+4;\n      this.vy=-(Math.random()*.45+.18);this.vx=(Math.random()-.5)*.28;\n      this.rot=Math.random()*Math.PI*2;this.rotV=(Math.random()-.5)*.038;\n      this.alpha=Math.random()*.5+.22;\n    }\n    update(){\n      this.y+=this.vy;this.x+=this.vx;this.rot+=this.rotV;\n      this.alpha-=.0014;\n      if(this.alpha<=0||this.y<-30)Object.assign(this,new Coin(false));\n    }\n    draw(cx){\n      cx.save();cx.translate(this.x,this.y);cx.rotate(this.rot);\n      cx.globalAlpha=Math.max(0,this.alpha);\n      const g=cx.createRadialGradient(-this.r*.3,-this.r*.3,0,0,0,this.r);\n      g.addColorStop(0,'rgba(255,245,120,1)');\n      g.addColorStop(.5,'rgba(220,170,20,1)');\n      g.addColorStop(1,'rgba(160,95,0,1)');\n      cx.fillStyle=g;cx.shadowColor='rgba(255,200,0,.55)';cx.shadowBlur=7;\n      cx.beginPath();cx.ellipse(0,0,this.r,this.r*.33,0,0,Math.PI*2);cx.fill();\n      cx.fillStyle='rgba(255,255,180,.4)';\n      cx.beginPath();cx.ellipse(-this.r*.22,-this.r*.05,this.r*.28,this.r*.09,-.3,0,Math.PI*2);cx.fill();\n      cx.restore();\n    }\n  }\n  const coins=Array.from({length:18},()=>new Coin(true));\n  function draw(){\n    t++;cx.clearRect(0,0,W,H);\n    if(t%60===0&&coins.length<26)coins.push(new Coin(false));\n    coins.forEach(c=>{c.update();c.draw(cx);});\n    requestAnimationFrame(draw);\n  }\n  draw();\n})();\n</script>\n</body>\n</html>"
    },
    {
      "id": 1772937978152.9502,
      "type": "html",
      "name": "Title",
      "html": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,600;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  .video-bg{\n    position:absolute;inset:0;z-index:0;\n    width:100%;height:100%;\n    object-fit:cover;object-position:center;\n  }\n\n  .photo-fallback{\n    position:absolute;inset:0;z-index:0;\n    background:linear-gradient(160deg,#1a0f05 0%,#3d2210 30%,#1c1408 55%,#0a0810 100%);\n  }\n\n  /* slightly stronger overlay so text always pops */\n  .overlay{\n    position:absolute;inset:0;z-index:2;\n    background:\n      linear-gradient(\n        170deg,\n        rgba(10,5,0,.70)  0%,\n        rgba(8,4,0,.35)   38%,\n        rgba(8,4,0,.32)   60%,\n        rgba(4,2,0,.85)  100%\n      );\n  }\n\n  .glow-center{\n    position:absolute;\n    left:50%;top:48%;\n    transform:translate(-50%,-50%);\n    width:82vw;height:58vh;\n    background:radial-gradient(ellipse,\n      rgba(255,165,40,.08) 0%,\n      rgba(200,100,20,.03) 45%,\n      transparent 70%\n    );\n    z-index:3;\n    animation:divineGlow 8s ease-in-out infinite;\n  }\n  @keyframes divineGlow{\n    0%,100%{opacity:.7;transform:translate(-50%,-50%) scale(1)}\n    50%    {opacity:1; transform:translate(-50%,-50%) scale(1.10)}\n  }\n\n  .rays{\n    position:absolute;inset:0;z-index:2;\n    background:conic-gradient(\n      from 270deg at 50% 42%,\n      transparent 0deg,\n      rgba(255,185,50,.025) 3deg,\n      transparent 6deg,\n      transparent 20deg,\n      rgba(255,185,50,.02) 23deg,\n      transparent 26deg,\n      transparent 45deg,\n      rgba(255,185,50,.018) 48deg,\n      transparent 51deg,\n      transparent 360deg\n    );\n    animation:raysPulse 10s ease-in-out infinite;\n  }\n  @keyframes raysPulse{\n    0%,100%{opacity:.5}\n    50%    {opacity:1}\n  }\n\n  .vignette{\n    position:absolute;inset:0;z-index:4;\n    background:radial-gradient(ellipse at center,transparent 34%,rgba(0,0,0,.82) 100%);\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:11;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* welcome — gold accent, small so it works */\n  .welcome{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(11px,1.3vw,19px);\n    letter-spacing:16px;text-transform:uppercase;\n    color:rgba(238,200,120,.90);\n    text-shadow:\n      0 0 16px rgba(160,100,20,.60),\n      0 2px 8px rgba(0,0,0,.95);\n    margin-bottom:1.4vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.1s;\n  }\n\n  /* orn 1 — gold accent line */\n  .orn{\n    width:50vw;height:1px;margin-bottom:1.8vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 1.5s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.40) 20%,\n      rgba(255,215,80,.85) 50%,\n      rgba(200,150,40,.40) 80%,\n      transparent\n    );\n    position:relative;\n  }\n  .orn::before,.orn::after{\n    content:'✦';position:absolute;top:-7px;\n    font-size:11px;color:rgba(255,210,75,.90);\n    text-shadow:0 0 10px rgba(200,150,35,.80);\n  }\n  .orn::before{left:-6px}.orn::after{right:-6px}\n\n  /* ── TITLE 1 ──\n     Pure white core shimmer — maximum contrast against sepia brown.\n     Thin gold edges so it still feels warm/holy, not cold.\n  ── */\n  .t1-wrap{\n    margin-bottom:.3vh;\n    opacity:0;animation:fadeUp 1s ease forwards 1.8s;\n  }\n  .t1{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(30px,5.5vw,86px);\n    font-weight:900;line-height:1.15;\n    white-space:nowrap;letter-spacing:3px;\n    background:linear-gradient(90deg,\n      #d4a820 0%,    /* warm gold edge */\n      #ffffff 18%,   /* pure white */\n      #ffffff 38%,   /* pure white */\n      #fffef5 50%,   /* near-white centre */\n      #ffffff 62%,   /* pure white */\n      #ffffff 80%,   /* pure white */\n      #d4a820 100%   /* warm gold edge */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 5s linear infinite;\n    /* strong dark drop shadow = crisp edge against brown bg */\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 30px rgba(255,255,255,.15));\n  }\n\n  /* ── TITLE 2 ──\n     Cool silver-white with faint lavender — contrasts warm sepia perfectly.\n  ── */\n  .t2-wrap{\n    opacity:0;animation:fadeUp 1s ease forwards 2.1s;\n  }\n  .t2{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(22px,4.3vw,66px);\n    font-weight:700;line-height:1.3;\n    letter-spacing:14px;white-space:nowrap;\n    background:linear-gradient(90deg,\n      #c8b8f0 0%,    /* soft lavender-silver */\n      #ffffff 20%,   /* white */\n      #e8e0ff 38%,   /* silver-lavender */\n      #ffffff 50%,   /* white */\n      #e8e0ff 62%,   /* silver-lavender */\n      #ffffff 80%,   /* white */\n      #c8b8f0 100%   /* soft lavender-silver */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 4s linear infinite;\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 25px rgba(200,185,255,.20));\n  }\n\n  @keyframes whiteShimmer{\n    0%  {background-position:0%   center}\n    100%{background-position:200% center}\n  }\n\n  /* orn 2 */\n  .orn2{\n    width:34vw;height:1px;\n    margin-top:1.8vh;margin-bottom:1.6vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 2.6s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.45) 35%,\n      rgba(255,215,80,.68) 65%,\n      transparent\n    );\n  }\n\n  /* verse — bright white-ivory, clearly readable */\n  .verse{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:600;\n    font-size:clamp(11px,1.2vw,17px);\n    letter-spacing:2px;text-align:center;\n    padding:0 12vw;\n    color:rgba(255,248,225,.92);\n    text-shadow:\n      0 1px 3px rgba(0,0,0,1),\n      0 3px 12px rgba(0,0,0,.96),\n      0 0 20px rgba(0,0,0,.80);\n    opacity:0;animation:fadeUp .9s ease forwards 2.9s;\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(15px)}\n    to  {opacity:1;transform:translateY(0)}\n  }\n  @keyframes lineExpand{to{opacity:1;transform:scaleX(1)}}\n</style>\n</head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"photo-fallback\"></div>\n\n  <video class=\"video-bg\" autoplay muted loop playsinline>\n    <source src=\"bgv.mp4\" type=\"video/mp4\">\n  </video>\n\n  <div class=\"overlay\"></div>\n  <div class=\"rays\"></div>\n  <div class=\"glow-center\"></div>\n  <div class=\"vignette\"></div>\n\n  <div class=\"content\">\n    <div class=\"welcome\">Welcome to</div>\n    <div class=\"orn\"></div>\n    <div class=\"t1-wrap\"><span class=\"t1\">நல்ல சமாரியன் இயேசு</span></div>\n    <div class=\"t2-wrap\"><span class=\"t2\">ஜெப வீடு</span></div>\n    <div class=\"orn2\"></div>\n    <div class=\"verse\">❝ என்னுடைய வீடு ஜெபவீடு என்னப்படும் ❞ — மத்தேயு 21:13</div>\n  </div>\n\n</div>\n</body>\n</html>",
      "_thumbHtml": "<!DOCTYPE html>\n<html lang=\"ta\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>நல்ல சமாரியன் இயேசு ஜெப வீடு</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif+Tamil:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,600;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:100%;height:100%;overflow:hidden;background:#000}\n\n  .stage{\n    width:100vw;height:100vh;\n    position:relative;overflow:hidden;\n  }\n\n  .video-bg{\n    position:absolute;inset:0;z-index:0;\n    width:100%;height:100%;\n    object-fit:cover;object-position:center;\n  }\n\n  .photo-fallback{\n    position:absolute;inset:0;z-index:0;\n    background:linear-gradient(160deg,#1a0f05 0%,#3d2210 30%,#1c1408 55%,#0a0810 100%);\n  }\n\n  /* slightly stronger overlay so text always pops */\n  .overlay{\n    position:absolute;inset:0;z-index:2;\n    background:\n      linear-gradient(\n        170deg,\n        rgba(10,5,0,.70)  0%,\n        rgba(8,4,0,.35)   38%,\n        rgba(8,4,0,.32)   60%,\n        rgba(4,2,0,.85)  100%\n      );\n  }\n\n  .glow-center{\n    position:absolute;\n    left:50%;top:48%;\n    transform:translate(-50%,-50%);\n    width:82vw;height:58vh;\n    background:radial-gradient(ellipse,\n      rgba(255,165,40,.08) 0%,\n      rgba(200,100,20,.03) 45%,\n      transparent 70%\n    );\n    z-index:3;\n    animation:divineGlow 8s ease-in-out infinite;\n  }\n  @keyframes divineGlow{\n    0%,100%{opacity:.7;transform:translate(-50%,-50%) scale(1)}\n    50%    {opacity:1; transform:translate(-50%,-50%) scale(1.10)}\n  }\n\n  .rays{\n    position:absolute;inset:0;z-index:2;\n    background:conic-gradient(\n      from 270deg at 50% 42%,\n      transparent 0deg,\n      rgba(255,185,50,.025) 3deg,\n      transparent 6deg,\n      transparent 20deg,\n      rgba(255,185,50,.02) 23deg,\n      transparent 26deg,\n      transparent 45deg,\n      rgba(255,185,50,.018) 48deg,\n      transparent 51deg,\n      transparent 360deg\n    );\n    animation:raysPulse 10s ease-in-out infinite;\n  }\n  @keyframes raysPulse{\n    0%,100%{opacity:.5}\n    50%    {opacity:1}\n  }\n\n  .vignette{\n    position:absolute;inset:0;z-index:4;\n    background:radial-gradient(ellipse at center,transparent 34%,rgba(0,0,0,.82) 100%);\n  }\n\n  /* ── CONTENT ── */\n  .content{\n    position:absolute;inset:0;z-index:11;\n    display:flex;flex-direction:column;\n    align-items:center;justify-content:center;\n  }\n\n  /* welcome — gold accent, small so it works */\n  .welcome{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:400;\n    font-size:clamp(11px,1.3vw,19px);\n    letter-spacing:16px;text-transform:uppercase;\n    color:rgba(238,200,120,.90);\n    text-shadow:\n      0 0 16px rgba(160,100,20,.60),\n      0 2px 8px rgba(0,0,0,.95);\n    margin-bottom:1.4vh;\n    opacity:0;animation:fadeUp .9s ease forwards 1.1s;\n  }\n\n  /* orn 1 — gold accent line */\n  .orn{\n    width:50vw;height:1px;margin-bottom:1.8vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 1.5s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.40) 20%,\n      rgba(255,215,80,.85) 50%,\n      rgba(200,150,40,.40) 80%,\n      transparent\n    );\n    position:relative;\n  }\n  .orn::before,.orn::after{\n    content:'✦';position:absolute;top:-7px;\n    font-size:11px;color:rgba(255,210,75,.90);\n    text-shadow:0 0 10px rgba(200,150,35,.80);\n  }\n  .orn::before{left:-6px}.orn::after{right:-6px}\n\n  /* ── TITLE 1 ──\n     Pure white core shimmer — maximum contrast against sepia brown.\n     Thin gold edges so it still feels warm/holy, not cold.\n  ── */\n  .t1-wrap{\n    margin-bottom:.3vh;\n    opacity:0;animation:fadeUp 1s ease forwards 1.8s;\n  }\n  .t1{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(30px,5.5vw,86px);\n    font-weight:900;line-height:1.15;\n    white-space:nowrap;letter-spacing:3px;\n    background:linear-gradient(90deg,\n      #d4a820 0%,    /* warm gold edge */\n      #ffffff 18%,   /* pure white */\n      #ffffff 38%,   /* pure white */\n      #fffef5 50%,   /* near-white centre */\n      #ffffff 62%,   /* pure white */\n      #ffffff 80%,   /* pure white */\n      #d4a820 100%   /* warm gold edge */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 5s linear infinite;\n    /* strong dark drop shadow = crisp edge against brown bg */\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 30px rgba(255,255,255,.15));\n  }\n\n  /* ── TITLE 2 ──\n     Cool silver-white with faint lavender — contrasts warm sepia perfectly.\n  ── */\n  .t2-wrap{\n    opacity:0;animation:fadeUp 1s ease forwards 2.1s;\n  }\n  .t2{\n    display:block;\n    font-family:'Noto Serif Tamil',serif;\n    font-size:clamp(22px,4.3vw,66px);\n    font-weight:700;line-height:1.3;\n    letter-spacing:14px;white-space:nowrap;\n    background:linear-gradient(90deg,\n      #c8b8f0 0%,    /* soft lavender-silver */\n      #ffffff 20%,   /* white */\n      #e8e0ff 38%,   /* silver-lavender */\n      #ffffff 50%,   /* white */\n      #e8e0ff 62%,   /* silver-lavender */\n      #ffffff 80%,   /* white */\n      #c8b8f0 100%   /* soft lavender-silver */\n    );\n    background-size:200% auto;\n    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n    animation:whiteShimmer 4s linear infinite;\n    filter:\n      drop-shadow(0 2px 2px rgba(0,0,0,1))\n      drop-shadow(0 4px 12px rgba(0,0,0,.95))\n      drop-shadow(0 0 25px rgba(200,185,255,.20));\n  }\n\n  @keyframes whiteShimmer{\n    0%  {background-position:0%   center}\n    100%{background-position:200% center}\n  }\n\n  /* orn 2 */\n  .orn2{\n    width:34vw;height:1px;\n    margin-top:1.8vh;margin-bottom:1.6vh;\n    opacity:0;transform:scaleX(0);\n    animation:lineExpand .85s ease forwards 2.6s;\n    background:linear-gradient(90deg,\n      transparent,\n      rgba(200,150,40,.45) 35%,\n      rgba(255,215,80,.68) 65%,\n      transparent\n    );\n  }\n\n  /* verse — bright white-ivory, clearly readable */\n  .verse{\n    font-family:'Cormorant Garamond',serif;\n    font-style:italic;font-weight:600;\n    font-size:clamp(11px,1.2vw,17px);\n    letter-spacing:2px;text-align:center;\n    padding:0 12vw;\n    color:rgba(255,248,225,.92);\n    text-shadow:\n      0 1px 3px rgba(0,0,0,1),\n      0 3px 12px rgba(0,0,0,.96),\n      0 0 20px rgba(0,0,0,.80);\n    opacity:0;animation:fadeUp .9s ease forwards 2.9s;\n  }\n\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(15px)}\n    to  {opacity:1;transform:translateY(0)}\n  }\n  @keyframes lineExpand{to{opacity:1;transform:scaleX(1)}}\n</style>\n<style>.verse-text{white-space:pre-line !important;word-break:normal !important;overflow-wrap:break-word !important;}</style><style>*,*::before,*::after{animation-delay:-9999s!important;animation-duration:1ms!important;animation-iteration-count:1!important;animation-play-state:running!important;transition:none!important;}canvas{display:none!important;}video{display:none!important;}</style><script>window.requestAnimationFrame=function(){return 0;};window.cancelAnimationFrame=function(){};</script></head>\n<body>\n<div class=\"stage\">\n\n  <div class=\"photo-fallback\"></div>\n\n  <video class=\"video-bg\" autoplay muted loop playsinline>\n    <source src=\"bgv.mp4\" type=\"video/mp4\">\n  </video>\n\n  <div class=\"overlay\"></div>\n  <div class=\"rays\"></div>\n  <div class=\"glow-center\"></div>\n  <div class=\"vignette\"></div>\n\n  <div class=\"content\">\n    <div class=\"welcome\">Welcome to</div>\n    <div class=\"orn\"></div>\n    <div class=\"t1-wrap\"><span class=\"t1\">நல்ல சமாரியன் இயேசு</span></div>\n    <div class=\"t2-wrap\"><span class=\"t2\">ஜெப வீடு</span></div>\n    <div class=\"orn2\"></div>\n    <div class=\"verse\">❝ என்னுடைய வீடு ஜெபவீடு என்னப்படும் ❞ — மத்தேயு 21:13</div>\n  </div>\n\n</div>\n</body>\n</html>"
