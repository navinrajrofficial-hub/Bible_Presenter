# Development Environment Configuration
NODE_ENV=development
VITE_APP_ENV=development

# API Configuration
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Performance Configuration
VITE_LAZY_LOAD_DELAY=500
VITE_BIBLE_CHUNK_SIZE=5
VITE_SONG_CHUNK_SIZE=50
VITE_THUMBNAIL_CACHE_SIZE=50
VITE_SEARCH_DEBOUNCE_MS=300
VITE_MAX_CONCURRENT_RENDERS=3

# Feature Flags
VITE_ENABLE_PWA=false
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_VOICE_CONTROL=true
VITE_ENABLE_AI_EXTRACTION=true

# Logging Configuration
VITE_LOG_LEVEL=debug
VITE_ENABLE_REMOTE_LOGGING=false
VITE_MAX_LOGS_PER_MINUTE=1000

# Storage Configuration
VITE_PREFER_INDEXEDDB=true
VITE_MAX_STORAGE_SIZE=104857600
VITE_ENABLE_MIGRATION=true
